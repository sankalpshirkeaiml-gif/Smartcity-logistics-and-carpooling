utton>\n434:             </div>\n435: \n436:             <!-- Active Trips List -->\n437:             <div class=\"active-trips-stream\" id=\"active-trips-stream\">\n438:               <!-- EcoSprout Empty State loaded dynamically -->\n439:             </div>\n440: \n441:             <!-- Transit Registry Canvas & Reversal Audit Trail -->\n442:             <div class=\"trip-insights-grid\">\n443:               <div class=\"insights-box\">\n444:                 <div class=\"column-subtitle\">\n445:                   <span><i class=\"fa-solid fa-bezier-curve text-electric\"></i> Trip Hierarchy & Corridor Network</span>\n446:                   <span class=\"sub-pill font-mono\" id=\"registry-count-pill\">0 Dispatched</span>\n447:                 </div>\n448:                 <div class=\"canvas-visual-box\">\n449:                   <canvas id=\"trip-hierarchy-canvas\" width=\"460\" height=\"180\"></canvas>\n450:                 </div>\n451:               </div>\n452: \n453:               <div class=\"insights-box\">\n454:                 <div class=\"column-subtitle\">\n455:                   <span><i class=\"fa-solid fa-clock-rotate-left text-slate-600\"></i> Recent Dispatch Reversal Log</span>\n456:                   <span class=\"sub-pill font-mono\" id=\"audit-log-pill\">0 Rollbacks Available</span>\n457:                 </div>\n458:                 <div class=\"audit-history-list\" id=\"audit-history-list\">\n459:                   <div class=\"empty-state\">\n460:                     <p>Reversal log clear. Confirm a trip to create a restorable dispatch state.</p>\n461:                   </div>\n462:                 </div>\n463:               </div>\n464:             </div>\n465:           </div>\n466: \n467:         </div>\n468:       </section>\n469: \n470:       <!-- ==========================================\n471:            TAB 4: CITY SUSTAINABILITY ANALYTICS\n472:            ========================================== -->\n473:       <section id=\"tab-sustainability\" class=\"tab-view\">\n474:         <div class=\"sustainability-section white-card eco-card-hover\">\n475:           <div class=\"panel-header\">\n476:             <div class=\"header-title\">\n477:               <i class=\"fa-solid fa-earth-americas text-emerald\"></i>\n478:               <div>\n479:                 <h2>Metropolitan Sustainability & Carbon Offset Analytics</h2>\n480:                 <p>Empirical climate impact metrics, fuel consumption reduction, and gamified top eco-mobility partners</p>\n481:               </div>\n482:             </div>\n483:             <div class=\"status-badge live-badge\">\n484:               <i class=\"fa-solid fa-seedling text-emerald\"></i> Clean Air Metric ISO-14064\n485:             </div>\n486:           </div>\n487: \n488:           <div class=\"sustainability-grid\">\n489:             <div class=\"eco-metric-card\">\n490:               <div class=\"eco-num text-emerald\" id=\"eco-total-co2\">148.5 kg</div>\n491:               <div class=\"eco-desc\">Net Atmospheric Carbon Reduction</div>\n492:               <div class=\"progress-bar-wrap\">\n493:                 <div class=\"progress-bar-fill bg-emerald\" style=\"width: 74%;\"></div>\n494:               </div>\n495:               <span class=\"text-[11px] text-slate-500\">74% toward daily metropolitan reduction target</span>\n496:             </div>\n497: \n498:             <div class=\"eco-metric-card\">\n499:               <div class=\"eco-num text-electric\" id=\"eco-shared-km\">1,420 km</div>\n500:               <div class=\"eco-desc\">Collective Pooled Distance Traveled</div>"}
