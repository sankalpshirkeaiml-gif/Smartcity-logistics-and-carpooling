itle\">\n              <i class=\"fa-solid fa-map-location-dot text-electric\"></i>\n              <div>\n                <h2>Metropolitan Eco-Route Finder & Corridor Map</h2>\n                <p>Interactive 3D transit network with automated minimum-emission trip routing</p>\n              </div>\n            </div>\n            <div class=\"status-badge live-badge\">\n              <span class=\"live-pulse\"></span>\n              Live Grid Active\n            </div>\n          </div>\n\n          <!-- Route Query Bar -->\n          <div class=\"route-query-bar\">\n            <div class=\"form-control-inline\">\n              <label><i class=\"fa-solid fa-circle-dot text-emerald\"></i> Origin</label>\n              <select id=\"route-origin\" class=\"select-field\"></select>\n            </div>\n            <div class=\"route-swap-btn\" id=\"btn-swap-route\" title=\"Swap Origin & Destination\">\n              <i class=\"fa-solid fa-arrow-right-arrow-left\"></i>\n            </div>\n            <div class=\"form-control-inline\">\n              <label><i class=\"fa-solid fa-location-dot text-rose-500\"></i> Destination</label>\n              <select id=\"route-destination\" class=\"select-field\"></select>\n            </div>\n            <button id=\"btn-calc-route\" class=\"btn btn-primary\">\n              <i class=\"fa-solid fa-route\"></i> Calculate Eco-Route\n            </button>\n            <button id=\"btn-reset-view\" class=\"btn btn-ghost\" title=\"Reset 3D Map View\">\n              <i class=\"fa-solid fa-crosshairs\"></i> Reset View\n            </button>\n          </div>\n\n          <!-- 3D Spatial Canvas Container (Light Blueprint Style) -->\n          <div class=\"map-canvas-container\" id=\"map-canvas-container\">\n            <canvas id=\"urban-3d-canvas\"></canvas>\n            <div class=\"map-hud-overlay\" id=\"map-hud-overlay\">\n              <i class=\"fa-solid fa-hand-pointer text-emerald\"></i> Click & drag to orbit 3D city corridors &bull; Scroll to zoom\n            </div>\n            <div class=\"compass-rose\">\n              <div class=\"compass-inner\">\n                <span class=\"compass-n\">N</span>\n                <span class=\"compass-e\">E</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Trip Impact Metrics Summary Strip -->\n          <div class=\"trip-impact-strip\" id=\"trip-impact-strip\">\n            <div class=\"impact-metric\">\n              <span class=\"label\">TRANSIT PATH</span>\n              <span class=\"value text-slate-800 font-mono\" id=\"strip-path\">Select stations above</span>\n            </div>\n            <div class=\"impact-metric\">\n              <span class=\"label\">EST. COMMUTE DISTANCE</span>\n              <span class=\"value text-electric font-mono\" id=\"strip-distance\">-- km</span>\n            </div>\n            <div class=\"impact-metric\">\n              <span class=\"label\">EST. COMMUTE TIME</span>\n              <span class=\"value text-slate-700 font-mono\" id=\"strip-time\">-- min</span>\n            </div>\n            <div class=\"impact-metric\">\n              <span class=\"label\">CO₂ OFFSET SAVED</span>\n              <span class=\"value text-emerald font-mono font-bold\" id=\"strip-co2\">-- kg</span>\n            </div>\n            <div class=\"impact-metric\">\n              <span class=\"label\">POOLED FARE PER SEAT</span>\n              <span class=\"value text-amber-700 font-mono font-bold\" id=\"strip-fare\">-- $</span>\n            </div>\n          </div>\n        </section>\n\n        <!-- 2. Passenger Ride Request & Dispatch Hub -->\n        <section id=\"dispatch-hub\" class=\"content-panel white-card tilt-element\" data-tilt>\n          <div class=\"panel-header\">\n            <div class=\"header-title\">\n              <i class=\"fa-solid fa-users text-emerald\"></i>\n              <div>\n                <h2>Passenger Dispatch Hub & Priority Standby Lounge</h2>\n                <p>Instant commuter ride submission, dynamic dispatch pipeline, and 5-slot priority overflow lounge</p>\n              </div>\n            </div>\n            <div class=\"status-badge\">\n              <span class=\"seat-badge\">Auto-Matching Active</span>\n            </div>\n          </div>\n\n          <!-- Passenger Request Form -->\n          <div class=\"action-bar-row\">\n            <div class=\"input-with-icon flex-1\">\n              <i class=\"fa-solid fa-user\"></i>\n              <input type=\"text\" id=\"passenger-name-input\" placeholder=\"Commuter Name (e.g., Dr. Aris Thorne)\" class=\"text-input\" />\n            </div>\n            <div class=\"form-control-inline\">\n              <select id=\"passenger-pickup-select\" class=\"select-field\"></select>\n            </div>\n            <div class=\"form-control-inline\">\n              <select id=\"passenger-drop-select\" class=\"select-field\"></select>\n            </div>\n            <button id=\"btn-request-ride\" class=\"btn btn-emerald\">\n              <i class=\"fa-solid fa-plus\"></i> Request Ride\n            </button>\n            <button id=\"btn-cancel-front-req\" class=\"btn btn-outline\" title=\"Dispatch or cancel front pending request\">\n              <i class=\"fa-solid fa-user-xmark\"></i> Dequeue Next\n            </button>\n          </div>\n\n          <!-- Dual Dispatch Pipelines Layout -->\n          <div class=\"dispatch-layout\">\n            <!-- Real-Time Request Conveyor -->\n            <div class=\"dispatch-column\">\n              <div class=\"column-subtitle\">\n                <span><i class=\"fa-solid fa-stream text-electric\"></i> Live Passenger Dispatch Pipeline</span>\n                <span class=\"sub-pill\">FIRST TO BE MATCHED &rarr; REAR</span>\n              </div>\n              <div class=\"conveyor-pipeline\" id=\"passenger-conveyor\">\n                <div class=\"empty-state\">\n                  <i class=\"fa-regular fa-clock text-slate-400 text-xl\"></i>\n                  <p>No active passenger ride requests pending. Submit a request above or run the Rush-Hour simulation.</p>\n                </div>\n              </div>\n            </div>\n\n            <!-- Priority Standby Lounge (Max 5 Slots) -->\n            <div class=\"dispatch-column standby-column\">\n              <div class=\"column-subtitle\">\n                <span><i class=\"fa-solid fa-champagne-glasses text-amber-600\"></i> Priority Standby Lounge (5 Slots)</span>\n                <span class=\"sub-pill text-amber-700 font-bold\" id=\"standby-status-pill\">Available Slots: 5 / 5</span>\n              </div>\n              <div class=\"standby-hub-container\">\n                <div class=\"standby-ring\" id=\"standby-ring\">\n                  <!-- 5 Visual Standby Slots dynamically generated -->\n                </div>\n                <div class=\"standby-center-badge\">\n                  <span class=\"text-[10px] text-slate-500 font-semibold tracking-wider\">STANDBY</span>\n                  <span class=\"text-xl font-bold text-amber-600\" id=\"standby-slot-counter\">0 / 5</span>\n                  <span class=\"text-[9px] text-slate-500 font-medium\">AUTO-DISPATCH</span>\n                </div>\n              </div>\n              <div class=\"standby-actions\">\n                <button id=\"btn-push-standby\" class=\"btn btn-sm btn-amber\" title=\"Hold passenger in priority standby lounge\">\n                  <i class=\"fa-solid fa-chair\"></i> Add to Standby\n                </button>\n                <button id=\"btn-pop-standby\" class=\"btn btn-sm btn-outline\" title=\"Seat front passenger from standby lounge\">\n                  <i class=\"fa-solid fa-arrow-up-from-bracket\"></i> Seat Commuter\n                </button>\n              </div>\n            </div>\n          </div>\n        </section>\n\n      </div>\n\n      <!-- RIGHT COLUMN: Driver Fleet Management + Active Rides & Trip Reversal -->\n      <div class=\"grid-column\">\n\n        <!-- 3. Driver Partner Fleet & Interactive 4-Seat Car Diagram -->\n        <section id=\"fleet-network\" class=\"content-panel white-card tilt-element\" data-tilt>\n          <div class=\"panel-header\">\n            <div class=\"header-title\">\n              <i class=\"fa-solid fa-id-card-clip text-emerald\"></i>\n              <div>\n                <h2>Driver Partner Fleet & Visual Vehicle Seat Selector</h2>\n                <p>Onboard driver partners, toggle seat availability visually, and verify credentials</p>\n              </div>\n            </div>\n            <div class=\"status-badge fleet-badge\" id=\"fleet-count-badge\">\n              0 Active Partners\n            </div>\n          </div>\n\n          <!-- Driver Registration Bar with Visual Car Diagram -->\n          <div class=\"driver-onboarding-panel\">\n            <div class=\"onboarding-form-inputs\">\n              <div class=\"input-with-icon\">\n                <i class=\"fa-solid fa-user-tie\"></i>\n                <input type=\"text\" id=\"driver-name-input\" placeholder=\"Partner Name (e.g., Marcus Vance)\" class=\"text-input\" />\n              </div>\n              <div class=\"form-control-inline\">\n                <select id=\"driver-station-select\" class=\"select-field\"></select>\n              </div>\n              <button id=\"btn-register-driver\" class=\"btn btn-emerald w-full\">\n                <i class=\"fa-solid fa-car-on\"></i> Onboard Partner (<span id=\"driver-seats-count-label\">3</span> Seats)\n              </button>\n            </div>\n\n            <!-- Interactive 4-Seat Visual Car Blueprint -->\n            <div class=\"car-diagram-box\">\n              <div class=\"car-diagram-title\">\n                <i class=\"fa-solid fa-car\"></i> Visual Seat Selector (Click to Toggle)\n              </div>\n              <div class=\"car-chassis\">\n                <div class=\"car-front-windshield\"></div>\n                <div class=\"car-cabin\">\n                  <div class=\"car-row\">\n                    <div class=\"car-seat occupied-driver\" title=\"Driver Seat (Always Occupied)\">\n                      <i class=\"fa-solid fa-user-ninja\"></i>\n                      <span>DRIVER</span>\n                    </div>\n                    <div class=\"car-seat active-seat\" id=\"seat-front-pass\" data-seat=\"front\" title=\"Click to toggle Front Passenger Seat\">\n                      <i class=\"fa-solid fa-user-check\"></i>\n                      <span>FRONT</span>\n                    </div>\n                  </div>\n                  <div class=\"car-row\">\n                    <div class=\"car-seat active-seat\" id=\"seat-rear-left\" data-seat=\"rear-left\" title=\"Click to toggle Rear Left Seat\">\n                      <i class=\"fa-solid fa-user-check\"></i>\n                      <span>REAR L</span>\n                    </div>\n                    <div class=\"car-seat active-seat\" id=\"seat-rear-right\" data-seat=\"rear-right\" title=\"Click to toggle Rear Right Seat\">\n                      <i class=\"fa-solid fa-user-check\"></i>\n                      <span>REAR R</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- Fleet Directory Stream -->\n          <div class=\"fleet-directory-wrapper\">\n            <div class=\"column-subtitle\">\n              <span><i class=\"fa-solid fa-list-check text-emerald\"></i> Active Driver Partner Directory</span>\n              <span class=\"sub-pill\" id=\"fleet-capacity-pill\">Total Available Seats: 0</span>\n            </div>\n            <div class=\"fleet-stream\" id=\"fleet-stream-container\">\n              <div class=\"empty-state\">\n                <i class=\"fa-solid fa-car-rear text-slate-400 text-xl\"></i>\n                <p>No driver partners currently on duty. Onboard a partner above to open seat capacity.</p>\n              </div>\n            </div>\n          </div>\n\n          <!-- Quick Identity & Booking Verification Lookup (Supports #101 or NX-501 / BK-201) -->\n          <div class=\"verification-wrapper\">\n            <div class=\"column-subtitle\">\n              <span><i class=\"fa-solid fa-magnifying-glass text-electric\"></i> Fast Identity & Trip Verification Lookup</span>\n              <span class=\"sub-pill\">SUPPORTS DRIVER ID (#101) OR BOOKING REF (NX-501)</span>\n            </div>\n            <div class=\"search-bar-row\">\n              <div class=\"input-with-icon flex-1\">\n                <i class=\"fa-solid fa-fingerprint\"></i>\n                <input type=\"text\" id=\"verify-id-input\" placeholder=\"Enter ID (e.g., 101, NX-501, BK-201)\" class=\"text-input\" />\n              </div>\n              <button id=\"btn-verify-id\" class=\"btn btn-outline\">\n                <i class=\"fa-solid fa-check-double text-emerald\"></i> Verify Record\n              </button>\n            </div>\n            <div class=\"verification-result-box\" id=\"verification-result-box\">\n              <span class=\"text-slate-500 text-xs\">Enter a Driver ID or Booking Reference above to verify operational credentials.</span>\n            </div>\n          </div>\n        </section>\n\n        <!-- 4. Active Shared Trips Console & Confirmation Controls -->\n        <section id=\"active-trips\" class=\"content-panel white-card tilt-element\" data-tilt>\n          <div class=\"panel-header\">\n            <div class=\"header-title\">\n              <i class=\"fa-solid fa-car-side text-purple-600\"></i>\n              <div>\n                <h2>Active Shared Trips & Route Compatibility Console</h2>\n                <p>Monitor dispatched carpools with route compatibility match scores, or safely revert recent confirmations</p>\n              </div>\n            </div>\n            <div class=\"status-badge purple-badge\" id=\"active-trips-badge\">\n              0 In-Transit\n            </div>\n          </div>\n\n          <!-- Dispatch Operations Action Bar -->\n          <div class=\"action-bar-row justify-between\">\n            <button id=\"btn-auto-match-trip\" class=\"btn btn-primary\">\n              <i class=\"fa-solid fa-handshake\"></i> Dispatch Next Compatible Trip\n            </button>\n            <button id=\"btn-revert-confirmation\" class=\"btn btn-rose\" title=\"Safely revert the most recent trip confirmation and restore seat count\">\n              <i class=\"fa-solid fa-rotate-left\"></i> Revert Last Confirmation\n            </button>\n          </div>\n\n          <!-- Active Trips List -->\n          <div class=\"active-trips-stream\" id=\"active-trips-stream\">\n            <div class=\"empty-state\">\n              <i class=\"fa-solid fa-road text-slate-400 text-xl\"></i>\n              <p>No shared trips currently in transit. Click \"Dispatch Next Compatible Trip\" or run the Rush-Hour simulation.</p>\n            </div>\n          </div>\n\n          <!-- Split Row: Transit Registry Canvas & Trip Audit Trail -->\n          <div class=\"trip-insights-grid\">\n            <div class=\"insights-box\">\n              <div class=\"column-subtitle\">\n                <span><i class=\"fa-solid fa-bezier-curve text-electric\"></i> Trip Hierarchy & Corridor Network</span>\n                <span class=\"sub-pill font-mono\" id=\"registry-count-pill\">0 Dispatched</span>\n              </div>\n              <div class=\"canvas-visual-box\">\n                <canvas id=\"trip-hierarchy-canvas\" width=\"460\" height=\"180\"></canvas>\n              </div>\n            </div>\n\n            <div class=\"insights-box\">\n              <div class=\"column-subtitle\">\n                <span><i class=\"fa-solid fa-clock-rotate-left text-slate-600\"></i> Recent Dispatch Reversal Log</span>\n                <span class=\"sub-pill font-mono\" id=\"audit-log-pill\">0 Rollbacks Available</span>\n              </div>\n              <div class=\"audit-history-list\" id=\"audit-history-list\">\n                <div class=\"empty-state\">\n                  <p>Reversal log clear. Confirm a trip to create a restorable dispatch state.</p>\n                </div>\n              </div>\n            </div>\n          </div>\n        </section>\n\n      </div>\n    </main>\n\n    <!-- 5. Sustainability & Carbon Savings Dashboard -->\n    <section id=\"sustainability\" class=\"sustainability-section white-card tilt-element\" data-tilt>\n      <div class=\"panel-header\">\n        <div class=\"header-title\">\n          <i class=\"fa-solid fa-earth-americas text-emerald\"></i>\n          <div>\n            <h2>Metropolitan Sustainability & Carbon Offset Analytics</h2>\n            <p>Empirical climate impact metrics, fuel consumption reduction, and top eco-mobility partners</p>\n          </div>\n        </div>\n        <div class=\"status-badge live-badge\">\n          <i class=\"fa-solid fa-seedling text-emerald\"></i> Clean Air Metric ISO-14064\n        </div>\n      </div>\n\n      <div class=\"sustainability-grid\">\n        <div class=\"eco-metric-card\">\n          <div class=\"eco-num text-emerald\" id=\"eco-total-co2\">148.5 kg</div>\n          <div class=\"eco-desc\">Net Atmospheric Carbon Reduction</div>\n          <div class=\"progress-bar-wrap\">\n            <div class=\"progress-bar-fill bg-emerald\" style=\"width: 74%;\"></div>\n          </div>\n          <span class=\"text-[11px] text-slate-500\">74% toward daily metropolitan reduction target</span>\n        </div>\n\n        <div class=\"eco-metric-card\">\n          <div class=\"eco-num text-electric\" id=\"eco-shared-km\">1,420 km</div>\n          <div class=\"eco-desc\">Collective Pooled Distance Traveled</div>\n          <div class=\"progress-bar-wrap\">\n            <div class=\"progress-bar-fill bg-electric\" style=\"width: 62%;\"></div>\n          </div>\n          <span class=\"text-[11px] text-slate-500\">Eliminating ~58 individual single-driver vehicles</span>\n        </div>\n\n        <div class=\"eco-metric-card\">\n          <div class=\"eco-num text-purple-600\" id=\"eco-efficiency\">94.2%</div>\n          <div class=\"eco-desc\">Corridor Fleet Seat Utilization Rate</div>\n          <div class=\"progress-bar-wrap\">\n            <div class=\"progress-bar-fill bg-purple\" style=\"width: 94%;\"></div>\n          </div>\n          <span class=\"text-[11px] text-slate-500\">Optimal multi-commuter ride clustering</span>\n        </div>\n\n        <!-- Leaderboard -->\n        <div class=\"eco-leaderboard-box\">\n          <div class=\"leaderboard-title\">\n            <i class=\"fa-solid fa-trophy text-amber-500\"></i> Top Eco-Driver Partners\n          </div>\n          <div class=\"leaderboard-list\" id=\"eco-leaderboard-list\">\n            <!-- Dynamic Leaderboard Items -->\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Platform Footer -->\n    <footer class=\"app-footer\">\n      <div class=\"footer-left\">\n        <span class=\"font-bold text-slate-900\">NexusMobility Technologies Inc.</span> &bull; Intelligent Urban Transit & Eco-Logistics Infrastructure\n      </div>\n      <div class=\"footer-right\">\n        <span><i class=\"fa-solid fa-shield-halved text-emerald\"></i> Enterprise SLA: 99.99%</span>\n        <span><i class=\"fa-solid fa-signal text-electric\"></i> Real-Time Telemetry Active</span>\n      </div>\n    </footer>\n  </div>\n\n  <!-- Modal: Official Eco-Transit Receipt -->\n  <div class=\"modal-overlay hidden\" id=\"receipt-modal-overlay\">\n    <div class=\"modal-card white-card\" id=\"receipt-modal-card\">\n      <div class=\"modal-header\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"brand-icon small-icon\"><i class=\"fa-solid fa-leaf text-emerald\"></i></div>\n          <div>\n            <h3 class=\"font-bold text-slate-900\">Official Eco-Transit Journey Receipt</h3>\n            <p class=\"text-xs text-slate-500 font-mono\">Metropolitan Shared Mobility Environmental Audit</p>\n          </div>\n        </div>\n        <button id=\"btn-close-receipt\" class=\"btn btn-ghost\"><i class=\"fa-solid fa-xmark text-lg\"></i></button>\n      </div>\n\n      <div class=\"receipt-content\" id=\"receipt-content-area\">\n        <!-- Receipt details populated dynamically -->\n      </div>\n\n      <div class=\"modal-footer\">\n        <button id=\"btn-print-receipt\" class=\"btn btn-outline\"><i class=\"fa-solid fa-print\"></i> Print Receipt</button>\n        <button id=\"btn-done-receipt\" class=\"btn btn-primary\">Done</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Notification Toasts Container -->\n  <div id=\"toast-container\" class=\"toast-container\"></div>\n\n  <script src=\"app.js\"></script>\n</body>\n</html>\n","Description":"Created index.html with Modern Clean Light Eco-Tech theme, interactive 4-seat visual car diagram, route compatibility badges, eco-receipt modal, and zero CS jargon","Overwrite":true,"TargetFile":"C:\\Users\\Kartik Bhosle\\.gemini\\antigravity\\brain\\6976d1a8-fd03-4453-a790-acd552e1861a\\index.html","toolAction":"Writing file","toolSummary":"Update index.html with modern light eco-tech layout"}}]}
