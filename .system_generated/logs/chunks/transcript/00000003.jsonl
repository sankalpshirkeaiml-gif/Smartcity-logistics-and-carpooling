dEventListener('click', () => {\n1392:     const temp = originSel.value;\n1393:     originSel.value = destSel.value;\n1394:     destSel.value = temp;\n1395:     computeAndDisplayRoute();\n1396:   });\n1397: \n1398:   document.getElementById('btn-reset-view').addEventListener('click', () => {\n1399:     urbanCanvasInstance.resetCamera();\n1400:   });","truncated_fields":["content"]}
