);\n1557: \n1558:     urbanCanvasInstance.setActivePath(route.path);\n1559:     refreshPlatformUI();\n1560:     openDispatchModal(trip, matchedPartner);\n1561:   });\n1562: \n1563:   // --- Revert Confirmation (Triggering Enterprise Reversal Modal) ---\n1564:   document.getElementById('btn-revert-confirmation').addEventListener('click', () => {\n1565:     const res = engine.revertLatestConfirmation();\n1566:     if (!res.success) {\n1567:       showPlatformToast(res.message, 'rose');\n1568:     } else {\n1569:       refreshPlatformUI();\n1570:       openReversalModal(res.action, res.driver);\n1571:     }\n1572:   });\n1573: \n1574:   // --- Rush-Hour Simulation Scenario ---\n1575:   document.getElementById('btn-demo-rushhour').addEventListener('click', () => {\n1576:     engine.onboardDriver('Marcus Vance', 'ALPHA', 3);\n1577:     engine.onboardDriver('Elena Rostova', 'METRO', 3);\n1578:     engine.onboardDriver('Kaelen Chen', 'SKYPORT', 2);\n1579:     engine.onboardDriver('Siddharth Rao', 'QUANTUM', 3);\n1580: \n1581:     engine.submitRideRequest('Dr. Aris Thorne', 'ALPHA', 'HORIZON');\n1582:     engine.submitRideRequest('Maya Lin', 'METRO', 'SKYPORT');\n1583:     engine.submitRideRequest('Amara Okafor', 'HARBOR', 'QUANTUM');\n1584: \n1585:     engine.pushToStandby({\n1586:       id: 'BK-STDBY-01',\n1587:       name: 'Taro Watanabe',\n1588:       pickup: 'HARBOR',\n1589:       drop: 'HORIZON',\n1590:       requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n1591:       status: 'Priority Standby'\n1592:     });\n1593: \n1594:     const p = engine.dequeueNextRequest();\n1595:     const d = engine.fleetPartners[0];\n1596:     const r = engine.findOptimalEcoRoute(p.pickup, p.drop);\n1597:     const trip = engine.dispatchSharedTrip(p, d, r.path, r.totalDist, r.estTime, r.fare, r.co2Offset, 96);\n1598: \n1599:     urbanCanvasInstance.setActivePath(r.path);\n1600:     refreshPlatformUI();\n1601:     showPlatformToast('Simulated Metropolitan Rush-Hour scenario loaded with live fleet, commuters, and active trips!', 'emerald');\n1602:   });\n1603: \n1604:   // --- Quick Book CTA in Header ---\n1605:   document.getElementById('btn-quick-book').addEventListener('click', () => {\n1606:     const commuterTabBtn = document.querySelector('[data-tab=\"tab-passenger-hub\"]');\n1607:     if (commuterTabBtn) commuterTabBtn.click();\n1608:     setTimeout(() => {\n1609:       document.getElementById('passenger-name-input').focus();\n1610:     }, 150);\n1611:   });\n1612: \n1613:   // --- Dispatch Modal Actions ---\n1614:   const dispatchModal = document.getElementById('dispatch-confirm-modal');\n1615:   document.getElementById('btn-close-dispatch-modal').addEventListener('click', () => {\n1616:     dispatchModal.classList.add('hidden');\n1617:   });\n1618:   document.getElementById('btn-ack-dispatch').addEventListener('click', () => {\n1619:     dispatchModal.classList.add('hidden');\n1620:   });\n1621:   document.getElementById('btn-view-map-dispatch').addEventListener('click', () => {\n1622:     dispatchModal.classList.add('hidden');\n1623:     const mapTabBtn = document.querySelector('[data-tab=\"tab-route-finder\"]');\n1624:     if (mapTabBtn) mapTabBtn.click();\n1625:     urbanCanvasInstance.startCarSimulation();\n1626:   });\n1627: \n1628:   // --- Reversal Modal Actions ---\n1629:   const reversalModal = document.getElementById('reversal-confirm-modal');\n1630:   document.getElementById('btn-close-reversal-modal').addEventListener('click', () => {\n1631:     reversalModal.classList.add('hidden');\n1632:   });\n1633:   document.getElementById('btn-ack-reversal').addEventListener('click', () => {\n1634:     reversalModal.classList.add('hidden');\n1635:   });\n1636: \n1637:   // --- Eco-Receipt Modal Controls ---\n1638:   const receiptModal = document.getElementById('receipt-modal-overlay');\n1639:   document.getElementById('btn-close-receipt').addEventListener('click', () => {\n1640:     receiptModal.class