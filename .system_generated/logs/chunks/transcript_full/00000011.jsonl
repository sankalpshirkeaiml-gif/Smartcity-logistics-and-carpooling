{"step_index":152,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:25:34Z","content":"Created At: 2026-10-20T11:55:34+05:30\nCompleted At: 2026-10-20T11:55:34+05:30\nShowing lines 850-1100 of 1661\n850:   let totalSavedCO2 = 148.5;\n851:   let totalDistance = 1420;\n852:   engine.activeTrips.forEach(t => {\n853:     totalSavedCO2 += t.co2Saved;\n854:     totalDistance += t.distance;\n855:   });\n856: \n857:   document.getElementById('kpi-co2').innerHTML = `${totalSavedCO2.toFixed(1)} <span class=\"kpi-unit\">kg</span>`;\n858:   document.getElementById('eco-total-co2').textContent = `${totalSavedCO2.toFixed(1)} kg`;\n859:   document.getElementById('eco-shared-km').textContent = `${Math.round(totalDistance).toLocaleString()} km`;\n860: \n861:   document.getElementById('fleet-count-badge').textContent = `${engine.fleetPartners.length} Active Partners`;\n862:   document.getElementById('active-trips-badge').textContent = `${engine.activeTrips.length} In-Transit`;\n863: }\n864: \n865: // --- Passenger Dispatch Stream with EcoSprout Empty State ---\n866: function renderPassengerDispatchStream() {\n867:   const container = document.getElementById('passenger-conveyor');\n868:   if (!container) return;\n869: \n870:   if (engine.dispatchStream.length === 0) {\n871:     container.innerHTML = `\n872:       <div class=\"ecosprout-container\">\n873:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n874:         <div class=\"ecosprout-bubble\">\n875:           <b>EcoSprout here!</b> The dispatch conveyor is clear. Submit a commuter request above to plan a green trip!\n876:         </div>\n877:       </div>`;\n878:     return;\n879:   }\n880: \n881:   container.innerHTML = engine.dispatchStream.map((pass, idx) => `\n882:     <div class=\"commuter-token ${idx === 0 ? 'head-token' : ''} eco-card-hover\">\n883:       <div class=\"token-badge\">${idx === 0 ? 'NEXT DISPATCH' : `PRIORITY #${idx + 1}`}</div>\n884:       <div class=\"token-name\">${pass.name}</div>\n885:       <div class=\"token-route\"><i class=\"fa-solid fa-route\"></i> ${pass.pickup} &rarr; ${pass.drop}</div>\n886:       <div class=\"token-meta\">${pass.id} &bull; ${pass.requestedAt}</div>\n887:     </div>\n888:   `).join('');\n889: }\n890: \n891: // --- Priority Standby Lounge ---\n892: function renderStandbyLounge() {\n893:   const ring = document.getElementById('standby-ring');\n894:   const counter = document.getElementById('standby-slot-counter');\n895:   const pill = document.getElementById('standby-status-pill');\n896:   if (!ring || !counter || !pill) return;\n897: \n898:   counter.textContent = `${engine.standbyCount} / ${engine.standbyCap}`;\n899:   pill.textContent = `Available Slots: ${engine.standbyCap - engine.standbyCount} / ${engine.standbyCap}`;\n900: \n901:   ring.innerHTML = '';\n902:   const total = engine.standbyCap;\n903:   const radius = 90;\n904: \n905:   for (let i = 0; i < total; i++) {\n906:     const angle = (i * 2 * Math.PI) / total - Math.PI / 2;\n907:     const x = Math.round(radius * Math.cos(angle) + 105);\n908:     const y = Math.round(radius * Math.sin(angle) + 105);\n909: \n910:     const isOccupied = engine.standbyLounge[i] !== null;\n911:     const isActivePointer = i === engine.standbyFront && engine.standbyCount > 0;\n912: \n913:     const slotEl = document.createElement('div');\n914:     slotEl.className = `standby-slot ${isOccupied ? 'occupied' : ''} ${isActivePointer ? 'is-active-pointer' : ''}`;\n915:     slotEl.style.left = `${x}px`;\n916:     slotEl.style.top = `${y}px`;\n917: \n918:     const passenger = engine.standbyLounge[i];\n919:     slotEl.innerHTML = `\n920:       <div class=\"font-bold\">SLOT ${i + 1}</div>\n921:       <div class=\"text-[9px] truncate max-w-[42px]\">${passenger ? passenger.name.split(' ')[0] : 'FREE'}</div>\n922:     `;\n923:     slotEl.title = passenger ? `Standby: ${passenger.name} (${passenger.pickup} -> ${passenger.drop})` : `Slot ${i + 1}: Empty`;\n924:     ring.appendChild(slotEl);\n925:   }\n926: }\n927: \n928: // --- Driver Fleet Directory with EcoSprout Empty State ---\n929: function renderFleetDirectory() {\n930:   const container = document.getElementById('fleet-stream-container');\n931:   const capacityPill = document.getElementById('fleet-capacity-pill');\n932:   if (!container || !capacityPill) return;\n933: \n934:   let totalAvailableSeats = 0;\n935:   engine.fleetPartners.forEach(p => { totalAvailableSeats += p.seats; });\n936:   capacityPill.textContent = `Total Available Seats: ${totalAvailableSeats}`;\n937: \n938:   if (engine.fleetPartners.length === 0) {\n939:     container.innerHTML = `\n940:       <div class=\"ecosprout-container\">\n941:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n942:         <div class=\"ecosprout-bubble\">\n943:           <b>EcoSprout needs partners!</b> Toggle vehicle seats above and onboard a driver partner to open seat capacity.\n944:         </div>\n945:       </div>`;\n946:     return;\n947:   }\n948: \n949:   let html = '';\n950:   engine.fleetPartners.forEach((partner, idx) => {\n951:     html += `\n952:       <div class=\"driver-partner-card eco-card-hover\">\n953:         <div class=\"card-top\">\n954:           <span class=\"driver-id-badge\">ID: #${partner.id}</span>\n955:           <span class=\"seat-counter-pill\">${partner.seats}/${partner.originalSeats} Seats</span>\n956:         </div>\n957:         <div class=\"driver-name\">${partner.name}</div>\n958:         <div class=\"driver-corridor\"><i class=\"fa-solid fa-location-dot text-emerald\"></i> ${partner.station} Station</div>\n959:         <div class=\"text-[10px] text-slate-500 mt-1\">${partner.tripsCompleted} Shared Trips</div>\n960:       </div>\n961:     `;\n962: \n963:     if (idx < engine.fleetPartners.length - 1) {\n964:       html += `<div class=\"fleet-pointer\"><i class=\"fa-solid fa-arrow-right\"></i></div>`;\n965:     }\n966:   });\n967: \n968:   container.innerHTML = html;\n969: }\n970: \n971: // --- Active Shared Trips with EcoSprout Empty State ---\n972: function renderActiveTrips() {\n973:   const container = document.getElementById('active-trips-stream');\n974:   if (!container) return;\n975: \n976:   if (engine.activeTrips.length === 0) {\n977:     container.innerHTML = `\n978:       <div class=\"ecosprout-container\">\n979:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n980:         <div class=\"ecosprout-bubble\">\n981:           <b>EcoSprout is ready to roll!</b> Dispatch a trip or launch the Rush-Hour simulation to watch active pooled rides.\n982:         </div>\n983:       </div>`;\n984:     return;\n985:   }\n986: \n987:   container.innerHTML = engine.activeTrips.map(trip => `\n988:     <div class=\"shared-trip-card eco-card-hover\">\n989:       <button class=\"btn-cancel-trip\" title=\"Complete / Cancel Trip\" onclick=\"handleCompleteTrip('${trip.tripRef}')\">\n990:         <i class=\"fa-solid fa-xmark\"></i>\n991:       </button>\n992:       <div class=\"flex justify-between items-center\">\n993:         <span class=\"trip-ref\">${trip.tripRef}</span>\n994:         <span class=\"route-match-badge\">${trip.matchScore}% Route Match</span>\n995:       </div>\n996:       <div class=\"text-xs font-bold text-slate-900 mt-0.5\">${trip.passenger.name}</div>\n997:       <div class=\"text-[10px] text-electric font-semibold\">${trip.corridorPath.join(' &rarr; ')}</div>\n998:       <div class=\"text-[10px] text-slate-600 mt-1\"><i class=\"fa-solid fa-id-badge text-emerald\"></i> ${trip.driverName}</div>\n999:       <div class=\"flex justify-between items-center text-[9px] text-slate-500 pt-1 border-t border-slate-200 mt-1\">\n1000:         <span>+${trip.co2Saved}kg CO₂</span>\n1001:         <button class=\"text-emerald hover:underline font-bold\" onclick=\"viewEcoReceipt('${trip.tripRef}')\">\n1002:           <i class=\"fa-solid fa-receipt\"></i> Eco-Receipt\n1003:         </button>\n1004:         <span class=\"text-slate-900 font-bold\">$${trip.fare}</span>\n1005:       </div>\n1006:     </div>\n1007:   `).join('');\n1008: }\n1009: \n1010: // --- Transit Hierarchy Canvas ---\n1011: function renderTransitHierarchyCanvas() {\n1012:   const canvas = document.getElementById('trip-hierarchy-canvas');\n1013:   if (!canvas) return;\n1014:   const ctx = canvas.getContext('2d');\n1015:   const countPill = document.getElementById('registry-count-pill');\n1016: \n1017:   countPill.textContent = `${engine.activeTrips.length} Active Trips`;\n1018:   ctx.clearRect(0, 0, canvas.width, canvas.height);\n1019: \n1020:   if (engine.activeTrips.length === 0) {\n1021:     ctx.fillStyle = '#64748B';\n1022:     ctx.font = '11px \"Inter\"';\n1023:     ctx.textAlign = 'center';\n1024:     ctx.fillText('Transit Dispatch Registry Ready. Active shared trips will display here.', canvas.width / 2, canvas.height / 2);\n1025:     return;\n1026:   }\n1027: \n1028:   // Draw Root Hub\n1029:   const rootX = canvas.width / 2;\n1030:   const rootY = 24;\n1031: \n1032:   ctx.beginPath();\n1033:   ctx.arc(rootX, rootY, 14, 0, Math.PI * 2);\n1034:   ctx.fillStyle = '#FFFFFF';\n1035:   ctx.strokeStyle = '#059669';\n1036:   ctx.lineWidth = 2.5;\n1037:   ctx.fill();\n1038:   ctx.stroke();\n1039: \n1040:   ctx.fillStyle = '#059669';\n1041:   ctx.font = 'bold 9px \"Inter\"';\n1042:   ctx.textAlign = 'center';\n1043:   ctx.textBaseline = 'middle';\n1044:   ctx.fillText('NEXUS', rootX, rootY);\n1045: \n1046:   // Draw Branches\n1047:   const count = engine.activeTrips.length;\n1048:   const spacing = Math.min(80, (canvas.width - 60) / Math.max(count, 1));\n1049:   const startX = rootX - ((count - 1) * spacing) / 2;\n1050: \n1051:   engine.activeTrips.forEach((trip, idx) => {\n1052:     const nodeX = startX + idx * spacing;\n1053:     const nodeY = 110;\n1054: \n1055:     ctx.beginPath();\n1056:     ctx.moveTo(rootX, rootY + 14);\n1057:     ctx.lineTo(nodeX, nodeY - 14);\n1058:     ctx.strokeStyle = '#CBD5E1';\n1059:     ctx.lineWidth = 1.5;\n1060:     ctx.stroke();\n1061: \n1062:     ctx.beginPath();\n1063:     ctx.arc(nodeX, nodeY, 13, 0, Math.PI * 2);\n1064:     ctx.fillStyle = '#FFFFFF';\n1065:     ctx.strokeStyle = '#2563EB';\n1066:     ctx.lineWidth = 2;\n1067:     ctx.shadowColor = 'rgba(37, 99, 235, 0.2)';\n1068:     ctx.shadowBlur = 6;\n1069:     ctx.fill();\n1070:     ctx.stroke();\n1071:     ctx.shadowBlur = 0;\n1072: \n1073:     ctx.fillStyle = '#1E293B';\n1074:     ctx.font = 'bold 8px \"JetBrains Mono\"';\n1075:     ctx.textAlign = 'center';\n1076:     ctx.fillText(trip.tripRef.replace('NX-', ''), nodeX, nodeY);\n1077: \n1078:     ctx.fillStyle = '#059669';\n1079:     ctx.font = '500 8px \"Inter\"';\n1080:     ctx.fillText(trip.passenger.name.split(' ')[0], nodeX, nodeY + 22);\n1081:   });\n1082: }\n1083: \n1084: // --- Reversal Audit History List ---\n1085: function renderAuditHistory() {\n1086:   const container = document.getElementById('audit-history-list');\n1087:   const pill = document.getElementById('audit-log-pill');\n1088:   if (!container || !pill) return;\n1089: \n1090:   pill.textContent = `${engine.reversalAuditLog.length} Rollbacks Available`;\n1091: \n1092:   if (engine.reversalAuditLog.length === 0) {\n1093:     container.innerHTML = `\n1094:       <div class=\"empty-state\">\n1095:         <p>Reversal log clear. Confirm a trip to create a restorable dispatch state.</p>\n1096:       </div>`;\n1097:     return;\n1098:   }\n1099: \n1100:   const latestIdx = engine.reversalAuditLog.length - 1;"}
