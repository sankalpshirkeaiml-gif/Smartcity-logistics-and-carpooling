olid fa-shield-halved text-emerald\\\"></i> Enterprise Eco-Tech</span>\\n          </div>\\n          <div class=\\\"brand-tagline\\\">SMART URBAN TRANSIT &amp; GREEN MOBILITY SUITE</div>\\n        </div>\\n      </div>\\n\\n      <!-- Essential Primary Action Controls -->\\n      <div class=\\\"nav-actions\\\">\\n        <button id=\\\"btn-demo-rushhour\\\" class=\\\"btn btn-emerald-outline\\\" title=\\\"Simulate realistic metropolitan rush hour traffic\\\">\\n          <i class=\\\"fa-solid fa-bolt-lightning text-emerald\\\"></i> Rush-Hour Simulation\\n        </button>\\n        <button id=\\\"btn-quick-book\\\" class=\\\"btn btn-primary\\\">\\n          <i class=\\\"fa-solid fa-calenda\n<truncated 29640 bytes>","Overwrite":"true","Path":"\"C:/Users/Kartik Bhosle/.gemini/antigravity/brain/6976d1a8-fd03-4453-a790-acd552e1861a/index.html\""}}],"truncated_fields":["tool_calls"]}
