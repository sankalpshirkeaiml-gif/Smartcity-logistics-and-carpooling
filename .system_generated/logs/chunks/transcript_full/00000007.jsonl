        const v = edge.node;\n103:         const newDist = dist[u] + edge.distance;\n104:         if (newDist < dist[v]) {\n105:           dist[v] = newDist;\n106:           prev[v] = u;\n107:           activeCorridors.push([newDist, v]);\n108:         }\n109:       }\n110:     }\n111: \n112:     const path = [];\n113:     let curr = endId;\n114:     if (dist[endId] !== Infinity) {\n115:       while (curr) {\n116:         path.unshift(curr);\n117:         curr = prev[curr];\n118:       }\n119:     }\n120: \n121:     const totalDist = dist[endId] === Infinity ? 0 : parseFloat(dist[endId].toFixed(1));\n122:     const estTime = Math.round(totalDist * 2.2);\n123:     const baseCO2 = totalDist * 0.171;\n124:     const co2Offset = parseFloat((baseCO2 * (0.8 + this.commuterDensity * 0.4)).toFixed(2));\n125: \n126:     const baseTripCost = 4.0 + totalDist * 1.5;\n127:     const pooledFare = parseFloat(((baseTripCost * (1 + (this.commuterDensity - 1) * 0.25)) / this.commuterDensity).toFixed(2));\n128: \n129:     return {\n130:       path,\n131:       totalDist,\n132:       estTime,\n133:       co2Offset,\n134:       fare: pooledFare,\n135:       soloCarsSaved: Math.max(0, this.commuterDensity - 1)\n136:     };\n137:   }\n138: \n139:   submitRideRequest(name, pickup, drop) {\n140:     const passenger = {\n141:       id: `BK-${this.counters.passenger++}`,\n142:       name,\n143:       pickup,\n144:       drop,\n145:       requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n146:       status: 'Pending Dispatch'\n147:     };\n148:     this.dispatchStream.push(passenger);\n149:     return passenger;\n150:   }\n151: \n152:   dequeueNextRequest() {\n153:     return this.dispatchStream.shift() || null;\n154:   }\n155: \n156:   pushToStandby(item) {\n157:     if (this.standbyCount === this.standbyCap) {\n158:       return { success: false, message: 'Priority Standby Lounge is currently at maximum capacity (5/5).' };\n159:     }\n160:     this.standbyLounge[this.standbyRear] = item;"}
