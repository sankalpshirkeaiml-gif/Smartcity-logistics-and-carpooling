    ctx.rotate(heading);\n696: \n697:     // Glowing Headlight Beams\n698:     ctx.beginPath();\n699:     ctx.moveTo(12 * carProj.scale, -4 * carProj.scale);\n700:     ctx.lineTo(26 * carProj.scale, -12 * carProj.scale);\n<truncated 3817 bytes>\n// 6. MULTI-TAB SWITCHING CONTROLLER\n798: // ==========================================\n799: function initTabNavigation() {\n800:   const triggers = document.querySelectorAll('.tab-trigger');\n801:   const views = document.querySelectorAll('.tab-view');\n802: \n803:   triggers.forEach(trigger => {\n804:     trigger.addEventListener('click', () => {\n805:       const targetTabId = trigger.dataset.tab;\n806: \n807:       triggers.forEach(t => t.classList.remove('active'));\n808:       trigger.classList.add('active');\n809: \n810:       views.forEach(v => {\n811:         v.classList.remove('active');\n812:         if (v.id === targetTabId) {\n813:           v.classList.add('active');\n814:         }\n815:       });\n816: \n817:       if (targetTabId === 'tab-route-finder' && urbanCanvasInstance) {\n818:         setTimeout(() => {\n819:           urbanCanvasInstance.resize();\n820:         }, 50);\n821:       }\n822:     });\n823:   });\n824: }\n825: \n826: // ==========================================\n827: // 7. UI REFRESH & COMPONENT RENDERERS\n828: // ==========================================\n829: function refreshPlatformUI() {\n830:   renderPassengerDispatchStream();\n831:   renderStandbyLounge();\n832:   renderFleetDirectory();\n833:   renderActiveTrips();\n834:   renderTransitHierarchyCanvas();\n835:   renderAuditHistory();\n836:   renderLeaderboard();\n837:   updateTopKPIs();\n838: }\n839: \n840: function updateTopKPIs() {\n841:   document.getElementById('kpi-commuters').innerHTML = `${engine.dispatchStream.length} <span class=\"kpi-unit\">commuters</span>`;\n842:   document.getElementById('kpi-active-trips').innerHTML = `${engine.activeTrips.length} <span class=\"kpi-unit\">trips</span>`;\n843: \n844:   const passBadge = document.getElementById('tab-passengers-badge');\n845:   if (passBadge) passBadge.textContent = engine.dispatchStream.length + engine.standbyCount;\n846: \n847:   const fleetBadge = document.getElementById('tab-fleet-badge');\n848:   if (fleetBadge) fleetBadge.textContent = engine.fleetPartners.length;\n849: \n850:   let totalSavedCO2 = 148.5;","truncated_fields":["content"]}
