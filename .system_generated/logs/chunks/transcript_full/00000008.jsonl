{"step_index":150,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:16:03Z","content":"Created At: 2026-10-20T11:46:03+05:30\nCompleted At: 2026-10-20T11:46:03+05:30\nShowing lines 651-850 of 1652\n651:     });\n652: \n653:     // Draw Animated Electric Transit Car Driving Along Route\n654:     if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n655:       this.drawAnimatedCar();\n656:     }\n657:   }\n658: \n659:   drawAnimatedCar() {\n660:     const ctx = this.ctx;\n661:     const segmentIndex = Math.floor(this.carProgress);\n662:     const segmentT = this.carProgress - segmentIndex;\n663: \n664:     const fromId = this.activeCorridorPath[segmentIndex];\n665:     const toId = this.activeCorridorPath[segmentIndex + 1];\n666: \n667:     if (!fromId || !toId) return;\n668: \n669:     const s1 = TRANSIT_STATIONS.find(s => s.id === fromId);\n670:     const s2 = TRANSIT_STATIONS.find(s => s.id === toId);\n671: \n672:     // Interpolate 3D coordinates\n673:     const curX = s1.x + (s2.x - s1.x) * segmentT;\n674:     const curY = s1.y + (s2.y - s1.y) * segmentT;\n675:     const curZ = s1.z + (s2.z - s1.z) * segmentT;\n676: \n677:     const carProj = this.project(curX, curY, curZ);\n678: \n679:     // Calculate heading angle\n680:     const p1 = this.project(s1.x, s1.y, s1.z);\n681:     const p2 = this.project(s2.x, s2.y, s2.z);\n682:     const heading = Math.atan2(p2.y - p1.y, p2.x - p1.x);\n683: \n684:     ctx.save();\n685:     ctx.translate(carProj.x, carProj.y);\n686:     ctx.rotate(heading);\n687: \n688:     // Glowing Headlight Beams\n689:     ctx.beginPath();\n690:     ctx.moveTo(12 * carProj.scale, -4 * carProj.scale);\n691:     ctx.lineTo(26 * carProj.scale, -12 * carProj.scale);\n692:     ctx.lineTo(26 * carProj.scale, 12 * carProj.scale);\n693:     ctx.lineTo(12 * carProj.scale, 4 * carProj.scale);\n694:     ctx.closePath();\n695:     const lightGrad = ctx.createLinearGradient(12 * carProj.scale, 0, 26 * carProj.scale, 0);\n696:     lightGrad.addColorStop(0, 'rgba(32, 201, 176, 0.45)');\n697:     lightGrad.addColorStop(1, 'rgba(32, 201, 176, 0)');\n698:     ctx.fillStyle = lightGrad;\n699:     ctx.fill();\n700: \n701:     // Electric Vehicle Chassis\n702:     ctx.beginPath();\n703:     ctx.roundRect(-10 * carProj.scale, -6 * carProj.scale, 20 * carProj.scale, 12 * carProj.scale, 4 * carProj.scale);\n704:     ctx.fillStyle = '#059669';\n705:     ctx.fill();\n706:     ctx.strokeStyle = '#FFFFFF';\n707:     ctx.lineWidth = 1.5;\n708:     ctx.stroke();\n709: \n710:     // Windshield\n711:     ctx.beginPath();\n712:     ctx.roundRect(0, -4 * carProj.scale, 5 * carProj.scale, 8 * carProj.scale, 2 * carProj.scale);\n713:     ctx.fillStyle = '#93C5FD';\n714:     ctx.fill();\n715: \n716:     // Headlight bulbs\n717:     ctx.fillStyle = '#FEF08A';\n718:     ctx.fillRect(8 * carProj.scale, -5 * carProj.scale, 2 * carProj.scale, 2 * carProj.scale);\n719:     ctx.fillRect(8 * carProj.scale, 3 * carProj.scale, 2 * carProj.scale, 2 * carProj.scale);\n720: \n721:     ctx.restore();\n722:   }\n723: \n724:   drawGroundGrid() {\n725:     const ctx = this.ctx;\n726:     const size = 220;\n727:     const step = 44;\n728:     const floorZ = -30;\n729: \n730:     ctx.save();\n731:     ctx.strokeStyle = 'rgba(203, 213, 225, 0.6)';\n732:     ctx.lineWidth = 1;\n733: \n734:     for (let i = -size; i <= size; i += step) {\n735:       const p1 = this.project(i, -size, floorZ);\n736:       const p2 = this.project(i, size, floorZ);\n737:       ctx.beginPath();\n738:       ctx.moveTo(p1.x, p1.y);\n739:       ctx.lineTo(p2.x, p2.y);\n740:       ctx.stroke();\n741: \n742:       const p3 = this.project(-size, i, floorZ);\n743:       const p4 = this.project(size, i, floorZ);\n744:       ctx.beginPath();\n745:       ctx.moveTo(p3.x, p3.y);\n746:       ctx.lineTo(p4.x, p4.y);\n747:       ctx.stroke();\n748:     }\n749:     ctx.restore();\n750:   }\n751: }\n752: \n753: let urbanCanvasInstance = null;\n754: let ambientCanvasInstance = null;\n755: \n756: // ==========================================\n757: // 5. ECOSPROUT MASCOT VECTOR TEMPLATE\n758: // ==========================================\n759: function getEcoSproutSVG() {\n760:   return `\n761:     <svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n762:       <!-- Mascot Head -->\n763:       <circle cx=\"32\" cy=\"38\" r=\"18\" fill=\"#10B981\"/>\n764:       <ellipse cx=\"32\" cy=\"42\" rx=\"14\" ry=\"10\" fill=\"#34D399\"/>\n765:       \n766:       <!-- Leaf Cap on top -->\n767:       <path d=\"M32 20C32 20 22 14 26 6C34 10 32 20 32 20Z\" fill=\"#059669\"/>\n768:       <path d=\"M32 20C32 20 42 14 38 6C30 10 32 20 32 20Z\" fill=\"#34D399\"/>\n769:       <circle cx=\"32\" cy=\"20\" r=\"3\" fill=\"#D97706\"/>\n770:       \n771:       <!-- Aviator Goggles -->\n772:       <rect x=\"18\" y=\"28\" width=\"12\" height=\"9\" rx=\"3\" fill=\"#1E293B\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n773:       <rect x=\"34\" y=\"28\" width=\"12\" height=\"9\" rx=\"3\" fill=\"#1E293B\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n774:       <line x1=\"30\" y1=\"32\" x2=\"34\" y2=\"32\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n775:       <circle cx=\"24\" cy=\"32\" r=\"3\" fill=\"#38BDF8\"/>\n776:       <circle cx=\"40\" cy=\"32\" r=\"3\" fill=\"#38BDF8\"/>\n777:       \n778:       <!-- Cheerful Smile -->\n779:       <path d=\"M26 43C28 47 36 47 38 43\" stroke=\"#064E3B\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n780:       <!-- Rosy Cheeks -->\n781:       <circle cx=\"21\" cy=\"41\" r=\"2.5\" fill=\"#F87171\" opacity=\"0.7\"/>\n782:       <circle cx=\"43\" cy=\"41\" r=\"2.5\" fill=\"#F87171\" opacity=\"0.7\"/>\n783:     </svg>\n784:   `;\n785: }\n786: \n787: // ==========================================\n788: // 6. MULTI-TAB SWITCHING CONTROLLER\n789: // ==========================================\n790: function initTabNavigation() {\n791:   const triggers = document.querySelectorAll('.tab-trigger');\n792:   const views = document.querySelectorAll('.tab-view');\n793: \n794:   triggers.forEach(trigger => {\n795:     trigger.addEventListener('click', () => {\n796:       const targetTabId = trigger.dataset.tab;\n797: \n798:       triggers.forEach(t => t.classList.remove('active'));\n799:       trigger.classList.add('active');\n800: \n801:       views.forEach(v => {\n802:         v.classList.remove('active');\n803:         if (v.id === targetTabId) {\n804:           v.classList.add('active');\n805:         }\n806:       });\n807: \n808:       if (targetTabId === 'tab-route-finder' && urbanCanvasInstance) {\n809:         setTimeout(() => {\n810:           urbanCanvasInstance.resize();\n811:         }, 50);\n812:       }\n813:     });\n814:   });\n815: }\n816: \n817: // ==========================================\n818: // 7. UI REFRESH & COMPONENT RENDERERS\n819: // ==========================================\n820: function refreshPlatformUI() {\n821:   renderPassengerDispatchStream();\n822:   renderStandbyLounge();\n823:   renderFleetDirectory();\n824:   renderActiveTrips();\n825:   renderTransitHierarchyCanvas();\n826:   renderAuditHistory();\n827:   renderLeaderboard();\n828:   updateTopKPIs();\n829: }\n830: \n831: function updateTopKPIs() {\n832:   document.getElementById('kpi-commuters').innerHTML = `${engine.dispatchStream.length} <span class=\"kpi-unit\">commuters</span>`;\n833:   document.getElementById('kpi-active-trips').innerHTML = `${engine.activeTrips.length} <span class=\"kpi-unit\">trips</span>`;\n834: \n835:   const passBadge = document.getElementById('tab-passengers-badge');\n836:   if (passBadge) passBadge.textContent = engine.dispatchStream.length + engine.standbyCount;\n837: \n838:   const fleetBadge = document.getElementById('tab-fleet-badge');\n839:   if (fleetBadge) fleetBadge.textContent = engine.fleetPartners.length;\n840: \n841:   let totalSavedCO2 = 148.5;\n842:   let totalDistance = 1420;\n843:   engine.activeTrips.forEach(t => {\n844:     totalSavedCO2 += t.co2Saved;\n845:     totalDistance += t.distance;\n846:   });\n847: \n848:   document.getElementById('kpi-co2').innerHTML = `${totalSavedCO2.toFixed(1)} <span class=\"kpi-unit\">kg</span>`;\n849:   document.getElementById('eco-total-co2').textContent = `${totalSavedCO2.toFixed(1)} kg`;\n850:   document.getElementById('eco-shared-km').textContent = `${Math.round(totalDistance).toLocaleString()} km`;"}
