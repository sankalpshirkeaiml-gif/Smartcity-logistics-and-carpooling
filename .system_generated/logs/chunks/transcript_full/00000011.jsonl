{"step_index":150,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:25:29Z","content":"Created At: 2026-10-20T11:55:29+05:30\nCompleted At: 2026-10-20T11:55:29+05:30\nShowing lines 650-850 of 1661\n650:       // Station Label & Zone\n651:       ctx.save();\n652:       ctx.font = '600 11px \"Inter\"';\n653:       ctx.fillStyle = isPath ? '#059669' : '#0F172A';\n654:       ctx.textAlign = 'center';\n655:       ctx.fillText(station.name, proj.x, proj.y - 18 * proj.scale);\n656:       ctx.font = '500 9px \"JetBrains Mono\"';\n657:       ctx.fillStyle = '#64748B';\n658:       ctx.fillText(station.zone, proj.x, proj.y + 20 * proj.scale);\n659:       ctx.restore();\n660:     });\n661: \n662:     // Draw Animated Electric Transit Car Driving Along Route\n663:     if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n664:       this.drawAnimatedCar();\n665:     }\n666:   }\n667: \n668:   drawAnimatedCar() {\n669:     const ctx = this.ctx;\n670:     const segmentIndex = Math.floor(this.carProgress);\n671:     const segmentT = this.carProgress - segmentIndex;\n672: \n673:     const fromId = this.activeCorridorPath[segmentIndex];\n674:     const toId = this.activeCorridorPath[segmentIndex + 1];\n675: \n676:     if (!fromId || !toId) return;\n677: \n678:     const s1 = TRANSIT_STATIONS.find(s => s.id === fromId);\n679:     const s2 = TRANSIT_STATIONS.find(s => s.id === toId);\n680: \n681:     // Interpolate 3D coordinates\n682:     const curX = s1.x + (s2.x - s1.x) * segmentT;\n683:     const curY = s1.y + (s2.y - s1.y) * segmentT;\n684:     const curZ = s1.z + (s2.z - s1.z) * segmentT;\n685: \n686:     const carProj = this.project(curX, curY, curZ);\n687: \n688:     // Calculate heading angle\n689:     const p1 = this.project(s1.x, s1.y, s1.z);\n690:     const p2 = this.project(s2.x, s2.y, s2.z);\n691:     const heading = Math.atan2(p2.y - p1.y, p2.x - p1.x);\n692: \n693:     ctx.save();\n694:     ctx.translate(carProj.x, carProj.y);\n695:     ctx.rotate(heading);\n696: \n697:     // Glowing Headlight Beams\n698:     ctx.beginPath();\n699:     ctx.moveTo(12 * carProj.scale, -4 * carProj.scale);\n700:     ctx.lineTo(26 * carProj.scale, -12 * carProj.scale);\n701:     ctx.lineTo(26 * carProj.scale, 12 * carProj.scale);\n702:     ctx.lineTo(12 * carProj.scale, 4 * carProj.scale);\n703:     ctx.closePath();\n704:     const lightGrad = ctx.createLinearGradient(12 * carProj.scale, 0, 26 * carProj.scale, 0);\n705:     lightGrad.addColorStop(0, 'rgba(32, 201, 176, 0.45)');\n706:     lightGrad.addColorStop(1, 'rgba(32, 201, 176, 0)');\n707:     ctx.fillStyle = lightGrad;\n708:     ctx.fill();\n709: \n710:     // Electric Vehicle Chassis\n711:     ctx.beginPath();\n712:     ctx.roundRect(-10 * carProj.scale, -6 * carProj.scale, 20 * carProj.scale, 12 * carProj.scale, 4 * carProj.scale);\n713:     ctx.fillStyle = '#059669';\n714:     ctx.fill();\n715:     ctx.strokeStyle = '#FFFFFF';\n716:     ctx.lineWidth = 1.5;\n717:     ctx.stroke();\n718: \n719:     // Windshield\n720:     ctx.beginPath();\n721:     ctx.roundRect(0, -4 * carProj.scale, 5 * carProj.scale, 8 * carProj.scale, 2 * carProj.scale);\n722:     ctx.fillStyle = '#93C5FD';\n723:     ctx.fill();\n724: \n725:     // Headlight bulbs\n726:     ctx.fillStyle = '#FEF08A';\n727:     ctx.fillRect(8 * carProj.scale, -5 * carProj.scale, 2 * carProj.scale, 2 * carProj.scale);\n728:     ctx.fillRect(8 * carProj.scale, 3 * carProj.scale, 2 * carProj.scale, 2 * carProj.scale);\n729: \n730:     ctx.restore();\n731:   }\n732: \n733:   drawGroundGrid() {\n734:     const ctx = this.ctx;\n735:     const size = 220;\n736:     const step = 44;\n737:     const floorZ = -30;\n738: \n739:     ctx.save();\n740:     ctx.strokeStyle = 'rgba(203, 213, 225, 0.6)';\n741:     ctx.lineWidth = 1;\n742: \n743:     for (let i = -size; i <= size; i += step) {\n744:       const p1 = this.project(i, -size, floorZ);\n745:       const p2 = this.project(i, size, floorZ);\n746:       ctx.beginPath();\n747:       ctx.moveTo(p1.x, p1.y);\n748:       ctx.lineTo(p2.x, p2.y);\n749:       ctx.stroke();\n750: \n751:       const p3 = this.project(-size, i, floorZ);\n752:       const p4 = this.project(size, i, floorZ);\n753:       ctx.beginPath();\n754:       ctx.moveTo(p3.x, p3.y);\n755:       ctx.lineTo(p4.x, p4.y);\n756:       ctx.stroke();\n757:     }\n758:     ctx.restore();\n759:   }\n760: }\n761: \n762: let urbanCanvasInstance = null;\n763: let ambientCanvasInstance = null;\n764: \n765: // ==========================================\n766: // 5. ECOSPROUT MASCOT VECTOR TEMPLATE\n767: // ==========================================\n768: function getEcoSproutSVG() {\n769:   return `\n770:     <svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n771:       <!-- Mascot Head -->\n772:       <circle cx=\"32\" cy=\"38\" r=\"18\" fill=\"#10B981\"/>\n773:       <ellipse cx=\"32\" cy=\"42\" rx=\"14\" ry=\"10\" fill=\"#34D399\"/>\n774:       \n775:       <!-- Leaf Cap on top -->\n776:       <path d=\"M32 20C32 20 22 14 26 6C34 10 32 20 32 20Z\" fill=\"#059669\"/>\n777:       <path d=\"M32 20C32 20 42 14 38 6C30 10 32 20 32 20Z\" fill=\"#34D399\"/>\n778:       <circle cx=\"32\" cy=\"20\" r=\"3\" fill=\"#D97706\"/>\n779:       \n780:       <!-- Aviator Goggles -->\n781:       <rect x=\"18\" y=\"28\" width=\"12\" height=\"9\" rx=\"3\" fill=\"#1E293B\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n782:       <rect x=\"34\" y=\"28\" width=\"12\" height=\"9\" rx=\"3\" fill=\"#1E293B\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n783:       <line x1=\"30\" y1=\"32\" x2=\"34\" y2=\"32\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n784:       <circle cx=\"24\" cy=\"32\" r=\"3\" fill=\"#38BDF8\"/>\n785:       <circle cx=\"40\" cy=\"32\" r=\"3\" fill=\"#38BDF8\"/>\n786:       \n787:       <!-- Cheerful Smile -->\n788:       <path d=\"M26 43C28 47 36 47 38 43\" stroke=\"#064E3B\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n789:       <!-- Rosy Cheeks -->\n790:       <circle cx=\"21\" cy=\"41\" r=\"2.5\" fill=\"#F87171\" opacity=\"0.7\"/>\n791:       <circle cx=\"43\" cy=\"41\" r=\"2.5\" fill=\"#F87171\" opacity=\"0.7\"/>\n792:     </svg>\n793:   `;\n794: }\n795: \n796: // ==========================================\n797: // 6. MULTI-TAB SWITCHING CONTROLLER\n798: // ==========================================\n799: function initTabNavigation() {\n800:   const triggers = document.querySelectorAll('.tab-trigger');\n801:   const views = document.querySelectorAll('.tab-view');\n802: \n803:   triggers.forEach(trigger => {\n804:     trigger.addEventListener('click', () => {\n805:       const targetTabId = trigger.dataset.tab;\n806: \n807:       triggers.forEach(t => t.classList.remove('active'));\n808:       trigger.classList.add('active');\n809: \n810:       views.forEach(v => {\n811:         v.classList.remove('active');\n812:         if (v.id === targetTabId) {\n813:           v.classList.add('active');\n814:         }\n815:       });\n816: \n817:       if (targetTabId === 'tab-route-finder' && urbanCanvasInstance) {\n818:         setTimeout(() => {\n819:           urbanCanvasInstance.resize();\n820:         }, 50);\n821:       }\n822:     });\n823:   });\n824: }\n825: \n826: // ==========================================\n827: // 7. UI REFRESH & COMPONENT RENDERERS\n828: // ==========================================\n829: function refreshPlatformUI() {\n830:   renderPassengerDispatchStream();\n831:   renderStandbyLounge();\n832:   renderFleetDirectory();\n833:   renderActiveTrips();\n834:   renderTransitHierarchyCanvas();\n835:   renderAuditHistory();\n836:   renderLeaderboard();\n837:   updateTopKPIs();\n838: }\n839: \n840: function updateTopKPIs() {\n841:   document.getElementById('kpi-commuters').innerHTML = `${engine.dispatchStream.length} <span class=\"kpi-unit\">commuters</span>`;\n842:   document.getElementById('kpi-active-trips').innerHTML = `${engine.activeTrips.length} <span class=\"kpi-unit\">trips</span>`;\n843: \n844:   const passBadge = document.getElementById('tab-passengers-badge');\n845:   if (passBadge) passBadge.textContent = engine.dispatchStream.length + engine.standbyCount;\n846: \n847:   const fleetBadge = document.getElementById('tab-fleet-badge');\n848:   if (fleetBadge) fleetBadge.textContent = engine.fleetPartners.length;\n849: \n850:   let totalSavedCO2 = 148.5;"}
