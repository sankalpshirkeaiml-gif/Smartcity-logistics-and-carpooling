r-radius: 10px;\n1605:   background: #FFFFFF;\n1606:   border: 1px solid var(--slate-200);\n1607:   border-left: 4px solid var(--emerald);\n1608:   box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);\n1609:   font-size: 0.8rem;\n1610:   font-weight: 500;\n1611:   display: flex;\n1612:   align-items: center;\n1613:   gap: 0.75rem;\n1614:   color: var(--slate-900);\n1615:   animation: toastIn 0.3s ease-out;\n1616: }\n1617: .toast.toast-emerald { border-left-color: var(--emerald); }\n1618: .toast.toast-blue { border-left-color: var(--electric); }\n1619: .toast.toast-rose { border-left-color: var(--rose); }\n1620: .toast.toast-amber { border-left-color: var(--amber); }\n1621: \n1622: @keyframes toastIn {\n1623:   from { opacity: 0; transform: translateY(15px); }\n1624:   to { opacity: 1; transform: translateY(0); }\n1625: }\n1626: \n1627: @keyframes modalIn {\n1628:   from { opacity: 0; transform: scale(0.95); }\n1629:   to { opacity: 1; transform: scale(1); }\n1630: }\n1631: \n1632: @keyframes slideRight {\n1633:   from { opacity: 0; transform: translateX(20px); }\n1634:   to { opacity: 1; transform: translateX(0); }\n1635: }\n1636: \n1637: @keyframes slideDown {\n1638:   from { opacity: 0; transform: translateY(-10px); }\n1639:   to { opacity: 1; transform: translateY(0); }\n1640: }\n1641: \n1642: @keyframes pulse {\n1643:   0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0.7); }\n1644:   70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(5, 150, 105, 0); }\n1645:   100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(5, 150, 105, 0); }\n1646: }"}
