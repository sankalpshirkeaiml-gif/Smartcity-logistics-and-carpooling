459:   backdrop-filter: blur(6px);\n1460:   z-index: 1000;\n1461:   display: flex;\n1462:   align-items: center;\n1463:   justify-content: center;\n1464:   padding: 1.5rem;\n1465: }\n1466: \n1467: .modal-overlay.hidden {\n1468:   display: none;\n1469: }\n1470: \n1471: .modal-card {\n1472:   width: 520px;\n1473:   max-width: 95vw;\n1474:   background: #FFFFFF;\n1475:   border-radius: 16px;\n1476:   box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.2);\n1477:   display: flex;\n1478:   flex-direction: column;\n1479:   overflow: hidden;\n1480:   animation: modalIn 0.28s cubic-bezier(0.16, 1, 0.3, 1);\n1481: }\n1482: \n1483: .modal-header {\n1484:   padding: 1.1rem 1.5rem;\n1485:   display: flex;\n1486:   align-items: center;\n1487:   justify-content: space-between;\n1488:   border-bottom: 1px solid var(--slate-100);\n1489: }\n1490: \n1491: .modal-dialog-body {\n1492:   padding: 1.5rem;\n1493:   display: flex;\n1494:   flex-direction: column;\n1495:   gap: 1rem;\n1496: }\n1497: \n1498: .modal-footer {\n1499:   padding: 1rem 1.5rem;\n1500:   display: flex;\n1501:   justify-content: flex-end;\n1502:   gap: 0.75rem;\n1503:   border-top: 1px solid var(--slate-100);\n1504:   background: #F8FAFC;\n1505: }\n1506: \n1507: .receipt-item-row {\n1508:   display: flex;\n1509:   justify-content: space-between;\n1510:   font-size: 0.8rem;\n1511:   color: var(--slate-600);\n1512: }\n1513: .receipt-item-row.bold-row {\n1514:   font-weight: 700;\n1515:   color: var(--slate-900);\n1516:   border-top: 1px dashed var(--slate-300);\n1517:   padding-top: 0.5rem;\n1518:   font-size: 0.9rem;\n1519: }\n1520: \n1521: .modal-stat-grid {\n1522:   display: grid;\n1523:   grid-template-columns: 1fr 1fr;\n1524:   gap: 0.75rem;\n1525:   margin: 0.5rem 0;\n1526: }\n1527: \n1528: .modal-stat-box {\n1529:   background: #F8FAFC;\n1530:   border: 1px solid var(--slate-200);\n1531:   border-radius: 10px;\n1532:   padding: 0.65rem 0.85rem;\n1533:   display: flex;\n1534:   flex-direction: column;\n1535: }\n1536: .modal-stat-box .stat-label {\n1537:   font-size: 0.65rem;\n1538:   color: var(--slate-500);\n1539:   font-family: var(--font-mono);\n1540: }\n1541: .modal-stat-box .stat-val {\n1542:   font-size: 0.95rem;\n1543:   font-weight: 700;\n1544:   color: var(--slate-900);\n1545: }\n1546: \n1547: /* --------------------------------------------------------------------------\n1548:    Footer & Toasts\n1549:    -------------------------------------------------------------------------- */\n1550: .app-footer {\n1551:   padding: 1.25rem 0.5rem;\n1552:   display: flex;\n1553:   justify-content: space-between;\n1554:   align-items: center;\n1555:   font-size: 0.75rem;\n1556:   color: var(--slate-500);\n1557:   border-top: 1px solid var(--slate-200);\n1558:   flex-wrap: wrap;\n1559:   gap: 0.75rem;\n1560: }\n1561: \n1562: .footer-right {\n1563:   display: flex;\n1564:   gap: 1.25rem;\n1565: }\n1566: \n1567: .toast-container {\n1568:   position: fixed;\n1569:   bottom: 1.5rem;\n1570:   right: 1.5rem;\n1571:   display: flex;\n1572:   flex-direction: column;\n1573:   gap: 0.5rem;\n1574:   z-index: 9999;\n1575: }\n1576: \n1577: .toast {\n1578:   padding: 0.75rem 1.25rem;\n1579:   border-radius: 10px;\n1580:   background: #FFFFFF;\n1581:   border: 1px solid var(--slate-200);\n1582:   border-left: 4px solid var(--emerald);\n1583:   box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);\n1584:   font-size: 0.8rem;\n1585:   font-weight: 500;\n1586:   display: flex;\n1587:   align-items: center;\n1588:   gap: 0.75rem;\n1589:   color: var(--slate-900);\n1590:   animation: toastIn 0.3s ease-out;\n1591: }\n1592: .toast.toast-emerald { border-left-color: var(--emerald); }\n1593: .toast.toast-blue { border-left-color: var(--electric); }\n1594: .toast.toast-rose { border-left-color: var(--rose); }\n1595: .toast.toast-amber { border-left-color: var(--amber); }\n1596: \n1597: @keyframes toastIn {\n1598:   from { opacity: 0; transform: translateY(15px); }\n1599:   to { opacity: 1; transform: translateY(0); }"}
