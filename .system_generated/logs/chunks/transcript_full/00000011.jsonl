rseFloat(dist[endId].toFixed(1));\n127:     const estTime = Math.round(totalDist * 2.2);\n128:     const baseCO2 = totalDist * 0.171;\n129:     const co2Offset = parseFloat((baseCO2 * (0.8 + this.commuterDensity * 0.4)).toFixed(2));\n130: \n131:     const baseTripCost = 4.0 + totalDist * 1.5;\n132:     const pooledFare = parseFloat(((baseTripCost * (1 + (this.commuterDensity - 1) * 0.25)) / this.commuterDensity).toFixed(2));\n133: \n134:     return {\n135:       path,\n136:       totalDist,\n137:       estTime,\n138:       co2Offset,\n139:       fare: pooledFare,\n140:       soloCarsSaved: Math.max(0, this.commuterDensity - 1)\n141:     };\n142:   }\n143: \n144:   submitRideRequest(name, pickup, drop) {\n145:     const passenger = {\n146:       id: `BK-${this.counters.passenger++}`,\n147:       name,\n148:       pickup,\n149:       drop,\n150:       requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n151:       status: 'Pending Dispatch'\n152:     };\n153:     this.dispatchStream.push(passenger);\n154:     return passenger;\n155:   }\n156: \n157:   dequeueNextRequest() {\n158:     return this.dispatchStream.shift() || null;\n159:   }\n160: \n161:   pushToStandby(item) {\n162:     if (this.standbyCount === this.standbyCap) {\n163:       return { success: false, message: 'Priority Standby Lounge is currently at maximum capacity (5/5).' };\n164:     }\n165:     this.standbyLounge[this.standbyRear] = item;\n166:     this.standbyRear = (this.standbyRear + 1) % this.standbyCap;\n167:     this.standbyCount++;\n168:     return { success: true };\n169:   }\n170: \n171:   popFromStandby() {\n172:     if (this.standbyCount === 0) {\n173:       return { success: false, message: 'Standby lounge is currently empty.' };\n174:     }\n175:     const item = this.standbyLounge[this.standbyFront];\n176:     this.standbyLounge[this.standbyFront] = null;\n177:     this.standbyFront = (this.standbyFront + 1) % this.standbyCap;\n178:     this.standbyCount--;\n179:     return { success: true, item };\n180:   }\n181: \n182:   onboardDriver(name, station, seats) {\n183:     const driverId = this.counters.driver++;\n184:     const newPartner = {\n185:       id: driverId,\n186:       name,\n187:       station,\n188:       seats: parseInt(seats, 10),\n189:       originalSeats: parseInt(seats, 10),\n190:       tripsCompleted: 0\n191:     };\n192:     this.fleetPartners.push(newPartner);\n193:     return newPartner;\n194:   }\n195: \n196:   getDriverById(id) {\n197:     const cleanId = String(id).replace(/[^0-9]/g, '');\n198:     return this.fleetPartners.find(d => String(d.id) === cleanId) || null;\n199:   }\n200: \n201:   getBookingByRef(ref) {\n202:     const upper = String(ref).trim().toUpperCase();\n203:     return this.activeTrips.find(t => t.tripRef.toUpperCase() === upper || t.passenger.id.toUpperCase() === upper) || null;\n204:   }\n205: \n206:   dispatchSharedTrip(passenger, driver, corridorPath, distance, time, fare, co2Saved, matchScore = 94) {\n207:     const tripRef = `NX-${this.counters.booking++}`;\n208:     const trip = {\n209:       tripRef,\n210:       passenger,\n211:       driverId: driver.id,\n212:       driverName: driver.name,\n213:       corridorPath,\n214:       distance,\n215:       time,\n216:       fare,\n217:       co2Saved,\n218:       matchScore,\n219:       dispatchedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\n220:     };\n221: \n222:     this.activeTrips.push(trip);\n223:     // FIX: Clamp seats to prevent negative values\n224:     driver.seats = Math.max(0, driver.seats - 1);\n225:     driver.tripsCompleted += 1;\n226: \n227:     this.reversalAuditLog.push({\n228:       type: 'DISPATCH_CONFIRMATION',\n229:       tripRef,\n230:       driverId: driver.id,\n231:       passenger,\n232:       trip\n233:     });\n234: \n235:     return trip;\n236:   }\n237: \n238:   cancelActiveTrip(tripRef) {\n239:     const index = this.activeTrips.findIndex(t => t.tripRef === tripRef);\n240:     if (index !== -1) {\n241:       const removed = this.activeTrips.splice(index, 1)[0];\n242:       return removed;\n243:     }\n244:     return null;\n245:   }\n246: \n247:   revertLatestConfirmation() {\n248:     if (this.reversalAuditLog.length === 0) {\n249:       return { success: false, message: 'No recent dispatch confirmations available to revert.' };\n250:     }"}
