{"step_index":154,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:25:38Z","content":"Created At: 2026-10-20T11:55:38+05:30\nCompleted At: 2026-10-20T11:55:39+05:30\nShowing lines 1100-1400 of 1661\n1100:   const latestIdx = engine.reversalAuditLog.length - 1;\n1101:   container.innerHTML = engine.reversalAuditLog.map((entry, idx) => `\n1102:     <div class=\"audit-entry ${idx === latestIdx ? 'latest-entry' : ''}\">\n1103:       <div class=\"flex items-center gap-2\">\n1104:         <i class=\"fa-solid fa-shield-check text-emerald\"></i>\n1105:         <span class=\"font-semibold text-slate-800\">${entry.tripRef} &bull; ${entry.passenger.name}</span>\n1106:       </div>\n1107:       <span class=\"text-slate-500 font-mono text-[10px]\">Driver #${entry.driverId}</span>\n1108:     </div>\n1109:   `).join('');\n1110: }\n1111: \n1112: // --- Leaderboard with Gamified Achievement Badges ---\n1113: function renderLeaderboard() {\n1114:   const container = document.getElementById('eco-leaderboard-list');\n1115:   if (!container) return;\n1116: \n1117:   container.innerHTML = engine.leaderboard.map((item, idx) => `\n1118:     <div class=\"leader-item\">\n1119:       <div class=\"flex items-center gap-2\">\n1120:         <span class=\"text-amber-500 font-bold\">#${idx + 1}</span>\n1121:         <div>\n1122:           <div class=\"font-semibold text-slate-800\">${item.name}</div>\n1123:           <span class=\"gamified-badge\"><i class=\"fa-solid fa-award\"></i> ${item.badge}</span>\n1124:         </div>\n1125:       </div>\n1126:       <div class=\"flex items-center gap-3\">\n1127:         <span class=\"text-slate-500\">${item.trips} trips</span>\n1128:         <span class=\"text-emerald font-semibold\">${item.co2}</span>\n1129:         <span class=\"text-amber-600 font-mono text-[11px]\"><i class=\"fa-solid fa-star\"></i> ${item.rating}</span>\n1130:       </div>\n1131:     </div>\n1132:   `).join('');\n1133: }\n1134: \n1135: // ==========================================\n1136: // 8. ENTERPRISE CONFIRMATION MODALS\n1137: // ==========================================\n1138: function openDispatchModal(trip, driver) {\n1139:   const modal = document.getElementById('dispatch-confirm-modal');\n1140:   const body = document.getElementById('dispatch-modal-body');\n1141: \n1142:   body.innerHTML = `\n1143:     <div class=\"flex items-center gap-3 p-3 bg-emerald-50 border border-emerald-200 rounded-xl\">\n1144:       <div class=\"text-2xl text-emerald\"><i class=\"fa-solid fa-circle-check\"></i></div>\n1145:       <div>\n1146:         <div class=\"text-sm font-bold text-slate-900\">Trip Reference: ${trip.tripRef}</div>\n1147:         <div class=\"text-xs text-slate-600\">Passenger ${trip.passenger.name} matched with ${driver.name} (ID: #${driver.id})</div>\n1148:       </div>\n1149:     </div>\n1150: \n1151:     <div class=\"modal-stat-grid\">\n1152:       <div class=\"modal-stat-box\">\n1153:         <span class=\"stat-label\">CORRIDOR ALIGNMENT</span>\n1154:         <span class=\"stat-val text-emerald\">${trip.matchScore}% Match</span>\n1155:       </div>\n1156:       <div class=\"modal-stat-box\">\n1157:         <span class=\"stat-label\">EST. COMMUTE TIME</span>\n1158:         <span class=\"stat-val text-electric\">~${trip.time} mins (${trip.distance}km)</span>\n1159:       </div>\n1160:       <div class=\"modal-stat-box\">\n1161:         <span class=\"stat-label\">POOLED FARE</span>\n1162:         <span class=\"stat-val text-slate-900\">$${trip.fare} USD</span>\n1163:       </div>\n1164:       <div class=\"modal-stat-box\">\n1165:         <span class=\"stat-label\">CARBON OFFSET</span>\n1166:         <span class=\"stat-val text-emerald\">+${trip.co2Saved} kg CO₂</span>\n1167:       </div>\n1168:     </div>\n1169: \n1170:     <div class=\"text-xs text-slate-500 font-mono\">\n1171:       Route Transit: ${trip.corridorPath.join(' &rarr; ')} &bull; Fleet seats remaining for #${driver.id}: ${driver.seats}\n1172:     </div>\n1173:   `;\n1174: \n1175:   modal.classList.remove('hidden');\n1176: }\n1177: \n1178: function openReversalModal(action, driver) {\n1179:   const modal = document.getElementById('reversal-confirm-modal');\n1180:   const body = document.getElementById('reversal-modal-body');\n1181: \n1182:   body.innerHTML = `\n1183:     <div class=\"flex items-center gap-3 p-3 bg-rose-50 border border-rose-200 rounded-xl\">\n1184:       <div class=\"text-2xl text-rose\"><i class=\"fa-solid fa-arrow-rotate-left\"></i></div>\n1185:       <div>\n1186:         <div class=\"text-sm font-bold text-slate-900\">Reverted Trip: ${action.tripRef}</div>\n1187:         <div class=\"text-xs text-slate-600\">The most recent dispatch confirmation was safely reversed.</div>\n1188:       </div>\n1189:     </div>\n1190: \n1191:     <div class=\"modal-stat-grid\">\n1192:       <div class=\"modal-stat-box\">\n1193:         <span class=\"stat-label\">RESTORED DRIVER</span>\n1194:         <span class=\"stat-val text-slate-900\">${driver ? driver.name : `ID #${action.driverId}`}</span>\n1195:       </div>\n1196:       <div class=\"modal-stat-box\">\n1197:         <span class=\"stat-label\">UPDATED SEAT CAPACITY</span>\n1198:         <span class=\"stat-val text-emerald\">${driver ? `${driver.seats}/${driver.originalSeats} Seats` : 'Restored'}</span>\n1199:       </div>\n1200:     </div>\n1201: \n1202:     <div class=\"text-xs text-slate-600\">\n1203:       Commuter <b>${action.passenger.name}</b> has been returned to the front of the dispatch queue without losing priority.\n1204:     </div>\n1205:   `;\n1206: \n1207:   modal.classList.remove('hidden');\n1208: }\n1209: \n1210: // Global Toast System\n1211: function showPlatformToast(message, type = 'emerald') {\n1212:   const container = document.getElementById('toast-container');\n1213:   const toast = document.createElement('div');\n1214:   toast.className = `toast toast-${type}`;\n1215:   toast.innerHTML = `<i class=\"fa-solid fa-circle-check text-emerald\"></i><span>${message}</span>`;\n1216:   container.appendChild(toast);\n1217: \n1218:   setTimeout(() => {\n1219:     toast.style.opacity = '0';\n1220:     toast.style.transform = 'translateY(15px)';\n1221:     setTimeout(() => toast.remove(), 300);\n1222:   }, 3600);\n1223: }\n1224: \n1225: // Global trip completion hook\n1226: window.handleCompleteTrip = function(tripRef) {\n1227:   const removed = engine.cancelActiveTrip(tripRef);\n1228:   if (removed) {\n1229:     showPlatformToast(`Trip ${tripRef} successfully completed. Corridors updated.`, 'blue');\n1230:     refreshPlatformUI();\n1231:   }\n1232: };\n1233: \n1234: // Global Eco-Receipt viewer hook\n1235: window.viewEcoReceipt = function(tripRef) {\n1236:   const trip = engine.activeTrips.find(t => t.tripRef === tripRef);\n1237:   if (!trip) return;\n1238: \n1239:   const modal = document.getElementById('receipt-modal-overlay');\n1240:   const content = document.getElementById('receipt-content-area');\n1241: \n1242:   content.innerHTML = `\n1243:     <div class=\"receipt-item-row\">\n1244:       <span>Booking Reference:</span>\n1245:       <span class=\"font-mono font-bold text-slate-800\">${trip.tripRef}</span>\n1246:     </div>\n1247:     <div class=\"receipt-item-row\">\n1248:       <span>Commuter Name:</span>\n1249:       <span class=\"font-semibold text-slate-800\">${trip.passenger.name}</span>\n1250:     </div>\n1251:     <div class=\"receipt-item-row\">\n1252:       <span>Driver Partner:</span>\n1253:       <span class=\"text-slate-800\">${trip.driverName} (ID: #${trip.driverId})</span>\n1254:     </div>\n1255:     <div class=\"receipt-item-row\">\n1256:       <span>Corridor Route:</span>\n1257:       <span class=\"text-electric font-semibold\">${trip.corridorPath.join(' &rarr; ')}</span>\n1258:     </div>\n1259:     <div class=\"receipt-item-row\">\n1260:       <span>Distance & Time:</span>\n1261:       <span class=\"text-slate-800\">${trip.distance} km &bull; ~${trip.time} mins</span>\n1262:     </div>\n1263:     <div class=\"receipt-item-row\">\n1264:       <span>Net Carbon Avoided:</span>\n1265:       <span class=\"text-emerald font-bold font-mono\">+${trip.co2Saved} kg CO₂</span>\n1266:     </div>\n1267:     <div class=\"receipt-item-row\">\n1268:       <span>Corridor Alignment Match:</span>\n1269:       <span class=\"text-emerald font-bold\">${trip.matchScore}% Eco-Pooled Match</span>\n1270:     </div>\n1271:     <div class=\"receipt-item-row bold-row\">\n1272:       <span>Total Pooled Fare Paid:</span>\n1273:       <span class=\"text-slate-900\">$${trip.fare} USD</span>\n1274:     </div>\n1275:   `;\n1276: \n1277:   modal.classList.remove('hidden');\n1278: };\n1279: \n1280: // ==========================================\n1281: // 9. INITIALIZATION & EVENT LISTENERS\n1282: // ==========================================\n1283: document.addEventListener('DOMContentLoaded', () => {\n1284:   urbanCanvasInstance = new Urban3DCanvas('urban-3d-canvas');\n1285:   ambientCanvasInstance = new AmbientEcoCanvas('ambient-canvas');\n1286:   initTabNavigation();\n1287: \n1288:   // Populate Select Boxes\n1289:   const originSel = document.getElementById('route-origin');\n1290:   const destSel = document.getElementById('route-destination');\n1291:   const passPickup = document.getElementById('passenger-pickup-select');\n1292:   const passDrop = document.getElementById('passenger-drop-select');\n1293:   const driverStation = document.getElementById('driver-station-select');\n1294: \n1295:   TRANSIT_STATIONS.forEach(s => {\n1296:     const opt = `<option value=\"${s.id}\">${s.name} (${s.zone})</option>`;\n1297:     originSel.insertAdjacentHTML('beforeend', opt);\n1298:     destSel.insertAdjacentHTML('beforeend', opt);\n1299:     passPickup.insertAdjacentHTML('beforeend', opt);\n1300:     passDrop.insertAdjacentHTML('beforeend', opt);\n1301:     driverStation.insertAdjacentHTML('beforeend', opt);\n1302:   });\n1303: \n1304:   originSel.value = 'ALPHA';\n1305:   destSel.value = 'HORIZON';\n1306:   passPickup.value = 'ALPHA';\n1307:   passDrop.value = 'HORIZON';\n1308:   driverStation.value = 'METRO';\n1309: \n1310:   // --- Dynamic Commuter Slider Handler ---\n1311:   const commuterSlider = document.getElementById('commuter-range-slider');\n1312:   const sliderFareDisplay = document.getElementById('slider-fare-display');\n1313:   const sliderTicks = document.querySelectorAll('.slider-ticks .tick');\n1314: \n1315:   function updateCommuterSliderMetrics() {\n1316:     const val = parseInt(commuterSlider.value, 10);\n1317:     engine.commuterDensity = val;\n1318: \n1319:     sliderTicks.forEach((tick, idx) => {\n1320:       tick.classList.toggle('active-tick', idx + 1 === val);\n1321:     });\n1322: \n1323:     computeAndDisplayRoute();\n1324:   }\n1325: \n1326:   commuterSlider.addEventListener('input', updateCommuterSliderMetrics);\n1327: \n1328:   // --- Interactive 4-Seat Vehicle Selector ---\n1329:   const seatButtons = [\n1330:     document.getElementById('seat-front-pass'),\n1331:     document.getElementById('seat-rear-left'),\n1332:     document.getElementById('seat-rear-right')\n1333:   ];\n1334:   const driverSeatsCountLabel = document.getElementById('driver-seats-count-label');\n1335: \n1336:   function getActiveSeatsCount() {\n1337:     let count = 0;\n1338:     seatButtons.forEach(btn => {\n1339:       if (btn.classList.contains('active-seat')) count++;\n1340:     });\n1341:     return count;\n1342:   }\n1343: \n1344:   seatButtons.forEach(btn => {\n1345:     btn.addEventListener('click', () => {\n1346:       if (btn.classList.contains('active-seat')) {\n1347:         btn.classList.remove('active-seat');\n1348:         btn.classList.add('reserved-seat');\n1349:         btn.innerHTML = `<i class=\"fa-solid fa-ban\"></i><span>OFF</span>`;\n1350:       } else {\n1351:         btn.classList.remove('reserved-seat');\n1352:         btn.classList.add('active-seat');\n1353:         btn.innerHTML = `<i class=\"fa-solid fa-user-check\"></i><span>${btn.dataset.seat.toUpperCase()}</span>`;\n1354:       }\n1355:       const count = getActiveSeatsCount();\n1356:       driverSeatsCountLabel.textContent = count;\n1357:       showPlatformToast(`Car configuration: ${count} passenger seats available.`, 'emerald');\n1358:     });\n1359:   });\n1360: \n1361:   // --- Calculate Route Button ---\n1362:   function computeAndDisplayRoute() {\n1363:     const orig = originSel.value;\n1364:     const dest = destSel.value;\n1365: \n1366:     if (orig === dest) {\n1367:       showPlatformToast('Origin and Destination stations cannot be identical.', 'rose');\n1368:       return;\n1369:     }\n1370: \n1371:     const res = engine.findOptimalEcoRoute(orig, dest);\n1372:     urbanCanvasInstance.setActivePath(res.path);\n1373: \n1374:     document.getElementById('strip-path').textContent = res.path.join(' → ');\n1375:     document.getElementById('strip-distance').textContent = `${res.totalDist} km`;\n1376:     document.getElementById('strip-time').textContent = `~${res.estTime} min`;\n1377:     document.getElementById('strip-co2').textContent = `-${res.co2Offset} kg`;\n1378:     document.getElementById('strip-vehicles-saved').textContent = `${res.soloCarsSaved} ${res.soloCarsSaved === 1 ? 'Car' : 'Cars'}`;\n1379:     sliderFareDisplay.textContent = `$${res.fare}`;\n1380: \n1381:     showPlatformToast(`Optimal eco-route: ${res.totalDist} km, saving ${res.co2Offset} kg CO₂.`, 'emerald');\n1382:   }\n1383: \n1384:   document.getElementById('btn-calc-route').addEventListener('click', computeAndDisplayRoute);\n1385: \n1386:   document.getElementById('btn-simulate-drive').addEventListener('click', () => {\n1387:     urbanCanvasInstance.startCarSimulation();\n1388:     showPlatformToast('Simulating top-down electric transit drive along route corridors!', 'blue');\n1389:   });\n1390: \n1391:   document.getElementById('btn-swap-route').addEventListener('click', () => {\n1392:     const temp = originSel.value;\n1393:     originSel.value = destSel.value;\n1394:     destSel.value = temp;\n1395:     computeAndDisplayRoute();\n1396:   });\n1397: \n1398:   document.getElementById('btn-reset-view').addEventListener('click', () => {\n1399:     urbanCanvasInstance.resetCamera();\n1400:   });"}
