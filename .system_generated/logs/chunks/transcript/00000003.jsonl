======\n790: function initTabNavigation() {\n791:   const triggers = document.querySelectorAll('.tab-trigger');\n792:   const views = document.querySelectorAll('.tab-view');\n793: \n794:   triggers.forEach(trigger => {\n795:     trigger.addEventListener('click', () => {\n796:       const targetTabId = trigger.dataset.tab;\n797: \n798:       triggers.forEach(t => t.classList.remove('active'));\n799:       trigger.classList.add('active');\n800: ","truncated_fields":["content"]}
