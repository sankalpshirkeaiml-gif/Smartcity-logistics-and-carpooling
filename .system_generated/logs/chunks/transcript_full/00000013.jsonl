en;\n  align-items: center;\n  font-size: 0.75rem;\n  font-weight: 600;\n  color: var(--slate-700);\n}\n\n.vehicle-chassis-diagram {\n  width: 170px;\n  height: 220px;\n  margin: 0 auto;\n  border: 2px solid var(--slate-300);\n  border-radius: 40px 40px 24px 24px;\n  background: #FFFFFF;\n  position: relative;\n  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);\n  padding: 1.25rem 0.75rem;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.chassis-row {\n  display: flex;\n  justify-content: space-around;\n  gap: 0.5rem;\n}\n\n.vehicle-seat {\n  width: 58px;\n  height: 64px;\n  border-radius: 10px;\n  border: 1.5px solid var(--slate-200);\n  background: #FFFFFF;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 0.25rem;\n  font-size: 0.65rem;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  color: var(--slate-600);\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.vehicle-seat:hover {\n  border-color: var(--emerald);\n  transform: translateY(-2px);\n}\n\n.vehicle-seat.driver-locked {\n  background: #F1F5F9;\n  border-color: var(--slate-300);\n  color: var(--slate-700);\n  cursor: default;\n}\n\n.vehicle-seat.active-seat {\n  background: var(--emerald-light);\n  border-color: var(--emerald);\n  color: var(--emerald);\n  box-shadow: 0 4px 10px var(--emerald-glow);\n}\n\n.vehicle-seat.reserved-seat {\n  background: var(--rose-light);\n  border-color: var(--rose-border);\n  color: var(--rose);\n}\n\n/* Fleet Directory & Active Trips Column */\n.fleet-operations-column {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.fleet-stream-container {\n  display: flex;\n  gap: 1rem;\n  overflow-x: auto;\n  padding-bottom: 0.5rem;\n}\n\n.driver-partner-card {\n  min-width: 220px;\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 0.9rem 1.1rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n  flex-shrink: 0;\n}\n\n.card-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.driver-id-badge {\n  font-size: 0.65rem;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  color: var(--slate-500);\n}\n\n.seat-counter-pill {\n  font-size: 0.65rem;\n  font-weight: 700;\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  padding: 0.15rem 0.45rem;\n  border-radius: 9999px;\n}\n\n.driver-name {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--slate-900);\n}\n\n.driver-corridor {\n  font-size: 0.75rem;\n  color: var(--slate-600);\n}\n\n.fleet-pointer {\n  display: flex;\n  align-items: center;\n  color: var(--slate-400);\n}\n\n/* Active Shared Trips Console */\n.active-trips-stream {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));\n  gap: 1rem;\n}\n\n.shared-trip-card {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 1rem 1.15rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.45rem;\n  position: relative;\n}\n\n.route-match-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  padding: 0.15rem 0.5rem;\n  border-radius: 6px;\n  background: var(--electric-light);\n  color: var(--electric);\n  border: 1px solid var(--electric-border);\n}\n\n.trip-ref {\n  font-family: var(--font-mono);\n  font-size: 0.72rem;\n  font-weight: 700;\n  color: var(--slate-500);\n}\n\n.btn-cancel-trip {\n  position: absolute;\n  top: 0.75rem;\n  right: 0.75rem;\n  width: 24px;\n  height: 24px;\n  border-radius: 50%;\n  background: #F1F5F9;\n  border: none;\n  color: var(--slate-400);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  font-size: 0.7rem;\n  transition: all 0.2s ease;\n}\n.btn-cancel-trip:hover {\n  background: var(--rose-light);\n  color: var(--rose);\n}\n\n/* Search & Identity Verification Bar */\n.verification-bar-card {\n  padding: 1.25rem 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.search-input-row {\n  display: flex;\n  gap: 0.75rem;\n}\n\n.verification-result-box {\n  background: #F8FAFC;\n  border: 1px dashed var(--slate-200);\n  border-radius: 10px;\n  padding: 0.75rem 1rem;\n  display: flex;\n  align-items: center;\n}\n\n/* --------------------------------------------------------------------------\n   TAB 4: CITY SUSTAINABILITY ANALYTICS\n   -------------------------------------------------------------------------- */\n.view-grid-analytics {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.analytics-metrics-strip {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));\n  gap: 1.25rem;\n}\n\n.analytics-kpi-card {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 14px;\n  padding: 1.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n}\n\n.analytics-two-col {\n  display: grid;\n  grid-template-columns: 1.5fr 1fr;\n  gap: 1.5rem;\n}\n\n.audit-history-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.6rem;\n  max-height: 280px;\n  overflow-y: auto;\n}\n\n.audit-entry {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.65rem 0.85rem;\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 8px;\n  font-size: 0.75rem;\n}\n\n.audit-entry.latest-entry {\n  border-left: 3px solid var(--emerald);\n  background: #FCFDFD;\n}\n\n.leaderboard-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.leader-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.74rem;\n  padding: 0.35rem 0;\n  border-bottom: 1px solid var(--slate-200);\n}\n\n.gamified-badge {\n  font-size: 0.62rem;\n  font-weight: 700;\n  padding: 0.15rem 0.45rem;\n  border-radius: 6px;\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  display: inline-flex;\n  align-items: center;\n  gap: 0.25rem;\n}\n\n/* --------------------------------------------------------------------------\n   EcoSprout Mascot Container & SVG Component\n   -------------------------------------------------------------------------- */\n.ecosprout-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 1.5rem 1rem;\n  text-align: center;\n  gap: 0.5rem;\n}\n\n.ecosprout-avatar {\n  width: 68px;\n  height: 68px;\n  border-radius: 50%;\n  background: radial-gradient(circle, var(--emerald-light), #D1FAE5);\n  border: 2px solid var(--emerald-border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 4px 14px var(--emerald-glow);\n  animation: sproutBounce 3s ease-in-out infinite;\n}\n\n.ecosprout-avatar svg {\n  width: 48px;\n  height: 48px;\n}\n\n.ecosprout-bubble {\n  background: #FFFFFF;\n  border: 1px solid var(--emerald-border);\n  border-radius: 10px;\n  padding: 0.45rem 0.85rem;\n  font-size: 0.75rem;\n  color: var(--slate-700);\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n  max-width: 280px;\n}\n\n@keyframes sproutBounce {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-6px); }\n}\n\n/* --------------------------------------------------------------------------\n   Enterprise Alert Modals\n   -------------------------------------------------------------------------- */\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(15, 23, 42, 0.45);\n  backdrop-filter: blur(6px);\n  z-index: 10000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 1.5rem;\n}\n\n.modal-overlay.hidden {\n  display: none;\n}\n\n.modal-card {\n  width: 520px;\n  max-width: 95vw;\n  background: #FFFFFF;\n  border-radius: 16px;\n  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.2);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  animation: modalIn 0.28s cubic-bezier(0.16, 1, 0.3, 1);\n  position: relative;\n  z-index: 10001;\n}\n\n.modal-header {\n  padding: 1.1rem 1.5rem;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--slate-100);\n}\n\n.modal-dialog-body {\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.receipt-content {\n  padding: 1.25rem 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.65rem;\n}\n\n.modal-footer {\n  padding: 1rem 1.5rem;\n  display: flex;\n  justify-content: flex-end;\n  gap: 0.75rem;\n  border-top: 1px solid var(--slate-100);\n  background: #F8FAFC;\n}\n\n.receipt-item-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.8rem;\n  color: var(--slate-600);\n}\n.receipt-item-row.bold-row {\n  font-weight: 700;\n  color: var(--slate-900);\n  border-top: 1px dashed var(--slate-300);\n  padding-top: 0.5rem;\n  font-size: 0.9rem;\n}\n\n.modal-stat-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.75rem;\n  margin: 0.5rem 0;\n}\n\n.modal-stat-box {\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 10px;\n  padding: 0.65rem 0.85rem;\n  display: flex;\n  flex-direction: column;\n}\n.modal-stat-box .stat-label {\n  font-size: 0.65rem;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n}\n.modal-stat-box .stat-val {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--slate-900);\n}\n\n/* --------------------------------------------------------------------------\n   Footer & Toasts\n   -------------------------------------------------------------------------- */\n.app-footer {\n  padding: 1.25rem 0.5rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.75rem;\n  color: var(--slate-500);\n  border-top: 1px solid var(--slate-200);\n  flex-wrap: wrap;\n  gap: 0.75rem;\n}\n\n.footer-right {\n  display: flex;\n  gap: 1.25rem;\n}\n\n.toast-container {\n  position: fixed;\n  bottom: 1.5rem;\n  right: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  z-index: 99999;\n}\n\n.toast {\n  padding: 0.75rem 1.25rem;\n  border-radius: 10px;\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-left: 4px solid var(--emerald);\n  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);\n  font-size: 0.8rem;\n  font-weight: 500;\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  color: var(--slate-900);\n  animation: toastIn 0.3s ease-out;\n}\n.toast.toast-emerald { border-left-color: var(--emerald); }\n.toast.toast-blue { border-left-color: var(--electric); }\n.toast.toast-rose { border-left-color: var(--rose); }\n.toast.toast-amber { border-left-color: var(--amber); }\n\n/* Utility classes */\n.text-emerald { color: var(--emerald); }\n.text-electric { color: var(--electric); }\n.text-rose { color: var(--rose); }\n.text-amber { color: var(--amber); }\n.font-bold { font-weight: 700; }\n.font-semibold { font-weight: 600; }\n.flex { display: flex; }\n.items-center { align-items: center; }\n.justify-between { justify-content: space-between; }\n.gap-2 { gap: 0.5rem; }\n.gap-3 { gap: 0.75rem; }\n.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.max-w-\\[42px\\] { max-width: 42px; }\n\n/* --------------------------------------------------------------------------\n   Responsive Layout Adjustments\n   -------------------------------------------------------------------------- */\n@media (max-width: 1200px) {\n  .view-grid-map,\n  .view-grid-passengers,\n  .view-grid-fleet,\n  .analytics-two-col {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 768px) {\n  .app-layout {\n    padding: 1rem 1rem 2rem;\n  }\n  .telemetry-summary-strip {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .app-header {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  .nav-actions {\n    width: 100%;\n    justify-content: flex-start;\n  }\n}\n\n/* Print styling for Eco-Receipt */\n@media print {\n  body * {\n    visibility: hidden;\n  }\n  #receipt-modal-card,\n  #receipt-modal-card * {\n    visibility: visible;\n  }\n  #receipt-modal-card {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 100%;\n    box-shadow: none;\n    border: 1px solid #000;\n  }\n  .modal-footer {\n    display: none;\n  }\n}\n\n@keyframes toastIn {\n  from { opacity: 0; transform: translateY(15px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes modalIn {\n  from { opacity: 0; transform: scale(0.95); }\n  to { opacity: 1; transform: scale(1); }\n}\n","Overwrite":true,"Path":"C:/Users/Kartik Bhosle/.gemini/antigravity/brain/6976d1a8-fd03-4453-a790-acd552e1861a/styles.css"}}]}
