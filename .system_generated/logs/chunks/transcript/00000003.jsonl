02: \n503:   animate() {\n504:     this.flowDashOffset -= 0.6;\n505:     this.render();\n506: \n507:     // Advance transit vehicle along path\n508:     if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n509:     \n<truncated 3007 bytes>\ntx.textBaseline = 'middle';\n595:       ctx.fillText(`${corridor.distance}km`, midX, midY);\n596:       ctx.restore();\n597:     });\n598: \n599:     // Draw Stations (Sorted by Z for depth)\n600:     const sorted = [...TRANSIT_STATIONS].map(s => ({\n601:       station: s,\n602:       proj: this.project(s.x, s.y, s.z)\n603:     })).sort((a, b) => b.proj.z - a.proj.z);\n604: \n605:     sorted.forEach(({ station, proj }) => {\n606:       const isPath = this.activeCorridorPath.includes(station.id);\n607:       const isHovered = this.hoveredStation && this.hoveredStation.id === station.id;\n608: \n609:       ctx.save();\n610: \n611:       // Floor Shadow\n612:       const floorProj = this.project(station.x, station.y, -30);\n613:       ctx.beginPath();\n614:       ctx.ellipse(floorProj.x, floorProj.y, 14 * proj.scale, 7 * proj.scale, 0, 0, Math.PI * 2);\n615:       ctx.fillStyle = 'rgba(15, 23, 42, 0.08)';\n616:       ctx.fill();\n617: \n618:       // Elevation Stem\n619:       ctx.beginPath();\n620:       ctx.moveTo(floorProj.x, floorProj.y);\n621:       ctx.lineTo(proj.x, proj.y);\n622:       ctx.strokeStyle = isPath ? 'rgba(5, 150, 105, 0.6)' : '#CBD5E1';\n623:       ctx.lineWidth = 1.5;\n624:       ctx.setLineDash([2, 3]);\n625:       ctx.stroke();\n626:       ctx.setLineDash([]);\n627: \n628:       // Station Circle\n629:       ctx.beginPath();\n630:       const radius = (isHovered ? 14 : 11) * proj.scale;\n631:       ctx.arc(proj.x, proj.y, radius, 0, Math.PI * 2);\n632: \n633:       if (isPath) {\n634:         ctx.fillStyle = '#059669';\n635:         ctx.shadowColor = 'rgba(5, 150, 105, 0.4)';\n636:         ctx.shadowBlur = 14;\n637:       } else if (isHovered) {\n638:         ctx.fillStyle = '#2563EB';\n639:         ctx.shadowColor = 'rgba(37, 99, 235, 0.4)';\n640:         ctx.shadowBlur = 12;\n641:       } else {\n642:         ctx.fillStyle = '#FFFFFF';\n643:         ctx.strokeStyle = '#059669';\n644:         ctx.lineWidth = 2.5;\n645:         ctx.stroke();\n646:       }\n647:       ctx.fill();\n648:       ctx.restore();\n649: \n650:       // Station Label & Zone","truncated_fields":["content"]}
