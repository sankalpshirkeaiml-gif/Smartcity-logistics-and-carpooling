age}</span>`;\n  container.appendChild(toast);\n\n  setTimeout(() => {\n    toast.style.opacity = '0';\n    toast.style.transform = 'translateY(15px)';\n    setTimeout(() => toast.remove(), 300);\n  }, 3500);\n}\n\n// Global hook for deleting rides\nwindow.handleCancelRide = function(rideId) {\n  const deleted = engine.removeActiveRide(rideId);\n  if (deleted) {\n    showToast(`Ride #${rideId} completed/cancelled and removed from DLL & BST.`, 'purple');\n    updateAllUI();\n  }\n};\n\n// ==========================================\n// 6. C++ CODE INSPECTION SNIPPETS\n// ==========================================\nconst CPP_CODE_SNIPPETS = {\n  'tab-graph': `// 1. Graph Adjacency List & Dijkstra Algorithm with Min-Heap\n#include <iostream>\n#include <vector>\n#include <queue>\nusing namespace std;\n\ntypedef pair<int, string> EdgeWeightPair; // <distance, node_id>\n\nstruct CityGraph {\n    unordered_map<string, vector<pair<string, int>>> adjList;\n\n    void addEdge(const string& u, const string& v, int weight) {\n        adjList[u].push_back({v, weight});\n        adjList[v].push_back({u, weight});\n    }\n\n    void dijkstra(const string& source, const string& dest) {\n        priority_queue<EdgeWeightPair, vector<EdgeWeightPair>, greater<EdgeWeightPair>> minHeap;\n        unordered_map<string, int> dist;\n        unordered_map<string, string> parent;\n\n        for (auto& pair : adjList) dist[pair.first] = INT_MAX;\n        dist[source] = 0;\n        minHeap.push({0, source});\n\n        while (!minHeap.empty()) {\n            int d = minHeap.top().first;\n            string u = minHeap.top().second;\n            minHeap.pop();\n\n            if (u == dest) break;\n            if (d > dist[u]) continue;\n\n            for (auto& edge : adjList[u]) {\n                string v = edge.first;\n                int weight = edge.second;\n                if (dist[u] + weight < dist[v]) {\n                    dist[v] = dist[u] + weight;\n                    parent[v] = u;\n                    minHeap.push({dist[v], v}); // Push relaxed vertex\n                }\n            }\n        }\n    }\n};`,\n\n  'tab-queues': `// 2. FIFO Passenger Queue & Fixed Circular Buffer Queue\n#include <iostream>\nusing namespace std;\n\nstruct Passenger {\n    string id, name, pickup, drop;\n};\n\n// Circular Queue with fixed array buffer\nclass CircularWaitlistQueue {\nprivate:\n    Passenger array[5];\n    int front = 0;\n    int rear = 0;\n    int count = 0;\n    const int CAPACITY = 5;\n\npublic:\n    bool isFull() { return count == CAPACITY; }\n    bool isEmpty() { return count == 0; }\n\n    bool enqueue(Passenger p) {\n        if (isFull()) return false; // OVERFLOW\n        array[rear] = p;\n        rear = (rear + 1) % CAPACITY;\n        count++;\n        return true;\n    }\n\n    Passenger dequeue() {\n        if (isEmpty()) throw runtime_error(\"Underflow\");\n        Passenger item = array[front];\n        front = (front + 1) % CAPACITY;\n        count--;\n        return item;\n    }\n};`,\n\n  'tab-linkedlists': `// 3. Singly Linked List (Driver Catalog) & Doubly Linked List (Active Rides)\n#include <iostream>\nusing namespace std;\n\n// Singly Linked List Node\nstruct DriverNode {\n    int id;\n    string name, location;\n    int seats;\n    DriverNode* next = nullptr;\n};\n\n// Doubly Linked List Node for Active Rides with O(1) Deletion\nstruct ActiveRideNode {\n    int rideId;\n    string passengerName;\n    int driverId;\n    int distance;\n    ActiveRideNode* prev = nullptr;\n    ActiveRideNode* next = nullptr;\n\n    ActiveRideNode(int rId, string pName, int dId, int dist) \n        : rideId(rId), passengerName(pName), driverId(dId), distance(dist) {}\n};\n\nclass ActiveRideDoublyList {\npublic:\n    ActiveRideNode* head = nullptr;\n    ActiveRideNode* tail = nullptr;\n\n    void insertEnd(ActiveRideNode* newNode) {\n        if (!head) {\n            head = tail = newNode;\n        } else {\n            tail->next = newNode;\n            newNode->prev = tail;\n            tail = newNode;\n        }\n    }\n\n    void remove(ActiveRideNode* node) {\n        if (node->prev) node->prev->next = node->next;\n        else head = node->next;\n\n        if (node->next) node->next->prev = node->prev;\n        else tail = node->prev;\n\n        delete node;\n    }\n};`,\n\n  'tab-hashtable': `// 4. Hash Table with Separate Chaining for Driver ID Lookup\n#include <iostream>\n#include <vector>\n#include <list>\nusing namespace std;\n\nclass DriverHashTable {\nprivate:\n    static const int BUCKET_COUNT = 6;\n    list<DriverNode> table[BUCKET_COUNT];\n\n    int hashFunction(int driverId) {\n        return driverId % BUCKET_COUNT;\n    }\n\npublic:\n    void insertDriver(const DriverNode& driver) {\n        int index = hashFunction(driver.id);\n        table[index].push_back(driver);\n    }\n\n    DriverNode* searchDriver(int driverId) {\n        int index = hashFunction(driverId);\n        for (auto& driver : table[index]) {\n            if (driver.id == driverId) return &driver;\n        }\n        return nullptr; // Not found\n    }\n};`,\n\n  'tab-bst': `// 5. Binary Search Tree (BST) Sorted by Ride ID\n#include <iostream>\nusing namespace std;\n\nstruct BSTNode {\n    int rideId;\n    ActiveRideNode* rideRef;\n    BSTNode* left = nullptr;\n    BSTNode* right = nullptr;\n\n    BSTNode(int id, ActiveRideNode* ref) : rideId(id), rideRef(ref) {}\n};\n\nclass RideBST {\npublic:\n    BSTNode* root = nullptr;\n\n    BSTNode* insert(BSTNode* node, int rideId, ActiveRideNode* ref) {\n        if (!node) return new BSTNode(rideId, ref);\n        if (rideId < node->rideId) node->left = insert(node->left, rideId, ref);\n        else node->right = insert(node->right, rideId, ref);\n        return node;\n    }\n\n    void inOrder(BSTNode* node) {\n        if (!node) return;\n        inOrder(node->left);\n        cout << node->rideId << \" \";\n        inOrder(node->right);\n    }\n};`,\n\n  'tab-stack': `// 6. Stack LIFO Undo System\n#include <iostream>\n#include <stack>\nusing namespace std;\n\nstruct UndoAction {\n    string type; // \"CONFIRM_RIDE\"\n    int rideId;\n    int driverId;\n    Passenger passenger;\n};\n\nclass RideUndoManager {\nprivate:\n    stack<UndoAction> undoStack;\n\npublic:\n    void recordConfirmation(int rideId, int driverId, Passenger p) {\n        undoStack.push({\"CONFIRM_RIDE\", rideId, driverId, p});\n    }\n\n    bool undoLatest(ActiveRideDoublyList& activeList, DriverHashTable& drivers) {\n        if (undoStack.empty()) return false;\n        UndoAction lastAction = undoStack.top();\n        undoStack.pop();\n\n        // 1. Remove active ride from Doubly Linked List\n        // 2. Restore driver seat count\n        // 3. Re-queue passenger into front of FIFO queue\n        return true;\n    }\n};`\n};\n\n// ==========================================\n// 7. INITIALIZATION & EVENT LISTENERS\n// ==========================================\ndocument.addEventListener('DOMContentLoaded', () => {\n  const cityCanvas = new City3DCanvas('city-3d-canvas');\n\n  // Populate Select Boxes\n  const sourceSel = document.getElementById('route-source');\n  const destSel = document.getElementById('route-dest');\n  const passPickup = document.getElementById('pass-pickup-select');\n  const passDrop = document.getElementById('pass-drop-select');\n  const driverLoc = document.getElementById('driver-location-select');\n\n  CITY_NODES.forEach(n => {\n    const opt = `<option value=\"${n.id}\">${n.name} (${n.id})</option>`;\n    sourceSel.insertAdjacentHTML('beforeend', opt);\n    destSel.insertAdjacentHTML('beforeend', opt);\n    passPickup.insertAdjacentHTML('beforeend', opt);\n    passDrop.insertAdjacentHTML('beforeend', opt);\n    driverLoc.insertAdjacentHTML('beforeend', opt);\n  });\n\n  sourceSel.value = 'ALPHA';\n  destSel.value = 'HORIZON';\n  passPickup.value = 'ALPHA';\n  passDrop.value = 'HORIZON';\n  driverLoc.value = 'METRO';\n\n  // --- Run Dijkstra Button ---\n  document.getElementById('btn-run-dijkstra').addEventListener('click', () => {\n    const src = sourceSel.value;\n    const dst = destSel.value;\n\n    if (src === dst) {\n      showToast('Source and Destination cannot be the same node.', 'rose');\n      return;\n    }\n\n    const result = engine.runDijkstra(src, dst);\n    cityCanvas.setHighlightPath(result.path);\n\n    const costSummary = document.getElementById('route-cost-summary');\n    costSummary.textContent = `Path: ${result.path.join(' -> ')} (Cost: ${result.totalCost} km)`;\n\n    // Render Min-Heap trace strip\n    const heapStrip = document.getElementById('minheap-visual-strip');\n    heapStrip.innerHTML = result.traceSteps.map((step, idx) => `\n      <div class=\"heap-pill ${idx === 0 ? 'active' : ''}\">\n        <i class=\"fa-solid fa-angles-down\"></i> Pop: <b>${step.extracted}</b> (${step.dist}km)\n        ${step.heapSnapshot.length > 0 ? `<span class=\"text-slate-400\">| Q: [${step.heapSnapshot.map(h => `${h.node}:${h.dist}`).join(', ')}]</span>` : ''}\n      </div>\n    `).join('');\n\n    showToast(`Dijkstra Min-Heap computed optimal path in ${result.traceSteps.length} relaxation steps.`, 'cyan');\n  });\n\n  document.getElementById('btn-reset-graph-cam').addEventListener('click', () => {\n    cityCanvas.resetCamera();\n  });\n\n  // --- Enqueue Passenger ---\n  document.getElementById('btn-enqueue-passenger').addEventListener('click', () => {\n    const nameInput = document.getElementById('pass-name-input');\n    const name = nameInput.value.trim() || `Passenger_${Math.floor(Math.random() * 900 + 100)}`;\n    const pickup = passPickup.value;\n    const drop = passDrop.value;\n\n    if (pickup === drop) {\n      showToast('Pickup and drop-off cannot be the same city hub.', 'rose');\n      return;\n    }\n\n    const passenger = engine.enqueuePassenger(name, pickup, drop);\n    nameInput.value = '';\n    updateAllUI();\n    showToast(`Enqueued ${passenger.name} (${pickup} -> ${drop}) into FIFO Queue.`, 'cyan');\n  });\n\n  // --- Dequeue Passenger ---\n  document.getElementById('btn-dequeue-passenger').addEventListener('click', () => {\n    const popped = engine.dequeuePassenger();\n    if (popped) {\n      updateAllUI();\n      showToast(`Dequeued front passenger: ${popped.name} (${popped.id}).`, 'amber');\n    } else {\n      showToast('Passenger FIFO Queue is currently empty.', 'rose');\n    }\n  });\n\n  // --- Circular Queue Buttons ---\n  document.getElementById('btn-circ-enqueue').addEventListener('click', () => {\n    // Take front passenger from queue or create waiting passenger\n    let candidate = engine.dequeuePassenger();\n    if (!candidate) {\n      candidate = {\n        id: `P-WAIT-${Math.floor(Math.random() * 800 + 100)}`,\n        name: `Standby_${Math.floor(Math.random() * 90 + 10)}`,\n        pickup: 'METRO',\n        drop: 'SKYPORT',\n        timestamp: new Date().toLocaleTimeString()\n      };\n    }\n\n    const res = engine.circularEnqueue(candidate);\n    if (!res.success) {\n      showToast(res.reason, 'rose');\n      // If we dequeued them, put them back\n      engine.passengerQueue.unshift(candidate);\n    } else {\n      showToast(`Added ${candidate.name} to 3D Circular Buffer Array Slot.`, 'amber');\n    }\n    updateAllUI();\n  });\n\n  document.getElementById('btn-circ-dequeue').addEventListener('click', () => {\n    const res = engine.circularDequeue();\n    if (!res.success) {\n      showToast(res.reason, 'rose');\n    } else {\n      showToast(`Popped ${res.item.name} from Circular Waitlist.`, 'amber');\n    }\n    updateAllUI();\n  });\n\n  // --- Register Driver ---\n  document.getElementById('btn-register-driver').addEventListener('click', () => {\n    const nameInput = document.getElementById('driver-name-input');\n    const seatsInput = document.getElementById('driver-seats-input');\n    const name = nameInput.value.trim() || `Driver_${Math.floor(Math.random() * 900 + 100)}`;\n    const location = driverLoc.value;\n    const seats = parseInt(seatsInput.value, 10) || 4;\n\n    const newDriver = engine.registerDriver(name, location, seats);\n    nameInput.value = '';\n    updateAllUI();\n    showToast(`Driver ${newDriver.name} registered (ID: ${newDriver.id}) -> Added to Singly LL & Hash Bucket [${newDriver.id % engine.hashBucketSize}].`, 'emerald');\n  });\n\n  // --- Hash Search ---\n  document.getElementById('btn-hash-search').addEventListener('click', () => {\n    const searchId = document.getElementById('hash-search-id').value;\n    if (!searchId) return;\n\n    const bucketIdx = parseInt(searchId, 10) % engine.hashBucketSize;\n    // Highlight bucket card\n    document.querySelectorAll('.hash-bucket-card').forEach(b => b.classList.remove('highlight'));\n    const targetCard = document.getElementById(`hash-bucket-${bucketIdx}`);\n    if (targetCard) targetCard.classList.add('highlight');\n\n    const driver = engine.findDriverById(searchId);\n    if (driver) {\n      showToast(`Hash O(1) Hit in Bucket [${bucketIdx}]: ${driver.name} (Location: ${driver.location}, Seats: ${driver.seats})`, 'cyan');\n    } else {\n      showToast(`Hash Search: Driver ID ${searchId} not found in Bucket [${bucketIdx}].`, 'rose');\n    }\n  });\n\n  // --- Confirm & Match Ride ---\n  document.getElementById('btn-match-instant').addEventListener('click', () => {\n    // Get passenger (FIFO queue or Circular buffer)\n    let passenger = engine.dequeuePassenger();\n    if (!passenger && engine.circularSize > 0) {\n      passenger = engine.circularDequeue().item;\n    }\n\n    if (!passenger) {\n      showToast('No passengers waiting in Queue or Circular Buffer to match!', 'rose');\n      return;\n    }\n\n    // Find available driver\n    let matchedDriver = null;\n    let curr = engine.driverHead;\n    while (curr) {\n      if (curr.seats > 0) {\n        matchedDriver = curr;\n        break;\n      }\n      curr = curr.next;\n    }\n\n    if (!matchedDriver) {\n      // Put passenger back\n      engine.passengerQueue.unshift(passenger);\n      showToast('All registered drivers are full or fleet is empty. Register a driver first!', 'rose');\n      return;\n    }\n\n    // Compute route distance with Dijkstra\n    const routeRes = engine.runDijkstra(passenger.pickup, passenger.drop);\n    const ride = engine.addActiveRide(passenger, matchedDriver, routeRes.path, routeRes.totalCost);\n\n    cityCanvas.setHighlightPath(routeRes.path);\n    updateAllUI();\n    showToast(`Ride #${ride.rideId} matched! Inserted into Doubly LL, BST, and Stack.`, 'purple');\n  });\n\n  // --- Undo Ride (Stack Pop) ---\n  document.getElementById('btn-undo-ride').addEventListener('click', () => {\n    const res = engine.undoLatestRide();\n    if (!res.success) {\n      showToast(res.reason, 'rose');\n    } else {\n      showToast(`Undone Ride #${res.action.rideId}: Restored driver #${res.action.driverId} seats & pushed passenger back to Queue.`, 'rose');\n      updateAllUI();\n    }\n  });\n\n  // --- Preset City Demo Loader ---\n  document.getElementById('btn-demo-preset').addEventListener('click', () => {\n    // Pre-populate with realistic city traffic\n    engine.registerDriver('Marcus Vance', 'ALPHA', 3);\n    engine.registerDriver('Elena Rostova', 'METRO', 4);\n    engine.registerDriver('Kaelen Chen', 'SKYPORT', 2);\n    engine.registerDriver('Siddharth Rao', 'QUANTUM', 4);\n\n    engine.enqueuePassenger('Sarah Connor', 'ALPHA', 'HORIZON');\n    engine.enqueuePassenger('Liam Dawson', 'METRO', 'SKYPORT');\n    engine.enqueuePassenger('Amara Okafor', 'HARBOR', 'QUANTUM');\n\n    engine.circularEnqueue({\n      id: 'P-CIRC-01',\n      name: 'Waitlist Taro',\n      pickup: 'HARBOR',\n      drop: 'HORIZON',\n      timestamp: new Date().toLocaleTimeString()\n    });\n\n    // Run sample match\n    const p1 = engine.dequeuePassenger();\n    const d1 = engine.driverHead;\n    const r1 = engine.runDijkstra(p1.pickup, p1.drop);\n    engine.addActiveRide(p1, d1, r1.path, r1.totalCost);\n\n    cityCanvas.setHighlightPath(r1.path);\n    updateAllUI();\n    showToast('Loaded dynamic city scenario with live drivers, queues, and matched routes!', 'emerald');\n  });\n\n  // --- Code Inspector Drawer Tabs ---\n  const codeOverlay = document.getElementById('code-drawer-overlay');\n  const codeDisplay = document.getElementById('code-display');\n  const tabBtns = document.querySelectorAll('.tab-btn');\n\n  document.getElementById('btn-toggle-cpp-code').addEventListener('click', () => {\n    codeOverlay.classList.remove('hidden');\n    codeDisplay.textContent = CPP_CODE_SNIPPETS['tab-graph'];\n  });\n\n  document.getElementById('btn-close-drawer').addEventListener('click', () => {\n    codeOverlay.classList.add('hidden');\n  });\n\n  codeOverlay.addEventListener('click', (e) => {\n    if (e.target === codeOverlay) codeOverlay.classList.add('hidden');\n  });\n\n  tabBtns.forEach(btn => {\n    btn.addEventListener('click', () => {\n      tabBtns.forEach(b => b.classList.remove('active'));\n      btn.classList.add('active');\n      const tabKey = btn.dataset.tab;\n      codeDisplay.textContent = CPP_CODE_SNIPPETS[tabKey] || '// Code snippet loading...';\n    });\n  });\n\n  // Initial UI Render & Tilt Bind\n  updateAllUI();\n  bindTiltElements();\n});\n","Description":"Created app.js implementing the full interactive C++ DSA simulation engine, 3D canvas projection, tilt physics, Dijkstra router, FIFO & circular queues, driver fleet lists, hash tables, and BST.","Overwrite":true,"TargetFile":"C:\\Users\\Kartik Bhosle\\.gemini\\antigravity\\brain\\6976d1a8-fd03-4453-a790-acd552e1861a\\app.js","toolAction":"Writing JavaScript file","toolSummary":"Create app.js in artifacts directory"}}]}
