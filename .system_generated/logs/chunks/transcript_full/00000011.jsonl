\n297:   initParticles() {\n298:     this.particles = [];\n299:     for (let i = 0; i < this.numParticles; i++) {\n300:       this.particles.push({\n301:         x: Math.random() * this.width,\n302:         y: Math.random() * this.height,\n303:         size: Math.random() * 8 + 4,\n304:         speedY: -(Math.random() * 0.45 + 0.15),\n305:         speedX: Math.sin(Math.random() * Math.PI) * 0.25,\n306:         rotation: Math.random() * Math.PI * 2,\n307:         rotSpeed: (Math.random() - 0.5) * 0.015,\n308:         type: Math.random() > 0.45 ? 'leaf' : 'node',\n309:         opacity: Math.random() * 0.4 + 0.15\n310:       });\n311:     }\n312:   }\n313: \n314:   animate() {\n315:     this.ctx.clearRect(0, 0, this.width, this.height);\n316: \n317:     this.particles.forEach(p => {\n318:       p.y += p.speedY;\n319:       p.x += p.speedX + Math.sin(p.y * 0.01) * 0.2;\n320:       p.rotation += p.rotSpeed;\n321: \n322:       // Wrap around\n323:       if (p.y < -20) {\n324:         p.y = this.height + 20;\n325:         p.x = Math.random() * this.width;\n326:       }\n327:       if (p.x < -20) p.x = this.width + 20;\n328:       if (p.x > this.width + 20) p.x = -20;\n329: \n330:       this.ctx.save();\n331:       this.ctx.translate(p.x, p.y);\n332:       this.ctx.rotate(p.rotation);\n333: \n334:       if (p.type === 'leaf') {\n335:         // Draw delicate eco-leaf\n336:         this.ctx.fillStyle = `rgba(5, 150, 105, ${p.opacity * 0.55})`;\n337:         this.ctx.beginPath();\n338:         this.ctx.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);\n339:         this.ctx.fill();\n340: \n341:         // Leaf stem line\n342:         this.ctx.strokeStyle = `rgba(5, 150, 105, ${p.opacity * 0.7})`;\n343:         this.ctx.lineWidth = 0.8;\n344:         this.ctx.beginPath();\n345:         this.ctx.moveTo(-p.size, 0);\n346:         this.ctx.lineTo(p.size, 0);\n347:         this.ctx.stroke();\n348:       } else {\n349:         // Light glowing electric energy node\n350:         this.ctx.fillStyle = `rgba(37, 99, 235, ${p.opacity * 0.45})`;\n351:         this.ctx.beginPath();\n352:         this.ctx.arc(0, 0, p.size * 0.4, 0, Math.PI * 2);\n353:         this.ctx.fill();\n354:       }\n355: \n356:       this.ctx.restore();\n357:     });\n358: \n359:     requestAnimationFrame(() => this.animate());\n360:   }\n361: }\n362: \n363: // ==========================================\n364: // 4. 3D SPATIAL METROPOLITAN CANVAS MAP\n365: // WITH DIRECTIONAL CORRIDORS & ANIMATED TRANSIT VEHICLE\n366: // ==========================================\n367: class Urban3DCanvas {\n368:   constructor(canvasId) {\n369:     this.canvas = document.getElementById(canvasId);\n370:     // FIX: Null guard — prevent crash if canvas element is missing from DOM\n371:     if (!this.canvas) return;\n372:     this.ctx = this.canvas.getContext('2d');\n373:     this.wrapper = this.canvas.parentElement;\n374: \n375:     this.rotX = 0.45;\n376:     this.rotY = -0.32;\n377:     this.scale = 1.08;\n378: \n379:     this.isDragging = false;\n380:     this.lastMouseX = 0;\n381:     this.lastMouseY = 0;\n382: \n383:     this.activeCorridorPath = [];\n384:     this.hoveredStation = null;\n385: \n386:     // Animated Car along active path\n387:     this.carProgress = 0; // 0 to (path.length - 1)\n388:     this.carSpeed = 0.0085;\n389:     this.isCarDriving = false;\n390:     this.flowDashOffset = 0;\n391: \n392:     this.initEvents();\n393:     this.resize();\n394:     window.addEventListener('resize', () => this.resize());\n395:     this.animate();\n396:   }\n397: \n398:   resize() {\n399:     if (!this.wrapper) return;\n400:     this.width = this.wrapper.clientWidth || 800;\n401:     this.height = this.wrapper.clientHeight || 420;\n402:     this.canvas.width = this.width * window.devicePixelRatio;\n403:     this.canvas.height = this.height * window.devicePixelRatio;\n404:     // FIX: Reset transform before applying scale to prevent accumulation on repeated resize calls\n405:     this.ctx.setTransform(window.devicePixelRatio, 0, 0, window.devicePixelRatio, 0, 0);\n406:   }\n407: \n408:   initEvents() {\n409:     this.canvas.addEventListener('mousedown', (e) => {\n410:       this.isDragging = true;\n411:       this.lastMouseX = e.clientX;\n412:       this.lastMouseY = e.clientY;\n413:     });\n414: \n415:     window.addEventListener('mouseup', () => {\n416:       this.isDragging = false;\n417:     });\n418: \n419:     this.canvas.addEventListener('mousemove', (e) => {\n420:       if (this.isDragging) {\n421:         const deltaX = e.clientX - this.lastMouseX;\n422:         const deltaY = e.clientY - this.lastMouseY;\n423:         this.rotY += deltaX * 0.007;\n424:         this.rotX += deltaY * 0.007;\n425:         this.rotX = Math.max(0.12, Math.min(1.2, this.rotX));\n426:         this.lastMouseX = e.clientX;\n427:         this.lastMouseY = e.clientY;\n428:       }\n429:       this.checkHover(e);\n430:     });\n431: \n432:     this.canvas.addEventListener('wheel', (e) => {\n433:       e.preventDefault();\n434:       this.scale += e.deltaY * -0.001;\n435:       this.scale = Math.max(0.65, Math.min(1.85, this.scale));\n436:     });\n437:   }\n438: \n439:   checkHover(e) {\n440:     const rect = this.canvas.getBoundingClientRect();\n441:     const mouseX = e.clientX - rect.left;\n442:     const mouseY = e.clientY - rect.top;\n443: \n444:     let found = null;\n445:     TRANSIT_STATIONS.forEach(s => {\n446:       const p = this.project(s.x, s.y, s.z);\n447:       const dist = Math.hypot(p.x - mouseX, p.y - mouseY);\n448:       if (dist < 22) {\n449:         found = s;\n450:       }"}
