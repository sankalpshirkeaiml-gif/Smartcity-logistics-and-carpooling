{"step_index":240,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-21T10:31:56Z","input_tokens":3243,"cache_read_tokens":178381,"output_tokens":13405,"tool_calls":[{"name":"write_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Enterprise typographic hierarchy, padding, and spacing enhancements for NexusMobility to look like a high-end Silicon Valley / European mobility platform (Tesla / Apple Mobility level styling).","UserFacing":true},"Content":"/* ==========================================================================\n   NEXUSMOBILITY — MULTI-TABBED ENTERPRISE ECO-TECH DESIGN SYSTEM\n   Professional Enterprise Polish: Generous Breathing Room, High-End Typography,\n   Micro-Glassmorphic Layering, and Consistent Spatial Grid Padding.\n   ========================================================================== */\n\n:root {\n  --bg-primary: #F8FAFC;\n  --bg-surface: #F1F5F9;\n  --bg-card: #FFFFFF;\n  --bg-card-hover: #FCFDFD;\n  --border-light: #E2E8F0;\n  --border-subtle: #F1F5F9;\n  --border-emerald-glow: rgba(5, 150, 105, 0.4);\n  --border-blue-glow: rgba(37, 99, 235, 0.35);\n\n  --emerald: #059669;\n  --emerald-dark: #047857;\n  --emerald-light: #ECFDF5;\n  --emerald-border: #A7F3D0;\n  --emerald-glow: rgba(5, 150, 105, 0.18);\n\n  --electric: #2563EB;\n  --electric-dark: #1D4ED8;\n  --electric-light: #EFF6FF;\n  --electric-border: #BFDBFE;\n  --electric-glow: rgba(37, 99, 235, 0.18);\n\n  --amber: #D97706;\n  --amber-light: #FFFBEB;\n  --amber-border: #FDE68A;\n\n  --purple: #7C3AED;\n  --purple-light: #F5F3FF;\n  --purple-border: #DDD6FE;\n\n  --rose: #E11D48;\n  --rose-light: #FFF1F2;\n  --rose-border: #FECDD3;\n\n  --slate-900: #0F172A;\n  --slate-800: #1E293B;\n  --slate-700: #334155;\n  --slate-600: #475569;\n  --slate-500: #64748B;\n  --slate-400: #94A3B8;\n  --slate-300: #CBD5E1;\n  --slate-200: #E2E8F0;\n  --slate-100: #F1F5F9;\n  --slate-50: #F8FAFC;\n\n  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  --font-mono: 'JetBrains Mono', monospace;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  font-size: 15px;\n}\n\nbody {\n  background-color: var(--bg-primary);\n  color: var(--slate-800);\n  font-family: var(--font-sans);\n  min-height: 100vh;\n  overflow-x: hidden;\n  position: relative;\n  line-height: 1.6;\n  -webkit-font-smoothing: antialiased;\n  -moz-osx-font-smoothing: grayscale;\n}\n\n/* Ambient Canvas Background Layer */\n#ambient-canvas {\n  position: fixed;\n  inset: 0;\n  width: 100vw;\n  height: 100vh;\n  pointer-events: none;\n  z-index: 0;\n  opacity: 0.85;\n}\n\n/* Custom Scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: var(--slate-100);\n}\n::-webkit-scrollbar-thumb {\n  background: var(--slate-300);\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--emerald);\n}\n\n/* --------------------------------------------------------------------------\n   Layout Shell & Executive Polish\n   -------------------------------------------------------------------------- */\n.app-layout {\n  max-width: 1680px;\n  margin: 0 auto;\n  padding: 2rem 2.5rem 4rem;\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n  position: relative;\n  z-index: 1;\n}\n\n.white-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 20px;\n  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04), 0 1px 3px 0 rgba(15, 23, 42, 0.02);\n  position: relative;\n  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;\n}\n\n.eco-card-hover {\n  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;\n}\n.eco-card-hover:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 14px 30px -6px rgba(5, 150, 105, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.04);\n  border-color: var(--border-emerald-glow);\n}\n\n/* --------------------------------------------------------------------------\n   Top Navigation Header Bar\n   -------------------------------------------------------------------------- */\n.app-header {\n  padding: 1.25rem 2.25rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 1.5rem;\n}\n\n.brand-section {\n  display: flex;\n  align-items: center;\n  gap: 1.25rem;\n}\n\n.brand-icon {\n  width: 52px;\n  height: 52px;\n  border-radius: 14px;\n  background: var(--emerald-light);\n  border: 1.5px solid var(--emerald-border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.5rem;\n  box-shadow: 0 4px 16px var(--emerald-glow);\n  flex-shrink: 0;\n}\n\n.brand-title-wrap {\n  display: flex;\n  flex-direction: column;\n  gap: 0.2rem;\n}\n\n.brand-title {\n  font-size: 1.5rem;\n  font-weight: 800;\n  letter-spacing: -0.025em;\n  color: var(--slate-900);\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n  line-height: 1.2;\n}\n\n.brand-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  padding: 0.25rem 0.65rem;\n  border-radius: 9999px;\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n\n.brand-tagline {\n  font-size: 0.775rem;\n  color: var(--slate-500);\n  font-weight: 500;\n  letter-spacing: 0.03em;\n  text-transform: uppercase;\n}\n\n.nav-actions {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  flex-wrap: wrap;\n}\n\n/* --------------------------------------------------------------------------\n   Executive KPI Ribbon\n   -------------------------------------------------------------------------- */\n.kpi-banner {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 1.5rem;\n}\n\n.kpi-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 18px;\n  padding: 1.35rem 1.6rem;\n  display: flex;\n  align-items: center;\n  gap: 1.35rem;\n  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.02);\n}\n\n.kpi-icon-wrap {\n  width: 54px;\n  height: 54px;\n  border-radius: 14px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.45rem;\n  flex-shrink: 0;\n}\n\n.bg-emerald-light { background: var(--emerald-light); border: 1px solid var(--emerald-border); }\n.bg-blue-light { background: var(--electric-light); border: 1px solid var(--electric-border); }\n.bg-amber-light { background: var(--amber-light); border: 1px solid var(--amber-border); }\n.bg-purple-light { background: var(--purple-light); border: 1px solid var(--purple-border); }\n\n.kpi-content {\n  display: flex;\n  flex-direction: column;\n  gap: 0.15rem;\n}\n\n.kpi-label {\n  font-size: 0.7rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.07em;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n}\n\n.kpi-value {\n  font-size: 1.65rem;\n  font-weight: 800;\n  color: var(--slate-900);\n  line-height: 1.15;\n  letter-spacing: -0.02em;\n}\n\n.kpi-unit {\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: var(--slate-500);\n  letter-spacing: 0;\n}\n\n.kpi-subtext {\n  font-size: 0.775rem;\n  color: var(--slate-500);\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n  margin-top: 0.15rem;\n}\n\n/* --------------------------------------------------------------------------\n   Tab Navigation Bar\n   -------------------------------------------------------------------------- */\n.tab-navbar {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 16px;\n  padding: 0.65rem 0.85rem;\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.02);\n  overflow-x: auto;\n}\n\n.tab-trigger {\n  background: transparent;\n  border: none;\n  font-family: var(--font-sans);\n  font-size: 0.9rem;\n  font-weight: 600;\n  color: var(--slate-600);\n  padding: 0.8rem 1.45rem;\n  border-radius: 12px;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.75rem;\n  transition: all 0.2s ease;\n  white-space: nowrap;\n  letter-spacing: -0.01em;\n}\n\n.tab-trigger:hover {\n  background: var(--slate-100);\n  color: var(--slate-900);\n}\n\n.tab-trigger.active {\n  background: var(--emerald-light);\n  color: var(--emerald-dark);\n  border: 1px solid var(--emerald-border);\n  box-shadow: 0 2px 10px var(--emerald-glow);\n  font-weight: 700;\n}\n\n.tab-badge {\n  font-size: 0.7rem;\n  font-weight: 700;\n  padding: 0.2rem 0.55rem;\n  border-radius: 9999px;\n  background: var(--slate-200);\n  color: var(--slate-700);\n}\n.tab-trigger.active .tab-badge {\n  background: var(--emerald);\n  color: #FFFFFF;\n}\n\n/* Tab Views Container */\n.tab-content-container {\n  position: relative;\n  min-height: 580px;\n}\n\n.tab-view {\n  display: none;\n  animation: tabFadeIn 0.24s cubic-bezier(0.16, 1, 0.3, 1);\n}\n.tab-view.active {\n  display: block;\n}\n\n@keyframes tabFadeIn {\n  from { opacity: 0; transform: translateY(8px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* --------------------------------------------------------------------------\n   TAB 1: ECO-ROUTE FINDER & MAP\n   -------------------------------------------------------------------------- */\n.view-grid-map {\n  display: grid;\n  grid-template-columns: 440px 1fr;\n  gap: 2rem;\n  align-items: start;\n}\n\n.route-selector-panel {\n  padding: 2.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.75rem;\n}\n\n.card-header-clean {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  padding-bottom: 1.15rem;\n  border-bottom: 1px solid var(--slate-100);\n  gap: 1rem;\n}\n\n.card-title {\n  font-size: 1.15rem;\n  font-weight: 700;\n  color: var(--slate-900);\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  letter-spacing: -0.015em;\n  line-height: 1.3;\n}\n\n.card-subtitle {\n  font-size: 0.8rem;\n  color: var(--slate-500);\n  margin-top: 0.35rem;\n  line-height: 1.5;\n}\n\n.route-form-fields {\n  display: flex;\n  flex-direction: column;\n  gap: 1.35rem;\n}\n\n.field-group {\n  display: flex;\n  flex-direction: column;\n  gap: 0.55rem;\n}\n\n.field-label {\n  font-size: 0.8rem;\n  font-weight: 600;\n  color: var(--slate-700);\n  display: flex;\n  align-items: center;\n  gap: 0.45rem;\n  letter-spacing: -0.005em;\n}\n\n.route-interchange-row {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: -0.35rem 0;\n}\n\n.btn-icon-circle {\n  width: 40px;\n  height: 40px;\n  border-radius: 50%;\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  color: var(--slate-600);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.22s ease;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);\n}\n.btn-icon-circle:hover {\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border-color: var(--emerald-border);\n  transform: rotate(180deg);\n}\n\n/* Commuter Slider Box */\n.commuter-slider-box {\n  background: var(--slate-50);\n  border: 1px solid var(--slate-200);\n  border-radius: 14px;\n  padding: 1.35rem 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.slider-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 1rem;\n}\n\n.fare-pill {\n  background: #FFFFFF;\n  border: 1px solid var(--emerald-border);\n  padding: 0.4rem 0.85rem;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  box-shadow: 0 2px 8px var(--emerald-glow);\n}\n\n.slider-range-input {\n  width: 100%;\n  accent-color: var(--emerald);\n  cursor: pointer;\n  height: 7px;\n  background: var(--slate-200);\n  border-radius: 8px;\n  outline: none;\n}\n\n.slider-ticks {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.74rem;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n  font-weight: 500;\n  margin-top: -0.25rem;\n}\n\n.slider-ticks .tick.active-tick {\n  color: var(--emerald);\n  font-weight: 700;\n}\n\n.route-actions-row {\n  display: flex;\n  gap: 0.85rem;\n}\n\n/* Map Card Wrapper */\n.map-card-wrapper {\n  padding: 2.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.map-header-actions {\n  display: flex;\n  gap: 0.65rem;\n}\n\n.map-canvas-container {\n  position: relative;\n  width: 100%;\n  height: 500px;\n  background: #FAFCFB;\n  border: 1px solid var(--slate-200);\n  border-radius: 16px;\n  overflow: hidden;\n  box-shadow: inset 0 2px 6px rgba(0, 0, 0, 0.02);\n}\n\n#urban-3d-canvas {\n  width: 100%;\n  height: 100%;\n  cursor: grab;\n  display: block;\n}\n#urban-3d-canvas:active {\n  cursor: grabbing;\n}\n\n.map-hud-overlay {\n  position: absolute;\n  bottom: 1.25rem;\n  left: 1.25rem;\n  background: rgba(255, 255, 255, 0.95);\n  backdrop-filter: blur(10px);\n  border: 1px solid var(--slate-200);\n  padding: 0.55rem 1.15rem;\n  border-radius: 10px;\n  font-size: 0.775rem;\n  color: var(--slate-700);\n  font-family: var(--font-mono);\n  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.06);\n}\n\n.telemetry-summary-strip {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 1rem;\n  background: var(--slate-50);\n  border: 1px solid var(--slate-200);\n  border-radius: 14px;\n  padding: 1.15rem 1.45rem;\n}\n\n.telemetry-item {\n  display: flex;\n  flex-direction: column;\n  gap: 0.2rem;\n}\n.telemetry-label {\n  font-size: 0.68rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n  letter-spacing: 0.04em;\n}\n.telemetry-value {\n  font-size: 1.05rem;\n  font-weight: 800;\n  color: var(--slate-900);\n  letter-spacing: -0.01em;\n}\n\n/* --------------------------------------------------------------------------\n   Buttons & Inputs System\n   -------------------------------------------------------------------------- */\n.btn {\n  font-family: var(--font-sans);\n  font-size: 0.85rem;\n  font-weight: 600;\n  padding: 0.725rem 1.45rem;\n  border-radius: 12px;\n  border: 1px solid transparent;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.6rem;\n  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n  white-space: nowrap;\n  letter-spacing: -0.005em;\n}\n\n.btn-primary {\n  background: var(--electric);\n  color: #FFFFFF;\n  box-shadow: 0 4px 14px rgba(37, 99, 235, 0.25);\n}\n.btn-primary:hover {\n  background: var(--electric-dark);\n  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35);\n  transform: translateY(-2px);\n}\n\n.btn-emerald {\n  background: var(--emerald);\n  color: #FFFFFF;\n  box-shadow: 0 4px 14px rgba(5, 150, 105, 0.25);\n}\n.btn-emerald:hover {\n  background: var(--emerald-dark);\n  box-shadow: 0 6px 20px rgba(5, 150, 105, 0.35);\n  transform: translateY(-2px);\n}\n\n.btn-emerald-outline {\n  background: var(--emerald-light);\n  border: 1.5px solid var(--emerald-border);\n  color: var(--emerald-dark);\n}\n.btn-emerald-outline:hover {\n  background: var(--emerald);\n  color: #FFFFFF;\n  border-color: var(--emerald);\n  transform: translateY(-2px);\n}\n\n.btn-amber {\n  background: var(--amber-light);\n  border: 1.5px solid var(--amber-border);\n  color: var(--amber);\n}\n.btn-amber:hover {\n  background: var(--amber);\n  color: #FFFFFF;\n  transform: translateY(-2px);\n}\n\n.btn-rose {\n  background: var(--rose-light);\n  border: 1.5px solid var(--rose-border);\n  color: var(--rose);\n}\n.btn-rose:hover {\n  background: var(--rose);\n  color: #FFFFFF;\n  transform: translateY(-2px);\n}\n\n.btn-outline {\n  background: #FFFFFF;\n  border: 1.5px solid var(--slate-200);\n  color: var(--slate-700);\n}\n.btn-outline:hover {\n  background: var(--slate-100);\n  border-color: var(--slate-400);\n  color: var(--slate-900);\n  transform: translateY(-2px);\n}\n\n.btn-ghost {\n  background: transparent;\n  color: var(--slate-500);\n}\n.btn-ghost:hover {\n  background: var(--slate-100);\n  color: var(--slate-900);\n}\n\n.btn-sm {\n  padding: 0.45rem 0.95rem;\n  font-size: 0.775rem;\n  border-radius: 9px;\n}\n\n.text-input, .select-field {\n  background: #FFFFFF;\n  border: 1.5px solid var(--slate-200);\n  border-radius: 12px;\n  color: var(--slate-900);\n  padding: 0.75rem 1.05rem;\n  font-size: 0.875rem;\n  font-family: var(--font-sans);\n  outline: none;\n  transition: all 0.2s ease;\n  width: 100%;\n}\n\n.text-input:focus, .select-field:focus {\n  border-color: var(--emerald);\n  box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);\n}\n\n.text-input::placeholder {\n  color: var(--slate-400);\n}\n\n.input-with-icon {\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n.input-with-icon i {\n  position: absolute;\n  left: 1.05rem;\n  color: var(--slate-400);\n  font-size: 0.9rem;\n}\n.input-with-icon .text-input {\n  padding-left: 2.75rem;\n}\n\n/* --------------------------------------------------------------------------\n   TAB 2: COMMUTER PASSENGER HUB\n   -------------------------------------------------------------------------- */\n.view-grid-passengers {\n  display: grid;\n  grid-template-columns: 380px 1.4fr 360px;\n  gap: 2rem;\n  align-items: start;\n}\n\n.passenger-form-card {\n  padding: 2.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.75rem;\n}\n\n/* Conveyor Pipeline Stream */\n.conveyor-pipeline-card {\n  padding: 2.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.conveyor-belt-container {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  max-height: 480px;\n  overflow-y: auto;\n  padding-right: 0.5rem;\n}\n\n.commuter-token {\n  background: #FFFFFF;\n  border: 1.5px solid var(--slate-200);\n  border-radius: 14px;\n  padding: 1.1rem 1.4rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.45rem;\n  position: relative;\n  overflow: hidden;\n}\n\n.commuter-token.head-token {\n  border-left: 5px solid var(--emerald);\n  background: #FCFDFD;\n}\n\n.token-badge {\n  font-size: 0.68rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n  letter-spacing: 0.03em;\n}\n.head-token .token-badge {\n  color: var(--emerald-dark);\n}\n\n.token-name {\n  font-size: 1rem;\n  font-weight: 700;\n  color: var(--slate-900);\n}\n\n.token-route {\n  font-size: 0.825rem;\n  color: var(--slate-600);\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.token-meta {\n  font-size: 0.725rem;\n  color: var(--slate-400);\n  font-family: var(--font-mono);\n}\n\n/* Priority Standby Circular Lounge */\n.standby-lounge-card {\n  padding: 2.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n  align-items: center;\n}\n\n.standby-ring-wrap {\n  position: relative;\n  width: 260px;\n  height: 260px;\n  margin: 1rem auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.standby-ring-center {\n  position: absolute;\n  width: 96px;\n  height: 96px;\n  border-radius: 50%;\n  background: #FFFFFF;\n  border: 2px dashed var(--slate-300);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  z-index: 2;\n  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);\n}\n\n.standby-slot {\n  position: absolute;\n  width: 48px;\n  height: 48px;\n  border-radius: 50%;\n  background: #FFFFFF;\n  border: 2px solid var(--slate-200);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.65rem;\n  color: var(--slate-600);\n  font-family: var(--font-mono);\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);\n}\n\n.standby-slot.occupied {\n  background: var(--amber-light);\n  border-color: var(--amber);\n  color: var(--amber);\n  box-shadow: 0 4px 12px rgba(217, 119, 6, 0.2);\n}\n\n.standby-slot.is-active-pointer {\n  border-color: var(--emerald);\n  background: var(--emerald-light);\n  color: var(--emerald-dark);\n  box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);\n}\n\n.standby-actions-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 0.65rem;\n}\n\n/* --------------------------------------------------------------------------\n   TAB 3: DRIVER FLEET & DISPATCH CONSOLE\n   -------------------------------------------------------------------------- */\n.view-grid-fleet {\n  display: grid;\n  grid-template-columns: 440px 1fr;\n  gap: 2rem;\n  align-items: start;\n}\n\n.fleet-onboarding-card {\n  padding: 2.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.75rem;\n}\n\n/* Vehicle Chassis Blueprint Diagram */\n.vehicle-blueprint-box {\n  background: var(--slate-50);\n  border: 1px solid var(--slate-200);\n  border-radius: 16px;\n  padding: 1.45rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.15rem;\n}\n\n.vehicle-blueprint-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.8rem;\n  font-weight: 600;\n  color: var(--slate-700);\n}\n\n.vehicle-chassis-diagram {\n  width: 180px;\n  height: 230px;\n  margin: 0 auto;\n  border: 2px solid var(--slate-300);\n  border-radius: 44px 44px 28px 28px;\n  background: #FFFFFF;\n  position: relative;\n  box-shadow: 0 4px 16px rgba(15, 23, 42, 0.04);\n  padding: 1.35rem 0.85rem;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.chassis-row {\n  display: flex;\n  justify-content: space-around;\n  gap: 0.6rem;\n}\n\n.vehicle-seat {\n  width: 62px;\n  height: 68px;\n  border-radius: 12px;\n  border: 1.5px solid var(--slate-200);\n  background: #FFFFFF;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 0.3rem;\n  font-size: 0.68rem;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  color: var(--slate-600);\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.vehicle-seat:hover {\n  border-color: var(--emerald);\n  transform: translateY(-2px);\n}\n\n.vehicle-seat.driver-locked {\n  background: var(--slate-100);\n  border-color: var(--slate-300);\n  color: var(--slate-700);\n  cursor: default;\n}\n\n.vehicle-seat.active-seat {\n  background: var(--emerald-light);\n  border-color: var(--emerald);\n  color: var(--emerald-dark);\n  box-shadow: 0 4px 10px var(--emerald-glow);\n}\n\n.vehicle-seat.reserved-seat {\n  background: var(--rose-light);\n  border-color: var(--rose-border);\n  color: var(--rose);\n}\n\n/* Fleet Directory & Active Trips Column */\n.fleet-operations-column {\n  display: flex;\n  flex-direction: column;\n  gap: 2rem;\n}\n\n.fleet-stream-container {\n  display: flex;\n  gap: 1.15rem;\n  overflow-x: auto;\n  padding-bottom: 0.65rem;\n}\n\n.driver-partner-card {\n  min-width: 235px;\n  background: #FFFFFF;\n  border: 1.5px solid var(--slate-200);\n  border-radius: 14px;\n  padding: 1.15rem 1.35rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.45rem;\n  flex-shrink: 0;\n}\n\n.card-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.driver-id-badge {\n  font-size: 0.72rem;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  color: var(--slate-500);\n}\n\n.seat-counter-pill {\n  font-size: 0.7rem;\n  font-weight: 700;\n  background: var(--emerald-light);\n  color: var(--emerald-dark);\n  border: 1px solid var(--emerald-border);\n  padding: 0.25rem 0.65rem;\n  border-radius: 9999px;\n}\n\n.driver-name {\n  font-size: 1rem;\n  font-weight: 700;\n  color: var(--slate-900);\n}\n\n.driver-corridor {\n  font-size: 0.8rem;\n  color: var(--slate-600);\n}\n\n.fleet-pointer {\n  display: flex;\n  align-items: center;\n  color: var(--slate-400);\n}\n\n/* Active Shared Trips Console */\n.active-trips-stream {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));\n  gap: 1.25rem;\n  margin-top: 1.25rem;\n}\n\n.shared-trip-card {\n  background: #FFFFFF;\n  border: 1.5px solid var(--slate-200);\n  border-radius: 14px;\n  padding: 1.25rem 1.45rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.6rem;\n  position: relative;\n}\n\n.route-match-badge {\n  font-size: 0.7rem;\n  font-weight: 700;\n  padding: 0.25rem 0.65rem;\n  border-radius: 8px;\n  background: var(--electric-light);\n  color: var(--electric);\n  border: 1px solid var(--electric-border);\n}\n\n.trip-ref {\n  font-family: var(--font-mono);\n  font-size: 0.775rem;\n  font-weight: 700;\n  color: var(--slate-500);\n}\n\n.btn-cancel-trip {\n  position: absolute;\n  top: 1rem;\n  right: 1rem;\n  width: 28px;\n  height: 28px;\n  border-radius: 50%;\n  background: var(--slate-100);\n  border: none;\n  color: var(--slate-400);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  font-size: 0.8rem;\n  transition: all 0.2s ease;\n}\n.btn-cancel-trip:hover {\n  background: var(--rose-light);\n  color: var(--rose);\n}\n\n/* Search & Identity Verification Bar */\n.verif