\n  box-sizing: border-box;\\n  margin: 0;\\n  padding: 0;\\n}\\n\\nhtml {\\n  scroll-behavior: smooth;\\n}\\n\\nbody {\\n  background-color: var(--bg-primary);\\n  color: var(--slate-800);\\n  font-family: var(--font-sans);\\n  min-height: 100vh;\\n  overflow-x: hidden;\\n  position: relative;\\n  line-height: 1.5;\\n}\\n\\n/* Ambient Canvas Background Layer */\\n#ambient-canvas {\\n  position: fixed;\\n  inset: 0;\\n  width: 100vw;\\n  height: 100vh;\\n  pointer-events: none;\\n  z-index: 0;\\n}\\n\\n/* Custom Scrollbars */\\n::-webkit-scrollbar {\\n  width: 6px;\\n  height: 6px;\\n}\\n::-webkit-scrollbar-trac\n<truncated 29472 bytes>","Overwrite":"true","Path":"\"C:/Users/Kartik Bhosle/.gemini/antigravity/brain/6976d1a8-fd03-4453-a790-acd552e1861a/styles.css\""}}],"truncated_fields":["tool_calls"]}
