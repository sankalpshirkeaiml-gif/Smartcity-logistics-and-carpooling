\n  position: fixed;\n  bottom: 2rem;\n  right: 2rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.65rem;\n  z-index: 99999;\n}\n\n.toast {\n  padding: 0.95rem 1.5rem;\n  border-radius: 12px;\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-left: 5px solid var(--emerald);\n  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.08);\n  font-size: 0.85rem;\n  font-weight: 500;\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n  color: var(--slate-900);\n  animation: toastIn 0.3s ease-out;\n}\n.toast.toast-emerald { border-left-color: var(--emerald); }\n.toast.toast-blue { border-left-color: var(--electric); }\n.toast.toast-rose { border-left-color: var(--rose); }\n.toast.toast-amber { border-left-color: var(--amber); }\n\n/* Utility classes */\n.text-emerald { color: var(--emerald); }\n.text-electric { color: var(--electric); }\n.text-rose { color: var(--rose); }\n.text-amber { color: var(--amber); }\n.text-purple { color: var(--purple); }\n.font-bold { font-weight: 700; }\n.font-semibold { font-weight: 600; }\n.flex { display: flex; }\n.flex-1 { flex: 1; }\n.flex-col { flex-direction: column; }\n.items-center { align-items: center; }\n.justify-between { justify-content: space-between; }\n.gap-2 { gap: 0.5rem; }\n.gap-3 { gap: 0.75rem; }\n.gap-4 { gap: 1rem; }\n.p-4 { padding: 1.75rem; }\n.pt-2 { padding-top: 0.5rem; }\n.w-full { width: 100%; }\n.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.max-w-\\[42px\\] { max-width: 42px; }\n\n/* --------------------------------------------------------------------------\n   Responsive Layout Adjustments\n   -------------------------------------------------------------------------- */\n@media (max-width: 1360px) {\n  .view-grid-map {\n    grid-template-columns: 400px 1fr;\n  }\n  .view-grid-passengers {\n    grid-template-columns: 340px 1fr 320px;\n  }\n  .view-grid-fleet {\n    grid-template-columns: 400px 1fr;\n  }\n}\n\n@media (max-width: 1120px) {\n  .kpi-banner {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .view-grid-map,\n  .view-grid-passengers,\n  .view-grid-fleet,\n  .analytics-two-col {\n    grid-template-columns: 1fr;\n  }\n  .sustainability-grid,\n  .analytics-metrics-strip {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 768px) {\n  .app-layout {\n    padding: 1.25rem 1.25rem 2.5rem;\n  }\n  .kpi-banner {\n    grid-template-columns: 1fr;\n  }\n  .telemetry-summary-strip {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .app-header {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  .nav-actions {\n    width: 100%;\n    justify-content: flex-start;\n  }\n}\n\n/* Print styling for Eco-Receipt */\n@media print {\n  body * {\n    visibility: hidden;\n  }\n  #receipt-modal-card,\n  #receipt-modal-card * {\n    visibility: visible;\n  }\n  #receipt-modal-card {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 100%;\n    box-shadow: none;\n    border: 1px solid #000;\n  }\n  .modal-footer {\n    display: none;\n  }\n}\n\n@keyframes toastIn {\n  from { opacity: 0; transform: translateY(15px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes modalIn {\n  from { opacity: 0; transform: scale(0.95); }\n  to { opacity: 1; transform: scale(1); }\n}\n","Overwrite":true,"Path":"C:/Users/Kartik Bhosle/.gemini/antigravity/brain/6976d1a8-fd03-4453-a790-acd552e1861a/styles.css"}}]}
