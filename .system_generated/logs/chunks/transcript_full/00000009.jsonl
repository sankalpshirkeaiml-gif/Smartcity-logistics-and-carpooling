{"step_index":144,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:19:31Z","content":"Created At: 2026-10-20T11:49:31+05:30\nCompleted At: 2026-10-20T11:49:32+05:30\nShowing lines 1-800 of 1652\n1: /**\n2:  * NEXUSMOBILITY — MULTI-TABBED ENTERPRISE ECO-TECH PLATFORM\n3:  * Core Engine & Multi-View Controller\n4:  * Featuring Animated Transit Car Simulation, Ambient Eco Particle Canvas,\n5:  * EcoSprout Mascot, and Enterprise Confirmation Modals.\n6:  * 100% Zero CS / Academic Jargon.\n7:  */\n8: \n9: // ==========================================\n10: // 1. METROPOLITAN TRANSIT STATIONS & NETWORK\n11: // ==========================================\n12: const TRANSIT_STATIONS = [\n13:   { id: 'ALPHA', name: 'Tech Park Alpha', x: -160, y: -70, z: 20, zone: 'North Industrial', icon: 'fa-microchip' },\n14:   { id: 'HARBOR', name: 'Bayfront Terminal', x: -80, y: 110, z: -15, zone: 'Maritime District', icon: 'fa-anchor' },\n15:   { id: 'METRO', name: 'Central Financial Core', x: 0, y: 0, z: 40, zone: 'Downtown Metro', icon: 'fa-building-columns' },\n16:   { id: 'SKYPORT', name: 'AeroPort Interchange', x: 130, y: -90, z: 30, zone: 'Aviation Corridor', icon: 'fa-plane-departure' },\n17:   { id: 'QUANTUM', name: 'Green Innovation Campus', x: 90, y: 100, z: -10, zone: 'Eco District', icon: 'fa-seedling' },\n18:   { id: 'HORIZON', name: 'Waterfront Marina', x: 200, y: 30, z: 5, zone: 'East Residential', icon: 'fa-water' }\n19: ];\n20: \n21: // Transit Corridors with distances (km)\n22: const TRANSIT_CORRIDORS = [\n23:   { u: 'ALPHA', v: 'METRO', distance: 8.2 },\n24:   { u: 'ALPHA', v: 'HARBOR', distance: 11.5 },\n25:   { u: 'HARBOR', v: 'METRO', distance: 6.4 },\n26:   { u: 'HARBOR', v: 'QUANTUM', distance: 13.8 },\n27:   { u: 'METRO', v: 'SKYPORT', distance: 9.6 },\n28:   { u: 'METRO', v: 'QUANTUM', distance: 7.1 },\n29:   { u: 'SKYPORT', v: 'HORIZON', distance: 8.8 },\n30:   { u: 'QUANTUM', v: 'HORIZON', distance: 10.4 }\n31: ];\n32: \n33: // ==========================================\n34: // 2. NEXUS LOGISTICS STATE ENGINE\n35: // ==========================================\n36: class NexusTransitEngine {\n37:   constructor() {\n38:     this.stations = TRANSIT_STATIONS;\n39:     this.corridors = TRANSIT_CORRIDORS;\n40: \n41:     this.dispatchStream = [];\n42: \n43:     // Priority Standby Lounge (Max 5 Slots)\n44:     this.standbyCap = 5;\n45:     this.standbyLounge = new Array(this.standbyCap).fill(null);\n46:     this.standbyFront = 0;\n47:     this.standbyRear = 0;\n48:     this.standbyCount = 0;\n49: \n50:     // Driver Fleet Directory\n51:     this.fleetPartners = [];\n52: \n53:     // Active Shared Trips\n54:     this.activeTrips = [];\n55: \n56:     // Reversible Dispatch Audit Log\n57:     this.reversalAuditLog = [];\n58: \n59:     // Top Eco-Partners Leaderboard with Gamified Achievement Badges\n60:     this.leaderboard = [\n61:       { name: 'Kaelen Chen', trips: 42, co2: '168.4 kg', rating: 4.98, badge: 'Carbon Crusader' },\n62:       { name: 'Elena Rostova', trips: 37, co2: '142.1 kg', rating: 4.95, badge: '5-Star Commute' },\n63:       { name: 'Marcus Vance', trips: 31, co2: '128.0 kg', rating: 4.92, badge: 'Zero-Emission Pioneer' },\n64:       { name: 'Siddharth Rao', trips: 28, co2: '115.6 kg', rating: 4.89, badge: 'Master Navigator' }\n65:     ];\n66: \n67:     this.counters = {\n68:       driver: 101,\n69:       booking: 501,\n70:       passenger: 201\n71:     };\n72: \n73:     this.commuterDensity = 2;\n74:   }\n75: \n76:   findOptimalEcoRoute(startId, endId) {\n77:     const adj = {};\n78:     TRANSIT_STATIONS.forEach(s => { adj[s.id] = []; });\n79:     TRANSIT_CORRIDORS.forEach(c => {\n80:       adj[c.u].push({ node: c.v, distance: c.distance });\n81:       adj[c.v].push({ node: c.u, distance: c.distance });\n82:     });\n83: \n84:     const dist = {};\n85:     const prev = {};\n86:     TRANSIT_STATIONS.forEach(s => {\n87:       dist[s.id] = Infinity;\n88:       prev[s.id] = null;\n89:     });\n90: \n91:     dist[startId] = 0;\n92:     const activeCorridors = [[0, startId]];\n93: \n94:     while (activeCorridors.length > 0) {\n95:       activeCorridors.sort((a, b) => a[0] - b[0]);\n96:       const [d, u] = activeCorridors.shift();\n97: \n98:       if (u === endId) break;\n99:       if (d > dist[u]) continue;\n100: \n101:       for (const edge of adj[u]) {\n102:         const v = edge.node;\n103:         const newDist = dist[u] + edge.distance;\n104:         if (newDist < dist[v]) {\n105:           dist[v] = newDist;\n106:           prev[v] = u;\n107:           activeCorridors.push([newDist, v]);\n108:         }\n109:       }\n110:     }\n111: \n112:     const path = [];\n113:     let curr = endId;\n114:     if (dist[endId] !== Infinity) {\n115:       while (curr) {\n116:         path.unshift(curr);\n117:         curr = prev[curr];\n118:       }\n119:     }\n120: \n121:     const totalDist = dist[endId] === Infinity ? 0 : parseFloat(dist[endId].toFixed(1));\n122:     const estTime = Math.round(totalDist * 2.2);\n123:     const baseCO2 = totalDist * 0.171;\n124:     const co2Offset = parseFloat((baseCO2 * (0.8 + this.commuterDensity * 0.4)).toFixed(2));\n125: \n126:     const baseTripCost = 4.0 + totalDist * 1.5;\n127:     const pooledFare = parseFloat(((baseTripCost * (1 + (this.commuterDensity - 1) * 0.25)) / this.commuterDensity).toFixed(2));\n128: \n129:     return {\n130:       path,\n131:       totalDist,\n132:       estTime,\n133:       co2Offset,\n134:       fare: pooledFare,\n135:       soloCarsSaved: Math.max(0, this.commuterDensity - 1)\n136:     };\n137:   }\n138: \n139:   submitRideRequest(name, pickup, drop) {\n140:     const passenger = {\n141:       id: `BK-${this.counters.passenger++}`,\n142:       name,\n143:       pickup,\n144:       drop,\n145:       requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n146:       status: 'Pending Dispatch'\n147:     };\n148:     this.dispatchStream.push(passenger);\n149:     return passenger;\n150:   }\n151: \n152:   dequeueNextRequest() {\n153:     return this.dispatchStream.shift() || null;\n154:   }\n155: \n156:   pushToStandby(item) {\n157:     if (this.standbyCount === this.standbyCap) {\n158:       return { success: false, message: 'Priority Standby Lounge is currently at maximum capacity (5/5).' };\n159:     }\n160:     this.standbyLounge[this.standbyRear] = item;\n161:     this.standbyRear = (this.standbyRear + 1) % this.standbyCap;\n162:     this.standbyCount++;\n163:     return { success: true };\n164:   }\n165: \n166:   popFromStandby() {\n167:     if (this.standbyCount === 0) {\n168:       return { success: false, message: 'Standby lounge is currently empty.' };\n169:     }\n170:     const item = this.standbyLounge[this.standbyFront];\n171:     this.standbyLounge[this.standbyFront] = null;\n172:     this.standbyFront = (this.standbyFront + 1) % this.standbyCap;\n173:     this.standbyCount--;\n174:     return { success: true, item };\n175:   }\n176: \n177:   onboardDriver(name, station, seats) {\n178:     const driverId = this.counters.driver++;\n179:     const newPartner = {\n180:       id: driverId,\n181:       name,\n182:       station,\n183:       seats: parseInt(seats, 10),\n184:       originalSeats: parseInt(seats, 10),\n185:       tripsCompleted: 0\n186:     };\n187:     this.fleetPartners.push(newPartner);\n188:     return newPartner;\n189:   }\n190: \n191:   getDriverById(id) {\n192:     const cleanId = String(id).replace(/[^0-9]/g, '');\n193:     return this.fleetPartners.find(d => String(d.id) === cleanId) || null;\n194:   }\n195: \n196:   getBookingByRef(ref) {\n197:     const upper = String(ref).trim().toUpperCase();\n198:     return this.activeTrips.find(t => t.tripRef.toUpperCase() === upper || t.passenger.id.toUpperCase() === upper) || null;\n199:   }\n200: \n201:   dispatchSharedTrip(passenger, driver, corridorPath, distance, time, fare, co2Saved, matchScore = 94) {\n202:     const tripRef = `NX-${this.counters.booking++}`;\n203:     const trip = {\n204:       tripRef,\n205:       passenger,\n206:       driverId: driver.id,\n207:       driverName: driver.name,\n208:       corridorPath,\n209:       distance,\n210:       time,\n211:       fare,\n212:       co2Saved,\n213:       matchScore,\n214:       dispatchedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\n215:     };\n216: \n217:     this.activeTrips.push(trip);\n218:     driver.seats -= 1;\n219:     driver.tripsCompleted += 1;\n220: \n221:     this.reversalAuditLog.push({\n222:       type: 'DISPATCH_CONFIRMATION',\n223:       tripRef,\n224:       driverId: driver.id,\n225:       passenger,\n226:       trip\n227:     });\n228: \n229:     return trip;\n230:   }\n231: \n232:   cancelActiveTrip(tripRef) {\n233:     const index = this.activeTrips.findIndex(t => t.tripRef === tripRef);\n234:     if (index !== -1) {\n235:       const removed = this.activeTrips.splice(index, 1)[0];\n236:       return removed;\n237:     }\n238:     return null;\n239:   }\n240: \n241:   revertLatestConfirmation() {\n242:     if (this.reversalAuditLog.length === 0) {\n243:       return { success: false, message: 'No recent dispatch confirmations available to revert.' };\n244:     }\n245: \n246:     const action = this.reversalAuditLog.pop();\n247:     if (action.type === 'DISPATCH_CONFIRMATION') {\n248:       this.cancelActiveTrip(action.tripRef);\n249: \n250:       const driver = this.getDriverById(action.driverId);\n251:       if (driver) {\n252:         driver.seats = Math.min(driver.seats + 1, driver.originalSeats);\n253:       }\n254: \n255:       action.passenger.status = 'Restored to Dispatch';\n256:       this.dispatchStream.unshift(action.passenger);\n257: \n258:       return { success: true, action, driver };\n259:     }\n260: \n261:     return { success: false, message: 'Unable to process reversal.' };\n262:   }\n263: }\n264: \n265: const engine = new NexusTransitEngine();\n266: \n267: // ==========================================\n268: // 3. AMBIENT BACKGROUND CANVAS (FLOATING LEAVES & ENERGY NODES)\n269: // ==========================================\n270: class AmbientEcoCanvas {\n271:   constructor(canvasId) {\n272:     this.canvas = document.getElementById(canvasId);\n273:     if (!this.canvas) return;\n274:     this.ctx = this.canvas.getContext('2d');\n275:     this.particles = [];\n276:     this.numParticles = 35;\n277: \n278:     this.resize();\n279:     window.addEventListener('resize', () => this.resize());\n280:     this.initParticles();\n281:     this.animate();\n282:   }\n283: \n284:   resize() {\n285:     this.width = window.innerWidth;\n286:     this.height = window.innerHeight;\n287:     this.canvas.width = this.width;\n288:     this.canvas.height = this.height;\n289:   }\n290: \n291:   initParticles() {\n292:     this.particles = [];\n293:     for (let i = 0; i < this.numParticles; i++) {\n294:       this.particles.push({\n295:         x: Math.random() * this.width,\n296:         y: Math.random() * this.height,\n297:         size: Math.random() * 8 + 4,\n298:         speedY: -(Math.random() * 0.45 + 0.15),\n299:         speedX: Math.sin(Math.random() * Math.PI) * 0.25,\n300:         rotation: Math.random() * Math.PI * 2,\n301:         rotSpeed: (Math.random() - 0.5) * 0.015,\n302:         type: Math.random() > 0.45 ? 'leaf' : 'node',\n303:         opacity: Math.random() * 0.4 + 0.15\n304:       });\n305:     }\n306:   }\n307: \n308:   animate() {\n309:     this.ctx.clearRect(0, 0, this.width, this.height);\n310: \n311:     this.particles.forEach(p => {\n312:       p.y += p.speedY;\n313:       p.x += p.speedX + Math.sin(p.y * 0.01) * 0.2;\n314:       p.rotation += p.rotSpeed;\n315: \n316:       // Wrap around\n317:       if (p.y < -20) {\n318:         p.y = this.height + 20;\n319:         p.x = Math.random() * this.width;\n320:       }\n321:       if (p.x < -20) p.x = this.width + 20;\n322:       if (p.x > this.width + 20) p.x = -20;\n323: \n324:       this.ctx.save();\n325:       this.ctx.translate(p.x, p.y);\n326:       this.ctx.rotate(p.rotation);\n327: \n328:       if (p.type === 'leaf') {\n329:         // Draw delicate eco-leaf\n330:         this.ctx.fillStyle = `rgba(5, 150, 105, ${p.opacity * 0.55})`;\n331:         this.ctx.beginPath();\n332:         this.ctx.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);\n333:         this.ctx.fill();\n334: \n335:         // Leaf stem line\n336:         this.ctx.strokeStyle = `rgba(5, 150, 105, ${p.opacity * 0.7})`;\n337:         this.ctx.lineWidth = 0.8;\n338:         this.ctx.beginPath();\n339:         this.ctx.moveTo(-p.size, 0);\n340:         this.ctx.lineTo(p.size, 0);\n341:         this.ctx.stroke();\n342:       } else {\n343:         // Light glowing electric energy node\n344:         this.ctx.fillStyle = `rgba(37, 99, 235, ${p.opacity * 0.45})`;\n345:         this.ctx.beginPath();\n346:         this.ctx.arc(0, 0, p.size * 0.4, 0, Math.PI * 2);\n347:         this.ctx.fill();\n348:       }\n349: \n350:       this.ctx.restore();\n351:     });\n352: \n353:     requestAnimationFrame(() => this.animate());\n354:   }\n355: }\n356: \n357: // ==========================================\n358: // 4. 3D SPATIAL METROPOLITAN CANVAS MAP\n359: // WITH DIRECTIONAL CORRIDORS & ANIMATED TRANSIT VEHICLE\n360: // ==========================================\n361: class Urban3DCanvas {\n362:   constructor(canvasId) {\n363:     this.canvas = document.getElementById(canvasId);\n364:     this.ctx = this.canvas.getContext('2d');\n365:     this.wrapper = this.canvas.parentElement;\n366: \n367:     this.rotX = 0.45;\n368:     this.rotY = -0.32;\n369:     this.scale = 1.08;\n370: \n371:     this.isDragging = false;\n372:     this.lastMouseX = 0;\n373:     this.lastMouseY = 0;\n374: \n375:     this.activeCorridorPath = [];\n376:     this.hoveredStation = null;\n377: \n378:     // Animated Car along active path\n379:     this.carProgress = 0; // 0 to (path.length - 1)\n380:     this.carSpeed = 0.0085;\n381:     this.isCarDriving = false;\n382:     this.flowDashOffset = 0;\n383: \n384:     this.initEvents();\n385:     this.resize();\n386:     window.addEventListener('resize', () => this.resize());\n387:     this.animate();\n388:   }\n389: \n390:   resize() {\n391:     if (!this.wrapper) return;\n392:     this.width = this.wrapper.clientWidth || 800;\n393:     this.height = this.wrapper.clientHeight || 420;\n394:     this.canvas.width = this.width * window.devicePixelRatio;\n395:     this.canvas.height = this.height * window.devicePixelRatio;\n396:     this.ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n397:   }\n398: \n399:   initEvents() {\n400:     this.canvas.addEventListener('mousedown', (e) => {\n401:       this.isDragging = true;\n402:       this.lastMouseX = e.clientX;\n403:       this.lastMouseY = e.clientY;\n404:     });\n405: \n406:     window.addEventListener('mouseup', () => {\n407:       this.isDragging = false;\n408:     });\n409: \n410:     this.canvas.addEventListener('mousemove', (e) => {\n411:       if (this.isDragging) {\n412:         const deltaX = e.clientX - this.lastMouseX;\n413:         const deltaY = e.clientY - this.lastMouseY;\n414:         this.rotY += deltaX * 0.007;\n415:         this.rotX += deltaY * 0.007;\n416:         this.rotX = Math.max(0.12, Math.min(1.2, this.rotX));\n417:         this.lastMouseX = e.clientX;\n418:         this.lastMouseY = e.clientY;\n419:       }\n420:       this.checkHover(e);\n421:     });\n422: \n423:     this.canvas.addEventListener('wheel', (e) => {\n424:       e.preventDefault();\n425:       this.scale += e.deltaY * -0.001;\n426:       this.scale = Math.max(0.65, Math.min(1.85, this.scale));\n427:     });\n428:   }\n429: \n430:   checkHover(e) {\n431:     const rect = this.canvas.getBoundingClientRect();\n432:     const mouseX = e.clientX - rect.left;\n433:     const mouseY = e.clientY - rect.top;\n434: \n435:     let found = null;\n436:     TRANSIT_STATIONS.forEach(s => {\n437:       const p = this.project(s.x, s.y, s.z);\n438:       const dist = Math.hypot(p.x - mouseX, p.y - mouseY);\n439:       if (dist < 22) {\n440:         found = s;\n441:       }\n442:     });\n443: \n444:     this.hoveredStation = found;\n445:     const hud = document.getElementById('map-hud-overlay');\n446:     if (hud) {\n447:       if (found) {\n448:         hud.innerHTML = `<span class=\"text-emerald font-bold\">📍 ${found.name}</span> &bull; Transit Zone: ${found.zone} &bull; Elevation: +${found.z}m`;\n449:       } else {\n450:         hud.innerHTML = `<i class=\"fa-solid fa-hand-pointer text-emerald\"></i> Click & drag to orbit 3D city corridors &bull; Scroll to zoom`;\n451:       }\n452:     }\n453:   }\n454: \n455:   project(x, y, z) {\n456:     const cosY = Math.cos(this.rotY);\n457:     const sinY = Math.sin(this.rotY);\n458:     const x1 = x * cosY + z * sinY;\n459:     const z1 = -x * sinY + z * cosY;\n460: \n461:     const cosX = Math.cos(this.rotX);\n462:     const sinX = Math.sin(this.rotX);\n463:     const y2 = y * cosX - z1 * sinX;\n464:     const z2 = y * sinX + z1 * cosX;\n465: \n466:     const cameraDist = 440;\n467:     const fov = cameraDist / (cameraDist + z2);\n468: \n469:     const screenX = this.width / 2 + x1 * fov * this.scale;\n470:     const screenY = this.height / 2 + y2 * fov * this.scale;\n471: \n472:     return { x: screenX, y: screenY, scale: fov, z: z2 };\n473:   }\n474: \n475:   setActivePath(path) {\n476:     this.activeCorridorPath = path;\n477:     this.carProgress = 0;\n478:     this.isCarDriving = path && path.length > 1;\n479:   }\n480: \n481:   startCarSimulation() {\n482:     if (this.activeCorridorPath && this.activeCorridorPath.length > 1) {\n483:       this.carProgress = 0;\n484:       this.isCarDriving = true;\n485:     }\n486:   }\n487: \n488:   resetCamera() {\n489:     this.rotX = 0.45;\n490:     this.rotY = -0.32;\n491:     this.scale = 1.08;\n492:   }\n493: \n494:   animate() {\n495:     this.flowDashOffset -= 0.6;\n496:     this.render();\n497: \n498:     // Advance transit vehicle along path\n499:     if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n500:       this.carProgress += this.carSpeed;\n501:       if (this.carProgress >= this.activeCorridorPath.length - 1) {\n502:         this.carProgress = 0; // Loop or stop\n503:       }\n504:     }\n505: \n506:     requestAnimationFrame(() => this.animate());\n507:   }\n508: \n509:   render() {\n510:     const ctx = this.ctx;\n511:     ctx.clearRect(0, 0, this.width, this.height);\n512: \n513:     this.drawGroundGrid();\n514: \n515:     // Draw Corridors\n516:     TRANSIT_CORRIDORS.forEach(corridor => {\n517:       const uStation = TRANSIT_STATIONS.find(s => s.id === corridor.u);\n518:       const vStation = TRANSIT_STATIONS.find(s => s.id === corridor.v);\n519:       const p1 = this.project(uStation.x, uStation.y, uStation.z);\n520:       const p2 = this.project(vStation.x, vStation.y, vStation.z);\n521: \n522:       let isPath = false;\n523:       let pathDirection = 0; // 1: u->v, -1: v->u\n524: \n525:       for (let i = 0; i < this.activeCorridorPath.length - 1; i++) {\n526:         const a = this.activeCorridorPath[i];\n527:         const b = this.activeCorridorPath[i + 1];\n528:         if (a === corridor.u && b === corridor.v) {\n529:           isPath = true;\n530:           pathDirection = 1;\n531:           break;\n532:         } else if (a === corridor.v && b === corridor.u) {\n533:           isPath = true;\n534:           pathDirection = -1;\n535:           break;\n536:         }\n537:       }\n538: \n539:       ctx.save();\n540:       ctx.beginPath();\n541:       ctx.moveTo(p1.x, p1.y);\n542:       ctx.lineTo(p2.x, p2.y);\n543: \n544:       if (isPath) {\n545:         // Base route vector line\n546:         ctx.strokeStyle = '#2563EB';\n547:         ctx.lineWidth = 4.5;\n548:         ctx.stroke();\n549: \n550:         // Directional Flow Animation (Chevrons / dashed energy pulses)\n551:         ctx.save();\n552:         ctx.beginPath();\n553:         const startP = pathDirection === 1 ? p1 : p2;\n554:         const endP = pathDirection === 1 ? p2 : p1;\n555:         ctx.moveTo(startP.x, startP.y);\n556:         ctx.lineTo(endP.x, endP.y);\n557:         ctx.strokeStyle = '#60A5FA';\n558:         ctx.lineWidth = 2.5;\n559:         ctx.setLineDash([8, 12]);\n560:         ctx.lineDashOffset = this.flowDashOffset;\n561:         ctx.stroke();\n562:         ctx.restore();\n563:       } else {\n564:         ctx.strokeStyle = '#CBD5E1';\n565:         ctx.lineWidth = 2;\n566:         ctx.stroke();\n567:       }\n568:       ctx.restore();\n569: \n570:       // Corridor Distance Tag\n571:       const midX = (p1.x + p2.x) / 2;\n572:       const midY = (p1.y + p2.y) / 2;\n573:       ctx.save();\n574:       ctx.fillStyle = isPath ? '#2563EB' : '#FFFFFF';\n575:       ctx.strokeStyle = isPath ? '#1D4ED8' : '#CBD5E1';\n576:       ctx.lineWidth = 1;\n577:       ctx.beginPath();\n578:       ctx.roundRect(midX - 16, midY - 9, 32, 18, 4);\n579:       ctx.fill();\n580:       ctx.stroke();\n581: \n582:       ctx.fillStyle = isPath ? '#FFFFFF' : '#475569';\n583:       ctx.font = 'bold 9px \"JetBrains Mono\"';\n584:       ctx.textAlign = 'center';\n585:       ctx.textBaseline = 'middle';\n586:       ctx.fillText(`${corridor.distance}km`, midX, midY);\n587:       ctx.restore();\n588:     });\n589: \n590:     // Draw Stations (Sorted by Z for depth)\n591:     const sorted = [...TRANSIT_STATIONS].map(s => ({\n592:       station: s,\n593:       proj: this.project(s.x, s.y, s.z)\n594:     })).sort((a, b) => b.proj.z - a.proj.z);\n595: \n596:     sorted.forEach(({ station, proj }) => {\n597:       const isPath = this.activeCorridorPath.includes(station.id);\n598:       const isHovered = this.hoveredStation && this.hoveredStation.id === station.id;\n599: \n600:       ctx.save();\n601: \n602:       // Floor Shadow\n603:       const floorProj = this.project(station.x, station.y, -30);\n604:       ctx.beginPath();\n605:       ctx.ellipse(floorProj.x, floorProj.y, 14 * proj.scale, 7 * proj.scale, 0, 0, Math.PI * 2);\n606:       ctx.fillStyle = 'rgba(15, 23, 42, 0.08)';\n607:       ctx.fill();\n608: \n609:       // Elevation Stem\n610:       ctx.beginPath();\n611:       ctx.moveTo(floorProj.x, floorProj.y);\n612:       ctx.lineTo(proj.x, proj.y);\n613:       ctx.strokeStyle = isPath ? 'rgba(5, 150, 105, 0.6)' : '#CBD5E1';\n614:       ctx.lineWidth = 1.5;\n615:       ctx.setLineDash([2, 3]);\n616:       ctx.stroke();\n617:       ctx.setLineDash([]);\n618: \n619:       // Station Circle\n620:       ctx.beginPath();\n621:       const radius = (isHovered ? 14 : 11) * proj.scale;\n622:       ctx.arc(proj.x, proj.y, radius, 0, Math.PI * 2);\n623: \n624:       if (isPath) {\n625:         ctx.fillStyle = '#059669';\n626:         ctx.shadowColor = 'rgba(5, 150, 105, 0.4)';\n627:         ctx.shadowBlur = 14;\n628:       } else if (isHovered) {\n629:         ctx.fillStyle = '#2563EB';\n630:         ctx.shadowColor = 'rgba(37, 99, 235, 0.4)';\n631:         ctx.shadowBlur = 12;\n632:       } else {\n633:         ctx.fillStyle = '#FFFFFF';\n634:         ctx.strokeStyle = '#059669';\n635:         ctx.lineWidth = 2.5;\n636:         ctx.stroke();\n637:       }\n638:       ctx.fill();\n639:       ctx.restore();\n640: \n641:       // Station Label & Zone\n642:       ctx.save();\n643:       ctx.font = '600 11px \"Inter\"';\n644:       ctx.fillStyle = isPath ? '#059669' : '#0F172A';\n645:       ctx.textAlign = 'center';\n646:       ctx.fillText(station.name, proj.x, proj.y - 18 * proj.scale);\n647:       ctx.font = '500 9px \"JetBrains Mono\"';\n648:       ctx.fillStyle = '#64748B';\n649:       ctx.fillText(station.zone, proj.x, proj.y + 20 * proj.scale);\n650:       ctx.restore();\n651:     });\n652: \n653:     // Draw Animated Electric Transit Car Driving Along Route\n654:     if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n655:       this.drawAnimatedCar();\n656:     }\n657:   }\n658: \n659:   drawAnimatedCar() {\n660:     const ctx = this.ctx;\n661:     const segmentIndex = Math.floor(this.carProgress);\n662:     const segmentT = this.carProgress - segmentIndex;\n663: \n664:     const fromId = this.activeCorridorPath[segmentIndex];\n665:     const toId = this.activeCorridorPath[segmentIndex + 1];\n666: \n667:     if (!fromId || !toId) return;\n668: \n669:     const s1 = TRANSIT_STATIONS.find(s => s.id === fromId);\n670:     const s2 = TRANSIT_STATIONS.find(s => s.id === toId);\n671: \n672:     // Interpolate 3D coordinates\n673:     const curX = s1.x + (s2.x - s1.x) * segmentT;\n674:     const curY = s1.y + (s2.y - s1.y) * segmentT;\n675:     const curZ = s1.z + (s2.z - s1.z) * segmentT;\n676: \n677:     const carProj = this.project(curX, curY, curZ);\n678: \n679:     // Calculate heading angle\n680:     const p1 = this.project(s1.x, s1.y, s1.z);\n681:     const p2 = this.project(s2.x, s2.y, s2.z);\n682:     const heading = Math.atan2(p2.y - p1.y, p2.x - p1.x);\n683: \n684:     ctx.save();\n685:     ctx.translate(carProj.x, carProj.y);\n686:     ctx.rotate(heading);\n687: \n688:     // Glowing Headlight Beams\n689:     ctx.beginPath();\n690:     ctx.moveTo(12 * carProj.scale, -4 * carProj.scale);\n691:     ctx.lineTo(26 * carProj.scale, -12 * carProj.scale);\n692:     ctx.lineTo(26 * carProj.scale, 12 * carProj.scale);\n693:     ctx.lineTo(12 * carProj.scale, 4 * carProj.scale);\n694:     ctx.closePath();\n695:     const lightGrad = ctx.createLinearGradient(12 * carProj.scale, 0, 26 * carProj.scale, 0);\n696:     lightGrad.addColorStop(0, 'rgba(32, 201, 176, 0.45)');\n697:     lightGrad.addColorStop(1, 'rgba(32, 201, 176, 0)');\n698:     ctx.fillStyle = lightGrad;\n699:     ctx.fill();\n700: \n701:     // Electric Vehicle Chassis\n702:     ctx.beginPath();\n703:     ctx.roundRect(-10 * carProj.scale, -6 * carProj.scale, 20 * carProj.scale, 12 * carProj.scale, 4 * carProj.scale);\n704:     ctx.fillStyle = '#059669';\n705:     ctx.fill();\n706:     ctx.strokeStyle = '#FFFFFF';\n707:     ctx.lineWidth = 1.5;\n708:     ctx.stroke();\n709: \n710:     // Windshield\n711:     ctx.beginPath();\n712:     ctx.roundRect(0, -4 * carProj.scale, 5 * carProj.scale, 8 * carProj.scale, 2 * carProj.scale);\n713:     ctx.fillStyle = '#93C5FD';\n714:     ctx.fill();\n715: \n716:     // Headlight bulbs\n717:     ctx.fillStyle = '#FEF08A';\n718:     ctx.fillRect(8 * carProj.scale, -5 * carProj.scale, 2 * carProj.scale, 2 * carProj.scale);\n719:     ctx.fillRect(8 * carProj.scale, 3 * carProj.scale, 2 * carProj.scale, 2 * carProj.scale);\n720: \n721:     ctx.restore();\n722:   }\n723: \n724:   drawGroundGrid() {\n725:     const ctx = this.ctx;\n726:     const size = 220;\n727:     const step = 44;\n728:     const floorZ = -30;\n729: \n730:     ctx.save();\n731:     ctx.strokeStyle = 'rgba(203, 213, 225, 0.6)';\n732:     ctx.lineWidth = 1;\n733: \n734:     for (let i = -size; i <= size; i += step) {\n735:       const p1 = this.project(i, -size, floorZ);\n736:       const p2 = this.project(i, size, floorZ);\n737:       ctx.beginPath();\n738:       ctx.moveTo(p1.x, p1.y);\n739:       ctx.lineTo(p2.x, p2.y);\n740:       ctx.stroke();\n741: \n742:       const p3 = this.project(-size, i, floorZ);\n743:       const p4 = this.project(size, i, floorZ);\n744:       ctx.beginPath();\n745:       ctx.moveTo(p3.x, p3.y);\n746:       ctx.lineTo(p4.x, p4.y);\n747:       ctx.stroke();\n748:     }\n749:     ctx.restore();\n750:   }\n751: }\n752: \n753: let urbanCanvasInstance = null;\n754: let ambientCanvasInstance = null;\n755: \n756: // ==========================================\n757: // 5. ECOSPROUT MASCOT VECTOR TEMPLATE\n758: // ==========================================\n759: function getEcoSproutSVG() {\n760:   return `\n761:     <svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n762:       <!-- Mascot Head -->\n763:       <circle cx=\"32\" cy=\"38\" r=\"18\" fill=