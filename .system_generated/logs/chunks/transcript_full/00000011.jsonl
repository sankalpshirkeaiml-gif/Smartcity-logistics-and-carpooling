{"step_index":156,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:25:43Z","content":"Created At: 2026-10-20T11:55:43+05:30\nCompleted At: 2026-10-20T11:55:43+05:30\nShowing lines 1400-1661 of 1661\n1400:   });\n1401: \n1402:   // --- Passenger Request ---\n1403:   document.getElementById('btn-request-ride').addEventListener('click', () => {\n1404:     const nameInput = document.getElementById('passenger-name-input');\n1405:     const name = nameInput.value.trim() || `Commuter_${Math.floor(Math.random() * 900 + 100)}`;\n1406:     const pickup = passPickup.value;\n1407:     const drop = passDrop.value;\n1408: \n1409:     if (pickup === drop) {\n1410:       showPlatformToast('Pickup and drop-off stations must be distinct.', 'rose');\n1411:       return;\n1412:     }\n1413: \n1414:     const passenger = engine.submitRideRequest(name, pickup, drop);\n1415:     nameInput.value = '';\n1416:     refreshPlatformUI();\n1417:     showPlatformToast(`Ride request submitted for ${passenger.name} (${pickup} → ${drop}).`, 'emerald');\n1418:   });\n1419: \n1420:   document.getElementById('btn-cancel-front-req').addEventListener('click', () => {\n1421:     const dequeued = engine.dequeueNextRequest();\n1422:     if (dequeued) {\n1423:       refreshPlatformUI();\n1424:       showPlatformToast(`Dispatched or cancelled request for ${dequeued.name} (${dequeued.id}).`, 'amber');\n1425:     } else {\n1426:       showPlatformToast('No pending passenger requests in the pipeline.', 'rose');\n1427:     }\n1428:   });\n1429: \n1430:   // --- Priority Standby Lounge ---\n1431:   document.getElementById('btn-push-standby').addEventListener('click', () => {\n1432:     let candidate = engine.dequeueNextRequest();\n1433:     if (!candidate) {\n1434:       candidate = {\n1435:         id: `BK-STDBY-${Math.floor(Math.random() * 800 + 100)}`,\n1436:         name: `Standby_Passenger_${Math.floor(Math.random() * 90 + 10)}`,\n1437:         pickup: 'METRO',\n1438:         drop: 'SKYPORT',\n1439:         requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n1440:         status: 'In Priority Standby'\n1441:       };\n1442:     }\n1443: \n1444:     const res = engine.pushToStandby(candidate);\n1445:     if (!res.success) {\n1446:       showPlatformToast(res.message, 'rose');\n1447:       engine.dispatchStream.unshift(candidate);\n1448:     } else {\n1449:       showPlatformToast(`${candidate.name} admitted to Priority Standby Lounge.`, 'amber');\n1450:     }\n1451:     refreshPlatformUI();\n1452:   });\n1453: \n1454:   document.getElementById('btn-pop-standby').addEventListener('click', () => {\n1455:     const res = engine.popFromStandby();\n1456:     if (!res.success) {\n1457:       showPlatformToast(res.message, 'rose');\n1458:     } else {\n1459:       showPlatformToast(`Seated ${res.item.name} from Priority Standby Lounge.`, 'amber');\n1460:     }\n1461:     refreshPlatformUI();\n1462:   });\n1463: \n1464:   // --- Driver Partner Registration with Visual Seat Selector ---\n1465:   document.getElementById('btn-register-driver').addEventListener('click', () => {\n1466:     const nameInput = document.getElementById('driver-name-input');\n1467:     const name = nameInput.value.trim() || `Partner_${Math.floor(Math.random() * 900 + 100)}`;\n1468:     const station = driverStation.value;\n1469:     const seats = getActiveSeatsCount();\n1470: \n1471:     if (seats === 0) {\n1472:       showPlatformToast('Please toggle at least 1 passenger seat in the vehicle blueprint.', 'rose');\n1473:       return;\n1474:     }\n1475: \n1476:     const partner = engine.onboardDriver(name, station, seats);\n1477:     nameInput.value = '';\n1478:     refreshPlatformUI();\n1479:     showPlatformToast(`Driver Partner ${partner.name} onboarded with ${partner.seats} passenger seats (ID: #${partner.id}).`, 'emerald');\n1480:   });\n1481: \n1482:   // --- Flexible Verification & Lookup ---\n1483:   document.getElementById('btn-verify-id').addEventListener('click', () => {\n1484:     const idInput = document.getElementById('verify-id-input');\n1485:     const resultBox = document.getElementById('verification-result-box');\n1486:     const query = idInput.value.trim();\n1487: \n1488:     if (!query) {\n1489:       resultBox.innerHTML = '<span class=\"text-rose-500 text-xs\">Please enter a valid Driver Partner ID or Booking Reference.</span>';\n1490:       return;\n1491:     }\n1492: \n1493:     const partner = engine.getDriverById(query);\n1494:     if (partner) {\n1495:       resultBox.innerHTML = `\n1496:         <div class=\"flex items-center justify-between w-full text-xs\">\n1497:           <div>\n1498:             <span class=\"text-emerald font-bold\"><i class=\"fa-solid fa-circle-check\"></i> Verified Partner:</span>\n1499:             <span class=\"text-slate-900 font-semibold ml-1\">${partner.name} (ID: #${partner.id})</span>\n1500:             <span class=\"text-slate-500 ml-2\">&bull; ${partner.station} Station</span>\n1501:           </div>\n1502:           <span class=\"seat-counter-pill\">${partner.seats} Seats Free</span>\n1503:         </div>`;\n1504:       showPlatformToast(`Verified operational identity for Partner #${partner.id}.`, 'emerald');\n1505:       return;\n1506:     }\n1507: \n1508:     const booking = engine.getBookingByRef(query);\n1509:     if (booking) {\n1510:       resultBox.innerHTML = `\n1511:         <div class=\"flex items-center justify-between w-full text-xs\">\n1512:           <div>\n1513:             <span class=\"text-electric font-bold\"><i class=\"fa-solid fa-ticket\"></i> Verified Booking:</span>\n1514:             <span class=\"text-slate-900 font-semibold ml-1\">${booking.tripRef} (${booking.passenger.name})</span>\n1515:             <span class=\"text-slate-500 ml-2\">&bull; Driver: ${booking.driverName}</span>\n1516:           </div>\n1517:           <span class=\"route-match-badge\">${booking.matchScore}% Match</span>\n1518:         </div>`;\n1519:       showPlatformToast(`Verified booking reference ${booking.tripRef}.`, 'blue');\n1520:       return;\n1521:     }\n1522: \n1523:     resultBox.innerHTML = `<span class=\"text-rose-500 text-xs\"><i class=\"fa-solid fa-triangle-exclamation\"></i> Reference \"${query}\" not found in metropolitan fleet or booking registry.</span>`;\n1524:     showPlatformToast(`Reference \"${query}\" not recognized.`, 'rose');\n1525:   });\n1526: \n1527:   // --- Match & Dispatch Shared Trip (Triggering Enterprise Confirmation Modal) ---\n1528:   document.getElementById('btn-auto-match-trip').addEventListener('click', () => {\n1529:     let passenger = engine.dequeueNextRequest();\n1530:     if (!passenger && engine.standbyCount > 0) {\n1531:       passenger = engine.popFromStandby().item;\n1532:     }\n1533: \n1534:     if (!passenger) {\n1535:       showPlatformToast('No pending commuter requests waiting to be dispatched.', 'rose');\n1536:       return;\n1537:     }\n1538: \n1539:     let matchedPartner = null;\n1540:     for (const partner of engine.fleetPartners) {\n1541:       if (partner.seats > 0) {\n1542:         matchedPartner = partner;\n1543:         break;\n1544:       }\n1545:     }\n1546: \n1547:     if (!matchedPartner) {\n1548:       engine.dispatchStream.unshift(passenger);\n1549:       showPlatformToast('All driver partners are currently at maximum passenger capacity.', 'rose');\n1550:       return;\n1551:     }\n1552: \n1553:     const route = engine.findOptimalEcoRoute(passenger.pickup, passenger.drop);\n1554:     const matchScore = Math.floor(Math.random() * 14 + 85);\n1555: \n1556:     const trip = engine.dispatchSharedTrip(\n1557:       passenger,\n1558:       matchedPartner,\n1559:       route.path,\n1560:       route.totalDist,\n1561:       route.estTime,\n1562:       route.fare,\n1563:       route.co2Offset,\n1564:       matchScore\n1565:     );\n1566: \n1567:     urbanCanvasInstance.setActivePath(route.path);\n1568:     refreshPlatformUI();\n1569:     openDispatchModal(trip, matchedPartner);\n1570:   });\n1571: \n1572:   // --- Revert Confirmation (Triggering Enterprise Reversal Modal) ---\n1573:   document.getElementById('btn-revert-confirmation').addEventListener('click', () => {\n1574:     const res = engine.revertLatestConfirmation();\n1575:     if (!res.success) {\n1576:       showPlatformToast(res.message, 'rose');\n1577:     } else {\n1578:       refreshPlatformUI();\n1579:       openReversalModal(res.action, res.driver);\n1580:     }\n1581:   });\n1582: \n1583:   // --- Rush-Hour Simulation Scenario ---\n1584:   document.getElementById('btn-demo-rushhour').addEventListener('click', () => {\n1585:     engine.onboardDriver('Marcus Vance', 'ALPHA', 3);\n1586:     engine.onboardDriver('Elena Rostova', 'METRO', 3);\n1587:     engine.onboardDriver('Kaelen Chen', 'SKYPORT', 2);\n1588:     engine.onboardDriver('Siddharth Rao', 'QUANTUM', 3);\n1589: \n1590:     engine.submitRideRequest('Dr. Aris Thorne', 'ALPHA', 'HORIZON');\n1591:     engine.submitRideRequest('Maya Lin', 'METRO', 'SKYPORT');\n1592:     engine.submitRideRequest('Amara Okafor', 'HARBOR', 'QUANTUM');\n1593: \n1594:     engine.pushToStandby({\n1595:       id: 'BK-STDBY-01',\n1596:       name: 'Taro Watanabe',\n1597:       pickup: 'HARBOR',\n1598:       drop: 'HORIZON',\n1599:       requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n1600:       status: 'Priority Standby'\n1601:     });\n1602: \n1603:     const p = engine.dequeueNextRequest();\n1604:     const d = engine.fleetPartners[0];\n1605:     const r = engine.findOptimalEcoRoute(p.pickup, p.drop);\n1606:     const trip = engine.dispatchSharedTrip(p, d, r.path, r.totalDist, r.estTime, r.fare, r.co2Offset, 96);\n1607: \n1608:     urbanCanvasInstance.setActivePath(r.path);\n1609:     refreshPlatformUI();\n1610:     showPlatformToast('Simulated Metropolitan Rush-Hour scenario loaded with live fleet, commuters, and active trips!', 'emerald');\n1611:   });\n1612: \n1613:   // --- Quick Book CTA in Header ---\n1614:   document.getElementById('btn-quick-book').addEventListener('click', () => {\n1615:     const commuterTabBtn = document.querySelector('[data-tab=\"tab-passenger-hub\"]');\n1616:     if (commuterTabBtn) commuterTabBtn.click();\n1617:     setTimeout(() => {\n1618:       document.getElementById('passenger-name-input').focus();\n1619:     }, 150);\n1620:   });\n1621: \n1622:   // --- Dispatch Modal Actions ---\n1623:   const dispatchModal = document.getElementById('dispatch-confirm-modal');\n1624:   document.getElementById('btn-close-dispatch-modal').addEventListener('click', () => {\n1625:     dispatchModal.classList.add('hidden');\n1626:   });\n1627:   document.getElementById('btn-ack-dispatch').addEventListener('click', () => {\n1628:     dispatchModal.classList.add('hidden');\n1629:   });\n1630:   document.getElementById('btn-view-map-dispatch').addEventListener('click', () => {\n1631:     dispatchModal.classList.add('hidden');\n1632:     const mapTabBtn = document.querySelector('[data-tab=\"tab-route-finder\"]');\n1633:     if (mapTabBtn) mapTabBtn.click();\n1634:     urbanCanvasInstance.startCarSimulation();\n1635:   });\n1636: \n1637:   // --- Reversal Modal Actions ---\n1638:   const reversalModal = document.getElementById('reversal-confirm-modal');\n1639:   document.getElementById('btn-close-reversal-modal').addEventListener('click', () => {\n1640:     reversalModal.classList.add('hidden');\n1641:   });\n1642:   document.getElementById('btn-ack-reversal').addEventListener('click', () => {\n1643:     reversalModal.classList.add('hidden');\n1644:   });\n1645: \n1646:   // --- Eco-Receipt Modal Controls ---\n1647:   const receiptModal = document.getElementById('receipt-modal-overlay');\n1648:   document.getElementById('btn-close-receipt').addEventListener('click', () => {\n1649:     receiptModal.classList.add('hidden');\n1650:   });\n1651:   document.getElementById('btn-done-receipt').addEventListener('click', () => {\n1652:     receiptModal.classList.add('hidden');\n1653:   });\n1654:   document.getElementById('btn-print-receipt').addEventListener('click', () => {\n1655:     window.print();\n1656:   });\n1657: \n1658:   // Initial Startup\n1659:   refreshPlatformUI();\n1660:   computeAndDisplayRoute();\n1661: });"}
