- ((count - 1) * spacing) / 2;\n1041: \n1042:   engine.activeTrips.forEach((trip, idx) => {\n1043:     const nodeX = startX + idx * spacing;\n1044:     const nodeY = 110;\n1045: \n1046:     ctx.beginPath();\n1047:     ctx.moveTo(rootX, rootY + 14);\n1048:     ctx.lineTo(nodeX, nodeY - 14);\n1049:     ctx.strokeStyle = '#CBD5E1';\n1050:     ctx.lineWidth = 1.5;","truncated_fields":["content"]}
