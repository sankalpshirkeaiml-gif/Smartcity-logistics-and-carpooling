\n453: \n454: .slider-header {\n455:   display: flex;\n456:   justify-content: space-between;\n457:   align-items: center;\n458:   gap: 0.75rem;\n459: }\n460: \n461: .fare-pill {\n462:   background: #FFFFFF;\n463:   border: 1px solid var(--emerald-border);\n464:   padding: 0.35rem 0.75rem;\n465:   border-radius: 8px;\n466:   display: flex;\n467:   align-items: center;\n468:   gap: 0.4rem;\n469:   box-shadow: 0 2px 6px var(--emerald-glow);\n470: }\n471: \n472: .slider-range-input {\n473:   width: 100%;\n474:   accent-color: var(--emerald);\n475:   cursor: pointer;\n476:   height: 6px;\n477:   background: #E2E8F0;\n478:   border-radius: 6px;\n479:   outline: none;\n480: }"}
