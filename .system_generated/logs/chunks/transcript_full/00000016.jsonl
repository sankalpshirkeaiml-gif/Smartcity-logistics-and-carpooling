ss=\"chassis-row\">\n                    <div class=\"vehicle-seat active-seat\" id=\"seat-rear-left\" data-seat=\"rear-left\" title=\"Toggle Rear Left Seat\">\n                      <i class=\"fa-solid fa-user-check\"></i>\n                      <span>REAR L</span>\n                    </div>\n                    <div class=\"vehicle-seat active-seat\" id=\"seat-rear-right\" data-seat=\"rear-right\" title=\"Toggle Rear Right Seat\">\n                      <i class=\"fa-solid fa-user-check\"></i>\n                      <span>REAR R</span>\n                    </div>\n                  </div>\n                </div>\n              </div>\n\n              <button id=\"btn-register-driver\" class=\"btn btn-emerald w-full\">\n                <i class=\"fa-solid fa-car-on\"></i> Onboard Partner\n              </button>\n            </div>\n\n            <!-- Identity Verification Box -->\n            <div class=\"verification-bar-card\">\n              <div class=\"card-header-clean\">\n                <div>\n                  <h4 class=\"card-title text-sm\">\n                    <i class=\"fa-solid fa-magnifying-glass text-electric\"></i>\n                    <span>Fast Verification Lookup</span>\n                  </h4>\n                  <p class=\"card-subtitle\">Driver ID (#101) or Booking Ref (NX-501)</p>\n                </div>\n              </div>\n              <div class=\"search-input-row\">\n                <input type=\"text\" id=\"verify-id-input\" placeholder=\"Enter ID (e.g. 101, NX-501)\" class=\"text-input\" />\n                <button id=\"btn-verify-id\" class=\"btn btn-outline\">\n                  <i class=\"fa-solid fa-check-double text-emerald\"></i> Verify\n                </button>\n              </div>\n              <div class=\"verification-result-box\" id=\"verification-result-box\">\n                <span class=\"text-slate-500 text-xs\">Enter a Driver ID or Booking Reference to verify.</span>\n              </div>\n            </div>\n          </div>\n\n          <!-- Right Column: Fleet Directory & Active Trips Console -->\n          <div class=\"fleet-operations-column\">\n\n            <!-- Active Partners Stream -->\n            <div class=\"white-card eco-card-hover p-4\">\n              <div class=\"card-header-clean\">\n                <div>\n                  <h3 class=\"card-title\">\n                    <i class=\"fa-solid fa-list-check text-emerald\"></i>\n                    <span>Fleet Partner Directory</span>\n                  </h3>\n                  <p class=\"card-subtitle\" id=\"fleet-capacity-pill\">Total Available Seats: 0</p>\n                </div>\n              </div>\n              <div class=\"fleet-stream-container\" id=\"fleet-stream-container\">\n                <!-- Populated dynamically -->\n              </div>\n            </div>\n\n            <!-- Active Trips & Reversal Console -->\n            <div class=\"white-card eco-card-hover p-4\">\n              <div class=\"card-header-clean\">\n                <div>\n                  <h3 class=\"card-title\">\n                    <i class=\"fa-solid fa-car-side text-purple\"></i>\n                    <span>Active Shared Trips Console</span>\n                  </h3>\n                  <p class=\"card-subtitle\" id=\"active-trips-badge\">0 In-Transit</p>\n                </div>\n                <div class=\"flex gap-2\">\n                  <button id=\"btn-auto-match-trip\" class=\"btn btn-primary btn-sm\">\n                    <i class=\"fa-solid fa-handshake\"></i> Dispatch Next\n                  </button>\n                  <button id=\"btn-revert-confirmation\" class=\"btn btn-rose btn-sm\" title=\"Revert last confirmation\">\n                    <i class=\"fa-solid fa-rotate-left\"></i> Revert Last\n                  </button>\n                </div>\n              </div>\n\n              <!-- Shared Trips List -->\n              <div class=\"active-trips-stream\" id=\"active-trips-stream\">\n                <!-- Populated dynamically -->\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n      <!-- ==========================================\n           TAB 4: CITY SUSTAINABILITY ANALYTICS\n           ========================================== -->\n      <section id=\"tab-sustainability\" class=\"tab-view\">\n        <div class=\"view-grid-analytics\">\n\n          <!-- Analytics KPI Metric Cards -->\n          <div class=\"analytics-metrics-strip\">\n            <div class=\"analytics-kpi-card white-card eco-card-hover\">\n              <div class=\"text-2xl font-black text-emerald\" id=\"eco-total-co2\">148.5 kg</div>\n              <div class=\"text-xs font-semibold text-slate-700\">Net CO₂ Atmospheric Reduction</div>\n              <span class=\"text-[11px] text-slate-500\">Continuous emissions avoidance</span>\n            </div>\n\n            <div class=\"analytics-kpi-card white-card eco-card-hover\">\n              <div class=\"text-2xl font-black text-electric\" id=\"eco-shared-km\">1,420 km</div>\n              <div class=\"text-xs font-semibold text-slate-700\">Collective Pooled Distance</div>\n              <span class=\"text-[11px] text-slate-500\">Shared vehicle passenger mileage</span>\n            </div>\n\n            <div class=\"analytics-kpi-card white-card eco-card-hover\">\n              <div class=\"text-2xl font-black text-amber\">94.2%</div>\n              <div class=\"text-xs font-semibold text-slate-700\">Corridor Alignment Efficiency</div>\n              <span class=\"text-[11px] text-slate-500\">Optimal pooled routing match score</span>\n            </div>\n          </div>\n\n          <!-- Two-Column Layout: Hierarchy Canvas & Leaderboard -->\n          <div class=\"analytics-two-col\">\n\n            <!-- Left: Transit Registry Canvas & Reversal Audit History -->\n            <div class=\"white-card eco-card-hover p-4 flex flex-col gap-4\">\n              <div class=\"card-header-clean\">\n                <div>\n                  <h3 class=\"card-title\">\n                    <i class=\"fa-solid fa-bezier-curve text-electric\"></i>\n                    <span>Transit Dispatch Hierarchy</span>\n                  </h3>\n                  <p class=\"card-subtitle\" id=\"registry-count-pill\">0 Active Trips</p>\n                </div>\n              </div>\n              <div class=\"canvas-box\">\n                <canvas id=\"trip-hierarchy-canvas\" width=\"600\" height=\"150\" class=\"w-full\"></canvas>\n              </div>\n\n              <!-- Audit Rollback History -->\n              <div class=\"card-header-clean pt-2\">\n                <div>\n                  <h4 class=\"card-title text-sm\">\n                    <i class=\"fa-solid fa-clock-rotate-left text-slate-600\"></i>\n                    <span>Reversal Audit Log</span>\n                  </h4>\n                  <p class=\"card-subtitle\" id=\"audit-log-pill\">0 Rollbacks Available</p>\n                </div>\n              </div>\n              <div class=\"audit-history-list\" id=\"audit-history-list\">\n                <!-- Dynamic log items -->\n              </div>\n            </div>\n\n            <!-- Right: Eco-Partner Leaderboard -->\n            <div class=\"white-card eco-card-hover p-4 flex flex-col gap-3\">\n              <div class=\"card-header-clean\">\n                <div>\n                  <h3 class=\"card-title\">\n                    <i class=\"fa-solid fa-trophy text-amber\"></i>\n                    <span>Top Eco-Mobility Partners</span>\n                  </h3>\n                  <p class=\"card-subtitle\">Leaderboard and gamified achievement badges</p>\n                </div>\n              </div>\n              <div class=\"leaderboard-list\" id=\"eco-leaderboard-list\">\n                <!-- Dynamic Leaderboard Items -->\n              </div>\n            </div>\n\n          </div>\n\n        </div>\n      </section>\n\n    </main>\n\n    <!-- Platform Footer -->\n    <footer class=\"app-footer\">\n      <div class=\"footer-left\">\n        <span class=\"font-bold text-slate-900\">NexusMobility Technologies Inc.</span> &bull; Intelligent Urban Transit &amp; Eco-Logistics Infrastructure\n      </div>\n      <div class=\"footer-right\">\n        <span><i class=\"fa-solid fa-shield-halved text-emerald\"></i> Enterprise SLA: 99.99%</span>\n        <span><i class=\"fa-solid fa-signal text-electric\"></i> Real-Time Telemetry Active</span>\n      </div>\n    </footer>\n  </div>\n\n  <!-- Enterprise Modal 1: Dispatch Confirmation Dialog -->\n  <div class=\"modal-overlay hidden\" id=\"dispatch-confirm-modal\">\n    <div class=\"modal-card white-card\">\n      <div class=\"modal-header\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"brand-icon small-icon bg-emerald-light\"><i class=\"fa-solid fa-car-rear text-emerald\"></i></div>\n          <div>\n            <h3 class=\"font-bold text-slate-900\">Trip Dispatched Successfully!</h3>\n            <p class=\"text-xs text-slate-500 font-mono\">Metropolitan Shared Transit Alignment Confirmed</p>\n          </div>\n        </div>\n        <button id=\"btn-close-dispatch-modal\" class=\"btn btn-ghost\"><i class=\"fa-solid fa-xmark text-lg\"></i></button>\n      </div>\n\n      <div class=\"modal-dialog-body\" id=\"dispatch-modal-body\">\n        <!-- Injected dynamically -->\n      </div>\n\n      <div class=\"modal-footer\">\n        <button id=\"btn-view-map-dispatch\" class=\"btn btn-outline\"><i class=\"fa-solid fa-map-location-dot\"></i> View on Route Map</button>\n        <button id=\"btn-ack-dispatch\" class=\"btn btn-emerald\">Acknowledge Dispatch</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Enterprise Modal 2: Trip Reversal & Rollback Dialog -->\n  <div class=\"modal-overlay hidden\" id=\"reversal-confirm-modal\">\n    <div class=\"modal-card white-card\">\n      <div class=\"modal-header\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"brand-icon small-icon bg-rose-light\"><i class=\"fa-solid fa-rotate-left text-rose\"></i></div>\n          <div>\n            <h3 class=\"font-bold text-slate-900\">Dispatch Confirmation Reverted</h3>\n            <p class=\"text-xs text-slate-500 font-mono\">Safe Rollback &amp; Fleet Capacity Restored</p>\n          </div>\n        </div>\n        <button id=\"btn-close-reversal-modal\" class=\"btn btn-ghost\"><i class=\"fa-solid fa-xmark text-lg\"></i></button>\n      </div>\n\n      <div class=\"modal-dialog-body\" id=\"reversal-modal-body\">\n        <!-- Injected dynamically -->\n      </div>\n\n      <div class=\"modal-footer\">\n        <button id=\"btn-ack-reversal\" class=\"btn btn-primary\">Done</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Modal 3: Official Eco-Transit Journey Receipt -->\n  <div class=\"modal-overlay hidden\" id=\"receipt-modal-overlay\">\n    <div class=\"modal-card white-card\" id=\"receipt-modal-card\">\n      <div class=\"modal-header\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"brand-icon small-icon\"><i class=\"fa-solid fa-leaf text-emerald\"></i></div>\n          <div>\n            <h3 class=\"font-bold text-slate-900\">Official Eco-Transit Journey Receipt</h3>\n            <p class=\"text-xs text-slate-500 font-mono\">Metropolitan Shared Mobility Environmental Audit</p>\n          </div>\n        </div>\n        <button id=\"btn-close-receipt\" class=\"btn btn-ghost\"><i class=\"fa-solid fa-xmark text-lg\"></i></button>\n      </div>\n\n      <div class=\"receipt-content\" id=\"receipt-content-area\">\n        <!-- Receipt details populated dynamically -->\n      </div>\n\n      <div class=\"modal-footer\">\n        <button id=\"btn-print-receipt\" class=\"btn btn-outline\"><i class=\"fa-solid fa-print\"></i> Print Receipt</button>\n        <button id=\"btn-done-receipt\" class=\"btn btn-primary\">Done</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Notification