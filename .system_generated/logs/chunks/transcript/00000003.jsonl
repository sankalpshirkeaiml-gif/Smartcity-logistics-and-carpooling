e`;\n1091: \n1092:   if (engine.reversalAuditLog.length === 0) {\n1093:     container.innerHTML = `\n1094:       <div class=\"empty-state\">\n1095:         <p>Reversal log clear. Confirm a trip to create a restorable dispatch state.</p>\n1096:       </div>`;\n1097:     return;\n1098:   }\n1099: \n1100:   const latestIdx = engine.reversalAuditLog.length - 1;","truncated_fields":["content"]}
