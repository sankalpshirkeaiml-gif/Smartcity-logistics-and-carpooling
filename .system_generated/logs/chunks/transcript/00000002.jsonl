tHTML('beforeend', opt);\n1291:     passDrop.insertAdjacentHTML('beforeend', opt);\n1292:     driverStation.insertAdjacentHTML('beforeend', opt);\n1293:   });\n1294: \n1295:   originSel.value = 'ALPHA';\n1296:   destSel.value = 'HORIZON';\n1297:   passPickup.value = 'ALPHA';\n1298:   passDrop.value = 'HORIZON';\n1299:   driverStation.value = 'METRO';\n1300: ","truncated_fields":["content"]}
