{"step_index":154,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:16:20Z","content":"Created At: 2026-10-20T11:46:20+05:30\nCompleted At: 2026-10-20T11:46:20+05:30\nShowing lines 1051-1300 of 1652\n1051:     ctx.stroke();\n1052: \n1053:     ctx.beginPath();\n1054:     ctx.arc(nodeX, nodeY, 13, 0, Math.PI * 2);\n1055:     ctx.fillStyle = '#FFFFFF';\n1056:     ctx.strokeStyle = '#2563EB';\n1057:     ctx.lineWidth = 2;\n1058:     ctx.shadowColor = 'rgba(37, 99, 235, 0.2)';\n1059:     ctx.shadowBlur = 6;\n1060:     ctx.fill();\n1061:     ctx.stroke();\n1062:     ctx.shadowBlur = 0;\n1063: \n1064:     ctx.fillStyle = '#1E293B';\n1065:     ctx.font = 'bold 8px \"JetBrains Mono\"';\n1066:     ctx.textAlign = 'center';\n1067:     ctx.fillText(trip.tripRef.replace('NX-', ''), nodeX, nodeY);\n1068: \n1069:     ctx.fillStyle = '#059669';\n1070:     ctx.font = '500 8px \"Inter\"';\n1071:     ctx.fillText(trip.passenger.name.split(' ')[0], nodeX, nodeY + 22);\n1072:   });\n1073: }\n1074: \n1075: // --- Reversal Audit History List ---\n1076: function renderAuditHistory() {\n1077:   const container = document.getElementById('audit-history-list');\n1078:   const pill = document.getElementById('audit-log-pill');\n1079:   if (!container || !pill) return;\n1080: \n1081:   pill.textContent = `${engine.reversalAuditLog.length} Rollbacks Available`;\n1082: \n1083:   if (engine.reversalAuditLog.length === 0) {\n1084:     container.innerHTML = `\n1085:       <div class=\"empty-state\">\n1086:         <p>Reversal log clear. Confirm a trip to create a restorable dispatch state.</p>\n1087:       </div>`;\n1088:     return;\n1089:   }\n1090: \n1091:   const latestIdx = engine.reversalAuditLog.length - 1;\n1092:   container.innerHTML = engine.reversalAuditLog.map((entry, idx) => `\n1093:     <div class=\"audit-entry ${idx === latestIdx ? 'latest-entry' : ''}\">\n1094:       <div class=\"flex items-center gap-2\">\n1095:         <i class=\"fa-solid fa-shield-check text-emerald\"></i>\n1096:         <span class=\"font-semibold text-slate-800\">${entry.tripRef} &bull; ${entry.passenger.name}</span>\n1097:       </div>\n1098:       <span class=\"text-slate-500 font-mono text-[10px]\">Driver #${entry.driverId}</span>\n1099:     </div>\n1100:   `).join('');\n1101: }\n1102: \n1103: // --- Leaderboard with Gamified Achievement Badges ---\n1104: function renderLeaderboard() {\n1105:   const container = document.getElementById('eco-leaderboard-list');\n1106:   if (!container) return;\n1107: \n1108:   container.innerHTML = engine.leaderboard.map((item, idx) => `\n1109:     <div class=\"leader-item\">\n1110:       <div class=\"flex items-center gap-2\">\n1111:         <span class=\"text-amber-500 font-bold\">#${idx + 1}</span>\n1112:         <div>\n1113:           <div class=\"font-semibold text-slate-800\">${item.name}</div>\n1114:           <span class=\"gamified-badge\"><i class=\"fa-solid fa-award\"></i> ${item.badge}</span>\n1115:         </div>\n1116:       </div>\n1117:       <div class=\"flex items-center gap-3\">\n1118:         <span class=\"text-slate-500\">${item.trips} trips</span>\n1119:         <span class=\"text-emerald font-semibold\">${item.co2}</span>\n1120:         <span class=\"text-amber-600 font-mono text-[11px]\"><i class=\"fa-solid fa-star\"></i> ${item.rating}</span>\n1121:       </div>\n1122:     </div>\n1123:   `).join('');\n1124: }\n1125: \n1126: // ==========================================\n1127: // 8. ENTERPRISE CONFIRMATION MODALS\n1128: // ==========================================\n1129: function openDispatchModal(trip, driver) {\n1130:   const modal = document.getElementById('dispatch-confirm-modal');\n1131:   const body = document.getElementById('dispatch-modal-body');\n1132: \n1133:   body.innerHTML = `\n1134:     <div class=\"flex items-center gap-3 p-3 bg-emerald-50 border border-emerald-200 rounded-xl\">\n1135:       <div class=\"text-2xl text-emerald\"><i class=\"fa-solid fa-circle-check\"></i></div>\n1136:       <div>\n1137:         <div class=\"text-sm font-bold text-slate-900\">Trip Reference: ${trip.tripRef}</div>\n1138:         <div class=\"text-xs text-slate-600\">Passenger ${trip.passenger.name} matched with ${driver.name} (ID: #${driver.id})</div>\n1139:       </div>\n1140:     </div>\n1141: \n1142:     <div class=\"modal-stat-grid\">\n1143:       <div class=\"modal-stat-box\">\n1144:         <span class=\"stat-label\">CORRIDOR ALIGNMENT</span>\n1145:         <span class=\"stat-val text-emerald\">${trip.matchScore}% Match</span>\n1146:       </div>\n1147:       <div class=\"modal-stat-box\">\n1148:         <span class=\"stat-label\">EST. COMMUTE TIME</span>\n1149:         <span class=\"stat-val text-electric\">~${trip.time} mins (${trip.distance}km)</span>\n1150:       </div>\n1151:       <div class=\"modal-stat-box\">\n1152:         <span class=\"stat-label\">POOLED FARE</span>\n1153:         <span class=\"stat-val text-slate-900\">$${trip.fare} USD</span>\n1154:       </div>\n1155:       <div class=\"modal-stat-box\">\n1156:         <span class=\"stat-label\">CARBON OFFSET</span>\n1157:         <span class=\"stat-val text-emerald\">+${trip.co2Saved} kg CO₂</span>\n1158:       </div>\n1159:     </div>\n1160: \n1161:     <div class=\"text-xs text-slate-500 font-mono\">\n1162:       Route Transit: ${trip.corridorPath.join(' &rarr; ')} &bull; Fleet seats remaining for #${driver.id}: ${driver.seats}\n1163:     </div>\n1164:   `;\n1165: \n1166:   modal.classList.remove('hidden');\n1167: }\n1168: \n1169: function openReversalModal(action, driver) {\n1170:   const modal = document.getElementById('reversal-confirm-modal');\n1171:   const body = document.getElementById('reversal-modal-body');\n1172: \n1173:   body.innerHTML = `\n1174:     <div class=\"flex items-center gap-3 p-3 bg-rose-50 border border-rose-200 rounded-xl\">\n1175:       <div class=\"text-2xl text-rose\"><i class=\"fa-solid fa-arrow-rotate-left\"></i></div>\n1176:       <div>\n1177:         <div class=\"text-sm font-bold text-slate-900\">Reverted Trip: ${action.tripRef}</div>\n1178:         <div class=\"text-xs text-slate-600\">The most recent dispatch confirmation was safely reversed.</div>\n1179:       </div>\n1180:     </div>\n1181: \n1182:     <div class=\"modal-stat-grid\">\n1183:       <div class=\"modal-stat-box\">\n1184:         <span class=\"stat-label\">RESTORED DRIVER</span>\n1185:         <span class=\"stat-val text-slate-900\">${driver ? driver.name : `ID #${action.driverId}`}</span>\n1186:       </div>\n1187:       <div class=\"modal-stat-box\">\n1188:         <span class=\"stat-label\">UPDATED SEAT CAPACITY</span>\n1189:         <span class=\"stat-val text-emerald\">${driver ? `${driver.seats}/${driver.originalSeats} Seats` : 'Restored'}</span>\n1190:       </div>\n1191:     </div>\n1192: \n1193:     <div class=\"text-xs text-slate-600\">\n1194:       Commuter <b>${action.passenger.name}</b> has been returned to the front of the dispatch queue without losing priority.\n1195:     </div>\n1196:   `;\n1197: \n1198:   modal.classList.remove('hidden');\n1199: }\n1200: \n1201: // Global Toast System\n1202: function showPlatformToast(message, type = 'emerald') {\n1203:   const container = document.getElementById('toast-container');\n1204:   const toast = document.createElement('div');\n1205:   toast.className = `toast toast-${type}`;\n1206:   toast.innerHTML = `<i class=\"fa-solid fa-circle-check text-emerald\"></i><span>${message}</span>`;\n1207:   container.appendChild(toast);\n1208: \n1209:   setTimeout(() => {\n1210:     toast.style.opacity = '0';\n1211:     toast.style.transform = 'translateY(15px)';\n1212:     setTimeout(() => toast.remove(), 300);\n1213:   }, 3600);\n1214: }\n1215: \n1216: // Global trip completion hook\n1217: window.handleCompleteTrip = function(tripRef) {\n1218:   const removed = engine.cancelActiveTrip(tripRef);\n1219:   if (removed) {\n1220:     showPlatformToast(`Trip ${tripRef} successfully completed. Corridors updated.`, 'blue');\n1221:     refreshPlatformUI();\n1222:   }\n1223: };\n1224: \n1225: // Global Eco-Receipt viewer hook\n1226: window.viewEcoReceipt = function(tripRef) {\n1227:   const trip = engine.activeTrips.find(t => t.tripRef === tripRef);\n1228:   if (!trip) return;\n1229: \n1230:   const modal = document.getElementById('receipt-modal-overlay');\n1231:   const content = document.getElementById('receipt-content-area');\n1232: \n1233:   content.innerHTML = `\n1234:     <div class=\"receipt-item-row\">\n1235:       <span>Booking Reference:</span>\n1236:       <span class=\"font-mono font-bold text-slate-800\">${trip.tripRef}</span>\n1237:     </div>\n1238:     <div class=\"receipt-item-row\">\n1239:       <span>Commuter Name:</span>\n1240:       <span class=\"font-semibold text-slate-800\">${trip.passenger.name}</span>\n1241:     </div>\n1242:     <div class=\"receipt-item-row\">\n1243:       <span>Driver Partner:</span>\n1244:       <span class=\"text-slate-800\">${trip.driverName} (ID: #${trip.driverId})</span>\n1245:     </div>\n1246:     <div class=\"receipt-item-row\">\n1247:       <span>Corridor Route:</span>\n1248:       <span class=\"text-electric font-semibold\">${trip.corridorPath.join(' &rarr; ')}</span>\n1249:     </div>\n1250:     <div class=\"receipt-item-row\">\n1251:       <span>Distance & Time:</span>\n1252:       <span class=\"text-slate-800\">${trip.distance} km &bull; ~${trip.time} mins</span>\n1253:     </div>\n1254:     <div class=\"receipt-item-row\">\n1255:       <span>Net Carbon Avoided:</span>\n1256:       <span class=\"text-emerald font-bold font-mono\">+${trip.co2Saved} kg CO₂</span>\n1257:     </div>\n1258:     <div class=\"receipt-item-row\">\n1259:       <span>Corridor Alignment Match:</span>\n1260:       <span class=\"text-emerald font-bold\">${trip.matchScore}% Eco-Pooled Match</span>\n1261:     </div>\n1262:     <div class=\"receipt-item-row bold-row\">\n1263:       <span>Total Pooled Fare Paid:</span>\n1264:       <span class=\"text-slate-900\">$${trip.fare} USD</span>\n1265:     </div>\n1266:   `;\n1267: \n1268:   modal.classList.remove('hidden');\n1269: };\n1270: \n1271: // ==========================================\n1272: // 9. INITIALIZATION & EVENT LISTENERS\n1273: // ==========================================\n1274: document.addEventListener('DOMContentLoaded', () => {\n1275:   urbanCanvasInstance = new Urban3DCanvas('urban-3d-canvas');\n1276:   ambientCanvasInstance = new AmbientEcoCanvas('ambient-canvas');\n1277:   initTabNavigation();\n1278: \n1279:   // Populate Select Boxes\n1280:   const originSel = document.getElementById('route-origin');\n1281:   const destSel = document.getElementById('route-destination');\n1282:   const passPickup = document.getElementById('passenger-pickup-select');\n1283:   const passDrop = document.getElementById('passenger-drop-select');\n1284:   const driverStation = document.getElementById('driver-station-select');\n1285: \n1286:   TRANSIT_STATIONS.forEach(s => {\n1287:     const opt = `<option value=\"${s.id}\">${s.name} (${s.zone})</option>`;\n1288:     originSel.insertAdjacentHTML('beforeend', opt);\n1289:     destSel.insertAdjacentHTML('beforeend', opt);\n1290:     passPickup.insertAdjacentHTML('beforeend', opt);\n1291:     passDrop.insertAdjacentHTML('beforeend', opt);\n1292:     driverStation.insertAdjacentHTML('beforeend', opt);\n1293:   });\n1294: \n1295:   originSel.value = 'ALPHA';\n1296:   destSel.value = 'HORIZON';\n1297:   passPickup.value = 'ALPHA';\n1298:   passDrop.value = 'HORIZON';\n1299:   driverStation.value = 'METRO';\n1300: "}
