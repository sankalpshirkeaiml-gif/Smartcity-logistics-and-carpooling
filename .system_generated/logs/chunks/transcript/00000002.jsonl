{"step_index":150,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:16:03Z","content":"Created At: 2026-10-20T11:46:03+05:30\nCompleted At: 2026-10-20T11:46:03+05:30\nShowing lines 651-850 of 1652\n651:     });\n652: \n653:     // Draw Animated Electric Transit Car Driving Along Route\n654:     if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n655:       this.drawAnimatedCar();\n656:     }\n657:   }\n658: \n659:   drawAnimatedCar() {\n660:     const ctx = this.ctx;\n661:     const segmentIndex = Math.floor(this.carProgress);\n662:     const segmentT = this.carProgress - segmentIndex;\n663: \n664:     const fromId = this.activeCorridorPath[segmentIndex];\n665:     const toId = this.activeCorridorPath[segmentIndex + 1];\n666: \n667:     if (!fromId || !toId) return;\n668: \n669:     const s1 = TRANSIT_STATIONS.find(s => s.id === fromId);\n670:     const s2 = TRANSIT_STATIONS.find(s => s.id === toId);\n671: \n672:     // Interpolate 3D coordinates\n673:     const curX = s1.x + (s2.x - s1.x) * segmentT;\n674:     const curY = s1.y + (s2.y - s1.y) * segmentT;\n675:     const curZ = s1.z + (s2.z - s1.z) * segmentT;\n676: \n677:     const carProj = this.project(curX, curY, curZ);\n678: \n679:     // Calculate heading angle\n680:     const p1 = this.project(s1.x, s1.y, s1.z);\n681:     const p2 = this.project(s2.x, s2.y, s2.z);\n682:     const heading = Math.atan2(p2.y - p1.y, p2.x - p1.x);\n683: \n684:     ctx.save();\n685:     ctx.translate(carProj.x, carProj.y);\n686:     ctx.rotate(heading);\n687: \n688:     // Glowing Headlight Beams\n689:     ctx.beginPath();\n690:     ctx.moveTo(12 * carProj.scale, -4 * carProj.scale);\n691:     ctx.lineTo(26 * carProj.scale, -12 * carProj.scale);\n692:     ctx.lineTo(26 * carProj.scale, 12 * carProj.scale);\n693:     ctx.lineTo(12 * carProj.scale, 4 * carProj.scale);\n694:     ctx.closePath();\n695:     const lightGrad = ctx.createLinearGradient(12 * carProj.scale, 0, 26 * carProj.scale, 0);\n696:     lightGrad.addColorStop(0, 'rgba(32, 201, 176, 0.45)');\n697:     lightGrad.addColorStop(1, 'rgba(32, 201, 176, 0)');\n698:     ctx.fillStyle = lightGrad;\n699:     ctx.fill();\n700: \n701:     // Electric \n<truncated 3856 bytes>\nt.add('active');\n800: \n801:       views.forEach(v => {\n802:         v.classList.remove('active');\n803:         if (v.id === targetTabId) {\n804:           v.classList.add('active');\n805:         }\n806:       });\n807: \n808:       if (targetTabId === 'tab-route-finder' && urbanCanvasInstance) {\n809:         setTimeout(() => {\n810:           urbanCanvasInstance.resize();\n811:         }, 50);\n812:       }\n813:     });\n814:   });\n815: }\n816: \n817: // ==========================================\n818: // 7. UI REFRESH & COMPONENT RENDERERS\n819: // ==========================================\n820: function refreshPlatformUI() {\n821:   renderPassengerDispatchStream();\n822:   renderStandbyLounge();\n823:   renderFleetDirectory();\n824:   renderActiveTrips();\n825:   renderTransitHierarchyCanvas();\n826:   renderAuditHistory();\n827:   renderLeaderboard();\n828:   updateTopKPIs();\n829: }\n830: \n831: function updateTopKPIs() {\n832:   document.getElementById('kpi-commuters').innerHTML = `${engine.dispatchStream.length} <span class=\"kpi-unit\">commuters</span>`;\n833:   document.getElementById('kpi-active-trips').innerHTML = `${engine.activeTrips.length} <span class=\"kpi-unit\">trips</span>`;\n834: \n835:   const passBadge = document.getElementById('tab-passengers-badge');\n836:   if (passBadge) passBadge.textContent = engine.dispatchStream.length + engine.standbyCount;\n837: \n838:   const fleetBadge = document.getElementById('tab-fleet-badge');\n839:   if (fleetBadge) fleetBadge.textContent = engine.fleetPartners.length;\n840: \n841:   let totalSavedCO2 = 148.5;\n842:   let totalDistance = 1420;\n843:   engine.activeTrips.forEach(t => {\n844:     totalSavedCO2 += t.co2Saved;\n845:     totalDistance += t.distance;\n846:   });\n847: \n848:   document.getElementById('kpi-co2').innerHTML = `${totalSavedCO2.toFixed(1)} <span class=\"kpi-unit\">kg</span>`;\n849:   document.getElementById('eco-total-co2').textContent = `${totalSavedCO2.toFixed(1)} kg`;\n850:   document.getElementById('eco-shared-km').textContent = `${Math.round(totalDistance).toLocaleString()} km`;","truncated_fields":["content"]}
