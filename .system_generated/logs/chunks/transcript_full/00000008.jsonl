{"step_index":146,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:15:43Z","content":"Created At: 2026-10-20T11:45:43+05:30\nCompleted At: 2026-10-20T11:45:44+05:30\nShowing lines 251-450 of 1652\n251:       if (driver) {\n252:         driver.seats = Math.min(driver.seats + 1, driver.originalSeats);\n253:       }\n254: \n255:       action.passenger.status = 'Restored to Dispatch';\n256:       this.dispatchStream.unshift(action.passenger);\n257: \n258:       return { success: true, action, driver };\n259:     }\n260: \n261:     return { success: false, message: 'Unable to process reversal.' };\n262:   }\n263: }\n264: \n265: const engine = new NexusTransitEngine();\n266: \n267: // ==========================================\n268: // 3. AMBIENT BACKGROUND CANVAS (FLOATING LEAVES & ENERGY NODES)\n269: // ==========================================\n270: class AmbientEcoCanvas {\n271:   constructor(canvasId) {\n272:     this.canvas = document.getElementById(canvasId);\n273:     if (!this.canvas) return;\n274:     this.ctx = this.canvas.getContext('2d');\n275:     this.particles = [];\n276:     this.numParticles = 35;\n277: \n278:     this.resize();\n279:     window.addEventListener('resize', () => this.resize());\n280:     this.initParticles();\n281:     this.animate();\n282:   }\n283: \n284:   resize() {\n285:     this.width = window.innerWidth;\n286:     this.height = window.innerHeight;\n287:     this.canvas.width = this.width;\n288:     this.canvas.height = this.height;\n289:   }\n290: \n291:   initParticles() {\n292:     this.particles = [];\n293:     for (let i = 0; i < this.numParticles; i++) {\n294:       this.particles.push({\n295:         x: Math.random() * this.width,\n296:         y: Math.random() * this.height,\n297:         size: Math.random() * 8 + 4,\n298:         speedY: -(Math.random() * 0.45 + 0.15),\n299:         speedX: Math.sin(Math.random() * Math.PI) * 0.25,\n300:         rotation: Math.random() * Math.PI * 2,\n301:         rotSpeed: (Math.random() - 0.5) * 0.015,\n302:         type: Math.random() > 0.45 ? 'leaf' : 'node',\n303:         opacity: Math.random() * 0.4 + 0.15\n304:       });\n305:     }\n306:   }\n307: \n308:   animate() {\n309:     this.ctx.clearRect(0, 0, this.width, this.height);\n310: \n311:     this.particles.forEach(p => {\n312:       p.y += p.speedY;\n313:       p.x += p.speedX + Math.sin(p.y * 0.01) * 0.2;\n314:       p.rotation += p.rotSpeed;\n315: \n316:       // Wrap around\n317:       if (p.y < -20) {\n318:         p.y = this.height + 20;\n319:         p.x = Math.random() * this.width;\n320:       }\n321:       if (p.x < -20) p.x = this.width + 20;\n322:       if (p.x > this.width + 20) p.x = -20;\n323: \n324:       this.ctx.save();\n325:       this.ctx.translate(p.x, p.y);\n326:       this.ctx.rotate(p.rotation);\n327: \n328:       if (p.type === 'leaf') {\n329:         // Draw delicate eco-leaf\n330:         this.ctx.fillStyle = `rgba(5, 150, 105, ${p.opacity * 0.55})`;\n331:         this.ctx.beginPath();\n332:         this.ctx.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);\n333:         this.ctx.fill();\n334: \n335:         // Leaf stem line\n336:         this.ctx.strokeStyle = `rgba(5, 150, 105, ${p.opacity * 0.7})`;\n337:         this.ctx.lineWidth = 0.8;\n338:         this.ctx.beginPath();\n339:         this.ctx.moveTo(-p.size, 0);\n340:         this.ctx.lineTo(p.size, 0);\n341:         this.ctx.stroke();\n342:       } else {\n343:         // Light glowing electric energy node\n344:         this.ctx.fillStyle = `rgba(37, 99, 235, ${p.opacity * 0.45})`;\n345:         this.ctx.beginPath();\n346:         this.ctx.arc(0, 0, p.size * 0.4, 0, Math.PI * 2);\n347:         this.ctx.fill();\n348:       }\n349: \n350:       this.ctx.restore();\n351:     });\n352: \n353:     requestAnimationFrame(() => this.animate());\n354:   }\n355: }\n356: \n357: // ==========================================\n358: // 4. 3D SPATIAL METROPOLITAN CANVAS MAP\n359: // WITH DIRECTIONAL CORRIDORS & ANIMATED TRANSIT VEHICLE\n360: // ==========================================\n361: class Urban3DCanvas {\n362:   constructor(canvasId) {\n363:     this.canvas = document.getElementById(canvasId);\n364:     this.ctx = this.canvas.getContext('2d');\n365:     this.wrapper = this.canvas.parentElement;\n366: \n367:     this.rotX = 0.45;\n368:     this.rotY = -0.32;\n369:     this.scale = 1.08;\n370: \n371:     this.isDragging = false;\n372:     this.lastMouseX = 0;\n373:     this.lastMouseY = 0;\n374: \n375:     this.activeCorridorPath = [];\n376:     this.hoveredStation = null;\n377: \n378:     // Animated Car along active path\n379:     this.carProgress = 0; // 0 to (path.length - 1)\n380:     this.carSpeed = 0.0085;\n381:     this.isCarDriving = false;\n382:     this.flowDashOffset = 0;\n383: \n384:     this.initEvents();\n385:     this.resize();\n386:     window.addEventListener('resize', () => this.resize());\n387:     this.animate();\n388:   }\n389: \n390:   resize() {\n391:     if (!this.wrapper) return;\n392:     this.width = this.wrapper.clientWidth || 800;\n393:     this.height = this.wrapper.clientHeight || 420;\n394:     this.canvas.width = this.width * window.devicePixelRatio;\n395:     this.canvas.height = this.height * window.devicePixelRatio;\n396:     this.ctx.scale(window.devicePixelRatio, window.devicePixelRatio);\n397:   }\n398: \n399:   initEvents() {\n400:     this.canvas.addEventListener('mousedown', (e) => {\n401:       this.isDragging = true;\n402:       this.lastMouseX = e.clientX;\n403:       this.lastMouseY = e.clientY;\n404:     });\n405: \n406:     window.addEventListener('mouseup', () => {\n407:       this.isDragging = false;\n408:     });\n409: \n410:     this.canvas.addEventListener('mousemove', (e) => {\n411:       if (this.isDragging) {\n412:         const deltaX = e.clientX - this.lastMouseX;\n413:         const deltaY = e.clientY - this.lastMouseY;\n414:         this.rotY += deltaX * 0.007;\n415:         this.rotX += deltaY * 0.007;\n416:         this.rotX = Math.max(0.12, Math.min(1.2, this.rotX));\n417:         this.lastMouseX = e.clientX;\n418:         this.lastMouseY = e.clientY;\n419:       }\n420:       this.checkHover(e);\n421:     });\n422: \n423:     this.canvas.addEventListener('wheel', (e) => {\n424:       e.preventDefault();\n425:       this.scale += e.deltaY * -0.001;\n426:       this.scale = Math.max(0.65, Math.min(1.85, this.scale));\n427:     });\n428:   }\n429: \n430:   checkHover(e) {\n431:     const rect = this.canvas.getBoundingClientRect();\n432:     const mouseX = e.clientX - rect.left;\n433:     const mouseY = e.clientY - rect.top;\n434: \n435:     let found = null;\n436:     TRANSIT_STATIONS.forEach(s => {\n437:       const p = this.project(s.x, s.y, s.z);\n438:       const dist = Math.hypot(p.x - mouseX, p.y - mouseY);\n439:       if (dist < 22) {\n440:         found = s;\n441:       }\n442:     });\n443: \n444:     this.hoveredStation = found;\n445:     const hud = document.getElementById('map-hud-overlay');\n446:     if (hud) {\n447:       if (found) {\n448:         hud.innerHTML = `<span class=\"text-emerald font-bold\">📍 ${found.name}</span> &bull; Transit Zone: ${found.zone} &bull; Elevation: +${found.z}m`;\n449:       } else {\n450:         hud.innerHTML = `<i class=\"fa-solid fa-hand-pointer text-emerald\"></i> Click & drag to orbit 3D city corridors &bull; Scroll to zoom`;"}
