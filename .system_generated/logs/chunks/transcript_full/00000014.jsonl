oter\">\n      <div class=\"footer-left\">\n        <span class=\"font-bold text-slate-900\">NexusMobility Technologies Inc.</span> &bull; Intelligent Urban Transit & Eco-Logistics Infrastructure\n      </div>\n      <div class=\"footer-right\">\n        <span><i class=\"fa-solid fa-shield-halved text-emerald\"></i> Enterprise SLA: 99.99%</span>\n        <span><i class=\"fa-solid fa-signal text-electric\"></i> Real-Time Telemetry Active</span>\n      </div>\n    </footer>\n  </div>\n\n  <!-- Enterprise Modal 1: Dispatch Confirmation Dialog -->\n  <div class=\"modal-overlay hidden\" id=\"dispatch-confirm-modal\">\n    <div class=\"modal-card white-card\">\n      <div class=\"modal-header\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"brand-icon small-icon bg-emerald-light\"><i class=\"fa-solid fa-car-rear text-emerald\"></i></div>\n          <div>\n            <h3 class=\"font-bold text-slate-900\">Trip Dispatched Successfully!</h3>\n            <p class=\"text-xs text-slate-500 font-mono\">Metropolitan Shared Transit Alignment Confirmed</p>\n          </div>\n        </div>\n        <button id=\"btn-close-dispatch-modal\" class=\"btn btn-ghost\"><i class=\"fa-solid fa-xmark text-lg\"></i></button>\n      </div>\n\n      <div class=\"modal-dialog-body\" id=\"dispatch-modal-body\">\n        <!-- Injected dynamically -->\n      </div>\n\n      <div class=\"modal-footer\">\n        <button id=\"btn-view-map-dispatch\" class=\"btn btn-outline\"><i class=\"fa-solid fa-map-location-dot\"></i> View on Route Map</button>\n        <button id=\"btn-ack-dispatch\" class=\"btn btn-emerald\">Acknowledge Dispatch</button>\n      </div>\n    </div>\n  </div>\n\n  <!-- Enterprise Modal 2: Trip Reversal & Rollback Dialog -->\n  <div class=\"modal-overlay hidden\" id=\"reversal-confirm-modal\">\n    <div class=\"modal-card white-card\">\n      <div class=\"modal-header\">\n        <div class=\"flex items-center gap-2\">\n          <div class=\"brand-icon s