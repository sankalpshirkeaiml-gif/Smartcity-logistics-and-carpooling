{"step_index":156,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:16:23Z","content":"Created At: 2026-10-20T11:46:23+05:30\nCompleted At: 2026-10-20T11:46:24+05:30\nShowing lines 1301-1652 of 1652\n1301:   // --- Dynamic Commuter Slider Handler ---\n1302:   const commuterSlider = document.getElementById('commuter-range-slider');\n1303:   const sliderFareDisplay = document.getElementById('slider-fare-display');\n1304:   const sliderTicks = document.querySelectorAll('.slider-ticks .tick');\n1305: \n1306:   function updateCommuterSliderMetrics() {\n1307:     const val = parseInt(commuterSlider.value, 10);\n1308:     engine.commuterDensity = val;\n1309: \n1310:     sliderTicks.forEach((tick, idx) => {\n1311:       tick.classList.toggle('active-tick', idx + 1 === val);\n1312:     });\n1313: \n1314:     computeAndDisplayRoute();\n1315:   }\n1316: \n1317:   commuterSlider.addEventListener('input', updateCommuterSliderMetrics);\n1318: \n1319:   // --- Interactive 4-Seat Vehicle Selector ---\n1320:   const seatButtons = [\n1321:     document.getElementById('seat-front-pass'),\n1322:     document.getElementById('seat-rear-left'),\n1323:     document.getElementById('seat-rear-right')\n1324:   ];\n1325:   const driverSeatsCountLabel = document.getElementById('driver-seats-count-label');\n1326: \n1327:   function getActiveSeatsCount() {\n1328:     let count = 0;\n1329:     seatButtons.forEach(btn => {\n1330:       if (btn.classList.contains('active-seat')) count++;\n1331:     });\n1332:     return count;\n1333:   }\n1334: \n1335:   seatButtons.forEach(btn => {\n1336:     btn.addEventListener('click', () => {\n1337:       if (btn.classList.contains('active-seat')) {\n1338:         btn.classList.remove('active-seat');\n1339:         btn.classList.add('reserved-seat');\n1340:         btn.innerHTML = `<i class=\"fa-solid fa-ban\"></i><span>OFF</span>`;\n1341:       } else {\n1342:         btn.classList.remove('reserved-seat');\n1343:         btn.classList.add('active-seat');\n1344:         btn.innerHTML = `<i class=\"fa-solid fa-user-check\"></i><span>${btn.dataset.seat.toUpperCase()}</span>`;\n1345:       }\n1346:       const count = getActiveSeatsCount();\n1347:       driverSeatsCountLabel.textContent = count;\n1348:       showPlatformToast(`Car configuration: ${count} passenger seats available.`, 'emerald');\n1349:     });\n1350:   });\n1351: \n1352:   // --- Calculate Route Button ---\n1353:   function computeAndDisplayRoute() {\n1354:     const orig = originSel.value;\n1355:     const dest = destSel.value;\n1356: \n1357:     if (orig === dest) {\n1358:       showPlatformToast('Origin and Destination stations cannot be identical.', 'rose');\n1359:       return;\n1360:     }\n1361: \n1362:     const res = engine.findOptimalEcoRoute(orig, dest);\n1363:     urbanCanvasInstance.setActivePath(res.path);\n1364: \n1365:     document.getElementById('strip-path').textContent = res.path.join(' → ');\n1366:     document.getElementById('strip-distance').textContent = `${res.totalDist} km`;\n1367:     document.getElementById('strip-time').textContent = `~${res.estTime} min`;\n1368:     document.getElementById('strip-co2').textContent = `-${res.co2Offset} kg`;\n1369:     document.getElementById('strip-vehicles-saved').textContent = `${res.soloCarsSaved} ${res.soloCarsSaved === 1 ? 'Car' : 'Cars'}`;\n1370:     sliderFareDisplay.textContent = `$${res.fare}`;\n1371: \n1372:     showPlatformToast(`Optimal eco-route: ${res.totalDist} km, saving ${res.co2Offset} kg CO₂.`, 'emerald');\n1373:   }\n1374: \n1375:   document.getElementById('btn-calc-route').addEventListener('click', computeAndDisplayRoute);\n1376: \n1377:   document.getElementById('btn-simulate-drive').addEventListener('click', () => {\n1378:     urbanCanvasInstance.startCarSimulation();\n1379:     showPlatformToast('Simulating top-down electric transit drive along route corridors!', 'blue');\n1380:   });\n1381: \n1382:   document.getElementById('btn-swap-route').addEventListener('click', () => {\n1383:     const temp = originSel.value;\n1384:     originSel.value = destSel.value;\n1385:     destSel.value = temp;\n1386:     computeAndDisplayRoute();\n1387:   });\n1388: \n1389:   document.getElementById('btn-reset-view').addEventListener('click', () => {\n1390:     urbanCanvasInstance.resetCamera();\n1391:   });\n1392: \n1393:   // --- Passenger Request ---\n1394:   document.getElementById('btn-request-ride').addEventListener('click', () => {\n1395:     const nameInput = document.getElementById('passenger-name-input');\n1396:     const name = nameInput.value.trim() || `Commuter_${Math.floor(Math.random() * 900 + 100)}`;\n1397:     const pickup = passPickup.value;\n1398:     const drop = passDrop.value;\n1399: \n1400:     if (pickup === drop) {\n1401:       showPlatformToast('Pickup and drop-off stations must be distinct.', 'rose');\n1402:       return;\n1403:     }\n1404: \n1405:     const passenger = engine.submitRideRequest(name, pickup, drop);\n1406:     nameInput.value = '';\n1407:     refreshPlatformUI();\n1408:     showPlatformToast(`Ride request submitted for ${passenger.name} (${pickup} → ${drop}).`, 'emerald');\n1409:   });\n1410: \n1411:   document.getElementById('btn-cancel-front-req').addEventListener('click', () => {\n1412:     const dequeued = engine.dequeueNextRequest();\n1413:     if (dequeued) {\n1414:       refreshPlatformUI();\n1415:       showPlatformToast(`Dispatched or cancelled request for ${dequeued.name} (${dequeued.id}).`, 'amber');\n1416:     } else {\n1417:       showPlatformToast('No pending passenger requests in the pipeline.', 'rose');\n1418:     }\n1419:   });\n1420: \n1421:   // --- Priority Standby Lounge ---\n1422:   document.getElementById('btn-push-standby').addEventListener('click', () => {\n1423:     let candidate = engine.dequeueNextRequest();\n1424:     if (!candidate) {\n1425:       candidate = {\n1426:         id: `BK-STDBY-${Math.floor(Math.random() * 800 + 100)}`,\n1427:         name: `Standby_Passenger_${Math.floor(Math.random() * 90 + 10)}`,\n1428:         pickup: 'METRO',\n1429:         drop: 'SKYPORT',\n1430:         requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n1431:         status: 'In Priority Standby'\n1432:       };\n1433:     }\n1434: \n1435:     const res = engine.pushToStandby(candidate);\n1436:     if (!res.success) {\n1437:       showPlatformToast(res.message, 'rose');\n1438:       engine.dispatchStream.unshift(candidate);\n1439:     } else {\n1440:       showPlatformToast(`${candidate.name} admitted to Priority Standby Lounge.`, 'amber');\n1441:     }\n1442:     refreshPlatformUI();\n1443:   });\n1444: \n1445:   document.getElementById('btn-pop-standby').addEventListener('click', () => {\n1446:     const res = engine.popFromStandby();\n1447:     if (!res.success) {\n1448:       showPlatformToast(res.message, 'rose');\n1449:     } else {\n1450:       showPlatformToast(`Seated ${res.item.name} from Priority Standby Lounge.`, 'amber');\n1451:     }\n1452:     refreshPlatformUI();\n1453:   });\n1454: \n1455:   // --- Driver Partner Registration with Visual Seat Selector ---\n1456:   document.getElementById('btn-register-driver').addEventListener('click', () => {\n1457:     const nameInput = document.getElementById('driver-name-input');\n1458:     const name = nameInput.value.trim() || `Partner_${Math.floor(Math.random() * 900 + 100)}`;\n1459:     const station = driverStation.value;\n1460:     const seats = getActiveSeatsCount();\n1461: \n1462:     if (seats === 0) {\n1463:       showPlatformToast('Please toggle at least 1 passenger seat in the vehicle blueprint.', 'rose');\n1464:       return;\n1465:     }\n1466: \n1467:     const partner = engine.onboardDriver(name, station, seats);\n1468:     nameInput.value = '';\n1469:     refreshPlatformUI();\n1470:     showPlatformToast(`Driver Partner ${partner.name} onboarded with ${partner.seats} passenger seats (ID: #${partner.id}).`, 'emerald');\n1471:   });\n1472: \n1473:   // --- Flexible Verification & Lookup ---\n1474:   document.getElementById('btn-verify-id').addEventListener('click', () => {\n1475:     const idInput = document.getElementById('verify-id-input');\n1476:     const resultBox = document.getElementById('verification-result-box');\n1477:     const query = idInput.value.trim();\n1478: \n1479:     if (!query) {\n1480:       resultBox.innerHTML = '<span class=\"text-rose-500 text-xs\">Please enter a valid Driver Partner ID or Booking Reference.</span>';\n1481:       return;\n1482:     }\n1483: \n1484:     const partner = engine.getDriverById(query);\n1485:     if (partner) {\n1486:       resultBox.innerHTML = `\n1487:         <div class=\"flex items-center justify-between w-full text-xs\">\n1488:           <div>\n1489:             <span class=\"text-emerald font-bold\"><i class=\"fa-solid fa-circle-check\"></i> Verified Partner:</span>\n1490:             <span class=\"text-slate-900 font-semibold ml-1\">${partner.name} (ID: #${partner.id})</span>\n1491:             <span class=\"text-slate-500 ml-2\">&bull; ${partner.station} Station</span>\n1492:           </div>\n1493:           <span class=\"seat-counter-pill\">${partner.seats} Seats Free</span>\n1494:         </div>`;\n1495:       showPlatformToast(`Verified operational identity for Partner #${partner.id}.`, 'emerald');\n1496:       return;\n1497:     }\n1498: \n1499:     const booking = engine.getBookingByRef(query);\n1500:     if (booking) {\n1501:       resultBox.innerHTML = `\n1502:         <div class=\"flex items-center justify-between w-full text-xs\">\n1503:           <div>\n1504:             <span class=\"text-electric font-bold\"><i class=\"fa-solid fa-ticket\"></i> Verified Booking:</span>\n1505:             <span class=\"text-slate-900 font-semibold ml-1\">${booking.tripRef} (${booking.passenger.name})</span>\n1506:             <span class=\"text-slate-500 ml-2\">&bull; Driver: ${booking.driverName}</span>\n1507:           </div>\n