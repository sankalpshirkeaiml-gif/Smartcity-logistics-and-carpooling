icon\"><i class=\"fa-solid fa-leaf text-emerald\"></i></div>\n598:           <div>\n599:             <h3 class=\"font-bold text-slate-900\">Official Eco-Transit Journey Receipt</h3>\n600:             <p class=\"text-xs text-slate-500 font-mono\">Metropolitan Shared Mobility Environmental Audit</p>\n601:           </div>\n602:         </div>\n603:         <button id=\"btn-close-receipt\" class=\"btn btn-ghost\"><i class=\"fa-solid fa-xmark text-lg\"></i></button>\n604:       </div>\n605: \n606:       <div class=\"receipt-content\" id=\"receipt-content-area\">\n607:         <!-- Receipt details populated dynamically -->\n608:       </div>\n609: \n610:       <div class=\"modal-footer\">\n611:         <button id=\"btn-print-receipt\" class=\"btn btn-outline\"><i class=\"fa-solid fa-print\"></i> Print Receipt</button>\n612:         <button id=\"btn-done-receipt\" class=\"btn btn-primary\">Done</button>\n613:       </div>\n614:     </div>\n615:   </div>\n616: \n617:   <!-- Notification Toasts Container -->\n618:   <div id=\"toast-container\" class=\"toast-container\"></div>\n619: \n620:   <script src=\"app.js\"></script>\n621: </body>\n622: </html>"}
{"step_index":169,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-20T06:26:13Z","input_tokens":3833,"cache_read_tokens":50901,"output_tokens":20973,"tool_calls":[{"name":"write_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Comprehensive bug fix and code audit for app.js including Dijkstra disconnected node handling, requestAnimationFrame cleanup on tab switches, 3D math bounds guards, modal backdrop/ESC listeners, and sanitization.","UserFacing":true},"Content":"/**\n * NEXUSMOBILITY — MULTI-TABBED ENTERPRISE ECO-TECH PLATFORM\n * Core Engine & Multi-View Controller\n * Featuring Animated Transit Car Simulation, Ambient Eco Particle Canvas,\n * EcoSprout Mascot, and Enterprise Confirmation Modals.\n * 100% Zero CS / Academic Jargon.\n * \n * AUDITED & HARDENED:\n * - Dijkstra route calculation guards for disconnected nodes, same-node, and non-existent stations.\n * - Circular queue pointer boundary safety for empty and full states.\n * - Driver seat capacity clamping (never negative, never exceeding originalSeats).\n * - LIFO rollback decoupling and status synchronization.\n * - 3D spatial matrix bounds protection preventing NaN in projection and atan2.\n * - Animation frame cancellation & resize cleanup.\n * - Robust DOM element null-guarding throughout.\n * - Modal backdrop clicking and ESC key dismiss listeners.\n * - Input sanitization & duplicate detection.\n */\n\n// ==========================================\n// 1. METROPOLITAN TRANSIT STATIONS & NETWORK\n// ==========================================\nconst TRANSIT_STATIONS = [\n  { id: 'ALPHA', name: 'Tech Park Alpha', x: -160, y: -70, z: 20, zone: 'North Industrial', icon: 'fa-microchip' },\n  { id: 'HARBOR', name: 'Bayfront Terminal', x: -80, y: 110, z: -15, zone: 'Maritime District', icon: 'fa-anchor' },\n  { id: 'METRO', name: 'Central Financial Core', x: 0, y: 0, z: 40, zone: 'Downtown Metro', icon: 'fa-building-columns' },\n  { id: 'SKYPORT', name: 'AeroPort Interchange', x: 130, y: -90, z: 30, zone: 'Aviation Corridor', icon: 'fa-plane-departure' },\n  { id: 'QUANTUM', name: 'Green Innovation Campus', x: 90, y: 100, z: -10, zone: 'Eco District', icon: 'fa-seedling' },\n  { id: 'HORIZON', name: 'Waterfront Marina', x: 200, y: 30, z: 5, zone: 'East Residential', icon: 'fa-water' }\n];\n\n// Transit Corridors with distances (km)\nconst TRANSIT_CORRIDORS = [\n  { u: 'ALPHA', v: 'METRO', distance: 8.2 },\n  { u: 'ALPHA', v: 'HARBOR', distance: 11.5 },\n  { u: 'HARBOR', v: 'METRO', distance: 6.4 },\n  { u: 'HARBOR', v: 'QUANTUM', distance: 13.8 },\n  { u: 'METRO', v: 'SKYPORT', distance: 9.6 },\n  { u: 'METRO', v: 'QUANTUM', distance: 7.1 },\n  { u: 'SKYPORT', v: 'HORIZON', distance: 8.8 },\n  { u: 'QUANTUM', v: 'HORIZON', distance: 10.4 }\n];\n\n// ==========================================\n// 2. NEXUS LOGISTICS STATE ENGINE\n// ==========================================\nclass NexusTransitEngine {\n  constructor() {\n    this.stations = TRANSIT_STATIONS;\n    this.corridors = TRANSIT_CORRIDORS;\n\n    this.dispatchStream = [];\n\n    // Priority Standby Lounge (Max 5 Slots)\n    this.standbyCap = 5;\n    this.standbyLounge = new Array(this.standbyCap).fill(null);\n    this.standbyFront = 0;\n    this.standbyRear = 0;\n    this.standbyCount = 0;\n\n    // Driver Fleet Directory\n    this.fleetPartners = [];\n\n    // Active Shared Trips\n    this.activeTrips = [];\n\n    // Reversible Dispatch Audit Log\n    this.reversalAuditLog = [];\n\n    // Top Eco-Partners Leaderboard with Gamified Achievement Badges\n    this.leaderboard = [\n      { name: 'Kaelen Chen', trips: 42, co2: '168.4 kg', rating: 4.98, badge: 'Carbon Crusader' },\n      { name: 'Elena Rostova', trips: 37, co2: '142.1 kg', rating: 4.95, badge: '5-Star Commute' },\n      { name: 'Marcus Vance', trips: 31, co2: '128.0 kg', rating: 4.92, badge: 'Zero-Emission Pioneer' },\n      { name: 'Siddharth Rao', trips: 28, co2: '115.6 kg', rating: 4.89, badge: 'Master Navigator' }\n    ];\n\n    this.counters = {\n      driver: 101,\n      booking: 501,\n      passenger: 201\n    };\n\n    this.commuterDensity = 2;\n  }\n\n  findOptimalEcoRoute(startId, endId) {\n    // FIX 1: Guard against missing station IDs\n    if (!startId || !endId) {\n      return { path: [], totalDist: 0, estTime: 0, co2Offset: 0, fare: 0, soloCarsSaved: 0 };\n    }\n\n    // FIX 2: Guard against same-origin-destination\n    if (startId === endId) {\n      return { path: [startId], totalDist: 0, estTime: 0, co2Offset: 0, fare: 0, soloCarsSaved: 0 };\n    }\n\n    const adj = {};\n    TRANSIT_STATIONS.forEach(s => { adj[s.id] = []; });\n    TRANSIT_CORRIDORS.forEach(c => {\n      if (adj[c.u]) adj[c.u].push({ node: c.v, distance: c.distance });\n      if (adj[c.v]) adj[c.v].push({ node: c.u, distance: c.distance });\n    });\n\n    const dist = {};\n    const prev = {};\n    TRANSIT_STATIONS.forEach(s => {\n      dist[s.id] = Infinity;\n      prev[s.id] = null;\n    });\n\n    dist[startId] = 0;\n    const activeCorridors = [[0, startId]];\n\n    while (activeCorridors.length > 0) {\n      activeCorridors.sort((a, b) => a[0] - b[0]);\n      const [d, u] = activeCorridors.shift();\n\n      if (u === endId) break;\n      if (d > dist[u]) continue;\n\n      if (!adj[u]) continue;\n      for (const edge of adj[u]) {\n        const v = edge.node;\n        const newDist = dist[u] + edge.distance;\n        if (newDist < dist[v]) {\n          dist[v] = newDist;\n          prev[v] = u;\n          activeCorridors.push([newDist, v]);\n        }\n      }\n    }\n\n    // FIX 3: Robust path extraction for disconnected nodes\n    const path = [];\n    if (dist[endId] !== Infinity && dist[endId] !== undefined) {\n      let curr = endId;\n      while (curr) {\n        path.unshift(curr);\n        curr = prev[curr];\n        // Cycle safety guard\n        if (path.length > TRANSIT_STATIONS.length) break;\n      }\n    }\n\n    const totalDist = (dist[endId] === Infinity || isNaN(dist[endId])) ? 0 : parseFloat(dist[endId].toFixed(1));\n    const estTime = Math.round(totalDist * 2.2);\n    const baseCO2 = totalDist * 0.171;\n    const co2Offset = parseFloat((baseCO2 * (0.8 + this.commuterDensity * 0.4)).toFixed(2));\n\n    const baseTripCost = 4.0 + totalDist * 1.5;\n    const pooledFare = parseFloat(((baseTripCost * (1 + (this.commuterDensity - 1) * 0.25)) / this.commuterDensity).toFixed(2));\n\n    return {\n      path,\n      totalDist,\n      estTime,\n      co2Offset,\n      fare: pooledFare,\n      soloCarsSaved: Math.max(0, this.commuterDensity - 1)\n    };\n  }\n\n  submitRideRequest(name, pickup, drop) {\n    const cleanName = (name || '').trim() || `Commuter_${Math.floor(Math.random() * 900 + 100)}`;\n    const passenger = {\n      id: `BK-${this.counters.passenger++}`,\n      name: cleanName,\n      pickup,\n      drop,\n      requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n      status: 'Pending Dispatch'\n    };\n    this.dispatchStream.push(passenger);\n    return passenger;\n  }\n\n  dequeueNextRequest() {\n    return this.dispatchStream.shift() || null;\n  }\n\n  pushToStandby(item) {\n    // FIX 4: Full capacity boundary condition\n    if (this.standbyCount >= this.standbyCap) {\n      return { success: false, message: 'Priority Standby Lounge is currently at maximum capacity (5/5).' };\n    }\n    this.standbyLounge[this.standbyRear] = item;\n    this.standbyRear = (this.standbyRear + 1) % this.standbyCap;\n    this.standbyCount++;\n    return { success: true };\n  }\n\n  popFromStandby() {\n    // FIX 5: Empty queue boundary condition\n    if (this.standbyCount === 0) {\n      return { success: false, message: 'Standby lounge is currently empty.' };\n    }\n    const item = this.standbyLounge[this.standbyFront];\n    this.standbyLounge[this.standbyFront] = null;\n    this.standbyFront = (this.standbyFront + 1) % this.standbyCap;\n    this.standbyCount--;\n    return { success: true, item };\n  }\n\n  onboardDriver(name, station, seats) {\n    const driverId = this.counters.driver++;\n    const seatCount = Math.max(1, Math.min(4, parseInt(seats, 10) || 1));\n    const cleanName = (name || '').trim() || `Partner_${Math.floor(Math.random() * 900 + 100)}`;\n    const newPartner = {\n      id: driverId,\n      name: cleanName,\n      station,\n      seats: seatCount,\n      originalSeats: seatCount,\n      tripsCompleted: 0\n    };\n    this.fleetPartners.push(newPartner);\n    return newPartner;\n  }\n\n  getDriverById(id) {\n    const cleanId = String(id).replace(/[^0-9]/g, '');\n    return this.fleetPartners.find(d => String(d.id) === cleanId) || null;\n  }\n\n  getBookingByRef(ref) {\n    const upper = String(ref).trim().toUpperCase();\n    return this.activeTrips.find(t => t.tripRef.toUpperCase() === upper || (t.passenger && t.passenger.id.toUpperCase() === upper)) || null;\n  }\n\n  dispatchSharedTrip(passenger, driver, corridorPath, distance, time, fare, co2Saved, matchScore = 94) {\n    const tripRef = `NX-${this.counters.booking++}`;\n    // Clone passenger to prevent reference mutation coupling\n    const passClone = { ...passenger, status: 'In Transit' };\n\n    const trip = {\n      tripRef,\n      passenger: passClone,\n      driverId: driver.id,\n      driverName: driver.name,\n      corridorPath: [...corridorPath],\n      distance,\n      time,\n      fare,\n      co2Saved,\n      matchScore,\n      dispatchedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\n    };\n\n    this.activeTrips.push(trip);\n    // Strict clamp: never below 0\n    driver.seats = Math.max(0, driver.seats - 1);\n    driver.tripsCompleted += 1;\n\n    this.reversalAuditLog.push({\n      type: 'DISPATCH_CONFIRMATION',\n      tripRef,\n      driverId: driver.id,\n      passenger: passClone,\n      trip\n    });\n\n    return trip;\n  }\n\n  cancelActiveTrip(tripRef) {\n    const index = this.activeTrips.findIndex(t => t.tripRef === tripRef);\n    if (index !== -1) {\n      const removed = this.activeTrips.splice(index, 1)[0];\n      // Restore driver seat safely if driver still exists\n      const driver = this.getDriverById(removed.driverId);\n      if (driver) {\n        driver.seats = Math.min(driver.originalSeats, driver.seats + 1);\n      }\n      return removed;\n    }\n    return null;\n  }\n\n  revertLatestConfirmation() {\n    if (this.reversalAuditLog.length === 0) {\n      return { success: false, message: 'No recent dispatch confirmations available to revert.' };\n    }\n\n    const action = this.reversalAuditLog.pop();\n    if (action.type === 'DISPATCH_CONFIRMATION') {\n      // Remove from active trips (without double incrementing seat)\n      const index = this.activeTrips.findIndex(t => t.tripRef === action.tripRef);\n      if (index !== -1) {\n        this.activeTrips.splice(index, 1);\n      }\n\n      const driver = this.getDriverById(action.driverId);\n      if (driver) {\n        driver.seats = Math.min(driver.originalSeats, driver.seats + 1);\n        driver.tripsCompleted = Math.max(0, driver.tripsCompleted - 1);\n      }\n\n      // Restored passenger gets a fresh independent object\n      const restoredPassenger = {\n        ...action.passenger,\n        status: 'Restored to Dispatch'\n      };\n      this.dispatchStream.unshift(restoredPassenger);\n\n      return { success: true, action, driver };\n    }\n\n    return { success: false, message: 'Unable to process reversal.' };\n  }\n}\n\nconst engine = new NexusTransitEngine();\n\n// ==========================================\n// 3. AMBIENT BACKGROUND CANVAS (FLOATING LEAVES & ENERGY NODES)\n// ==========================================\nclass AmbientEcoCanvas {\n  constructor(canvasId) {\n    this.canvas = document.getElementById(canvasId);\n    if (!this.canvas) return;\n    this.ctx = this.canvas.getContext('2d');\n    this.particles = [];\n    this.numParticles = 35;\n    this.animId = null;\n    this.isPaused = false;\n\n    this.resize = this.resize.bind(this);\n    this.animate = this.animate.bind(this);\n\n    this.resize();\n    window.addEventListener('resize', this.resize);\n    this.initParticles();\n    this.animate();\n  }\n\n  resize() {\n    if (!this.canvas) return;\n    this.width = window.innerWidth || 1200;\n    this.height = window.innerHeight || 800;\n    this.canvas.width = this.width;\n    this.canvas.height = this.height;\n  }\n\n  initParticles() {\n    this.particles = [];\n    for (let i = 0; i < this.numParticles; i++) {\n      this.particles.push({\n        x: Math.random() * (this.width || 1200),\n        y: Math.random() * (this.height || 800),\n        size: Math.random() * 8 + 4,\n        speedY: -(Math.random() * 0.45 + 0.15),\n        speedX: Math.sin(Math.random() * Math.PI) * 0.25,\n        rotation: Math.random() * Math.PI * 2,\n        rotSpeed: (Math.random() - 0.5) * 0.015,\n        type: Math.random() > 0.45 ? 'leaf' : 'node',\n        opacity: Math.random() * 0.4 + 0.15\n      });\n    }\n  }\n\n  pause() {\n    this.isPaused = true;\n    if (this.animId) {\n      cancelAnimationFrame(this.animId);\n      this.animId = null;\n    }\n  }\n\n  resume() {\n    if (this.isPaused) {\n      this.isPaused = false;\n      this.animate();\n    }\n  }\n\n  animate() {\n    if (this.isPaused || !this.ctx) return;\n    this.ctx.clearRect(0, 0, this.width, this.height);\n\n    this.particles.forEach(p => {\n      p.y += p.speedY;\n      p.x += p.speedX + Math.sin(p.y * 0.01) * 0.2;\n      p.rotation += p.rotSpeed;\n\n      // Wrap around screen boundaries\n      if (p.y < -20) {\n        p.y = this.height + 20;\n        p.x = Math.random() * this.width;\n      }\n      if (p.x < -20) p.x = this.width + 20;\n      if (p.x > this.width + 20) p.x = -20;\n\n      this.ctx.save();\n      this.ctx.translate(p.x, p.y);\n      this.ctx.rotate(p.rotation);\n\n      if (p.type === 'leaf') {\n        this.ctx.fillStyle = `rgba(5, 150, 105, ${p.opacity * 0.55})`;\n        this.ctx.beginPath();\n        this.ctx.ellipse(0, 0, p.size, p.size * 0.55, 0, 0, Math.PI * 2);\n        this.ctx.fill();\n\n        this.ctx.strokeStyle = `rgba(5, 150, 105, ${p.opacity * 0.7})`;\n        this.ctx.lineWidth = 0.8;\n        this.ctx.beginPath();\n        this.ctx.moveTo(-p.size, 0);\n        this.ctx.lineTo(p.size, 0);\n        this.ctx.stroke();\n      } else {\n        this.ctx.fillStyle = `rgba(37, 99, 235, ${p.opacity * 0.45})`;\n        this.ctx.beginPath();\n        this.ctx.arc(0, 0, p.size * 0.4, 0, Math.PI * 2);\n        this.ctx.fill();\n      }\n\n      this.ctx.restore();\n    });\n\n    this.animId = requestAnimationFrame(this.animate);\n  }\n}\n\n// ==========================================\n// 4. 3D SPATIAL METROPOLITAN CANVAS MAP\n// WITH DIRECTIONAL CORRIDORS & ANIMATED TRANSIT VEHICLE\n// ==========================================\nclass Urban3DCanvas {\n  constructor(canvasId) {\n    this.canvas = document.getElementById(canvasId);\n    if (!this.canvas) return;\n    this.ctx = this.canvas.getContext('2d');\n    this.wrapper = this.canvas.parentElement;\n\n    this.rotX = 0.45;\n    this.rotY = -0.32;\n    this.scale = 1.08;\n\n    this.isDragging = false;\n    this.lastMouseX = 0;\n    this.lastMouseY = 0;\n\n    this.activeCorridorPath = [];\n    this.hoveredStation = null;\n\n    // Animated Car along active path\n    this.carProgress = 0;\n    this.carSpeed = 0.0085;\n    this.isCarDriving = false;\n    this.flowDashOffset = 0;\n\n    this.animId = null;\n    this.isPaused = false;\n\n    this.resize = this.resize.bind(this);\n    this.animate = this.animate.bind(this);\n\n    this.initEvents();\n    this.resize();\n    window.addEventListener('resize', this.resize);\n    this.animate();\n  }\n\n  resize() {\n    if (!this.wrapper || !this.canvas) return;\n    this.width = this.wrapper.clientWidth || 800;\n    this.height = this.wrapper.clientHeight || 420;\n    const dpr = window.devicePixelRatio || 1;\n    this.canvas.width = this.width * dpr;\n    this.canvas.height = this.height * dpr;\n    this.ctx.setTransform(dpr, 0, 0, dpr, 0, 0);\n  }\n\n  initEvents() {\n    this.canvas.addEventListener('mousedown', (e) => {\n      this.isDragging = true;\n      this.lastMouseX = e.clientX;\n      this.lastMouseY = e.clientY;\n    });\n\n    window.addEventListener('mouseup', () => {\n      this.isDragging = false;\n    });\n\n    this.canvas.addEventListener('mousemove', (e) => {\n      if (this.isDragging) {\n        const deltaX = e.clientX - this.lastMouseX;\n        const deltaY = e.clientY - this.lastMouseY;\n        this.rotY += deltaX * 0.007;\n        this.rotX += deltaY * 0.007;\n        this.rotX = Math.max(0.12, Math.min(1.2, this.rotX));\n        this.lastMouseX = e.clientX;\n        this.lastMouseY = e.clientY;\n      }\n      this.checkHover(e);\n    });\n\n    this.canvas.addEventListener('wheel', (e) => {\n      e.preventDefault();\n      this.scale += e.deltaY * -0.001;\n      // Clamping scale between 0.65 and 1.85 ensures no camera inversion\n      this.scale = Math.max(0.65, Math.min(1.85, this.scale));\n    }, { passive: false });\n  }\n\n  checkHover(e) {\n    if (!this.canvas) return;\n    const rect = this.canvas.getBoundingClientRect();\n    const mouseX = e.clientX - rect.left;\n    const mouseY = e.clientY - rect.top;\n\n    let found = null;\n    TRANSIT_STATIONS.forEach(s => {\n      const p = this.project(s.x, s.y, s.z);\n      const dist = Math.hypot(p.x - mouseX, p.y - mouseY);\n      if (dist < 22) {\n        found = s;\n      }\n    });\n\n    this.hoveredStation = found;\n    const hud = document.getElementById('map-hud-overlay');\n    if (hud) {\n      if (found) {\n        hud.innerHTML = `<span class=\"text-emerald font-bold\">📍 ${found.name}</span> &bull; Transit Zone: ${found.zone} &bull; Elevation: +${found.z}m`;\n      } else {\n        hud.innerHTML = `<i class=\"fa-solid fa-hand-pointer text-emerald\"></i> Click & drag to orbit 3D city corridors &bull; Scroll to zoom`;\n      }\n    }\n  }\n\n  project(x, y, z) {\n    const cosY = Math.cos(this.rotY);\n    const sinY = Math.sin(this.rotY);\n    const x1 = x * cosY + z * sinY;\n    const z1 = -x * sinY + z * cosY;\n\n    const cosX = Math.cos(this.rotX);\n    const sinX = Math.sin(this.rotX);\n    const y2 = y * cosX - z1 * sinX;\n    const z2 = y * sinX + z1 * cosX;\n\n    const cameraDist = 440;\n    // Guard against divide by zero or extreme negative z2\n    const safeDenominator = Math.max(10, cameraDist + z2);\n    const fov = cameraDist / safeDenominator;\n\n    const screenX = (this.width || 800) / 2 + x1 * fov * this.scale;\n    const screenY = (this.height || 420) / 2 + y2 * fov * this.scale;\n\n    return { x: screenX, y: screenY, scale: fov, z: z2 };\n  }\n\n  setActivePath(path) {\n    this.activeCorridorPath = Array.isArray(path) ? path : [];\n    this.carProgress = 0;\n    this.isCarDriving = this.activeCorridorPath.length > 1;\n  }\n\n  startCarSimulation() {\n    if (this.activeCorridorPath && this.activeCorridorPath.length > 1) {\n      this.carProgress = 0;\n      this.isCarDriving = true;\n    }\n  }\n\n  resetCamera() {\n    this.rotX = 0.45;\n    this.rotY = -0.32;\n    this.scale = 1.08;\n  }\n\n  pause() {\n    this.isPaused = true;\n    if (this.animId) {\n      cancelAnimationFrame(this.animId);\n      this.animId = null;\n    }\n  }\n\n  resume() {\n    if (this.isPaused) {\n      this.isPaused = false;\n      this.animate();\n    }\n  }\n\n  animate() {\n    if (this.isPaused || !this.ctx) return;\n    this.flowDashOffset -= 0.6;\n    this.render();\n\n    // Advance transit vehicle along path\n    if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n      this.carProgress += this.carSpeed;\n      if (this.carProgress >= this.activeCorridorPath.length - 1) {\n        this.carProgress = 0;\n      }\n    }\n\n    this.animId = requestAnimationFrame(this.animate);\n  }\n\n  render() {\n    const ctx = this.ctx;\n    ctx.clearRect(0, 0, this.width, this.height);\n\n    this.drawGroundGrid();\n\n    // Draw Corridors\n    TRANSIT_CORRIDORS.forEach(corridor => {\n      const uStation = TRANSIT_STATIONS.find(s => s.id === corridor.u);\n      const vStation = TRANSIT_STATIONS.find(s => s.id === corridor.v);\n      if (!uStation || !vStation) return;\n\n      const p1 = this.project(uStation.x, uStation.y, uStation.z);\n      const p2 = this.project(vStation.x, vStation.y, vStation.z);\n\n      let isPath = false;\n      let pathDirection = 0; // 1: u->v, -1: v->u\n\n      for (let i = 0; i < this.activeCorridorPath.length - 1; i++) {\n        const a = this.activeCorridorPath[i];\n        const b = this.activeCorridorPath[i + 1];\n        if (a === corridor.u && b === corridor.v) {\n          isPath = true;\n          pathDirection = 1;\n          break;\n        } else if (a === corridor.v && b === corridor.u) {\n          isPath = true;\n          pathDirection = -1;\n          break;\n        }\n      }\n\n      ctx.save();\n      ctx.beginPath();\n      ctx.moveTo(p1.x, p1.y);\n      ctx.lineTo(p2.x, p2.y);\n\n      if (isPath) {\n        ctx.strokeStyle = '#2563EB';\n        ctx.lineWidth = 4.5;\n        ctx.stroke();\n\n        ctx.save();\n        ctx.beginPath();\n        const startP = pathDirection === 1 ? p1 : p2;\n        const endP = pathDirection === 1 ? p2 : p1;\n        ctx.moveTo(startP.x, startP.y);\n        ctx.lineTo(endP.x, endP.y);\n        ctx.strokeStyle = '#60A5FA';\n        ctx.lineWidth = 2.5;\n        ctx.setLineDash([8, 12]);\n        ctx.lineDashOffset = this.flowDashOffset;\n        ctx.stroke();\n        ctx.restore();\n      } else {\n        ctx.strokeStyle = '#CBD5E1';\n        ctx.lineWidth = 2;\n        ctx.stroke();\n      }\n      ctx.restore();\n\n      // Corridor Distance Tag\n      const midX = (p1.x + p2.x) / 2;\n      const midY = (p1.y + p2.y) / 2;\n      ctx.save();\n      ctx.fillStyle = isPath ? '#2563EB' : '#FFFFFF';\n      ctx.strokeStyle = isPath ? '#1D4ED8' : '#CBD5E1';\n      ctx.lineWidth = 1;\n      ctx.beginPath();\n      if (typeof ctx.roundRect === 'function') {\n        ctx.roundRect(midX - 16, midY - 9, 32, 18, 4);\n      } else {\n        ctx.rect(midX - 16, midY - 9, 32, 18);\n      }\n      ctx.fill();\n      ctx.stroke();\n\n      ctx.fillStyle = isPath ? '#FFFFFF' : '#475569';\n      ctx.font = 'bold 9px \"JetBrains Mono\"';\n      ctx.textAlign = 'center';\n      ctx.textBaseline = 'middle';\n      ctx.fillText(`${corridor.distance}km`, midX, midY);\n      ctx.restore();\n    });\n\n    // Draw Stations (Sorted by Z for depth)\n    const sorted = [...TRANSIT_STATIONS].map(s => ({\n      station: s,\n      proj: this.project(s.x, s.y, s.z)\n    })).sort((a, b) => b.proj.z - a.proj.z);\n\n    sorted.forEach(({ station, proj }) => {\n      const isPath = this.activeCorridorPath.includes(station.id);\n      const isHovered = this.hoveredStation && this.hoveredStation.id === station.id;\n\n      ctx.save();\n\n      // Floor Shadow\n      const floorProj = this.project(station.x, station.y, -30);\n      ctx.beginPath();\n      ctx.ellipse(floorProj.x, floorProj.y, 14 * proj.scale, 7 * proj.scale, 0, 0, Math.PI * 2);\n      ctx.fillStyle = 'rgba(15, 23, 42, 0.08)';\n      ctx.fill();\n\n      // Elevation Stem\n      ctx.beginPath();\n      ctx.moveTo(floorProj.x, floorProj.y);\n      ctx.lineTo(proj.x, proj.y);\n      ctx.strokeStyle = isPath ? 'rgba(5, 150, 105, 0.6)' : '#CBD5E1';\n      ctx.lineWidth = 1.5;\n      ctx.setLineDash([2, 3]);\n      ctx.stroke();\n      ctx.setLineDash([]);\n\n      // Station Circle\n      ctx.beginPath();\n      const radius = (isHovered ? 14 : 11) * proj.scale;\n      ctx.arc(proj.x, proj.y, Math.max(2, radius), 0, Math.PI * 2);\n\n      if (isPath) {\n        ctx.fillStyle = '#059669';\n        ctx.shadowColor = 'rgba(5, 150, 105, 0.4)';\n        ctx.shadowBlur = 14;\n      } else if (isHovered) {\n        ctx.fillStyle = '#2563EB';\n        ctx.shadowColor = 'rgba(37, 99, 235, 0.4)';\n        ctx.shadowBlur = 12;\n      } else {\n        ctx.fillStyle = '#FFFFFF';\n        ctx.strokeStyle = '#059669';\n        ctx.lineWidth = 2.5;\n        ctx.stroke();\n      }\n      ctx.fill();\n      ctx.restore();\n\n      // Station Label & Zone\n      ctx.save();\n      ctx.font = '600 11px \"Inter\"';\n      ctx.fillStyle = isPath ? '#059669' : '#0F172A';\n      ctx.textAlign = 'center';\n      ctx.fillText(station.name, proj.x, proj.y - 18 * proj.scale);\n      ctx.font = '500 9px \"JetBrains Mono\"';\n      ctx.fillStyle = '#64748B';\n      ctx.fillText(station.zone, proj.x, proj.y + 20 * proj.scale);\n      ctx.restore();\n    });\n\n    // Draw Animated Electric Transit Car\n    if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n      this.drawAnimatedCar();\n    }\n  }\n\n  drawAnimatedCar() {\n    const ctx = this.ctx;\n    const segmentIndex = Math.floor(this.carProgress);\n    const segmentT = this.carProgress - segmentIndex;\n\n    const fromId = this.activeCorridorPath[segmentIndex];\n    const toId = this.activeCorridorPath[segmentIndex + 1];\n\n    if (!fromId || !toId) return;\n\n    const s1 = TRANSIT_STATIONS.find(s => s.id === fromId);\n    const s2 = TRANSIT_STATIONS.find(s => s.id === toId);\n    if (!s1 || !s2) return;\n\n    // Interpolate 3D coordinates\n    const curX = s1.x + (s2.x - s1.x) * segmentT;\n    const curY = s1.y + (s2.y - s1.y) * segmentT;\n    const curZ = s1.z + (s2.z - s1.z) * segmentT;\n\n    const carProj = this.project(curX, curY, curZ);\n\n    // Calculate heading angle\n    const p1 = this.project(s1.x, s1.y, s1.z);\n    const p2 = this.project(s2.x, s2.y, s2.z);\n    const dx = p2.x - p1.x;\n    const dy = p2.y - p1.y;\n    // Guard against NaN heading\n    const heading = (dx === 0 && dy === 0) ? 0 : Math.atan2(dy, dx);\n\n    ctx.save();\n    ctx.translate(carProj.x, carProj.y);\n    ctx.rotate(heading);\n\n    const safeScale = Math.max(0.4, carProj.scale);\n\n    // Glowing Headlight Beams\n    ctx.beginPath();\n    ctx.moveTo(12 * safeScale, -4 * safeScale);\n    ctx.lineTo(26 * safeScale, -12 * safeScale);\n    ctx.lineTo(26 * safeScale, 12 * safeScale);\n    ctx.lineTo(12 * safeScale, 4 * safeScale);\n    ctx.closePath();\n    try {\n      const lightGrad = ctx.createLinearGradient(12 * safeScale, 0, 26 * safeScale, 0);\n      lightGrad.addColorStop(0, 'rgba(32, 201, 176, 0.45)');\n      lightGrad.addColorStop(1, 'rgba(32, 201, 176, 0)');\n      ctx.fillStyle = lightGrad;\n      ctx.fill();\n    } catch {\n      ctx.fillStyle = 'rgba(32, 201, 176, 0.25)';\n      ctx.fill();\n    }\n\n    // Electric Vehicle Chassis\n    ctx.beginPath();\n    if (typeof ctx.roundRect === 'function') {\n      ctx.roundRect(-10 * safeScale, -6 * safeScale, 20 * safeScale, 12 * safeScale, 4 * safeScale);\n    } else {\n      ctx.rect(-10 * safeScale, -6 * safeScale, 20 * safeScale, 12 * safeScale);\n    }\n    ctx.fillStyle = '#059669';\n    ctx.fill();\n    ctx.strokeStyle = '#FFFFFF';\n    ctx.lineWidth = 1.5;\n    ctx.stroke();\n\n    // Windshield\n    ctx.beginPath();\n    if (typeof ctx.roundRect === 'function') {\n      ctx.roundRect(0, -4 * safeScale, 5 * safeScale, 8 * safeScale, 2 * safeScale);\n    } else {\n      ctx.rect(0, -4 * safeScale, 5 * safeScale, 8 * safeScale);\n    }\n    ctx.fillStyle = '#93C5FD';\n    ctx.fill();\n\n    // Headlight bulbs\n    ctx.fillStyle = '#FEF08A';\n    ctx.fillRect(8 * safeScale, -5 * safeScale, 2 * safeScale, 2 * safeScale);\n    ctx.fillRect(8 * safeScale, 3 * safeScale, 2 * safeScale, 2 * safeScale);\n\n    ctx.restore();\n  }\n\n  drawGroundGrid() {\n    const ctx = this.ctx;\n    const size = 220;\n    const step = 44;\n    const floorZ = -30;\n\n    ctx.save();\n    ctx.strokeStyle = 'rgba(203, 213, 225, 0.6)';\n    ctx.lineWidth = 1;\n\n    for (let i = -size; i <= size; i += step) {\n      const p1 = this.project(i, -size, floorZ);\n      const p2 = this.project(i, size, floorZ);\n      ctx.beginPath();\n      ctx.moveTo(p1.x, p1.y);\n      ctx.lineTo(p2.x, p2.y);\n      ctx.stroke();\n\n      const p3 = this.project(-size, i, floorZ);\n      const p4 = this.project(size, i, floorZ);\n      ctx.beginPath();\n      ctx.moveTo(p3.x, p3.y);\n      ctx.lineTo(p4.x, p4.y);\n      ctx.stroke();\n    }\n    ctx.restore();\n  }\n}\n\nlet urbanCanvasInstance = null;\nlet ambientCanvasInstance = null;\n\n// ==========================================\n// 5. ECOSPROUT MASCOT VECTOR TEMPLATE\n// ==========================================\nfunction getEcoSproutSVG() {\n  return `\n    <svg viewBox=\"0 0 64 64\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n      <circle cx=\"32\" cy=\"38\" r=\"18\" fill=\"#10B981\"/>\n      <ellipse cx=\"32\" cy=\"42\" rx=\"14\" ry=\"10\" fill=\"#34D399\"/>\n      <path d=\"M32 20C32 20 22 14 26 6C34 10 32 20 32 20Z\" fill=\"#059669\"/>\n      <path d=\"M32 20C32 20 42 14 38 6C30 10 32 20 32 20Z\" fill=\"#34D399\"/>\n      <circle cx=\"32\" cy=\"20\" r=\"3\" fill=\"#D97706\"/>\n      <rect x=\"18\" y=\"28\" width=\"12\" height=\"9\" rx=\"3\" fill=\"#1E293B\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n      <rect x=\"34\" y=\"28\" width=\"12\" height=\"9\" rx=\"3\" fill=\"#1E293B\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n      <line x1=\"30\" y1=\"32\" x2=\"34\" y2=\"32\" stroke=\"#F59E0B\" stroke-width=\"2\"/>\n      <circle cx=\"24\" cy=\"32\" r=\"3\" fill=\"#38BDF8\"/>\n      <circle cx=\"40\" cy=\"32\" r=\"3\" fill=\"#38BDF8\"/>\n      <path d=\"M26 43C28 47 36 47 38 43\" stroke=\"#064E3B\" stroke-width=\"2\" stroke-linecap=\"round\"/>\n      <circle cx=\"21\" cy=\"41\" r=\"2.5\" fill=\"#F87171\" opacity=\"0.7\"/>\n      <circle cx=\"43\" cy=\"41\" r=\"2.5\" fill=\"#F87171\" opacity=\"0.7\"/>\n    </svg>\n  `;\n}\n\n// ==========================================\n// 6. MULTI-TAB SWITCHING CONTROLLER\n// ==========================================\nfunction initTabNavigation() {\n  const triggers = document.querySelectorAll('.tab-trigger');\n  const views = document.querySelectorAll('.tab-view');\n\n  triggers.forEach(trigger => {\n    trigger.addEventListener('click', () => {\n      const targetTabId = trigger.dataset.tab;\n\n      triggers.forEach(t => t.classList.remove('active'));\n      trigger.classList.add('active');\n\n      views.forEach(v => {\n        v.classList.remove('active');\n        if (v.id === targetTabId) {\n          v.classList.add('active');\n        }\n      });\n\n      // Tab-specific canvas optimization\n      if (targetTabId === 'tab-route-finder' && urbanCanvasInstance) {\n        urbanCanvasInstance.resume();\n        setTimeout(() => {\n          urbanCanvasInstance.resize();\n        }, 50);\n      } else if (urbanCanvasInstance) {\n        // Pause 3D render loop when offscreen to save GPU/CPU cycles\n        urbanCanvasInstance.pause();\n      }\n    });\n  });\n}\n\n// ==========================================\n// 7. UI REFRESH & COMPONENT RENDERERS\n// ==========================================\nfunction refreshPlatformUI() {\n  renderPassengerDispatchStream();\n  renderStandbyLounge();\n  renderFleetDirectory();\n  renderActiveTrips();\n  renderTransitHierarchyCanvas();\n  renderAuditHistory();\n  renderLeaderboard();\n  updateTopKPIs();\n}\n\nfunction updateTopKPIs() {\n  const commutersEl = document.getElementById('kpi-commuters');\n  if (commutersEl) commutersEl.innerHTML = `${engine.dispatchStream.length} <span class=\"kpi-unit\">commuters</span>`;\n\n  const tripsEl = document.getElementById('kpi-active-trips');\n  if (tripsEl) tripsEl.innerHTML = `${engine.activeTrips.length} <span class=\"kpi-unit\">trips</span>`;\n\n  const passBadge = document.getElementById('tab-passengers-badge');\n  if (passBadge) passBadge.textContent = engine.dispatchStream.length + engine.standbyCount;\n\n  const fleetBadge = document.getElementById('tab-fleet-badge');\n  if (fleetBadge) fleetBadge.textContent = engine.fleetPartners.length;\n\n  let totalSavedCO2 = 148.5;\n  let totalDistance = 1420;\n  engine.activeTrips.forEach(t => {\n    totalSavedCO2 += (t.co2Saved || 0);\n    totalDistance += (t.distance || 0);\n  });\n\n  const kpiCo2 = document.getElementById('kpi-co2');\n  if (kpiCo2) kpiCo2.innerHTML = `${totalSavedCO2.toFixed(1)} <span class=\"kpi-unit\">kg</span>`;\n\n  const ecoTotal = document.getElementById('eco-total-co2');\n  if (ecoTotal) ecoTotal.textContent = `${totalSavedCO2.toFixed(1)} kg`;\n\n  const ecoKm = document.getElementById('eco-shared-km');\n  if (ecoKm) ecoKm.textContent = `${Math.round(totalDistance).toLocaleString()} km`;\n\n  const fleetCountBadge = document.getElementById('fleet-count-badge');\n  if (fleetCountBadge) fleetCountBadge.textContent = `${engine.fleetPartners.length} Active Partners`;\n\n  const activeTripsBadge = document.getElementById('active-trips-badge');\n  if (activeTripsBadge) activeTripsBadge.textContent = `${engine.activeTrips.length} In-Transit`;\n}\n\n// --- Passenger Dispatch Stream with EcoSprout Empty State ---\nfunction renderPassengerDispatchStream() {\n  const container = document.getElementById('passenger-conveyor');\n  if (!container) return;\n\n  if (engine.dispatchStream.length === 0) {\n    container.innerHTML = `\n      <div class=\"ecosprout-container\">\n        <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n        <div class=\"ecosprout-bubble\">\n          <b>EcoSprout here!</b> The dispatch conveyor is clear. Submit a commuter request above to plan a green trip!\n        </div>\n      </div>`;\n    return;\n  }\n\n  container.innerHTML = engine.dispatchStream.map((pass, idx) => `\n    <div class=\"commuter-token ${idx === 0 ? 'head-token' : ''} eco-card-hover\">\n      <div class=\"token-badge\">${idx === 0 ? 'NEXT DISPATCH' : `PRIORITY #${idx + 1}`}</div>\n      <div class=\"token-name\">${escapeHTML(pass.name)}</div>\n      <div class=\"token-route\"><i class=\"fa-solid fa-route\"></i> ${escapeHTML(pass.pickup)} &rarr; ${escapeHTML(pass.drop)}</div>\n      <div class=\"token-meta\">${escapeHTML(pass.id)} &bull; ${escapeHTML(pass.requestedAt)}</div>\n    </div>\n  `).join('');\n}\n\n// --- Priority Standby Lounge ---\nfunction renderStandbyLounge() {\n  const ring = document.getElementById('standby-ring');\n  const counter = document.getElementById('standby-slot-counter');\n  const pill = document.getElementById('standby-status-pill');\n  if (!ring || !counter || !pill) return;\n\n  counter.textContent = `${engine.standbyCount} / ${engine.standbyCap}`;\n  pill.textContent = `Available Slots: ${engine.standbyCap - engine.standbyCount} / ${engine.standbyCap}`;\n\n  ring.innerHTML = '';\n  const total = engine.standbyCap;\n  const radius = 90;\n\n  for (let i = 0; i < total; i++) {\n    const angle = (i * 2 * Math.PI) / total - Math.PI / 2;\n    const x = Math.round(radius * Math.cos(angle) + 105);\n    const y = Math.round(radius * Math.sin(angle) + 105);\n\n    const isOccupied = engine.standbyLounge[i] !== null;\n    const isActivePointer = i === engine.standbyFront && engine.standbyCount > 0;\n\n    const slotEl = document.createElement('div');\n    slotEl.className = `standby-slot ${isOccupied ? 'occupied' : ''} ${isActivePointer ? 'is-active-pointer' : ''}`;\n    slotEl.style.left = `${x}px`;\n    slotEl.style.top = `${y}px`;\n\n    const passenger = engine.standbyLounge[i];\n    slotEl.innerHTML = `\n      <div class=\"font-bold\">SLOT ${i + 1}</div>\n      <div class=\"text-[9px] truncate max-w-[42px]\">${passenger ? escapeHTML(passenger.name.split(' ')[0]) : 'FREE'}</div>\n    `;\n    slotEl.title = passenger ? `Standby: ${passenger.name} (${passenger.pickup} -> ${passenger.drop})` : `Slot ${i + 1}: Empty`;\n    ring.appendChild(slotEl);\n  }\n}\n\n// --- Driver Fleet Directory with EcoSprout Empty State ---\nfunction renderFleetDirectory() {\n  const container = document.getElementById('fleet-stream-container');\n  const capacityPill = document.getElementById('fleet-capacity-pill');\n  if (!container || !capacityPill) return;\n\n  let totalAvailableSeats = 0;\n  engine.fleetPartners.forEach(p => { totalAvailableSeats += p.seats; });\n  capacityPill.textContent = `Total Available Seats: ${totalAvailableSeats}`;\n\n  if (engine.fleetPartners.length === 0) {\n    container.innerHTML = `\n      <div class=\"ecosprout-container\">\n        <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n        <div class=\"ecosprout-bubble\">\n          <b>EcoSprout needs partners!</b> Toggle vehicle seats above and onboard a driver partner to open seat capacity.\n        </div>\n      </div>`;\n    return;\n  }\n\n  let html = '';\n  engine.fleetPartners.forEach((partner, idx) => {\n    html += `\n      <div class=\"driver-partner-card eco-card-hover\">\n        <div class=\"card-top\">\n          <span class=\"driver-id-badge\">ID: #${partner.id}</span>\n          <span class=\"seat-counter-pill\">${partner.seats}/${partner.originalSeats} Seats</span>\n        </div>\n        <div class=\"driver-name\">${escapeHTML(partner.name)}</div>\n        <div class=\"driver-corridor\"><i class=\"fa-solid fa-location-dot text-emerald\"></i> ${escapeHTML(partner.station)} Station</div>\n        <div class=\"text-[10px] text-slate-500 mt-1\">${partner.tripsCompleted} Shared Trips</div>\n      </div>\n    `;\n\n    if (idx < engine.fleetPartners.length - 1) {\n      html += `<div class=\"fleet-pointer\"><i class=\"fa-solid fa-arrow-right\"></i></div>`;\n    }\n  });\n\n  container.innerHTML = html;\n}\n\n// --- Active Shared Trips with EcoSprout Empty State ---\nfunction renderActiveTrips() {\n  const container = document.getElementById('active-trips-stream');\n  if (!container) return;\n\n  if (engine.activeTrips.length === 0) {\n    container.innerHTML = `\n      <div class=\"ecosprout-container\">\n        <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n        <div class=\"ecosprout-bubble\">\n          <b>EcoSprout is ready to roll!</b> Dispatch a trip or launch the Rush-Hour simulation to watch active pooled rides.\n        </div>\n      </div>`;\n    return;\n  }\n\n  container.innerHTML = engine.activeTrips.map(trip => `\n    <div class=\"shared-trip-card eco-card-hover\">\n      <button class=\"btn-cancel-trip\" title=\"Complete / Cancel Trip\" onclick=\"handleCompleteTrip('${trip.tripRef}')\">\n        <i class=\"fa-solid fa-xmark\"></i>\n      </button>\n      <div class=\"flex justify-between items-center\">\n        <span class=\"trip-ref\">${escapeHTML(trip.tripRef)}</span>\n        <span class=\"route-match-badge\">${trip.matchScore}% Route Match</span>\n      </div>\n      <div class=\"text-xs font-bold text-slate-900 mt-0.5\">${escapeHTML(trip.passenger.name)}</div>\n      <div class=\"text-[10px] text-electric font-semibold\">${trip.corridorPath.map(escapeHTML).join(' &rarr; ')}</div>\n      <div class=\"text-[10px] text-slate-600 mt-1\"><i class=\"fa-solid fa-id-badge text-emerald\"></i> ${escapeHTML(trip.driverName)}</div>\n      <div class=\"flex justify-between items-center text-[9px] text-slate-500 pt-1 border-t border-slate-200 mt-1\">\n        <span>+${trip.co2Saved}kg CO₂</span>\n        <button class=\"text-emerald hover:underline font-bold\" onclick=\"viewEcoReceipt('${trip.tripRef}')\">\n          <i class=\"fa-solid fa-receipt\"></i> Eco-Receipt\n        </button>\n        <span class=\"text-slate-900 font-bold\">$${trip.fare}</span>\n      </div>\n    </div>\n  `).join('');\n}\n\n// --- Transit Hierarchy Canvas ---\nfunction renderTransitHierarchyCanvas() {\n  const canvas = document.getElementById('trip-hierarchy-canvas');\n  if (!canvas) return;\n  const ctx = canvas.getContext('2d');\n  const countPill = document.getElementById('registry-count-pill');\n\n  if (countPill) countPill.textContent = `${engine.activeTrips.length} Active Trips`;\n  ctx.clearRect(0, 0, canvas.width, canvas.height);\n\n  if (engine.activeTrips.length === 0) {\n    ctx.fillStyle = '#64748B';\n    ctx.font = '11px \"Inter\"';\n    ctx.textAlign = 'center';\n    ctx.fillText('Transit Dispatch Registry Ready. Active shared trips will display here.', canvas.width / 2, canvas.height / 2);\n    return;\n  }\n\n  const rootX = canvas.width / 2;\n  const rootY = 24;\n\n  ctx.beginPath();\n  ctx.arc(rootX, rootY, 14, 0, Math.PI * 2);\n  ctx.fillStyle = '#FFFFFF';\n  ctx.strokeStyle = '#059669';\n  ctx.lineWidth = 2.5;\n  ctx.fill();\n  ctx.stroke();\n\n  ctx.fillStyle = '#059669';\n  ctx.font = 'bold 9px \"Inter\"';\n  ctx.textAlign = 'center';\n  ctx.textBaseline = 'middle';\n  ctx.fillText('NEXUS', rootX, rootY);\n\n  const count = engine.activeTrips.length;\n  const spacing = Math.min(80, (canvas.width - 60) / Math.max(count, 1));\n  const startX = rootX - ((count - 1) * spacing) / 2;\n\n  engine.activeTrips.forEach((trip, idx) => {\n    const nodeX = startX + idx * spacing;\n    const nodeY = 110;\n\n    ctx.beginPath();\n    ctx.moveTo(rootX, rootY + 14);\n    ctx.lineTo(nodeX, nodeY - 14);\n    ctx.strokeStyle = '#CBD5E1';\n    ctx.lineWidth = 1.5;\n    ctx.stroke();\n\n    ctx.beginPath();\n    ctx.arc(nodeX, nodeY, 13, 0, Math.PI * 2);\n    ctx.fillStyle = '#FFFFFF';\n    ctx.strokeStyle = '#2563EB';\n    ctx.lineWidth = 2;\n    ctx.fill();\n    ctx.stroke();\n\n    ctx.fillStyle = '#1E293B';\n    ctx.font = 'bold 8px \"JetBrains Mono\"';\n    ctx.textAlign = 'center';\n    ctx.fillText(trip.tripRef.replace('NX-', ''), nodeX, nodeY);\n\n    ctx.fillStyle = '#059669';\n    ctx.font = '500 8px \"Inter\"';\n    const shortName = trip.passenger && trip.passenger.name ? trip.passenger.name.split(' ')[0] : 'Trip';\n    ctx.fillText(shortName, nodeX, nodeY + 22);\n  });\n}\n\n// --- Reversal Audit History List ---\nfunction renderAuditHistory() {\n  const container = document.getElementById('audit-history-list');\n  const pill = document.getElementById('audit-log-pill');\n  if (!container || !pill) return;\n\n  pill.textContent = `${engine.reversalAuditLog.length} Rollbacks Available`;\n\n  if (engine.reversalAuditLog.length === 0) {\n    container.innerHTML = `\n      <div class=\"empty-state\">\n        <p>Reversal log clear. Confirm a trip to create a restorable dispatch state.</p>\n      </div>`;\n    return;\n  }\n\n  const latestIdx = engine.reversalAuditLog.length - 1;\n  container.innerHTML = engine.reversalAuditLog.map((entry, idx) => `\n    <div class=\"audit-entry ${idx === latestIdx ? 'latest-entry' : ''}\">\n      <div class=\"flex items-center gap-2\">\n        <i class=\"fa-solid fa-shield-check text-emerald\"></i>\n        <span class=\"font-semibold text-slate-800\">${escapeHTML(entry.tripRef)} &bull; ${escapeHTML(entry.passenger ? entry.passenger.name : 'Unknown')}</span>\n      </div>\n      <span class=\"text-slate-500 font-mono text-[10px]\">Driver #${entry.driverId}</span>\n    </div>\n  `).join('');\n}\n\n// --- Leaderboard with Gamified Achievement Badges ---\nfunction renderLeaderboard() {\n  const container = document.getElementById('eco-leaderboard-list');\n  if (!container) return;\n\n  container.innerHTML = engine.leaderboard.map((item, idx) => `\n    <div class=\"leader-item\">\n      <div class=\"flex items-center gap-2\">\n        <span class=\"text-amber-500 font-bold\">#${idx + 1}</span>\n        <div>\n          <div class=\"font-semibold text-slate-800\">${escapeHTML(item.name)}</div>\n          <span class=\"gamified-badge\"><i class=\"fa-solid fa-award\"></i> ${escapeHTML(item.badge)}</span>\n        </div>\n      </div>\n      <div class=\"flex items-center gap-3\">\n        <span class=\"text-slate-500\">${item.trips} trips</span>\n        <span class=\"text-emerald font-semibold\">${item.co2}</span>\n        <span class=\"text-amber-600 font-mono text-[11px]\"><i class=\"fa-solid fa-star\"></i> ${item.rating}</span>\n      </div>\n    </div>\n  `).join('');\n}\n\n// ==========================================\n// 8. ENTERPRISE CONFIRMATION MODALS\n// ==========================================\nfunction openDispatchModal(trip, driver) {\n  const modal = document.getElementById('dispatch-confirm-modal');\n  const body = document.getElementById('dispatch-modal-body');\n  if (!modal || !body) return;\n\n  body.innerHTML = `\n    <div class=\"flex items-center gap-3 p-3 bg-emerald-50 border border-emerald-200 rounded-xl\">\n      <div class=\"text-2xl text-emerald\"><i class=\"fa-solid fa-circle-check\"></i></div>\n      <div>\n        <div class=\"text-sm font-bold text-slate-900\">Trip Reference: ${escapeHTML(trip.tripRef)}</div>\n        <div class=\"text-xs text-slate-600\">Passenger ${escapeHTML(trip.passenger.name)} matched with ${escapeHTML(driver.name)} (ID: #${driver.id})</div>\n      </div>\n    </div>\n\n    <div class=\"modal-stat-grid\">\n      <div class=\"modal-stat-box\">\n        <span class=\"stat-label\">CORRIDOR ALIGNMENT</span>\n        <span class=\"stat-val text-emerald\">${trip.matchScore}% Match</span>\n      </div>\n      <div class=\"modal-stat-box\">\n        <span class=\"stat-label\">EST. COMMUTE TIME</span>\n        <span class=\"stat-val text-electric\">~${trip.time} mins (${trip.distance}km)</span>\n      </div>\n      <div class=\"modal-stat-box\">\n        <span class=\"stat-label\">POOLED FARE</span>\n        <span class=\"stat-val text-slate-900\">$${trip.fare} USD</span>\n      </div>\n      <div class=\"modal-stat-box\">\n        <span class=\"stat-label\">CARBON OFFSET</span>\n        <span class=\"stat-val text-emerald\">+${trip.co2Saved} kg CO₂</span>\n      </div>\n    </div>\n\n    <div class=\"text-xs text-slate-500 font-mono\">\n      Route Transit: ${trip.corridorPath.map(escapeHTML).join(' &rarr; ')} &bull; Fleet seats remaining for #${driver.id}: ${driver.seats}\n    </div>\n  `;\n\n  modal.classList.remove('hidden');\n}\n\nfunction openReversalModal(action, driver) {\n  const modal = document.getElementById('reversal-confirm-modal');\n  const body = document.getElementById('reversal-modal-body');\n  if (!modal || !body) return;\n\n  body.innerHTML = `\n    <div class=\"flex items-center gap-3 p-3 bg-rose-50 border border-rose-200 rounded-xl\">\n      <div class=\"text-2xl text-rose\"><i class=\"fa-solid fa-arrow-rotate-left\"></i></div>\n      <div>\n        <div class=\"text-sm font-bold text-slate-900\">Reverted Trip: ${escapeHTML(action.tripRef)}</div>\n        <div class=\"text-xs text-slate-600\">The most recent dispatch confirmation was safely reversed.</div>\n      </div>\n    </div>\n\n    <div class=\"modal-stat-grid\">\n      <div class=\"modal-stat-box\">\n        <span class=\"stat-label\">RESTORED DRIVER</span>\n        <span class=\"stat-val text-slate-900\">${driver ? escapeHTML(driver.name) : `ID #${action.driverId}`}</span>\n      </div>\n      <div class=\"modal-stat-box\">\n        <span class=\"stat-label\">UPDATED SEAT CAPACITY</span>\n        <span class=\"stat-val text-emerald\">${driver ? `${driver.seats}/${driver.originalSeats} Seats` : 'Restored'}</span>\n      </div>\n    </div>\n\n    <div class=\"text-xs text-slate-600\">\n      Commuter <b>${escapeHTML(action.passenger.name)}</b> has been returned to the front of the dispatch queue without losing priority.\n    </div>\n  `;\n\n  modal.classList.remove('hidden');\n}\n\n// Global Toast System\nfunction showPlatformToast(message, type = 'emerald') {\n  const container = document.getElementById('toast-container');\n  if (!container) return;\n  const toast = document.createElement('div');\n  toast.className = `toast toast-${type}`;\n  toast.innerHTML = `<i class=\"fa-solid fa-circle-check text-emerald\"></i><span>${message}</span>`;\n  container.appendChild(toast);\n\n  setTimeout(() => {\n    toast.style.opacity = '0';\n    toast.style.transform = 'translateY(15px)';\n    setTimeout(() => toast.remove(), 300);\n  }, 3600);\n}\n\n// Escape HTML utility to prevent XSS injection\nfunction escapeHTML(str) {\n  if (typeof str !== 'string') return String(str || '');\n  return str.replace(/[&<>'\"]/g, tag => ({\n    '&': '&amp;',\n    '<': '&lt;',\n    '>': '&gt;',\n    \"'\": '&#39;',\n    '\"': '&quot;'\n  }[tag] || tag));\n}\n\n// Global trip completion hook\nwindow.handleCompleteTrip = function(tripRef) {\n  const removed = engine.cancelActiveTrip(tripRef);\n  if (removed) {\n    showPlatformToast(`Trip ${tripRef} successfully completed. Corridors updated.`, 'blue');\n    refreshPlatformUI();\n  }\n};\n\n// Global Eco-Receipt viewer hook\nwindow.viewEcoReceipt = function(tripRef) {\n  const trip = engine.activeTrips.find(t => t.tripRef === tripRef);\n  if (!trip) return;\n\n  const modal = document.getElementById('receipt-modal-overlay');\n  const content = document.getElementById('receipt-content-area');\n  if (!modal || !content) return;\n\n  content.innerHTML = `\n    <div class=\"receipt-item-row\">\n      <span>Booking Reference:</span>\n      <span class=\"font-mono font-bold text-slate-800\">${escapeHTML(trip.tripRef)}</span>\n    </div>\n    <div class=\"receipt-item-row\">\n      <span>Commuter Name:</span>\n      <span class=\"font-semibold text-slate-800\">${escapeHTML(trip.passenger.name)}</span>\n    </div>\n    <div class=\"receipt-item-row\">\n      <span>Driver Partner:</span>\n      <span class=\"text-slate-800\">${escapeHTML(trip.driverName)} (ID: #${trip.driverId})</span>\n    </div>\n    <div class=\"receipt-item-row\">\n      <span>Corridor Route:</span>\n      <span class=\"text-electric font-semibold\">${trip.corridorPath.map(escapeHTML).join(' &rarr; ')}</span>\n    </div>\n    <div class=\"receipt-item-row\">\n      <span>Distance & Time:</span>\n      <span class=\"text-slate-800\">${trip.distance} km &bull; ~${trip.time} mins</span>\n    </div>\n    <div class=\"receipt-item-row\">\n      <span>Net Carbon Avoided:</span>\n      <span class=\"text-emerald font-bold font-mono\">+${trip.co2Saved} kg CO₂</span>\n    </div>\n    <div class=\"receipt-item-row\">\n      <span>Corridor Alignment Match:</span>\n      <span class=\"text-emerald font-bold\">${trip.matchScore}% Eco-Pooled Match</span>\n    </div>\n    <div class=\"receipt-item-row bold-row\">\n      <span>Total Pooled Fare Paid:</span>\n      <span class=\"text-slate-900\">$${trip.fare} USD</span>\n    </div>\n  `;\n\n  modal.classList.remove('hidden');\n};\n\n// ==========================================\n// 9. INITIALIZATION & EVENT LISTENERS\n// ==========================================\ndocument.addEventListener('DOMContentLoaded', () => {\n  urbanCanvasInstance = new Urban3DCanvas('urban-3d-canvas');\n  ambientCanvasInstance = new AmbientEcoCanvas('ambient-canvas');\n  initTabNavigation();\n\n  // Populate Select Boxes\n  const originSel = document.getElementById('route-origin');\n  const destSel = document.getElementById('route-destination');\n  const passPickup = document.getElementById('passenger-pickup-select');\n  const passDrop = document.getElementById('passenger-drop-select');\n  const driverStation = document.getElementById('driver-station-select');\n\n  if (originSel && destSel && passPickup && passDrop && driverStation) {\n    TRANSIT_STATIONS.forEach(s => {\n      const opt = `<option value=\"${s.id}\">${s.name} (${s.zone})</option>`;\n      originSel.insertAdjacentHTML('beforeend', opt);\n      destSel.insertAdjacentHTML('beforeend', opt);\n      passPickup.insertAdjacentHTML('beforeend', opt);\n      passDrop.insertAdjacentHTML('beforeend', opt);\n      driverStation.insertAdjacentHTML('beforeend', opt);\n    });\n\n    originSel.value = 'ALPHA';\n    destSel.value = 'HORIZON';\n    passPickup.value = 'ALPHA';\n    passDrop.value = 'HORIZON';\n    driverStation.value = 'METRO';\n  }\n\n  // --- Dynamic Commuter Slider Handler ---\n  const commuterSlider = document.getElementById('commuter-range-slider');\n  const sliderFareDisplay = document.getElementById('slider-fare-display');\n  const sliderTicks = document.querySelectorAll('.slider-ticks .tick');\n\n  function updateCommuterSliderMetrics() {\n    if (!commuterSlider) return;\n    const val = parseInt(commuterSlider.value, 10);\n    engine.commuterDensity = val;\n\n    sliderTicks.forEach((tick, idx) => {\n      tick.classList.toggle('active-tick', idx + 1 === val);\n    });\n\n    computeAndDisplayRoute();\n  }\n\n  if (commuterSlider) {\n    commuterSlider.addEventListener('input', updateCommuterSliderMetrics);\n  }\n\n  // --- Interactive 4-Seat Vehicle Selector ---\n  const seatButtons = [\n    document.getElementById('seat-front-pass'),\n    document.getElementById('seat-rear-left'),\n    document.getElementById('seat-rear-right')\n  ].filter(Boolean);\n  const driverSeatsCountLabel = document.getElementById('driver-seats-count-label');\n\n  function getActiveSeatsCount() {\n    let count = 0;\n    seatButtons.forEach(btn => {\n      if (btn.classList.contains('active-seat')) count++;\n    });\n    return count;\n  }\n\n  seatButtons.forEach(btn => {\n    btn.addEventListener('click', () => {\n      if (btn.classList.contains('active-seat')) {\n        btn.classList.remove('active-seat');\n        btn.classList.add('reserved-seat');\n        btn.innerHTML = `<i class=\"fa-solid fa-ban\"></i><span>OFF</span>`;\n      } else {\n        btn.classList.remove('reserved-seat');\n        btn.classList.add('active-seat');\n        btn.innerHTML = `<i class=\"fa-solid fa-user-check\"></i><span>${(btn.dataset.seat || 'SEAT').toUpperCase()}</span>`;\n      }\n      const count = getActiveSeatsCount();\n      if (driverSeatsCountLabel) driverSeatsCountLabel.textContent = count;\n      showPlatformToast(`Car configuration: ${count} passenger seats available.`, 'emerald');\n    });\n  });\n\n  // --- Calculate Route Button ---\n  function computeAndDisplayRoute() {\n    if (!originSel || !destSel) return;\n    const orig = originSel.value;\n    const dest = destSel.value;\n\n    if (orig === dest) {\n      showPlatformToast('Origin and Destination stations cannot be identical.', 'rose');\n      return;\n    }\n\n    const res = engine.findOptimalEcoRoute(orig, dest);\n    if (urbanCanvasInstance) {\n      urbanCanvasInstance.setActivePath(res.path);\n    }\n\n    const stripPath = document.getElementById('strip-path');\n    if (stripPath) stripPath.textContent = res.path.length > 0 ? res.path.join(' → ') : 'No Direct Corridor';\n\n    const stripDist = document.getElementById('strip-distance');\n    if (stripDist) stripDist.textContent = `${res.totalDist} km`;\n\n    const stripTime = document.getElementById('strip-time');\n    if (stripTime) stripTime.textContent = `~${res.estTime} min`;\n\n    const stripCo2 = document.getElementById('strip-co2');\n    if (stripCo2) stripCo2.textContent = `-${res.co2Offset} kg`;\n\n    const stripVeh = document.getElementById('strip-vehicles-saved');\n    if (stripVeh) stripVeh.textContent = `${res.soloCarsSaved} ${res.soloCarsSaved === 1 ? 'Car' : 'Cars'}`;\n\n    if (sliderFareDisplay) sliderFareDisplay.textContent = `$${res.fare}`;\n  }\n\n  const btnCalcRoute = document.getElementById('btn-calc-route');\n  if (btnCalcRoute) btnCalcRoute.addEventListener('click', computeAndDisplayRoute);\n\n  const btnSimDrive = document.getElementById('btn-simulate-drive');\n  if (btnSimDrive) {\n    btnSimDrive.addEventListener('click', () => {\n      if (urbanCanvasInstance) {\n        urbanCanvasInstance.startCarSimulation();\n        showPlatformToast('Simulating top-down electric transit drive along route corridors!', 'blue');\n      }\n    });\n  }\n\n  const btnSwapRoute = document.getElementById('btn-swap-route');\n  if (btnSwapRoute && originSel && destSel) {\n    btnSwapRoute.addEventListener('click', () => {\n      const temp = originSel.value;\n      originSel.value = destSel.value;\n      destSel.value = temp;\n      computeAndDisplayRoute();\n    });\n  }\n\n  const btnResetView = document.getElementById('btn-reset-view');\n  if (btnResetView && urbanCanvasInstance) {\n    btnResetView.addEventListener('click', () => {\n      urbanCanvasInstance.resetCamera();\n    });\n  }\n\n  // --- Passenger Request ---\n  const btnRequestRide = document.getElementById('btn-request-ride');\n  if (btnRequestRide) {\n    btnRequestRide.addEventListener('click', () => {\n      const nameInput = document.getElementById('passenger-name-input');\n      const rawName = nameInput ? nameInput.value : '';\n      const name = rawName.trim() || `Commuter_${Math.floor(Math.random() * 900 + 100)}`;\n      const pickup = passPickup ? passPickup.value : 'ALPHA';\n      const drop = passDrop ? passDrop.value : 'HORIZON';\n\n      if (pickup === drop) {\n        showPlatformToast('Pickup and drop-off stations must be distinct.', 'rose');\n        return;\n      }\n\n      const passenger = engine.submitRideRequest(name, pickup, drop);\n      if (nameInput) nameInput.value = '';\n      refreshPlatformUI();\n      showPlatformToast(`Ride request submitted for ${passenger.name} (${pickup} → ${drop}).`, 'emerald');\n    });\n  }\n\n  const btnCancelFrontReq = document.getElementById('btn-cancel-front-req');\n  if (btnCancelFrontReq) {\n    btnCancelFrontReq.addEventListener('click', () => {\n      const dequeued = engine.dequeueNextRequest();\n      if (dequeued) {\n        refreshPlatformUI();\n        showPlatformToast(`Cancelled request for ${dequeued.name} (${dequeued.id}).`, 'amber');\n      } else {\n        showPlatformToast('No pending passenger requests in the pipeline.', 'rose');\n      }\n    });\n  }\n\n  // --- Priority Standby Lounge ---\n  const btnPushStandby = document.getElementById('btn-push-standby');\n  if (btnPushStandby) {\n    btnPushStandby.addEventListener('click', () => {\n      let candidate = engine.dequeueNextRequest();\n      if (!candidate) {\n        candidate = {\n          id: `BK-STDBY-${Math.floor(Math.random() * 800 + 100)}`,\n          name: `Standby_Passenger_${Math.floor(Math.random() * 90 + 10)}`,\n          pickup: 'METRO',\n          drop: 'SKYPORT',\n          requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n          status: 'In Priority Standby'\n        };\n      }\n\n      const res = engine.pushToStandby(candidate);\n      if (!res.success) {\n        showPlatformToast(res.message, 'rose');\n        engine.dispatchStream.unshift(candidate);\n      } else {\n        showPlatformToast(`${candidate.name} admitted to Priority Standby Lounge.`, 'amber');\n      }\n      refreshPlatformUI();\n    });\n  }\n\n  const btnPopStandby = document.getElementById('btn-pop-standby');\n  if (btnPopStandby) {\n    btnPopStandby.addEventListener('click', () => {\n      const res = engine.popFromStandby();\n      if (!res.success) {\n        showPlatformToast(res.message, 'rose');\n      } else {\n        showPlatformToast(`Seated ${res.item.name} from Priority Standby Lounge.`, 'amber');\n      }\n      refreshPlatformUI();\n    });\n  }\n\n  // --- Driver Partner Registration with Visual Seat Selector ---\n  const btnRegisterDriver = document.getElementById('btn-register-driver');\n  if (btnRegisterDriver) {\n    btnRegisterDriver.addEventListener('click', () => {\n      const nameInput = document.getElementById('driver-name-input');\n      const rawName = nameInput ? nameInput.value : '';\n      const name = rawName.trim() || `Partner_${Math.floor(Math.random() * 900 + 100)}`;\n      const station = driverStation ? driverStation.value : 'METRO';\n      const seats = getActiveSeatsCount();\n\n      if (seats === 0) {\n        showPlatformToast('Please toggle at least 1 passenger seat in the vehicle blueprint.', 'rose');\n        return;\n      }\n\n      const partner = engine.onboardDriver(name, station, seats);\n      if (nameInput) nameInput.value = '';\n      refreshPlatformUI();\n      showPlatformToast(`Driver Partner ${partner.name} onboarded with ${partner.seats} passenger seats (ID: #${partner.id}).`, 'emerald');\n    });\n  }\n\n  // --- Flexible Verification & Lookup ---\n  const btnVerifyId = document.getElementById('btn-verify-id');\n  if (btnVerifyId) {\n    btnVerifyId.addEventListener('click', () => {\n      const idInput = document.getElementById('verify-id-input');\n      const resultBox = document.getElementById('verification-result-box');\n      if (!idInput || !resultBox) return;\n      const query = idInput.value.trim();\n\n      if (!query) {\n        resultBox.innerHTML = '<span class=\"text-rose-500 text-xs\">Please enter a valid Driver Partner ID or Booking Reference.</span>';\n        return;\n      }\n\n      const partner = engine.getDriverById(query);\n      if (partner) {\n        resultBox.innerHTML = `\n          <div class=\"flex items-center justify-between w-full text-xs\">\n            <div>\n              <span class=\"text-emerald font-bold\"><i class=\"fa-solid fa-circle-check\"></i> Verified Partner:</span>\n              <span class=\"text-slate-900 font-semibold ml-1\">${escapeHTML(partner.name)} (ID: #${partner.id})</span>\n              <span class=\"text-slate-500 ml-2\">&bull; ${escapeHTML(partner.station)} Station</span>\n            </div>\n            <span class=\"seat-counter-pill\">${partner.seats} Seats Free</span>\n          </div>`;\n        showPlatformToast(`Verified operational identity for Partner #${partner.id}.`, 'emerald');\n        return;\n      }\n\n      const booking = engine.getBookingByRef(query);\n      if (booking) {\n        resultBox.innerHTML = `\n          <div class=\"flex items-center justify-between w-full text-xs\">\n            <div>\n              <span class=\"text-electric font-bold\"><i class=\"fa-solid fa-ticket\"></i> Verified Booking:</span>\n              <span class=\"text-slate-900 font-semibold ml-1\">${escapeHTML(booking.tripRef)} (${escapeHTML(booking.passenger.name)})</span>\n              <span class=\"text-slate-500 ml-2\">&bull; Driver: ${escapeHTML(booking.driverName)}</span>\n            </div>\n            <span class=\"route-match-badge\">${booking.matchScore}% Match</span>\n          </div>`;\n        showPlatformToast(`Verified booking reference ${booking.tripRef}.`, 'blue');\n        return;\n      }\n\n      resultBox.innerHTML = `<span class=\"text-rose-500 text-xs\"><i class=\"fa-solid fa-triangle-exclamation\"></i> Reference \"${escapeHTML(query)}\" not found in metropolitan fleet or booking registry.</span>`;\n      showPlatformToast(`Reference \"${query}\" not recognized.`, 'rose');\n    });\n  }\n\n  // --- Match & Dispatch Shared Trip (Triggering Enterprise Confirmation Modal) ---\n  const btnAutoMatch = document.getElementById('btn-auto-match-trip');\n  if (btnAutoMatch) {\n    btnAutoMatch.addEventListener('click', () => {\n      let passenger = engine.dequeueNextRequest();\n      if (!passenger && engine.standbyCount > 0) {\n        passenger = engine.popFromStandby().item;\n      }\n\n      if (!passenger) {\n        showPlatformToast('No pending commuter requests waiting to be dispatched.', 'rose');\n        return;\n      }\n\n      let matchedPartner = null;\n      for (const partner of engine.fleetPartners) {\n        if (partner.seats > 0) {\n          matchedPartner = partner;\n          break;\n        }\n      }\n\n      if (!matchedPartner) {\n        engine.dispatchStream.unshift(passenger);\n        showPlatformToast('All driver partners are currently at maximum passenger capacity.', 'rose');\n        return;\n      }\n\n      const route = engine.findOptimalEcoRoute(passenger.pickup, passenger.drop);\n      const matchScore = Math.floor(Math.random() * 14 + 85);\n\n      const trip = engine.dispatchSharedTrip(\n        passenger,\n        matchedPartner,\n        route.path,\n        route.totalDist,\n        route.estTime,\n        route.fare,\n        route.co2Offset,\n        matchScore\n      );\n\n      if (urbanCanvasInstance) {\n        urbanCanvasInstance.setActivePath(route.path);\n      }\n      refreshPlatformUI();\n      openDispatchModal(trip, matchedPartner);\n    });\n  }\n\n  // --- Revert Confirmation (Triggering Enterprise Reversal Modal) ---\n  const btnRevertConf = document.getElementById('btn-revert-confirmation');\n  if (btnRevertConf) {\n    btnRevertConf.addEventListener('click', () => {\n      const res = engine.revertLatestConfirmation();\n      if (!res.success) {\n        showPlatformToast(res.message, 'rose');\n      } else {\n        refreshPlatformUI();\n        openReversalModal(res.action, res.driver);\n      }\n    });\n  }\n\n  // --- Rush-Hour Simulation Scenario ---\n  const btnRushHour = document.getElementById('btn-demo-rushhour');\n  if (btnRushHour) {\n    btnRushHour.addEventListener('click', () => {\n      engine.onboardDriver('Marcus Vance', 'ALPHA', 3);\n      engine.onboardDriver('Elena Rostova', 'METRO', 3);\n      engine.onboardDriver('Kaelen Chen', 'SKYPORT', 2);\n      engine.onboardDriver('Siddharth Rao', 'QUANTUM', 3);\n\n      engine.submitRideRequest('Dr. Aris Thorne', 'ALPHA', 'HORIZON');\n      engine.submitRideRequest('Maya Lin', 'METRO', 'SKYPORT');\n      engine.submitRideRequest('Amara Okafor', 'HARBOR', 'QUANTUM');\n\n      engine.pushToStandby({\n        id: 'BK-STDBY-01',\n        name: 'Taro Watanabe',\n        pickup: 'HARBOR',\n        drop: 'HORIZON',\n        requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n        status: 'Priority Standby'\n      });\n\n      const p = engine.dequeueNextRequest();\n      const d = engine.fleetPartners[0];\n      const r = engine.findOptimalEcoRoute(p.pickup, p.drop);\n      const trip = engine.dispatchSharedTrip(p, d, r.path, r.totalDist, r.estTime, r.fare, r.co2Offset, 96);\n\n      if (urbanCanvasInstance) {\n        urbanCanvasInstance.setActivePath(r.path);\n      }\n      refreshPlatformUI();\n      showPlatformToast('Simulated Metropolitan Rush-Hour scenario loaded with live fleet, commuters, and active trips!', 'emerald');\n    });\n  }\n\n  // --- Quick Book CTA in Header ---\n  const btnQuickBook = document.getElementById('btn-quick-book');\n  if (btnQuickBook) {\n    btnQuickBook.addEventListener('click', () => {\n      const commuterTabBtn = document.querySelector('[data-tab=\"tab-passenger-hub\"]');\n      if (commuterTabBtn) commuterTabBtn.click();\n      setTimeout(() => {\n        const inp = document.getElementById('passenger-name-input');\n        if (inp) inp.focus();\n      }, 150);\n    });\n  }\n\n  // --- Modal Close Helpers & Backdrop Listeners ---\n  const dispatchModal = document.getElementById('dispatch-confirm-modal');\n  const reversalModal = document.getElementById('reversal-confirm-modal');\n  const receiptModal = document.getElementById('receipt-modal-overlay');\n\n  function closeAllModals() {\n    if (dispatchModal) dispatchModal.classList.add('hidden');\n    if (reversalModal) reversalModal.classList.add('hidden');\n    if (receiptModal) receiptModal.classList.add('hidden');\n  }\n\n  // Backdrop click dismiss\n  [dispatchModal, reversalModal, receiptModal].forEach(modal => {\n    if (modal) {\n      modal.addEventListener('click', (e) => {\n        if (e.target === modal) {\n          modal.classList.add('hidden');\n        }\n      });\n    }\n  });\n\n  // ESC key dismiss for all open modals\n  window.addEventListener('keydown', (e) => {\n    if (e.key === 'Escape') {\n      closeAllModals();\n    }\n  });\n\n  // Dispatch Modal Buttons\n  const btnCloseDispatch = document.getElementById('btn-close-dispatch-modal');\n  if (btnCloseDispatch) btnCloseDispatch.addEventListener('click', () => dispatchModal.classList.add('hidden'));\n\n  const btnAckDispatch = document.getElementById('btn-ack-dispatch');\n  if (btnAckDispatch) btnAckDispatch.addEventListener('click', () => dispatchModal.classList.add('hidden'));\n\n  const btnViewMapDispatch = document.getElementById('btn-view-map-dispatch');\n  if (btnViewMapDispatch) {\n    btnViewMapDispatch.addEventListener('click', () => {\n      dispatchModal.classList.add('hidden');\n      const mapTabBtn = document.querySelector('[data-tab=\"tab-route-finder\"]');\n      if (mapTabBtn) mapTabBtn.click();\n      if (urbanCanvasInstance) urbanCanvasInstance.startCarSimulation();\n    });\n  }\n\n  // Reversal Modal Buttons\n  const btnCloseReversal = document.getElementById('btn-close-reversal-modal');\n  if (btnCloseReversal) btnCloseReversal.addEventListener('click', () => reversalModal.classList.add('hidden'));\n\n  const btnAckReversal = document.getElementById('btn-ack-reversal');\n  if (btnAckReversal) btnAckReversal.addEventListener('click', () => reversalModal.classList.add('hidden'));\n\n  // Eco-Receipt Modal Buttons\n  const btnCloseReceipt = document.getElementById('btn-close-receipt');\n  if (btnCloseReceipt) btnCloseReceipt.addEventListener('click', () => receiptModal.classList.add('hidden'));\n\n  const btnDoneReceipt = document.getElementById('btn-done-receipt');\n  if (btnDoneReceipt) btnDoneReceipt.addEventListener('click', () => receiptModal.classList.add('hidden'));\n\n  const btnPrintReceipt = document.getElementById('btn-print-receipt');\n  if (btnPrintReceipt) {\n    btnPrintReceipt.addEventListener('click', () => {\n      window.print();\n    });\n  }\n\n  // Initial Startup\n  refreshPlatformUI();\n  computeAndDisplayRoute();\n});\n","Overwrite":true,"Path":"C:/Users/Kartik Bhosle/.gemini/antigravity/brain/6976d1a8-fd03-4453-a790-acd552e1861a/app.js"}}]}
{"step_index":170,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:27:59Z","content":"Created At: 2026-10-20T11:57:59+05:30\nCompleted At: 2026-10-20T11:57:59+05:30\nCreated file."}
{"step_index":171,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-20T06:27:59Z","input_tokens":21046,"cache_read_tokens":54737,"output_tokens":12308,"tool_calls":[{"name":"write_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Hardened CSS styles: fixed modal overlay z-index stacking context, mobile responsive layout padding, table overflow, and print styling for the Eco-Receipt dialog.","UserFacing":true},"Content":"/* ==========================================================================\n   NEXUSMOBILITY — MULTI-TABBED ENTERPRISE ECO-TECH DESIGN SYSTEM\n   Modern Clean Light Palette: Soft Slate (#F4F7F6), White Glass (#FFFFFF),\n   Urban Emerald (#059669), Electric Blue (#2563EB), Energy Amber (#D97706).\n   ========================================================================== */\n\n:root {\n  --bg-primary: #F4F7F6;\n  --bg-card: #FFFFFF;\n  --bg-card-hover: #FAFCFB;\n  --border-light: rgba(226, 232, 240, 0.9);\n  --border-emerald-glow: rgba(5, 150, 105, 0.45);\n  --border-blue-glow: rgba(37, 99, 235, 0.4);\n\n  --emerald: #059669;\n  --emerald-light: #ECFDF5;\n  --emerald-border: #A7F3D0;\n  --emerald-glow: rgba(5, 150, 105, 0.25);\n\n  --electric: #2563EB;\n  --electric-light: #EFF6FF;\n  --electric-border: #BFDBFE;\n  --electric-glow: rgba(37, 99, 235, 0.25);\n\n  --amber: #D97706;\n  --amber-light: #FFFBEB;\n  --amber-border: #FDE68A;\n\n  --purple: #7C3AED;\n  --purple-light: #F5F3FF;\n  --purple-border: #DDD6FE;\n\n  --rose: #E11D48;\n  --rose-light: #FFF1F2;\n  --rose-border: #FECDD3;\n\n  --slate-900: #0F172A;\n  --slate-800: #1E293B;\n  --slate-700: #334155;\n  --slate-600: #475569;\n  --slate-500: #64748B;\n  --slate-400: #94A3B8;\n  --slate-200: #E2E8F0;\n  --slate-100: #F1F5F9;\n\n  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  --font-mono: 'JetBrains Mono', monospace;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml {\n  scroll-behavior: smooth;\n}\n\nbody {\n  background-color: var(--bg-primary);\n  color: var(--slate-800);\n  font-family: var(--font-sans);\n  min-height: 100vh;\n  overflow-x: hidden;\n  position: relative;\n  line-height: 1.5;\n}\n\n/* Ambient Canvas Background Layer */\n#ambient-canvas {\n  position: fixed;\n  inset: 0;\n  width: 100vw;\n  height: 100vh;\n  pointer-events: none;\n  z-index: 0;\n}\n\n/* Custom Scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #E2E8F0;\n}\n::-webkit-scrollbar-thumb {\n  background: var(--slate-400);\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--emerald);\n}\n\n/* --------------------------------------------------------------------------\n   Layout Shell & Modern White Glassmorphism\n   -------------------------------------------------------------------------- */\n.app-layout {\n  max-width: 1720px;\n  margin: 0 auto;\n  padding: 1.25rem 2rem 2.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n  position: relative;\n  z-index: 1;\n}\n\n.white-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 16px;\n  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);\n  position: relative;\n  transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.25s ease;\n}\n\n/* 2D Micro-Lifting Hover Effect */\n.eco-card-hover {\n  transition: transform 0.22s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.22s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.22s ease;\n}\n.eco-card-hover:hover {\n  transform: translateY(-4px);\n  box-shadow: 0 12px 28px -6px rgba(5, 150, 105, 0.12), 0 4px 10px -2px rgba(15, 23, 42, 0.04);\n  border-color: var(--border-emerald-glow);\n}\n\n/* --------------------------------------------------------------------------\n   Header Bar\n   -------------------------------------------------------------------------- */\n.app-header {\n  padding: 1rem 1.75rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 1rem;\n}\n\n.brand-section {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.brand-icon {\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  background: var(--emerald-light);\n  border: 1px solid var(--emerald-border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.35rem;\n  box-shadow: 0 4px 12px var(--emerald-glow);\n}\n\n.brand-title-wrap {\n  display: flex;\n  flex-direction: column;\n}\n\n.brand-title {\n  font-size: 1.3rem;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  color: var(--slate-900);\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.brand-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  padding: 0.15rem 0.5rem;\n  border-radius: 9999px;\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n\n.brand-tagline {\n  font-size: 0.775rem;\n  color: var(--slate-500);\n  font-weight: 500;\n}\n\n.nav-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n/* --------------------------------------------------------------------------\n   Executive KPI Ribbon\n   -------------------------------------------------------------------------- */\n.kpi-banner {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));\n  gap: 1.25rem;\n}\n\n.kpi-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 14px;\n  padding: 1.1rem 1.35rem;\n  display: flex;\n  align-items: center;\n  gap: 1.1rem;\n  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);\n}\n\n.kpi-icon-wrap {\n  width: 46px;\n  height: 46px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.25rem;\n  flex-shrink: 0;\n}\n\n.bg-emerald-light { background: var(--emerald-light); border: 1px solid var(--emerald-border); }\n.bg-blue-light { background: var(--electric-light); border: 1px solid var(--electric-border); }\n.bg-amber-light { background: var(--amber-light); border: 1px solid var(--amber-border); }\n.bg-purple-light { background: var(--purple-light); border: 1px solid var(--purple-border); }\n\n.kpi-content {\n  display: flex;\n  flex-direction: column;\n}\n\n.kpi-label {\n  font-size: 0.68rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n}\n\n.kpi-value {\n  font-size: 1.45rem;\n  font-weight: 800;\n  color: var(--slate-900);\n  line-height: 1.2;\n  margin: 0.2rem 0;\n}\n\n.kpi-unit {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: var(--slate-500);\n}\n\n.kpi-subtext {\n  font-size: 0.72rem;\n  color: var(--slate-600);\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n\n/* --------------------------------------------------------------------------\n   Tab Navigation Bar\n   -------------------------------------------------------------------------- */\n.tab-navbar {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 14px;\n  padding: 0.45rem 0.6rem;\n  box-shadow: 0 2px 10px rgba(15, 23, 42, 0.03);\n  overflow-x: auto;\n}\n\n.tab-trigger {\n  background: transparent;\n  border: none;\n  font-family: var(--font-sans);\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: var(--slate-600);\n  padding: 0.65rem 1.25rem;\n  border-radius: 10px;\n  cursor: pointer;\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  transition: all 0.2s ease;\n  white-space: nowrap;\n}\n\n.tab-trigger:hover {\n  background: var(--slate-100);\n  color: var(--slate-900);\n}\n\n.tab-trigger.active {\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  box-shadow: 0 2px 8px var(--emerald-glow);\n}\n\n.tab-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  padding: 0.1rem 0.45rem;\n  border-radius: 9999px;\n  background: #E2E8F0;\n  color: var(--slate-700);\n}\n.tab-trigger.active .tab-badge {\n  background: var(--emerald);\n  color: #FFFFFF;\n}\n\n/* Tab Views Container */\n.tab-content-container {\n  position: relative;\n  min-height: 520px;\n}\n\n.tab-view {\n  display: none;\n  animation: tabFadeIn 0.25s ease-out;\n}\n.tab-view.active {\n  display: block;\n}\n\n@keyframes tabFadeIn {\n  from { opacity: 0; transform: translateY(6px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* --------------------------------------------------------------------------\n   TAB 1: ECO-ROUTE FINDER & MAP\n   -------------------------------------------------------------------------- */\n.view-grid-map {\n  display: grid;\n  grid-template-columns: 1.8fr 1.2fr;\n  gap: 1.5rem;\n}\n\n.map-card-wrapper {\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.map-canvas-container {\n  position: relative;\n  width: 100%;\n  height: 440px;\n  background: #FAFCFB;\n  border: 1px solid var(--slate-200);\n  border-radius: 14px;\n  overflow: hidden;\n}\n\n#urban-3d-canvas {\n  width: 100%;\n  height: 100%;\n  cursor: grab;\n}\n#urban-3d-canvas:active {\n  cursor: grabbing;\n}\n\n.map-controls-floating {\n  position: absolute;\n  top: 1rem;\n  right: 1rem;\n  display: flex;\n  gap: 0.5rem;\n  z-index: 5;\n}\n\n.map-hud-overlay {\n  position: absolute;\n  bottom: 1rem;\n  left: 1rem;\n  background: rgba(255, 255, 255, 0.92);\n  backdrop-filter: blur(8px);\n  border: 1px solid var(--slate-200);\n  padding: 0.4rem 0.85rem;\n  border-radius: 8px;\n  font-size: 0.75rem;\n  color: var(--slate-600);\n  font-family: var(--font-mono);\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\n}\n\n.telemetry-summary-strip {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 0.75rem;\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 0.85rem 1rem;\n}\n\n.telemetry-item {\n  display: flex;\n  flex-direction: column;\n}\n.telemetry-label {\n  font-size: 0.65rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n}\n.telemetry-value {\n  font-size: 0.95rem;\n  font-weight: 800;\n  color: var(--slate-900);\n  margin-top: 0.15rem;\n}\n\n/* Route Selector Form Panel */\n.route-selector-panel {\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n.card-header-clean {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding-bottom: 0.75rem;\n  border-bottom: 1px solid var(--slate-100);\n}\n\n.card-title {\n  font-size: 1.05rem;\n  font-weight: 700;\n  color: var(--slate-900);\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.card-subtitle {\n  font-size: 0.75rem;\n  color: var(--slate-500);\n}\n\n.route-form-fields {\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.field-group {\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n}\n\n.field-label {\n  font-size: 0.75rem;\n  font-weight: 600;\n  color: var(--slate-700);\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n\n.route-interchange-row {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.btn-icon-circle {\n  width: 34px;\n  height: 34px;\n  border-radius: 50%;\n  background: #F1F5F9;\n  border: 1px solid var(--slate-200);\n  color: var(--slate-600);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n.btn-icon-circle:hover {\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border-color: var(--emerald-border);\n  transform: rotate(180deg);\n}\n\n/* Commuter Slider Box */\n.commuter-slider-box {\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 1rem 1.15rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.slider-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.slider-range-input {\n  width: 100%;\n  accent-color: var(--emerald);\n  cursor: pointer;\n}\n\n.slider-ticks {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.7rem;\n  color: var(--slate-400);\n  font-family: var(--font-mono);\n}\n\n.slider-ticks .tick.active-tick {\n  color: var(--emerald);\n  font-weight: 700;\n}\n\n/* --------------------------------------------------------------------------\n   Buttons & Inputs System\n   -------------------------------------------------------------------------- */\n.btn {\n  font-family: var(--font-sans);\n  font-size: 0.825rem;\n  font-weight: 600;\n  padding: 0.6rem 1.15rem;\n  border-radius: 10px;\n  border: 1px solid transparent;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);\n  white-space: nowrap;\n}\n\n.btn-primary {\n  background: var(--electric);\n  color: #FFFFFF;\n  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);\n}\n.btn-primary:hover {\n  background: #1D4ED8;\n  box-shadow: 0 6px 18px rgba(37, 99, 235, 0.4);\n  transform: translateY(-2px);\n}\n\n.btn-emerald {\n  background: var(--emerald);\n  color: #FFFFFF;\n  box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);\n}\n.btn-emerald:hover {\n  background: #047857;\n  box-shadow: 0 6px 18px rgba(5, 150, 105, 0.4);\n  transform: translateY(-2px);\n}\n\n.btn-emerald-outline {\n  background: var(--emerald-light);\n  border: 1px solid var(--emerald-border);\n  color: var(--emerald);\n}\n.btn-emerald-outline:hover {\n  background: var(--emerald);\n  color: #FFFFFF;\n  transform: translateY(-2px);\n}\n\n.btn-amber {\n  background: var(--amber-light);\n  border: 1px solid var(--amber-border);\n  color: var(--amber);\n}\n.btn-amber:hover {\n  background: var(--amber);\n  color: #FFFFFF;\n  transform: translateY(-2px);\n}\n\n.btn-rose {\n  background: var(--rose-light);\n  border: 1px solid var(--rose-border);\n  color: var(--rose);\n}\n.btn-rose:hover {\n  background: var(--rose);\n  color: #FFFFFF;\n  transform: translateY(-2px);\n}\n\n.btn-outline {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  color: var(--slate-700);\n}\n.btn-outline:hover {\n  background: var(--slate-100);\n  border-color: var(--slate-400);\n  transform: translateY(-2px);\n}\n\n.btn-ghost {\n  background: transparent;\n  color: var(--slate-500);\n}\n.btn-ghost:hover {\n  background: var(--slate-100);\n  color: var(--slate-800);\n}\n\n.btn-sm {\n  padding: 0.35rem 0.65rem;\n  font-size: 0.74rem;\n}\n\n.text-input, .select-field {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 9px;\n  color: var(--slate-900);\n  padding: 0.6rem 0.85rem;\n  font-size: 0.825rem;\n  font-family: var(--font-sans);\n  outline: none;\n  transition: all 0.2s ease;\n  width: 100%;\n}\n\n.text-input:focus, .select-field:focus {\n  border-color: var(--emerald);\n  box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);\n}\n\n.text-input::placeholder {\n  color: var(--slate-400);\n}\n\n.input-with-icon {\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n.input-with-icon i {\n  position: absolute;\n  left: 0.85rem;\n  color: var(--slate-400);\n  font-size: 0.85rem;\n}\n.input-with-icon .text-input {\n  padding-left: 2.3rem;\n}\n\n/* --------------------------------------------------------------------------\n   TAB 2: COMMUTER PASSENGER HUB\n   -------------------------------------------------------------------------- */\n.view-grid-passengers {\n  display: grid;\n  grid-template-columns: 1fr 1.6fr 1fr;\n  gap: 1.5rem;\n}\n\n.passenger-form-card {\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n/* Conveyor Pipeline Stream */\n.conveyor-pipeline-card {\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.conveyor-belt-container {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  max-height: 440px;\n  overflow-y: auto;\n  padding-right: 0.4rem;\n}\n\n.commuter-token {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 0.9rem 1.15rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.35rem;\n  position: relative;\n  overflow: hidden;\n}\n\n.commuter-token.head-token {\n  border-left: 4px solid var(--emerald);\n  background: #FCFDFD;\n}\n\n.token-badge {\n  font-size: 0.62rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n}\n.head-token .token-badge {\n  color: var(--emerald);\n}\n\n.token-name {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--slate-900);\n}\n\n.token-route {\n  font-size: 0.78rem;\n  color: var(--slate-600);\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.token-meta {\n  font-size: 0.68rem;\n  color: var(--slate-400);\n  font-family: var(--font-mono);\n}\n\n/* Priority Standby Circular Lounge */\n.standby-lounge-card {\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n  align-items: center;\n}\n\n.standby-ring-wrap {\n  position: relative;\n  width: 250px;\n  height: 250px;\n  margin: 0.5rem auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.standby-ring-center {\n  position: absolute;\n  width: 90px;\n  height: 90px;\n  border-radius: 50%;\n  background: #FFFFFF;\n  border: 2px dashed var(--slate-200);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  z-index: 2;\n  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);\n}\n\n.standby-slot {\n  position: absolute;\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  background: #FFFFFF;\n  border: 2px solid var(--slate-200);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.62rem;\n  color: var(--slate-600);\n  font-family: var(--font-mono);\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);\n}\n\n.standby-slot.occupied {\n  background: var(--amber-light);\n  border-color: var(--amber);\n  color: var(--amber);\n  box-shadow: 0 4px 12px rgba(217, 119, 6, 0.2);\n}\n\n.standby-slot.is-active-pointer {\n  border-color: var(--emerald);\n  background: var(--emerald-light);\n  color: var(--emerald);\n  box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);\n}\n\n/* --------------------------------------------------------------------------\n   TAB 3: DRIVER FLEET & DISPATCH CONSOLE\n   -------------------------------------------------------------------------- */\n.view-grid-fleet {\n  display: grid;\n  grid-template-columns: 1.1fr 1.9fr;\n  gap: 1.5rem;\n}\n\n.fleet-onboarding-card {\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n/* Vehicle Chassis Blueprint Diagram */\n.vehicle-blueprint-box {\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 14px;\n  padding: 1.15rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.85rem;\n}\n\n.vehicle-blueprint-header {\n  display: flex;\n  justify-content: space-betwe