ckup-select\" class=\"select-field\"></select>\n              </div>\n\n              <div class=\"field-group\">\n                <label class=\"field-label\" for=\"passenger-drop-select\">\n                  <i class=\"fa-solid fa-location-dot text-rose\"></i> Drop-off Hub\n                </label>\n                <select id=\"passenger-drop-select\" class=\"select-field\"></select>\n              </div>\n\n              <button id=\"btn-request-ride\" class=\"btn btn-emerald w-full\">\n                <i class=\"fa-solid fa-plus\"></i> Submit Request\n              </button>\n\n              <button id=\"btn-cancel-front-req\" class=\"btn btn-outline w-full\" title=\"Dequeue or cancel front request\">\n                <i class=\"fa-solid fa-user-xmark\"></i> Dequeue Next Request\n              </button>\n            </div>\n          </div>\n\n          <!-- Col 2: Live Conveyor Pipeline Stream -->\n          <div class=\"conveyor-pipeline-card white-card eco-card-hover\">\n            <div class=\"card-header-clean\">\n              <div>\n                <h3 class=\"card-title\">\n                  <i class=\"fa-solid fa-stream text-electric\"></i>\n                  <span>Passenger Dispatch Pipeline</span>\n                </h3>\n                <p class=\"card-subtitle\">Real-time demand stream ordered by boarding priority</p>\n              </div>\n              <span class=\"brand-badge\">FIFO Stream</span>\n            </div>\n\n            <div class=\"conveyor-belt-container\" id=\"passenger-conveyor\">\n              <!-- EcoSprout Empty State loaded dynamically -->\n            </div>\n          </div>\n\n          <!-- Col 3: Priority Standby Lounge (5 Slots) -->\n          <div class=\"standby-lounge-card white-card eco-card-hover\">\n            <div class=\"card-header-clean w-full\">\n              <div>\n                <h3 class=\"card-title\">\n                  <i class=\"fa-solid fa-chair text-amber\"></i>\n                  <span>Priority S