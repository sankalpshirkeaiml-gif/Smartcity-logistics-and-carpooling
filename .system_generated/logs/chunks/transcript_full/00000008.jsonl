    const ctx = this.ctx;\n511:     ctx.clearRect(0, 0, this.width, this.height);\n512: \n513:     this.drawGroundGrid();\n514: \n515:     // Draw Corridors\n516:     TRANSIT_CORRIDORS.forEach(corridor => {\n517:       const uStation = TRANSIT_STATIONS.find(s => s.id === corridor.u);\n518:       const vStation = TRANSIT_STATIONS.find(s => s.id === corridor.v);\n519:       const p1 = this.project(uStation.x, uStation.y, uStation.z);\n520:       const p2 = this.project(vStation.x, vStation.y, vStation.z);\n521: \n522:       let isPath = false;\n523:       let pathDirection = 0; // 1: u->v, -1: v->u\n524: \n525:       for (let i = 0; i < this.activeCorridorPath.length - 1; i++) {\n526:         const a = this.activeCorridorPath[i];\n527:         const b = this.activeCorridorPath[i + 1];\n528:         if (a === corridor.u && b === corridor.v) {\n529:           isPath = true;\n530:           pathDirection = 1;\n531:           break;\n532:         } else if (a === corridor.v && b === corridor.u) {\n533:           isPath = true;\n534:           pathDirection = -1;\n535:           break;\n536:         }\n537:       }\n538: \n539:       ctx.save();\n540:       ctx.beginPath();\n541:       ctx.moveTo(p1.x, p1.y);\n542:       ctx.lineTo(p2.x, p2.y);\n543: \n544:       if (isPath) {\n545:         // Base route vector line\n546:         ctx.strokeStyle = '#2563EB';\n547:         ctx.lineWidth = 4.5;\n548:         ctx.stroke();\n549: \n550:         // Directional Flow Animation (Chevrons / dashed energy pulses)\n551:         ctx.save();\n552:         ctx.beginPath();\n553:         const startP = pathDirection === 1 ? p1 : p2;\n554:         const endP = pathDirection === 1 ? p2 : p1;\n555:         ctx.moveTo(startP.x, startP.y);\n556:         ctx.lineTo(endP.x, endP.y);\n557:         ctx.strokeStyle = '#60A5FA';\n558:         ctx.lineWidth = 2.5;\n559:         ctx.setLineDash([8, 12]);\n560:         ctx.lineDashOffset = this.flowDashOffset;\n561:         ctx.stroke();\n562:         ctx.restore();\n563:       } else {\n564:         ctx.strokeStyle = '#CBD5E1';\n565:         ctx.lineWidth = 2;\n566:         ctx.stroke();\n567:       }\n568:       ctx.restore();\n569: \n570:       // Corridor Distance Tag\n571:       const midX = (p1.x + p2.x) / 2;\n572:       const midY = (p1.y + p2.y) / 2;\n573:       ctx.save();\n574:       ctx.fillStyle = isPath ? '#2563EB' : '#FFFFFF';\n575:       ctx.strokeStyle = isPath ? '#1D4ED8' : '#CBD5E1';\n576:       ctx.lineWidth = 1;\n577:       ctx.beginPath();\n578:       ctx.roundRect(midX - 16, midY - 9, 32, 18, 4);\n579:       ctx.fill();\n580:       ctx.stroke();\n581: \n582:       ctx.fillStyle = isPath ? '#FFFFFF' : '#475569';\n583:       ctx.font = 'bold 9px \"JetBrains Mono\"';\n584:       ctx.textAlign = 'center';\n585:       ctx.textBaseline = 'middle';\n586:       ctx.fillText(`${corridor.distance}km`, midX, midY);\n587:       ctx.restore();\n588:     });\n589: \n590:     // Draw Stations (Sorted by Z for depth)\n591:     const sorted = [...TRANSIT_STATIONS].map(s => ({\n592:       station: s,\n593:       proj: this.project(s.x, s.y, s.z)\n594:     })).sort((a, b) => b.proj.z - a.proj.z);\n595: \n596:     sorted.forEach(({ station, proj }) => {\n597:       const isPath = this.activeCorridorPath.includes(station.id);\n598:       const isHovered = this.hoveredStation && this.hoveredStation.id === station.id;\n599: \n600:       ctx.save();\n601: \n602:       // Floor Shadow\n603:       const floorProj = this.project(station.x, station.y, -30);\n604:       ctx.beginPath();\n605:       ctx.ellipse(floorProj.x, floorProj.y, 14 * proj.scale, 7 * proj.scale, 0, 0, Math.PI * 2);\n606:       ctx.fillStyle = 'rgba(15, 23, 42, 0.08)';\n607:       ctx.fill();\n608: \n609:       // Elevation Stem\n610:       ctx.beginPath();\n611:       ctx.moveTo(floorProj.x, floorProj.y);\n612:       ctx.lineTo(proj.x, proj.y);\n613:       ctx.strokeStyle = isPath ? 'rgba(5, 150, 105, 0.6)' : '#CBD5E1';\n614:       ctx.lineWidth = 1.5;\n615:       ctx.setLineDash([2, 3]);\n616:       ctx.stroke();\n617:       ctx.setLineDash([]);\n618: \n619:       // Station Circle\n620:       ctx.beginPath();\n621:       const radius = (isHovered ? 14 : 11) * proj.scale;\n622:       ctx.arc(proj.x, proj.y, radius, 0, Math.PI * 2);\n623: \n624:       if (isPath) {\n625:         ctx.fillStyle = '#059669';\n626:         ctx.shadowColor = 'rgba(5, 150, 105, 0.4)';\n627:         ctx.shadowBlur = 14;\n628:       } else if (isHovered) {\n629:         ctx.fillStyle = '#2563EB';\n630:         ctx.shadowColor = 'rgba(37, 99, 235, 0.4)';\n631:         ctx.shadowBlur = 12;\n632:       } else {\n633:         ctx.fillStyle = '#FFFFFF';\n634:         ctx.strokeStyle = '#059669';\n635:         ctx.lineWidth = 2.5;\n636:         ctx.stroke();\n637:       }\n638:       ctx.fill();\n639:       ctx.restore();\n640: \n641:       // Station Label & Zone\n642:       ctx.save();\n643:       ctx.font = '600 11px \"Inter\"';\n644:       ctx.fillStyle = isPath ? '#059669' : '#0F172A';\n645:       ctx.textAlign = 'center';\n646:       ctx.fillText(station.name, proj.x, proj.y - 18 * proj.scale);\n647:       ctx.font = '500 9px \"JetBrains Mono\"';\n648:       ctx.fillStyle = '#64748B';\n649:       ctx.fillText(station.zone, proj.x, proj.y + 20 * proj.scale);\n650:       ctx.restore();"}
