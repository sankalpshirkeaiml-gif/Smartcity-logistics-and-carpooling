{"step_index":144,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:15:38Z","content":"Created At: 2026-10-20T11:45:38+05:30\nCompleted At: 2026-10-20T11:45:38+05:30\nShowing lines 70-250 of 1652\n70:       passenger: 201\n71:     };\n72: \n73:     this.commuterDensity = 2;\n74:   }\n75: \n76:   findOptimalEcoRoute(startId, endId) {\n77:     const adj = {};\n78:     TRANSIT_STATIONS.forEach(s => { adj[s.id] = []; });\n79:     TRANSIT_CORRIDORS.forEach(c => {\n80:       adj[c.u].push({ node: c.v, distance: c.distance });\n81:       adj[c.v].push({ node: c.u, distance: c.distance });\n82:     });\n83: \n84:     const dist = {};\n85:     const prev = {};\n86:     TRANSIT_STATIONS.forEach(s => {\n87:       dist[s.id] = Infinity;\n88:       prev[s.id] = null;\n89:     });\n90: \n91:     dist[startId] = 0;\n92:     const activeCorridors = [[0, startId]];\n93: \n94:     while (activeCorridors.length > 0) {\n95:       activeCorridors.sort((a, b) => a[0] - b[0]);\n96:       const [d, u] = activeCorridors.shift();\n97: \n98:       if (u === endId) break;\n99:       if (d > dist[u]) continue;\n100: \n101:       for (const edge of adj[u]) {\n102:         const v = edge.node;\n103:         const newDist = dist[u] + edge.distance;\n104:         if (newDist < dist[v]) {\n105:           dist[v] = newDist;\n106:           prev[v] = u;\n107:           activeCorridors.push([newDist, v]);\n108:         }\n109:       }\n110:     }\n111: \n112:     const path = [];\n113:     let curr = endId;\n114:     if (dist[endId] !== Infinity) {\n115:       while (curr) {\n116:         path.unshift(curr);\n117:         curr = prev[curr];\n118:       }\n119:     }\n120: \n121:     const totalDist = dist[endId] === Infinity ? 0 : parseFloat(dist[endId].toFixed(1));\n122:     const estTime = Math.round(totalDist * 2.2);\n123:     const baseCO2 = totalDist * 0.171;\n124:     const co2Offset = parseFloat((baseCO2 * (0.8 + this.commuterDensity * 0.4)).toFixed(2));\n125: \n126:     const baseTripCost = 4.0 + totalDist * 1.5;\n127:     const pooledFare = parseFloat(((baseTripCost * (1 + (this.commuterDensity - 1) * 0.25)) / this.commuterDensity).toFixed(2));\n128: \n129:     return {\n130:       path,\n131:       totalDist,\n132:       estTime,\n133:       co2Offset,\n134:       fare: pooledFare,\n135:       soloCarsSaved: Math.max(0, this.commuterDensity - 1)\n136:     };\n137:   }\n138: \n139:   submitRideRequest(name, pickup, drop) {\n140:     const passenger = {\n141:       id: `BK-${this.counters.passenger++}`,\n142:       name,\n143:       pickup,\n144:       drop,\n145:       requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n146:       status: 'Pending Dispatch'\n147:     };\n148:     this.dispatchStream.push(passenger);\n149:     return passenger;\n150:   }\n151: \n152:   dequeueNextRequest() {\n153:     return this.dispatchStream.shift() || null;\n154:   }\n155: \n156:   pushToStandby(item) {\n157:     if (this.standbyCount === this.standbyCap) {\n158:       return { success: false, message: 'Priority Standby Lounge is currently at maximum capacity (5/5).' };\n159:     }\n160:     this.standbyLounge[this.standbyRear] = item;\n161:     this.standbyRear = (this.standbyRear + 1) % this.standbyCap;\n162:     this.standbyCount++;\n163:     return { success: true };\n164:   }\n165: \n166:   popFromStandby() {\n167:     if (this.standbyCount === 0) {\n168:       return { success: false, message: 'Standby lounge is currently empty.' };\n169:     }\n170:     const item = this.standbyLounge[this.standbyFront];\n171:     this.standbyLounge[this.standbyFront] = null;\n172:     this.standbyFront = (this.standbyFront + 1) % this.standbyCap;\n173:     this.standbyCount--;\n174:     return { success: true, item };\n175:   }\n176: \n177:   onboardDriver(name, station, seats) {\n178:     const driverId = this.counters.driver++;\n179:     const newPartner = {\n180:       id: driverId,\n181:       name,\n182:       station,\n183:       seats: parseInt(seats, 10),\n184:       originalSeats: parseInt(seats, 10),\n185:       tripsCompleted: 0\n186:     };\n187:     this.fleetPartners.push(newPartner);\n188:     return newPartner;\n189:   }\n190: \n191:   getDriverById(id) {\n192:     const cleanId = String(id).replace(/[^0-9]/g, '');\n193:     return this.fleetPartners.find(d => String(d.id) === cleanId) || null;\n194:   }\n195: \n196:   getBookingByRef(ref) {\n197:     const upper = String(ref).trim().toUpperCase();\n198:     return this.activeTrips.find(t => t.tripRef.toUpperCase() === upper || t.passenger.id.toUpperCase() === upper) || null;\n199:   }\n200: \n201:   dispatchSharedTrip(passenger, driver, corridorPath, distance, time, fare, co2Saved, matchScore = 94) {\n202:     const tripRef = `NX-${this.counters.booking++}`;\n203:     const trip = {\n204:       tripRef,\n205:       passenger,\n206:       driverId: driver.id,\n207:       driverName: driver.name,\n208:       corridorPath,\n209:       distance,\n210:       time,\n211:       fare,\n212:       co2Saved,\n213:       matchScore,\n214:       dispatchedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })\n215:     };\n216: \n217:     this.activeTrips.push(trip);\n218:     driver.seats -= 1;\n219:     driver.tripsCompleted += 1;\n220: \n221:     this.reversalAuditLog.push({\n222:       type: 'DISPATCH_CONFIRMATION',\n223:       tripRef,\n224:       driverId: driver.id,\n225:       passenger,\n226:       trip\n227:     });\n228: \n229:     return trip;\n230:   }\n231: \n232:   cancelActiveTrip(tripRef) {\n233:     const index = this.activeTrips.findIndex(t => t.tripRef === tripRef);\n234:     if (index !== -1) {\n235:       const removed = this.activeTrips.splice(index, 1)[0];\n236:       return removed;\n237:     }\n238:     return null;\n239:   }\n240: \n241:   revertLatestConfirmation() {\n242:     if (this.reversalAuditLog.length === 0) {\n243:       return { success: false, message: 'No recent dispatch confirmations available to revert.' };\n244:     }\n245: \n246:     const action = this.reversalAuditLog.pop();\n247:     if (action.type === 'DISPATCH_CONFIRMATION') {\n248:       this.cancelActiveTrip(action.tripRef);\n249: \n250:       const driver = this.getDriverById(action.driverId);"}
