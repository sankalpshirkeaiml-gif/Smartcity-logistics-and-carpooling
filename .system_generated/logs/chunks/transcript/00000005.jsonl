tRide) {\n1562:     btnRequestRide.addEventListener('click', () => {\n1563:       const nameInput = document.getElementById('passenger-name-input');\n1564:       const rawName = nameInput ? nameInput.value : '';\n1565:       const name = rawName.trim() || `Commuter_${Math.floor(Math.random() * 900 + 100)}`;\n1566:       const pickup = passPickup ? passPickup.value : 'ALPHA';\n1567:       const drop = passDrop ? passDrop.value : 'HORIZON';\n1568: \n1569:       if (pickup === drop) {\n1570:         showPlatformToast('Pickup and drop-off stations must be distinct.', 'rose');\n1571:         return;\n1572:       }\n1573: \n1574:       const passenger = engine.submitRideRequest(name, pickup, drop);\n1575:       if (nameInput) nameInput.value = '';\n1576:       refreshPlatformUI();\n1577:       showPlatformToast(`Ride request submitted for ${passenger.name} (${pickup} → ${drop}).`, 'emerald');\n1578:     });\n1579:   }\n1580: \n1581:   const btnCancelFrontReq = document.getElementById('btn-cancel-front-req');\n1582:   if (btnCancelFrontReq) {\n1583:     btnCancelFrontReq.addEventListener('click', () => {\n1584:       const dequeued = engine.dequeueNextRequest();\n1585:       if (dequeued) {\n1586:         refreshPlatformUI();\n1587:         showPlatformToast(`Cancelled request for ${dequeued.name} (${dequeued.id}).`, 'amber');\n1588:       } else {\n1589:         showPlatformToast('No pending passenger requests in the pipeline.', 'rose');\n1590:       }"}
