{"step_index":216,"source":"MODEL","type":"PLANNER_RESPONSE","status":"DONE","created_at":"2026-10-21T10:25:05Z","input_tokens":7897,"cache_read_tokens":134081,"output_tokens":13013,"tool_calls":[{"name":"write_file","args":{"ArtifactMetadata":{"RequestFeedback":false,"Summary":"Complete overhaul of styles.css: fixed congested spacing, eliminated narrow button stacks, expanded the 3D map canvas workspace with a clear 2-column grid, spaced form fields with clean labels, gave ample breathing room to the commuter slider, and ensured clean responsive layouts across all viewport sizes.","UserFacing":true},"Content":"/* ==========================================================================\n   NEXUSMOBILITY — MULTI-TABBED ENTERPRISE ECO-TECH DESIGN SYSTEM\n   Modern Clean Light Palette: Soft Slate (#F4F7F6), White Glass (#FFFFFF),\n   Urban Emerald (#059669), Electric Blue (#2563EB), Energy Amber (#D97706).\n   ========================================================================== */\n\n:root {\n  --bg-primary: #F4F7F6;\n  --bg-card: #FFFFFF;\n  --bg-card-hover: #FAFCFB;\n  --border-light: rgba(226, 232, 240, 0.9);\n  --border-emerald-glow: rgba(5, 150, 105, 0.35);\n  --border-blue-glow: rgba(37, 99, 235, 0.3);\n\n  --emerald: #059669;\n  --emerald-light: #ECFDF5;\n  --emerald-border: #A7F3D0;\n  --emerald-glow: rgba(5, 150, 105, 0.2);\n\n  --electric: #2563EB;\n  --electric-light: #EFF6FF;\n  --electric-border: #BFDBFE;\n  --electric-glow: rgba(37, 99, 235, 0.2);\n\n  --amber: #D97706;\n  --amber-light: #FFFBEB;\n  --amber-border: #FDE68A;\n\n  --purple: #7C3AED;\n  --purple-light: #F5F3FF;\n  --purple-border: #DDD6FE;\n\n  --rose: #E11D48;\n  --rose-light: #FFF1F2;\n  --rose-border: #FECDD3;\n\n  --slate-900: #0F172A;\n  --slate-800: #1E293B;\n  --slate-700: #334155;\n  --slate-600: #475569;\n  --slate-500: #64748B;\n  --slate-400: #94A3B8;\n  --slate-200: #E2E8F0;\n  --slate-100: #F1F5F9;\n\n  --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif;\n  --font-mono: 'JetBrains Mono', monospace;\n}\n\n* {\n  box-sizing: border-box;\n  margin: 0;\n  padding: 0;\n}\n\nhtml {\n  scroll-behavior: smooth;\n}\n\nbody {\n  background-color: var(--bg-primary);\n  color: var(--slate-800);\n  font-family: var(--font-sans);\n  min-height: 100vh;\n  overflow-x: hidden;\n  position: relative;\n  line-height: 1.5;\n}\n\n/* Ambient Canvas Background Layer */\n#ambient-canvas {\n  position: fixed;\n  inset: 0;\n  width: 100vw;\n  height: 100vh;\n  pointer-events: none;\n  z-index: 0;\n}\n\n/* Custom Scrollbars */\n::-webkit-scrollbar {\n  width: 6px;\n  height: 6px;\n}\n::-webkit-scrollbar-track {\n  background: #E2E8F0;\n}\n::-webkit-scrollbar-thumb {\n  background: var(--slate-400);\n  border-radius: 9999px;\n}\n::-webkit-scrollbar-thumb:hover {\n  background: var(--emerald);\n}\n\n/* --------------------------------------------------------------------------\n   Layout Shell & Modern White Glassmorphism\n   -------------------------------------------------------------------------- */\n.app-layout {\n  max-width: 1640px;\n  margin: 0 auto;\n  padding: 1.5rem 2rem 3rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n  position: relative;\n  z-index: 1;\n}\n\n.white-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 16px;\n  box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.04);\n  position: relative;\n  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;\n}\n\n.eco-card-hover {\n  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s ease;\n}\n.eco-card-hover:hover {\n  transform: translateY(-3px);\n  box-shadow: 0 10px 25px -4px rgba(5, 150, 105, 0.1), 0 4px 10px -2px rgba(15, 23, 42, 0.03);\n  border-color: var(--border-emerald-glow);\n}\n\n/* --------------------------------------------------------------------------\n   Header Bar\n   -------------------------------------------------------------------------- */\n.app-header {\n  padding: 1rem 1.75rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 1.25rem;\n}\n\n.brand-section {\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n}\n\n.brand-icon {\n  width: 44px;\n  height: 44px;\n  border-radius: 12px;\n  background: var(--emerald-light);\n  border: 1px solid var(--emerald-border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.35rem;\n  box-shadow: 0 4px 12px var(--emerald-glow);\n  flex-shrink: 0;\n}\n\n.brand-title-wrap {\n  display: flex;\n  flex-direction: column;\n}\n\n.brand-title {\n  font-size: 1.35rem;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  color: var(--slate-900);\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n}\n\n.brand-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  padding: 0.2rem 0.55rem;\n  border-radius: 9999px;\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n\n.brand-tagline {\n  font-size: 0.75rem;\n  color: var(--slate-500);\n  font-weight: 500;\n  letter-spacing: 0.02em;\n}\n\n.nav-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  flex-wrap: wrap;\n}\n\n/* --------------------------------------------------------------------------\n   Executive KPI Ribbon\n   -------------------------------------------------------------------------- */\n.kpi-banner {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 1.25rem;\n}\n\n.kpi-card {\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 14px;\n  padding: 1.15rem 1.4rem;\n  display: flex;\n  align-items: center;\n  gap: 1.15rem;\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);\n}\n\n.kpi-icon-wrap {\n  width: 48px;\n  height: 48px;\n  border-radius: 12px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.3rem;\n  flex-shrink: 0;\n}\n\n.bg-emerald-light { background: var(--emerald-light); border: 1px solid var(--emerald-border); }\n.bg-blue-light { background: var(--electric-light); border: 1px solid var(--electric-border); }\n.bg-amber-light { background: var(--amber-light); border: 1px solid var(--amber-border); }\n.bg-purple-light { background: var(--purple-light); border: 1px solid var(--purple-border); }\n\n.kpi-content {\n  display: flex;\n  flex-direction: column;\n}\n\n.kpi-label {\n  font-size: 0.68rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 0.06em;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n}\n\n.kpi-value {\n  font-size: 1.5rem;\n  font-weight: 800;\n  color: var(--slate-900);\n  line-height: 1.2;\n  margin: 0.15rem 0;\n}\n\n.kpi-unit {\n  font-size: 0.85rem;\n  font-weight: 600;\n  color: var(--slate-500);\n}\n\n.kpi-subtext {\n  font-size: 0.74rem;\n  color: var(--slate-500);\n  display: flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n\n/* --------------------------------------------------------------------------\n   Tab Navigation Bar\n   -------------------------------------------------------------------------- */\n.tab-navbar {\n  display: flex;\n  align-items: center;\n  gap: 0.6rem;\n  background: var(--bg-card);\n  border: 1px solid var(--border-light);\n  border-radius: 14px;\n  padding: 0.5rem 0.75rem;\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.03);\n  overflow-x: auto;\n}\n\n.tab-trigger {\n  background: transparent;\n  border: none;\n  font-family: var(--font-sans);\n  font-size: 0.875rem;\n  font-weight: 600;\n  color: var(--slate-600);\n  padding: 0.7rem 1.35rem;\n  border-radius: 10px;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.65rem;\n  transition: all 0.2s ease;\n  white-space: nowrap;\n}\n\n.tab-trigger:hover {\n  background: var(--slate-100);\n  color: var(--slate-900);\n}\n\n.tab-trigger.active {\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  box-shadow: 0 2px 8px var(--emerald-glow);\n}\n\n.tab-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  padding: 0.15rem 0.5rem;\n  border-radius: 9999px;\n  background: #E2E8F0;\n  color: var(--slate-700);\n}\n.tab-trigger.active .tab-badge {\n  background: var(--emerald);\n  color: #FFFFFF;\n}\n\n/* Tab Views Container */\n.tab-content-container {\n  position: relative;\n  min-height: 560px;\n}\n\n.tab-view {\n  display: none;\n  animation: tabFadeIn 0.22s ease-out;\n}\n.tab-view.active {\n  display: block;\n}\n\n@keyframes tabFadeIn {\n  from { opacity: 0; transform: translateY(6px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n/* --------------------------------------------------------------------------\n   TAB 1: ECO-ROUTE FINDER & MAP (UNCONGESTED 2-COLUMN WORKSPACE)\n   -------------------------------------------------------------------------- */\n.view-grid-map {\n  display: grid;\n  grid-template-columns: 420px 1fr;\n  gap: 1.5rem;\n  align-items: start;\n}\n\n.route-selector-panel {\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.card-header-clean {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  padding-bottom: 0.9rem;\n  border-bottom: 1px solid var(--slate-100);\n  gap: 0.75rem;\n}\n\n.card-title {\n  font-size: 1.05rem;\n  font-weight: 700;\n  color: var(--slate-900);\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n}\n\n.card-subtitle {\n  font-size: 0.775rem;\n  color: var(--slate-500);\n  margin-top: 0.2rem;\n  line-height: 1.4;\n}\n\n.route-form-fields {\n  display: flex;\n  flex-direction: column;\n  gap: 1.15rem;\n}\n\n.field-group {\n  display: flex;\n  flex-direction: column;\n  gap: 0.45rem;\n}\n\n.field-label {\n  font-size: 0.775rem;\n  font-weight: 600;\n  color: var(--slate-700);\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.route-interchange-row {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: -0.35rem 0;\n}\n\n.btn-icon-circle {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  color: var(--slate-600);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  transition: all 0.22s ease;\n  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);\n}\n.btn-icon-circle:hover {\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border-color: var(--emerald-border);\n  transform: rotate(180deg);\n}\n\n/* Commuter Slider Box */\n.commuter-slider-box {\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 1.1rem 1.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.85rem;\n}\n\n.slider-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n.fare-pill {\n  background: #FFFFFF;\n  border: 1px solid var(--emerald-border);\n  padding: 0.35rem 0.75rem;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n  box-shadow: 0 2px 6px var(--emerald-glow);\n}\n\n.slider-range-input {\n  width: 100%;\n  accent-color: var(--emerald);\n  cursor: pointer;\n  height: 6px;\n  background: #E2E8F0;\n  border-radius: 6px;\n  outline: none;\n}\n\n.slider-ticks {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.72rem;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n  font-weight: 500;\n}\n\n.slider-ticks .tick.active-tick {\n  color: var(--emerald);\n  font-weight: 700;\n}\n\n.route-actions-row {\n  display: flex;\n  gap: 0.75rem;\n}\n\n/* Map Card Wrapper */\n.map-card-wrapper {\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n.map-header-actions {\n  display: flex;\n  gap: 0.5rem;\n}\n\n.map-canvas-container {\n  position: relative;\n  width: 100%;\n  height: 480px;\n  background: #FAFCFB;\n  border: 1px solid var(--slate-200);\n  border-radius: 14px;\n  overflow: hidden;\n}\n\n#urban-3d-canvas {\n  width: 100%;\n  height: 100%;\n  cursor: grab;\n  display: block;\n}\n#urban-3d-canvas:active {\n  cursor: grabbing;\n}\n\n.map-hud-overlay {\n  position: absolute;\n  bottom: 1rem;\n  left: 1rem;\n  background: rgba(255, 255, 255, 0.94);\n  backdrop-filter: blur(8px);\n  border: 1px solid var(--slate-200);\n  padding: 0.5rem 0.95rem;\n  border-radius: 8px;\n  font-size: 0.75rem;\n  color: var(--slate-700);\n  font-family: var(--font-mono);\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);\n}\n\n.telemetry-summary-strip {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 0.85rem;\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 0.95rem 1.15rem;\n}\n\n.telemetry-item {\n  display: flex;\n  flex-direction: column;\n}\n.telemetry-label {\n  font-size: 0.65rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n  letter-spacing: 0.03em;\n}\n.telemetry-value {\n  font-size: 0.95rem;\n  font-weight: 800;\n  color: var(--slate-900);\n  margin-top: 0.2rem;\n}\n\n/* --------------------------------------------------------------------------\n   Buttons & Inputs System\n   -------------------------------------------------------------------------- */\n.btn {\n  font-family: var(--font-sans);\n  font-size: 0.825rem;\n  font-weight: 600;\n  padding: 0.65rem 1.25rem;\n  border-radius: 10px;\n  border: 1px solid transparent;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 0.5rem;\n  transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);\n  white-space: nowrap;\n}\n\n.btn-primary {\n  background: var(--electric);\n  color: #FFFFFF;\n  box-shadow: 0 4px 12px rgba(37, 99, 235, 0.25);\n}\n.btn-primary:hover {\n  background: #1D4ED8;\n  box-shadow: 0 6px 18px rgba(37, 99, 235, 0.35);\n  transform: translateY(-2px);\n}\n\n.btn-emerald {\n  background: var(--emerald);\n  color: #FFFFFF;\n  box-shadow: 0 4px 12px rgba(5, 150, 105, 0.25);\n}\n.btn-emerald:hover {\n  background: #047857;\n  box-shadow: 0 6px 18px rgba(5, 150, 105, 0.35);\n  transform: translateY(-2px);\n}\n\n.btn-emerald-outline {\n  background: var(--emerald-light);\n  border: 1px solid var(--emerald-border);\n  color: var(--emerald);\n}\n.btn-emerald-outline:hover {\n  background: var(--emerald);\n  color: #FFFFFF;\n  transform: translateY(-2px);\n}\n\n.btn-amber {\n  background: var(--amber-light);\n  border: 1px solid var(--amber-border);\n  color: var(--amber);\n}\n.btn-amber:hover {\n  background: var(--amber);\n  color: #FFFFFF;\n  transform: translateY(-2px);\n}\n\n.btn-rose {\n  background: var(--rose-light);\n  border: 1px solid var(--rose-border);\n  color: var(--rose);\n}\n.btn-rose:hover {\n  background: var(--rose);\n  color: #FFFFFF;\n  transform: translateY(-2px);\n}\n\n.btn-outline {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  color: var(--slate-700);\n}\n.btn-outline:hover {\n  background: var(--slate-100);\n  border-color: var(--slate-400);\n  transform: translateY(-2px);\n}\n\n.btn-ghost {\n  background: transparent;\n  color: var(--slate-500);\n}\n.btn-ghost:hover {\n  background: var(--slate-100);\n  color: var(--slate-800);\n}\n\n.btn-sm {\n  padding: 0.4rem 0.8rem;\n  font-size: 0.75rem;\n}\n\n.text-input, .select-field {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 10px;\n  color: var(--slate-900);\n  padding: 0.65rem 0.95rem;\n  font-size: 0.85rem;\n  font-family: var(--font-sans);\n  outline: none;\n  transition: all 0.2s ease;\n  width: 100%;\n}\n\n.text-input:focus, .select-field:focus {\n  border-color: var(--emerald);\n  box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.12);\n}\n\n.text-input::placeholder {\n  color: var(--slate-400);\n}\n\n.input-with-icon {\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n.input-with-icon i {\n  position: absolute;\n  left: 0.95rem;\n  color: var(--slate-400);\n  font-size: 0.85rem;\n}\n.input-with-icon .text-input {\n  padding-left: 2.5rem;\n}\n\n/* --------------------------------------------------------------------------\n   TAB 2: COMMUTER PASSENGER HUB\n   -------------------------------------------------------------------------- */\n.view-grid-passengers {\n  display: grid;\n  grid-template-columns: 360px 1.4fr 340px;\n  gap: 1.5rem;\n  align-items: start;\n}\n\n.passenger-form-card {\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n/* Conveyor Pipeline Stream */\n.conveyor-pipeline-card {\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n.conveyor-belt-container {\n  display: flex;\n  flex-direction: column;\n  gap: 0.85rem;\n  max-height: 460px;\n  overflow-y: auto;\n  padding-right: 0.4rem;\n}\n\n.commuter-token {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 0.95rem 1.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n  position: relative;\n  overflow: hidden;\n}\n\n.commuter-token.head-token {\n  border-left: 4px solid var(--emerald);\n  background: #FCFDFD;\n}\n\n.token-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  text-transform: uppercase;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n}\n.head-token .token-badge {\n  color: var(--emerald);\n}\n\n.token-name {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--slate-900);\n}\n\n.token-route {\n  font-size: 0.8rem;\n  color: var(--slate-600);\n  display: flex;\n  align-items: center;\n  gap: 0.45rem;\n}\n\n.token-meta {\n  font-size: 0.7rem;\n  color: var(--slate-400);\n  font-family: var(--font-mono);\n}\n\n/* Priority Standby Circular Lounge */\n.standby-lounge-card {\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n  align-items: center;\n}\n\n.standby-ring-wrap {\n  position: relative;\n  width: 250px;\n  height: 250px;\n  margin: 0.75rem auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.standby-ring-center {\n  position: absolute;\n  width: 90px;\n  height: 90px;\n  border-radius: 50%;\n  background: #FFFFFF;\n  border: 2px dashed var(--slate-200);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  text-align: center;\n  z-index: 2;\n  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);\n}\n\n.standby-slot {\n  position: absolute;\n  width: 44px;\n  height: 44px;\n  border-radius: 50%;\n  background: #FFFFFF;\n  border: 2px solid var(--slate-200);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.62rem;\n  color: var(--slate-600);\n  font-family: var(--font-mono);\n  transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);\n  box-shadow: 0 2px 8px rgba(15, 23, 42, 0.04);\n}\n\n.standby-slot.occupied {\n  background: var(--amber-light);\n  border-color: var(--amber);\n  color: var(--amber);\n  box-shadow: 0 4px 12px rgba(217, 119, 6, 0.2);\n}\n\n.standby-slot.is-active-pointer {\n  border-color: var(--emerald);\n  background: var(--emerald-light);\n  color: var(--emerald);\n  box-shadow: 0 0 0 3px rgba(5, 150, 105, 0.2);\n}\n\n.standby-actions-grid {\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n}\n\n/* --------------------------------------------------------------------------\n   TAB 3: DRIVER FLEET & DISPATCH CONSOLE\n   -------------------------------------------------------------------------- */\n.view-grid-fleet {\n  display: grid;\n  grid-template-columns: 420px 1fr;\n  gap: 1.5rem;\n  align-items: start;\n}\n\n.fleet-onboarding-card {\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n/* Vehicle Chassis Blueprint Diagram */\n.vehicle-blueprint-box {\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 14px;\n  padding: 1.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1rem;\n}\n\n.vehicle-blueprint-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.775rem;\n  font-weight: 600;\n  color: var(--slate-700);\n}\n\n.vehicle-chassis-diagram {\n  width: 170px;\n  height: 220px;\n  margin: 0 auto;\n  border: 2px solid var(--slate-300);\n  border-radius: 40px 40px 24px 24px;\n  background: #FFFFFF;\n  position: relative;\n  box-shadow: 0 4px 14px rgba(15, 23, 42, 0.04);\n  padding: 1.25rem 0.75rem;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n\n.chassis-row {\n  display: flex;\n  justify-content: space-around;\n  gap: 0.5rem;\n}\n\n.vehicle-seat {\n  width: 58px;\n  height: 64px;\n  border-radius: 10px;\n  border: 1.5px solid var(--slate-200);\n  background: #FFFFFF;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 0.25rem;\n  font-size: 0.65rem;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  color: var(--slate-600);\n  cursor: pointer;\n  transition: all 0.2s ease;\n}\n\n.vehicle-seat:hover {\n  border-color: var(--emerald);\n  transform: translateY(-2px);\n}\n\n.vehicle-seat.driver-locked {\n  background: #F1F5F9;\n  border-color: var(--slate-300);\n  color: var(--slate-700);\n  cursor: default;\n}\n\n.vehicle-seat.active-seat {\n  background: var(--emerald-light);\n  border-color: var(--emerald);\n  color: var(--emerald);\n  box-shadow: 0 4px 10px var(--emerald-glow);\n}\n\n.vehicle-seat.reserved-seat {\n  background: var(--rose-light);\n  border-color: var(--rose-border);\n  color: var(--rose);\n}\n\n/* Fleet Directory & Active Trips Column */\n.fleet-operations-column {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.fleet-stream-container {\n  display: flex;\n  gap: 1rem;\n  overflow-x: auto;\n  padding-bottom: 0.5rem;\n}\n\n.driver-partner-card {\n  min-width: 220px;\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 1rem 1.2rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n  flex-shrink: 0;\n}\n\n.card-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.driver-id-badge {\n  font-size: 0.68rem;\n  font-family: var(--font-mono);\n  font-weight: 700;\n  color: var(--slate-500);\n}\n\n.seat-counter-pill {\n  font-size: 0.68rem;\n  font-weight: 700;\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  padding: 0.2rem 0.55rem;\n  border-radius: 9999px;\n}\n\n.driver-name {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--slate-900);\n}\n\n.driver-corridor {\n  font-size: 0.775rem;\n  color: var(--slate-600);\n}\n\n.fleet-pointer {\n  display: flex;\n  align-items: center;\n  color: var(--slate-400);\n}\n\n/* Active Shared Trips Console */\n.active-trips-stream {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));\n  gap: 1rem;\n  margin-top: 1rem;\n}\n\n.shared-trip-card {\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 1.15rem 1.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  position: relative;\n}\n\n.route-match-badge {\n  font-size: 0.68rem;\n  font-weight: 700;\n  padding: 0.2rem 0.55rem;\n  border-radius: 6px;\n  background: var(--electric-light);\n  color: var(--electric);\n  border: 1px solid var(--electric-border);\n}\n\n.trip-ref {\n  font-family: var(--font-mono);\n  font-size: 0.75rem;\n  font-weight: 700;\n  color: var(--slate-500);\n}\n\n.btn-cancel-trip {\n  position: absolute;\n  top: 0.85rem;\n  right: 0.85rem;\n  width: 26px;\n  height: 26px;\n  border-radius: 50%;\n  background: #F1F5F9;\n  border: none;\n  color: var(--slate-400);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  font-size: 0.75rem;\n  transition: all 0.2s ease;\n}\n.btn-cancel-trip:hover {\n  background: var(--rose-light);\n  color: var(--rose);\n}\n\n/* Search & Identity Verification Bar */\n.verification-bar-card {\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 12px;\n  padding: 1.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.85rem;\n}\n\n.search-input-row {\n  display: flex;\n  gap: 0.75rem;\n}\n\n.verification-result-box {\n  background: #FFFFFF;\n  border: 1px dashed var(--slate-200);\n  border-radius: 10px;\n  padding: 0.85rem 1rem;\n  display: flex;\n  align-items: center;\n}\n\n/* --------------------------------------------------------------------------\n   TAB 4: CITY SUSTAINABILITY ANALYTICS\n   -------------------------------------------------------------------------- */\n.view-grid-analytics {\n  display: flex;\n  flex-direction: column;\n  gap: 1.5rem;\n}\n\n.analytics-metrics-strip {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 1.25rem;\n}\n\n.analytics-kpi-card {\n  padding: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n}\n\n.analytics-two-col {\n  display: grid;\n  grid-template-columns: 1.4fr 1fr;\n  gap: 1.5rem;\n}\n\n.audit-history-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.65rem;\n  max-height: 280px;\n  overflow-y: auto;\n}\n\n.audit-entry {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 0.75rem 1rem;\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 10px;\n  font-size: 0.775rem;\n}\n\n.audit-entry.latest-entry {\n  border-left: 3px solid var(--emerald);\n  background: #FCFDFD;\n}\n\n.leaderboard-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.85rem;\n}\n\n.leader-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.775rem;\n  padding: 0.45rem 0;\n  border-bottom: 1px solid var(--slate-100);\n}\n\n.gamified-badge {\n  font-size: 0.65rem;\n  font-weight: 700;\n  padding: 0.2rem 0.55rem;\n  border-radius: 6px;\n  background: var(--emerald-light);\n  color: var(--emerald);\n  border: 1px solid var(--emerald-border);\n  display: inline-flex;\n  align-items: center;\n  gap: 0.35rem;\n}\n\n/* --------------------------------------------------------------------------\n   EcoSprout Mascot Container & SVG Component\n   -------------------------------------------------------------------------- */\n.ecosprout-container {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 2rem 1.5rem;\n  text-align: center;\n  gap: 0.65rem;\n}\n\n.ecosprout-avatar {\n  width: 68px;\n  height: 68px;\n  border-radius: 50%;\n  background: radial-gradient(circle, var(--emerald-light), #D1FAE5);\n  border: 2px solid var(--emerald-border);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  box-shadow: 0 4px 14px var(--emerald-glow);\n  animation: sproutBounce 3s ease-in-out infinite;\n}\n\n.ecosprout-avatar svg {\n  width: 48px;\n  height: 48px;\n}\n\n.ecosprout-bubble {\n  background: #FFFFFF;\n  border: 1px solid var(--emerald-border);\n  border-radius: 12px;\n  padding: 0.65rem 1rem;\n  font-size: 0.775rem;\n  color: var(--slate-700);\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);\n  max-width: 320px;\n}\n\n@keyframes sproutBounce {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-6px); }\n}\n\n/* --------------------------------------------------------------------------\n   Enterprise Alert Modals\n   -------------------------------------------------------------------------- */\n.modal-overlay {\n  position: fixed;\n  inset: 0;\n  background: rgba(15, 23, 42, 0.45);\n  backdrop-filter: blur(6px);\n  z-index: 10000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 1.5rem;\n}\n\n.modal-overlay.hidden {\n  display: none;\n}\n\n.modal-card {\n  width: 520px;\n  max-width: 95vw;\n  background: #FFFFFF;\n  border-radius: 16px;\n  box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.2);\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n  animation: modalIn 0.28s cubic-bezier(0.16, 1, 0.3, 1);\n  position: relative;\n  z-index: 10001;\n}\n\n.modal-header {\n  padding: 1.25rem 1.75rem;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--slate-100);\n}\n\n.modal-dialog-body {\n  padding: 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.15rem;\n}\n\n.receipt-content {\n  padding: 1.5rem 1.75rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n}\n\n.modal-footer {\n  padding: 1.1rem 1.75rem;\n  display: flex;\n  justify-content: flex-end;\n  gap: 0.75rem;\n  border-top: 1px solid var(--slate-100);\n  background: #F8FAFC;\n}\n\n.receipt-item-row {\n  display: flex;\n  justify-content: space-between;\n  font-size: 0.825rem;\n  color: var(--slate-600);\n}\n.receipt-item-row.bold-row {\n  font-weight: 700;\n  color: var(--slate-900);\n  border-top: 1px dashed var(--slate-300);\n  padding-top: 0.65rem;\n  font-size: 0.95rem;\n}\n\n.modal-stat-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 0.85rem;\n  margin: 0.5rem 0;\n}\n\n.modal-stat-box {\n  background: #F8FAFC;\n  border: 1px solid var(--slate-200);\n  border-radius: 10px;\n  padding: 0.75rem 0.95rem;\n  display: flex;\n  flex-direction: column;\n}\n.modal-stat-box .stat-label {\n  font-size: 0.65rem;\n  color: var(--slate-500);\n  font-family: var(--font-mono);\n}\n.modal-stat-box .stat-val {\n  font-size: 0.95rem;\n  font-weight: 700;\n  color: var(--slate-900);\n  margin-top: 0.15rem;\n}\n\n/* --------------------------------------------------------------------------\n   Footer & Toasts\n   -------------------------------------------------------------------------- */\n.app-footer {\n  padding: 1.35rem 0.5rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.775rem;\n  color: var(--slate-500);\n  border-top: 1px solid var(--slate-200);\n  flex-wrap: wrap;\n  gap: 0.75rem;\n}\n\n.footer-right {\n  display: flex;\n  gap: 1.5rem;\n}\n\n.toast-container {\n  position: fixed;\n  bottom: 1.5rem;\n  right: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  z-index: 99999;\n}\n\n.toast {\n  padding: 0.85rem 1.35rem;\n  border-radius: 10px;\n  background: #FFFFFF;\n  border: 1px solid var(--slate-200);\n  border-left: 4px solid var(--emerald);\n  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.08);\n  font-size: 0.825rem;\n  font-weight: 500;\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  color: var(--slate-900);\n  animation: toastIn 0.3s ease-out;\n}\n.toast.toast-emerald { border-left-color: var(--emerald); }\n.toast.toast-blue { border-left-color: var(--electric); }\n.toast.toast-rose { border-left-color: var(--rose); }\n.toast.toast-amber { border-left-color: var(--amber); }\n\n/* Utility classes */\n.text-emerald { color: var(--emerald); }\n.text-electric { color: var(--electric); }\n.text-rose { color: var(--rose); }\n.text-amber { color: var(--amber); }\n.text-purple { color: var(--purple); }\n.font-bold { font-weight: 700; }\n.font-semibold { font-weight: 600; }\n.flex { display: flex; }\n.flex-1 { flex: 1; }\n.flex-col { flex-direction: column; }\n.items-center { align-items: center; }\n.justify-between { justify-content: space-between; }\n.gap-2 { gap: 0.5rem; }\n.gap-3 { gap: 0.75rem; }\n.gap-4 { gap: 1rem; }\n.p-4 { padding: 1.5rem; }\n.pt-2 { padding-top: 0.5rem; }\n.w-full { width: 100%; }\n.truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.max-w-\\[42px\\] { max-width: 42px; }\n\n/* --------------------------------------------------------------------------\n   Responsive Layout Adjustments\n   -------------------------------------------------------------------------- */\n@media (max-width: 1280px) {\n  .view-grid-map {\n    grid-template-columns: 380px 1fr;\n  }\n  .view-grid-passengers {\n    grid-template-columns: 320px 1fr 300px;\n  }\n  .view-grid-fleet {\n    grid-template-columns: 380px 1fr;\n  }\n}\n\n@media (max-width: 1080px) {\n  .kpi-banner {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .view-grid-map,\n  .view-grid-passengers,\n  .view-grid-fleet,\n  .analytics-two-col {\n    grid-template-columns: 1fr;\n  }\n  .analytics-metrics-strip {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 768px) {\n  .app-layout {\n    padding: 1rem 1rem 2rem;\n  }\n  .kpi-banner {\n    grid-template-columns: 1fr;\n  }\n  .telemetry-summary-strip {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .app-header {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n  .nav-actions {\n    width: 100%;\n    justify-content: flex-start;\n  }\n}\n\n/* Print styling for Eco-Receipt */\n@media print {\n  body * {\n    visibility: hidden;\n  }\n  #receipt-modal-card,\n  #receipt-modal-card * {\n    visibility: visible;\n  }\n  #receipt-modal-card {\n    position: absolute;\n    left: 0;\n    top: 0;\n    width: 100%;\n    box-shadow: none;\n    border: 1px solid #000;\n  }\n  .modal-footer {\n    display: none;\n  }\n}\n\n@keyframes toastIn {\n  from { opacity: 0; transform: translateY(15px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes modalIn {\n  from { opacity: 0; transform: scale(0.95); }\n  to { opacity: 1; transform: scale(1); }\n}\n","Overwrite":true,"Path":"C:/Users/Kartik Bhosle/.gemini/antigravity/brain/6976d1a8-fd03-4453-a790-acd552e1861a/styles.css"}}]}
