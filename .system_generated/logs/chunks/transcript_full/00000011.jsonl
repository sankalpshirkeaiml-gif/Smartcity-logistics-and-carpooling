02: \n503:   animate() {\n504:     this.flowDashOffset -= 0.6;\n505:     this.render();\n506: \n507:     // Advance transit vehicle along path\n508:     if (this.isCarDriving && this.activeCorridorPath.length > 1) {\n509:       this.carProgress += this.carSpeed;\n510:       if (this.carProgress >= this.activeCorridorPath.length - 1) {\n511:         this.carProgress = 0; // Loop or stop\n512:       }\n513:     }\n514: \n515:     requestAnimationFrame(() => this.animate());\n516:   }\n517: \n518:   render() {\n519:     const ctx = this.ctx;\n520:     ctx.clearRect(0, 0, this.width, this.height);\n521: \n522:     this.drawGroundGrid();\n523: \n524:     // Draw Corridors\n525:     TRANSIT_CORRIDORS.forEach(corridor => {\n526:       const uStation = TRANSIT_STATIONS.find(s => s.id === corridor.u);\n527:       const vStation = TRANSIT_STATIONS.find(s => s.id === corridor.v);\n528:       const p1 = this.project(uStation.x, uStation.y, uStation.z);\n529:       const p2 = this.project(vStation.x, vStation.y, vStation.z);\n530: \n531:       let isPath = false;\n532:       let pathDirection = 0; // 1: u->v, -1: v->u\n533: \n534:       for (let i = 0; i < this.activeCorridorPath.length - 1; i++) {\n535:         const a = this.activeCorridorPath[i];\n536:         const b = this.activeCorridorPath[i + 1];\n537:         if (a === corridor.u && b === corridor.v) {\n538:           isPath = true;\n539:           pathDirection = 1;\n540:           break;\n541:         } else if (a === corridor.v && b === corridor.u) {\n542:           isPath = true;\n543:           pathDirection = -1;\n544:           break;\n545:         }\n546:       }\n547: \n548:       ctx.save();\n549:       ctx.beginPath();\n550:       ctx.moveTo(p1.x, p1.y);\n551:       ctx.lineTo(p2.x, p2.y);\n552: \n553:       if (isPath) {\n554:         // Base route vector line\n555:         ctx.strokeStyle = '#2563EB';\n556:         ctx.lineWidth = 4.5;\n557:         ctx.stroke();\n558: \n559:         // Directional Flow Animation (Chevrons / dashed energy pulses)\n560:         ctx.save();\n561:         ctx.beginPath();\n562:         const startP = pathDirection === 1 ? p1 : p2;\n563:         const endP = pathDirection === 1 ? p2 : p1;\n564:         ctx.moveTo(startP.x, startP.y);\n565:         ctx.lineTo(endP.x, endP.y);\n566:         ctx.strokeStyle = '#60A5FA';\n567:         ctx.lineWidth = 2.5;\n568:         ctx.setLineDash([8, 12]);\n569:         ctx.lineDashOffset = this.flowDashOffset;\n570:         ctx.stroke();\n571:         ctx.restore();\n572:       } else {\n573:         ctx.strokeStyle = '#CBD5E1';\n574:         ctx.lineWidth = 2;\n575:         ctx.stroke();\n576:       }\n577:       ctx.restore();\n578: \n579:       // Corridor Distance Tag\n580:       const midX = (p1.x + p2.x) / 2;\n581:       const midY = (p1.y + p2.y) / 2;\n582:       ctx.save();\n583:       ctx.fillStyle = isPath ? '#2563EB' : '#FFFFFF';\n584:       ctx.strokeStyle = isPath ? '#1D4ED8' : '#CBD5E1';\n585:       ctx.lineWidth = 1;\n586:       ctx.beginPath();\n587:       ctx.roundRect(midX - 16, midY - 9, 32, 18, 4);\n588:       ctx.fill();\n589:       ctx.stroke();\n590: \n591:       ctx.fillStyle = isPath ? '#FFFFFF' : '#475569';\n592:       ctx.font = 'bold 9px \"JetBrains Mono\"';\n593:       ctx.textAlign = 'center';\n594:       ctx.textBaseline = 'middle';\n595:       ctx.fillText(`${corridor.distance}km`, midX, midY);\n596:       ctx.restore();\n597:     });\n598: \n599:     // Draw Stations (Sorted by Z for depth)\n600:     const sorted = [...TRANSIT_STATIONS].map(s => ({\n601:       station: s,\n602:       proj: this.project(s.x, s.y, s.z)\n603:     })).sort((a, b) => b.proj.z - a.proj.z);\n604: \n605:     sorted.forEach(({ station, proj }) => {\n606:       const isPath = this.activeCorridorPath.includes(station.id);\n607:       const isHovered = this.hoveredStation && this.hoveredStation.id === station.id;\n608: \n609:       ctx.save();\n610: \n611:       // Floor Shadow\n612:       const floorProj = this.project(station.x, station.y, -30);\n613:       ctx.beginPath();\n614:       ctx.ellipse(floorProj.x, floorProj.y, 14 * proj.scale, 7 * proj.scale, 0, 0, Math.PI * 2);\n615:       ctx.fillStyle = 'rgba(15, 23, 42, 0.08)';\n616:       ctx.fill();\n617: \n618:       // Elevation Stem\n619:       ctx.beginPath();\n620:       ctx.moveTo(floorProj.x, floorProj.y);\n621:       ctx.lineTo(proj.x, proj.y);\n622:       ctx.strokeStyle = isPath ? 'rgba(5, 150, 105, 0.6)' : '#CBD5E1';\n623:       ctx.lineWidth = 1.5;\n624:       ctx.setLineDash([2, 3]);\n625:       ctx.stroke();\n626:       ctx.setLineDash([]);\n627: \n628:       // Station Circle\n629:       ctx.beginPath();\n630:       const radius = (isHovered ? 14 : 11) * proj.scale;\n631:       ctx.arc(proj.x, proj.y, radius, 0, Math.PI * 2);\n632: \n633:       if (isPath) {\n634:         ctx.fillStyle = '#059669';\n635:         ctx.shadowColor = 'rgba(5, 150, 105, 0.4)';\n636:         ctx.shadowBlur = 14;\n637:       } else if (isHovered) {\n638:         ctx.fillStyle = '#2563EB';\n639:         ctx.shadowColor = 'rgba(37, 99, 235, 0.4)';\n640:         ctx.shadowBlur = 12;\n641:       } else {\n642:         ctx.fillStyle = '#FFFFFF';\n643:         ctx.strokeStyle = '#059669';\n644:         ctx.lineWidth = 2.5;\n645:         ctx.stroke();\n646:       }\n647:       ctx.fill();\n648:       ctx.restore();\n649: \n650:       // Station Label & Zone"}
