{"step_index":148,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:19:38Z","content":"Created At: 2026-10-20T11:49:38+05:30\nCompleted At: 2026-10-20T11:49:39+05:30\nShowing lines 800-1599 of 1652\n800: \n801:       views.forEach(v => {\n802:         v.classList.remove('active');\n803:         if (v.id === targetTabId) {\n804:           v.classList.add('active');\n805:         }\n806:       });\n807: \n808:       if (targetTabId === 'tab-route-finder' && urbanCanvasInstance) {\n809:         setTimeout(() => {\n810:           urbanCanvasInstance.resize();\n811:         }, 50);\n812:       }\n813:     });\n814:   });\n815: }\n816: \n817: // ==========================================\n818: // 7. UI REFRESH & COMPONENT RENDERERS\n819: // ==========================================\n820: function refreshPlatformUI() {\n821:   renderPassengerDispatchStream();\n822:   renderStandbyLounge();\n823:   renderFleetDirectory();\n824:   renderActiveTrips();\n825:   renderTransitHierarchyCanvas();\n826:   renderAuditHistory();\n827:   renderLeaderboard();\n828:   updateTopKPIs();\n829: }\n830: \n831: function updateTopKPIs() {\n832:   document.getElementById('kpi-commuters').innerHTML = `${engine.dispatchStream.length} <span class=\"kpi-unit\">commuters</span>`;\n833:   document.getElementById('kpi-active-trips').innerHTML = `${engine.activeTrips.length} <span class=\"kpi-unit\">trips</span>`;\n834: \n835:   const passBadge = document.getElementById('tab-passengers-badge');\n836:   if (passBadge) passBadge.textContent = engine.dispatchStream.length + engine.standbyCount;\n837: \n838:   const fleetBadge = document.getElementById('tab-fleet-badge');\n839:   if (fleetBadge) fleetBadge.textContent = engine.fleetPartners.length;\n840: \n841:   let totalSavedCO2 = 148.5;\n842:   let totalDistance = 1420;\n843:   engine.activeTrips.forEach(t => {\n844:     totalSavedCO2 += t.co2Saved;\n845:     totalDistance += t.distance;\n846:   });\n847: \n848:   document.getElementById('kpi-co2').innerHTML = `${totalSavedCO2.toFixed(1)} <span class=\"kpi-unit\">kg</span>`;\n849:   document.getElementById('eco-total-co2').textContent = `${totalSavedCO2.toFixed(1)} kg`;\n850:   document.getElementById('eco-shared-km').textContent = `${Math.round(totalDistance).toLocaleString()} km`;\n851: \n852:   document.getElementById('fleet-count-badge').textContent = `${engine.fleetPartners.length} Active Partners`;\n853:   document.getElementById('active-trips-badge').textContent = `${engine.activeTrips.length} In-Transit`;\n854: }\n855: \n856: // --- Passenger Dispatch Stream with EcoSprout Empty State ---\n857: function renderPassengerDispatchStream() {\n858:   const container = document.getElementById('passenger-conveyor');\n859:   if (!container) return;\n860: \n861:   if (engine.dispatchStream.length === 0) {\n862:     container.innerHTML = `\n863:       <div class=\"ecosprout-container\">\n864:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n865:         <div class=\"ecosprout-bubble\">\n866:           <b>EcoSprout here!</b> The dispatch conveyor is clear. Submit a commuter request above to plan a green trip!\n867:         </div>\n868:       </div>`;\n869:     return;\n870:   }\n871: \n872:   container.innerHTML = engine.dispatchStream.map((pass, idx) => `\n873:     <div class=\"commuter-token ${idx === 0 ? 'head-token' : ''} eco-card-hover\">\n874:       <div class=\"token-badge\">${idx === 0 ? 'NEXT DISPATCH' : `PRIORITY #${idx + 1}`}</div>\n875:       <div class=\"token-name\">${pass.name}</div>\n876:       <div class=\"token-route\"><i class=\"fa-solid fa-route\"></i> ${pass.pickup} &rarr; ${pass.drop}</div>\n877:       <div class=\"token-meta\">${pass.id} &bull; ${pass.requestedAt}</div>\n878:     </div>\n879:   `).join('');\n880: }\n881: \n882: // --- Priority Standby Lounge ---\n883: function renderStandbyLounge() {\n884:   const ring = document.getElementById('standby-ring');\n885:   const counter = document.getElementById('standby-slot-counter');\n886:   const pill = document.getElementById('standby-status-pill');\n887:   if (!ring || !counter || !pill) return;\n888: \n889:   counter.textContent = `${engine.standbyCount} / ${engine.standbyCap}`;\n890:   pill.textContent = `Available Slots: ${engine.standbyCap - engine.standbyCount} / ${engine.standbyCap}`;\n891: \n892:   ring.innerHTML = '';\n893:   const total = engine.standbyCap;\n894:   const radius = 90;\n895: \n896:   for (let i = 0; i < total; i++) {\n897:     const angle = (i * 2 * Math.PI) / total - Math.PI / 2;\n898:     const x = Math.round(radius * Math.cos(angle) + 105);\n899:     const y = Math.round(radius * Math.sin(angle) + 105);\n900: \n901:     const isOccupied = engine.standbyLounge[i] !== null;\n902:     const isActivePointer = i === engine.standbyFront && engine.standbyCount > 0;\n903: \n904:     const slotEl = document.createElement('div');\n905:     slotEl.className = `standby-slot ${isOccupied ? 'occupied' : ''} ${isActivePointer ? 'is-active-pointer' : ''}`;\n906:     slotEl.style.left = `${x}px`;\n907:     slotEl.style.top = `${y}px`;\n908: \n909:     const passenger = engine.standbyLounge[i];\n910:     slotEl.innerHTML = `\n911:       <div class=\"font-bold\">SLOT ${i + 1}</div>\n912:       <div class=\"text-[9px] truncate max-w-[42px]\">${passenger ? passenger.name.split(' ')[0] : 'FREE'}</div>\n913:     `;\n914:     slotEl.title = passenger ? `Standby: ${passenger.name} (${passenger.pickup} -> ${passenger.drop})` : `Slot ${i + 1}: Empty`;\n915:     ring.appendChild(slotEl);\n916:   }\n917: }\n918: \n919: // --- Driver Fleet Directory with EcoSprout Empty State ---\n920: function renderFleetDirectory() {\n921:   const container = document.getElementById('fleet-stream-container');\n922:   const capacityPill = document.getElementById('fleet-capacity-pill');\n923:   if (!container || !capacityPill) return;\n924: \n925:   let totalAvailableSeats = 0;\n926:   engine.fleetPartners.forEach(p => { totalAvailableSeats += p.seats; });\n927:   capacityPill.textContent = `Total Available Seats: ${totalAvailableSeats}`;\n928: \n929:   if (engine.fleetPartners.length === 0) {\n930:     container.innerHTML = `\n931:       <div class=\"ecosprout-container\">\n932:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n933:         <div class=\"ecosprout-bubble\">\n934:           <b>EcoSprout needs partners!</b> Toggle vehicle seats above and onboard a driver partner to open seat capacity.\n935:         </div>\n936:       </div>`;\n937:     return;\n938:   }\n939: \n940:   let html = '';\n941:   engine.fleetPartners.forEach((partner, idx) => {\n942:     html += `\n943:       <div class=\"driver-partner-card eco-card-hover\">\n944:         <div class=\"card-top\">\n945:           <span class=\"driver-id-badge\">ID: #${partner.id}</span>\n946:           <span class=\"seat-counter-pill\">${partner.seats}/${partner.originalSeats} Seats</span>\n947:         </div>\n948:         <div class=\"driver-name\">${partner.name}</div>\n949:         <div class=\"driver-corridor\"><i class=\"fa-solid fa-location-dot text-emerald\"></i> ${partner.station} Station</div>\n950:         <div class=\"text-[10px] text-slate-500 mt-1\">${partner.tripsCompleted} Shared Trips</div>\n951:       </div>\n952:     `;\n953: \n954:     if (idx < engine.fleetPartners.length - 1) {\n955:       html += `<div class=\"fleet-pointer\"><i class=\"fa-solid fa-arrow-right\"></i></div>`;\n956:     }\n957:   });\n958: \n959:   container.innerHTML = html;\n960: }\n961: \n962: // --- Active Shared Trips with EcoSprout Empty State ---\n963: function renderActiveTrips() {\n964:   const container = document.getElementById('active-trips-stream');\n965:   if (!container) return;\n966: \n967:   if (engine.activeTrips.length === 0) {\n968:     container.innerHTML = `\n969:       <div class=\"ecosprout-container\">\n970:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n971:         <div class=\"ecosprout-bubble\">\n972:           <b>EcoSprout is ready to roll!</b> Dispatch a trip or launch the Rush-Hour simulation to watch active pooled rides.\n973:         </div>\n974:       </div>`;\n975:     return;\n976:   }\n977: \n978:   container.innerHTML = engine.activeTrips.map(trip => `\n979:     <div class=\"shared-trip-card eco-card-hover\">\n980:       <button class=\"btn-cancel-trip\" title=\"Complete / Cancel Trip\" onclick=\"handleCompleteTrip('${trip.tripRef}')\">\n981:         <i class=\"fa-solid fa-xmark\"></i>\n982:       </button>\n983:       <div class=\"flex justify-between items-center\">\n984:         <span class=\"trip-ref\">${trip.tripRef}</span>\n985:         <span class=\"route-match-badge\">${trip.matchScore}% Route Match</span>\n986:       </div>\n987:       <div class=\"text-xs font-bold text-slate-900 mt-0.5\">${trip.passenger.name}</div>\n988:       <div class=\"text-[10px] text-electric font-semibold\">${trip.corridorPath.join(' &rarr; ')}</div>\n989:       <div class=\"text-[10px] text-slate-600 mt-1\"><i class=\"fa-solid fa-id-badge text-emerald\"></i> ${trip.driverName}</div>\n990:       <div class=\"flex justify-between items-center text-[9px] text-slate-500 pt-1 border-t border-slate-200 mt-1\">\n991:         <span>+${trip.co2Saved}kg CO₂</span>\n992:         <button class=\"text-emerald hover:underline font-bold\" onclick=\"viewEcoReceipt('${trip.tripRef}')\">\n993:           <i class=\"fa-solid fa-receipt\"></i> Eco-Receipt\n994:         </button>\n995:         <span class=\"text-slate-900 font-bold\">$${trip.fare}</span>\n996:       </div>\n997:     </div>\n998:   `).join('');\n999: }\n1000: \n1001: // --- Transit Hierarchy Canvas ---\n1002: function renderTransitHierarchyCanvas() {\n1003:   const canvas = document.getElementById('trip-hierarchy-canvas');\n1004:   if (!canvas) return;\n1005:   const ctx = canvas.getContext('2d');\n1006:   const countPill = document.getElementById('registry-count-pill');\n1007: \n1008:   countPill.textContent = `${engine.activeTrips.length} Active Trips`;\n1009:   ctx.clearRect(0, 0, canvas.width, canvas.height);\n1010: \n1011:   if (engine.activeTrips.length === 0) {\n1012:     ctx.fillStyle = '#64748B';\n1013:     ctx.font = '11px \"Inter\"';\n1014:     ctx.textAlign = 'center';\n1015:     ctx.fillText('Transit Dispatch Registry Ready. Active shared trips will display here.', canvas.width / 2, canvas.height / 2);\n1016:     return;\n1017:   }\n1018: \n1019:   // Draw Root Hub\n1020:   const rootX = canvas.width / 2;\n1021:   const rootY = 24;\n1022: \n1023:   ctx.beginPath();\n1024:   ctx.arc(rootX, rootY, 14, 0, Math.PI * 2);\n1025:   ctx.fillStyle = '#FFFFFF';\n1026:   ctx.strokeStyle = '#059669';\n1027:   ctx.lineWidth = 2.5;\n1028:   ctx.fill();\n1029:   ctx.stroke();\n1030: \n1031:   ctx.fillStyle = '#059669';\n1032:   ctx.font = 'bold 9px \"Inter\"';\n1033:   ctx.textAlign = 'center';\n1034:   ctx.textBaseline = 'middle';\n1035:   ctx.fillText('NEXUS', rootX, rootY);\n1036: \n1037:   // Draw Branches\n1038:   const count = engine.activeTrips.length;\n1039:   const spacing = Math.min(80, (canvas.width - 60) / Math.max(count, 1));\n1040:   const startX = rootX - ((count - 1) * spacing) / 2;\n1041: \n1042:   engine.activeTrips.forEach((trip, idx) => {\n1043:     const nodeX = startX + idx * spacing;\n1044:     const nodeY = 110;\n1045: \n1046:     ctx.beginPath();\n1047:     ctx.moveTo(rootX, rootY + 14);\n1048:     ctx.lineTo(nodeX, nodeY - 14);\n1049:     ctx.strokeStyle = '#CBD5E1';\n1050:     ctx.lineWidth = 1.5;\n1051:     ctx.stroke();\n1052: \n1053:     ctx.beginPath();\n1054:     ctx.arc(nodeX, nodeY, 13, 0, Math.PI * 2);\n1055:     ctx.fillStyle = '#FFFFFF';\n1056:     ctx.strokeStyle = '#2563EB';\n1057:     ctx.lineWidth = 2;\n1058:     ctx.shadowColor = 'rgba(37, 99, 235, 0.2)';\n1059:     ctx.shadowBlur = 6;\n1060:     ctx.fill();\n1061:     ctx.stroke();\n1062:     ctx.shadowBlur = 0;\n1063: \n1064:     ctx.fillStyle = '#1E293B';\n1065:     ctx.font = 'bold 8px \"JetBrains Mono\"';\n1066:     ctx.textAlign = 'center';\n1067:     ctx.fillText(trip.tripRef.replace('NX-', ''), nodeX, nodeY);\n1068: \n1069:     ctx.fillStyle = '#059669';\n1070:     ctx.font = '500 8px \"Inter\"';\n1071:     ctx.fillText(trip.passenger.name.split(' ')[0], nodeX, nodeY + 22);\n1072:   });\n1073: }\n1074: \n1075: // --- Reversal Audit History List ---\n1076: function renderAuditHistory() {\n1077:   const container = document.getElementById('audit-history-list');\n1078:   const pill = document.getElementById('audit-log-pill');\n1079:   if (!container || !pill) return;\n1080: \n1081:   pill.textContent = `${engine.reversalAuditLog.length} Rollbacks Available`;\n1082: \n1083:   if (engine.reversalAuditLog.length === 0) {\n1084:     container.innerHTML = `\n1085:       <div class=\"empty-state\">\n1086:         <p>Reversal log clear. Confirm a trip to create a restorable dispatch state.</p>\n1087:       </div>`;\n1088:     return;\n1089:   }\n1090: \n1091:   const latestIdx = engine.reversalAuditLog.length - 1;\n1092:   container.innerHTML = engine.reversalAuditLog.map((entry, idx) => `\n1093:     <div class=\"audit-entry ${idx === latestIdx ? 'latest-entry' : ''}\">\n1094:       <div class=\"flex items-center gap-2\">\n1095:         <i class=\"fa-solid fa-shield-check text-emerald\"></i>\n1096:         <span class=\"font-semibold text-slate-800\">${entry.tripRef} &bull; ${entry.passenger.name}</span>\n1097:       </div>\n1098:       <span class=\"text-slate-500 font-mono text-[10px]\">Driver #${entry.driverId}</span>\n1099:     </div>\n1100:   `).join('');\n1101: }\n1102: \n1103: // --- Leaderboard with Gamified Achievement Badges ---\n1104: function renderLeaderboard() {\n1105:   const container = document.getElementById('eco-leaderboard-list');\n1106:   if (!container) return;\n1107: \n1108:   container.innerHTML = engine.leaderboard.map((item, idx) => `\n1109:     <div class=\"leader-item\">\n1110:       <div class=\"flex items-center gap-2\">\n1111:         <span class=\"text-amber-500 font-bold\">#${idx + 1}</span>\n1112:         <div>\n1113:           <div class=\"font-semibold text-slate-800\">${item.name}</div>\n1114:           <span class=\"gamified-badge\"><i class=\"fa-solid fa-award\"></i> ${item.badge}</span>\n1115:         </div>\n1116:       </div>\n1117:       <div class=\"flex items-center gap-3\">\n1118:         <span class=\"text-slate-500\">${item.trips} trips</span>\n1119:         <span class=\"text-emerald font-semibold\">${item.co2}</span>\n1120:         <span class=\"text-amber-600 font-mono text-[11px]\"><i class=\"fa-solid fa-star\"></i> ${item.rating}</span>\n1121:       </div>\n1122:     </div>\n1123:   `).join('');\n1124: }\n1125: \n1126: // ==========================================\n1127: // 8. ENTERPRISE CONFIRMATION MODALS\n1128: // ==========================================\n1129: function openDispatchModal(trip, driver) {\n1130:   const modal = document.getElementById('dispatch-confirm-modal');\n1131:   const body = document.getElementById('dispatch-modal-body');\n1132: \n1133:   body.innerHTML = `\n1134:     <div class=\"flex items-center gap-3 p-3 bg-emerald-50 border border-emerald-200 rounded-xl\">\n1135:       <div class=\"text-2xl text-emerald\"><i class=\"fa-solid fa-circle-check\"></i></div>\n1136:       <div>\n1137:         <div class=\"text-sm font-bold text-slate-900\">Trip Reference: ${trip.tripRef}</div>\n1138:         <div class=\"text-xs text-slate-600\">Passenger ${trip.passenger.name} matched with ${driver.name} (ID: #${driver.id})</div>\n1139:       </div>\n1140:     </div>\n1141: \n1142:     <div class=\"modal-stat-grid\">\n1143:       <div class=\"modal-stat-box\">\n1144:         <span class=\"stat-label\">CORRIDOR ALIGNMENT</span>\n1145:         <span class=\"stat-val text-emerald\">${trip.matchScore}% Match</span>\n1146:       </div>\n1147:       <div class=\"modal-stat-box\">\n1148:         <span class=\"stat-label\">EST. COMMUTE TIME</span>\n1149:         <span class=\"stat-val text-electric\">~${trip.time} mins (${trip.distance}km)</span>\n1150:       </div>\n1151:       <div class=\"modal-stat-box\">\n1152:         <span class=\"stat-label\">POOLED FARE</span>\n1153:         <span class=\"stat-val text-slate-900\">$${trip.fare} USD</span>\n1154:       </div>\n1155:       <div class=\"modal-stat-box\">\n1156:         <span class=\"stat-label\">CARBON OFFSET</span>\n1157:         <span class=\"stat-val text-emerald\">+${trip.co2Saved} kg CO₂</span>\n1158:       </div>\n1159:     </div>\n1160: \n1161:     <div class=\"text-xs text-slate-500 font-mono\">\n1162:       Route Transit: ${trip.corridorPath.join(' &rarr; ')} &bull; Fleet seats remaining for #${driver.id}: ${driver.seats}\n1163:     </div>\n1164:   `;\n1165: \n1166:   modal.classList.remove('hidden');\n1167: }\n1168: \n1169: function openReversalModal(action, driver) {\n1170:   const modal = document.getElementById('reversal-confirm-modal');\n1171:   const body = document.getElementById('reversal-modal-body');\n1172: \n1173:   body.innerHTML = `\n1174:     <div class=\"flex items-center gap-3 p-3 bg-rose-50 border border-rose-200 rounded-xl\">\n1175:       <div class=\"text-2xl text-rose\"><i class=\"fa-solid fa-arrow-rotate-left\"></i></div>\n1176:       <div>\n1177:         <div class=\"text-sm font-bold text-slate-900\">Reverted Trip: ${action.tripRef}</div>\n1178:         <div class=\"text-xs text-slate-600\">The most recent dispatch confirmation was safely reversed.</div>\n1179:       </div>\n1180:     </div>\n1181: \n1182:     <div class=\"modal-stat-grid\">\n1183:       <div class=\"modal-stat-box\">\n1184:         <span class=\"stat-label\">RESTORED DRIVER</span>\n1185:         <span class=\"stat-val text-slate-900\">${driver ? driver.name : `ID #${action.driverId}`}</span>\n1186:       </div>\n1187:       <div class=\"modal-stat-box\">\n1188:         <span class=\"stat-label\">UPDATED SEAT CAPACITY</span>\n1189:         <span class=\"stat-val text-emerald\">${driver ? `${driver.seats}/${driver.originalSeats} Seats` : 'Restored'}</span>\n1190:       </div>\n1191:     </div>\n1192: \n1193:     <div class=\"text-xs text-slate-600\">\n1194:       Commuter <b>${action.passenger.name}</b> has been returned to the front of the dispatch queue without losing priority.\n1195:     </div>\n1196:   `;\n1197: \n1198:   modal.classList.remove('hidden');\n1199: }\n1200: \n1201: // Global Toast System\n1202: function showPlatformToast(message, type = 'emerald') {\n1203:   const container = document.getElementById('toast-container');\n1204:   const toast = document.createElement('div');\n1205:   toast.className = `toast toast-${type}`;\n1206:   toast.innerHTML = `<i class=\"fa-solid fa-circle-check text-emerald\"></i><span>${message}</span>`;\n1207:   container.appendChild(toast);\n1208: \n1209:   setTimeout(() => {\n1210:     toast.style.opacity = '0';\n1211:     toast.style.transform = 'translateY(15px)';\n1212:     setTimeout(() => toast.remove(), 300);\n1213:   }, 3600);\n1214: }\n1215: \n1216: // Global trip completion hook\n1217: window.handleCompleteTrip = function(tripRef) {\n1218:   const removed = engine.cancelActiveTrip(tripRef);\n1219:   if (removed) {\n1220:     showPlatformToast(`Trip ${tripRef} successfully completed. Corridors updated.`, 'blue');\n1221:     refreshPlatformUI();\n1222:   }\n1223: };\n1224: \n1225: // Global Eco-Receipt viewer hook\n1226: window.viewEcoReceipt = function(tripRef) {\n1227:   const trip = engine.activeTrips.find(t => t.tripRef === tripRef);\n1228:   if (!trip) return;\n1229: \n1230:   const modal = document.getElementById('receipt-modal-overlay');\n1231:   const content = document.getElementById('receipt-content-area');\n1232: \n1233:   content.innerHTML = `\n1234:     <div class=\"receipt-item-row\">\n1235:       <span>Booking Reference:</span>\n1236:       <span class=\"font-mono font-bold text-slate-800\">${trip.tripRef}</span>\n1237:     </div>\n1238:     <div class=\"receipt-item-row\">\n1239:       <span>Commuter Name:</span>\n1240:       <span class=\"font-semibold text-slate-800\">${trip.passenger.name}</span>\n1241:     </div>\n1242:     <div class=\"receipt-item-row\">\n1243:       <span>Driver Partner:</span>\n1244:       <span class=\"text-slate-800\">${trip.driverName} (ID: #${trip.driverId})</span>\n1245:     </div>\n1246:     <div class=\"receipt-item-row\">\n1247:       <span>Corridor Route:</span>\n1248:       <span class=\"text-electric font-semibold\">${trip.corridorPath.join(' &rarr; ')}</span>\n1249:     </div>\n1250:     <div class=\"receipt-item-row\">\n1251:       <span>Distance & Time:</span>\n1252:       <span class=\"text-slate-800\">${trip.distance} km &bull; ~${trip.time} mins</span>\n1253:     </div>\n1254:     <div class=\"receipt-item-row\">\n1255:       <span>Net Carbon Avoided:</span>\n1256:       <span class=\"text-emerald font-bold font-mono\">+${trip.co2Saved} kg CO₂</span>\n1257:     </div>\n1258:     <div class=\"receipt-item-row\">\n1259:       <span>Corridor Alignment Match:</span>\n1260:       <span class=\"text-emerald font-bold\">${trip.matchScore}% Eco-Pooled Match</span>\n1261:     </div>\n1262:     <div class=\"receipt-item-row bold-row\">\n1263:       <span>Total Pooled Fare Paid:</span>\n1264:       <span class=\"text-slate-900\">$${trip.fare} USD</span>\n1265:     </div>\n1266:   `;\n1267: \n1268:   modal.classList.remove('hidden');\n1269: };\n1270: \n1271: // ==========================================\n1272: // 9. INITIALIZATION & EVENT LISTENERS\n1273: // ==========================================\n1274: document.addEventListener('DOMContentLoaded', () => {\n1275:   urbanCanvasInstance = new Urban3DCanvas('urban-3d-canvas');\n1276:   ambientCanvasInstance = new AmbientEcoCanvas('ambient-canvas');\n1277:   initTabNavigation();\n1278: \n1279:   // Populate Select Boxes\n1280:   const originSel = document.getElementById('route-origin');\n1281:   const destSel = document.getElementById('route-destination');\n1282:   const passPickup = document.getElementById('passenger-pickup-select');\n1283:   const passDrop = document.getElementById('passenger-drop-select');\n1284:   const driverStation = document.getElementById('driver-station-select');\n1285: \n1286:   TRANSIT_STATIONS.forEach(s => {\n1287:     const opt = `<option value=\"${s.id}\">${s.name} (${s.zone})</option>`;\n1288:     originSel.insertAdjacentHTML('beforeend', opt);\n1289:     destSel.insertAdjacentHTML('beforeend', opt);\n1290:     passPickup.insertAdjacentHTML('beforeend', opt);\n1291:     passDrop.insertAdjacentHTML('beforeend', opt);\n1292:     driverStation.insertAdjacentHTML('beforeend', opt);\n1293:   });\n1294: \n1295:   originSel.value = 'ALPHA';\n1296:   destSel.value = 'HORIZON';\n1297:   passPickup.value = 'ALPHA';\n1298:   passDrop.value = 'HORIZON';\n1299:   driverStation.value = 'METRO';\n1300: \n1301:   // --- Dynamic Commuter Slider Handler ---\n1302:   const commuterSlider = document.getElementById('commuter-range-slider');\n1303:   const sliderFareDisplay = document.getElementById('slider-fare-display');\n1304:   const sliderTicks = document.querySelectorAll('.slider-ticks .tick');\n1305: \n1306:   function updateCommuterSliderMetrics() {\n1307:     const val = parseInt(commuterSlider.value, 10);\n1308:     engine.commuterDensity = val;\n1309: \n1310:     sliderTicks.forEach((tick, idx) => {\n1311:       tick.classList.toggle('active-tick', idx + 1 === val);\n1312:     });\n1313: \n1314:     computeAndDisplayRoute();\n1315:   }\n1316: \n1317:   commuterSlider.addEventListener('input', updateCommuterSliderMetrics);\n1318: \n1319:   // --- Interactive 4-Seat Vehicle Selector ---\n1320:   const seatButtons = [\n1321:     document.getElementById('seat-front-pass'),\n1322:     document.getElementById('seat-rear-left'),\n1323:     document.getElementById('seat-rear-right')\n1324:   ];\n1325:   const driverSeatsCountLabel = document.getElementById('driver-seats-count-label');\n1326: \n1327:   function getActiveSeatsCount() {\n1328:     let count = 0;\n1329:     seatButtons.forEach(btn => {\n1330:       if (btn.classList.contains('active-seat')) count++;\n1331:     });\n1332:     return count;\n1333:   }\n1334: \n1335:   seatButtons.forEach(btn => {\n1336:     btn.addEventListener('click', () => {\n1337:       if (btn.classList.contains('active-seat')) {\n1338:         btn.classList.remove('active-seat');\n1339:         btn.classList.add('reserved-seat');\n1340:         btn.innerHTML = `<i class=\"fa-solid fa-ban\"></i><span>OFF</span>`;\n1341:       } else {\n1342:         btn.classList.remove('reserved-seat');\n1343:         btn.classList.add('active-seat');\n1344:         btn.innerHTML = `<i class=\"fa-solid fa-user-check\"></i><span>${btn.dataset.seat.toUpperCase()}</span>`;\n1345:       }\n1346:       const count = getActiveSeatsCount();\n1347:       driverSeatsCountLabel.textContent = count;\n1348:       showPlatformToast(`Car configuration: ${count} passenger seats available.`, 'emerald');\n1349:     });\n1350:   });\n1351: \n1352:   // --- Calculate Route Button ---\n1353:   function computeAndDisplayRoute() {\n1354:     const orig = originSel.value;\n1355:     const dest = destSel.value;\n1356: \n1357:     if (orig === dest) {\n1358:       showPlatformToast('Origin and Destination stations cannot be identical.', 'rose');\n1359:       return;\n1360:     }\n1361: \n1362:     const res = engine.findOptimalEcoRoute(orig, dest);\n1363:     urbanCanvasInstance.setActivePath(res.path);\n1364: \n1365:     document.getElementById('strip-path').textContent = res.path.join(' → ');\n1366:     document.getElementById('strip-distance').textContent = `${res.totalDist} km`;\n1367:     document.getElementById('strip-time').textContent = `~${res.estTime} min`;\n1368:     document.getElementById('strip-co2').textContent = `-${res.co2Offset} kg`;\n1369:     document.getElementById('strip-vehicles-saved').textContent = `${res.soloCarsSaved} ${res.soloCarsSaved === 1 ? 'Car' : 'Cars'}`;\n1370:     sliderFareDisplay.textContent = `$${res.fare}`;\n1371: \n1372:     showPlatformToast(`Optimal eco-route: ${res.totalDist} km, saving ${res.co2Offset} kg CO₂.`, 'emerald');\n1373:   }\n1374: \n1375:   document.getElementById('btn-calc-route').addEventListener('click', computeAndDisplayRoute);\n1376: \n1377:   document.getElementById('btn-simulate-drive').addEventListener('click', () => {\n1378:     urbanCanvasInstance.startCarSimulation();\n1379:     showPlatformToast('Simulating top-down electric transit drive along route corridors!', 'blue');\n1380:   });\n1381: \n1382:   document.getElementById('btn-swap-route').addEventListener('click', () => {\n1383:     const temp = originSel.value;\n1384:     originSel.value = destSel.value;\n1385:     destSel.value = temp;\n1386:     computeAndDisplayRoute();\n1387:   });\n1388: \n1389:   document.getElementById('btn-reset-view').addEventListener('click', () => {\n1390:     urbanCanvasInstance.resetCamera();\n1391:   });\n1392: \n1393:   // --- Passenger Request ---\n1394:   document.getElementById('btn-request-ride').addEventListener('click', () => {\n1395:     const nameInput = document.getElementById('passenger-name-input');\n1396:     const name = nameInput.value.trim() || `Commuter_${Math.floor(Math.random() * 900 + 100)}`;\n1397:     const pickup = passPickup.value;\n1398:     const drop = passDrop.value;\n1399: \n1400:     if (pickup === drop) {\n1401:       showPlatformToast('Pickup and drop-off stations must be distinct.', 'rose');\n1402:       return;\n1403:     }\n1404: \n1405:     const passenger = engine.submitRideRequest(name, pickup, drop);\n1406:     nameInput.value = '';\n1407:     refreshPlatformUI();\n1408:     showPlatformToast(`Ride request submitted for ${passenger.name} (${pickup} → ${drop}).`, 'emerald');\n1409:   });\n1410: \n1411:   document.getElementById('btn-cancel-front-req').addEventListener('click', () => {\n1412:     const dequeued = engine.dequeueNextRequest();\n1413:     if (dequeued) {\n1414:       refreshPlatformUI();\n1415:       showPlatformToast(`Dispatched or cancelled request for ${dequeued.name} (${dequeued.id}).`, 'amber');\n1416:     } else {\n1417:       showPlatformToast('No pending passenger requests in the pipeline.', 'rose');\n1418:     }\n1419:   });\n1420: \n1421:   // --- Priority Standby Lounge ---\n1422:   document.getElementById('btn-push-standby').addEventListener('click', () => {\n1423:     let candidate = engine.dequeueNextRequest();\n1424:     if (!candidate) {\n1425:       candidate = {\n1426:         id: `BK-STDBY-${Math.floor(Math.random() * 800 + 100)}`,\n1427:         name: `Standby_Passenger_${Math.floor(Math.random() * 90 + 10)}`,\n1428:         pickup: 'METRO',\n1429:         drop: 'SKYPORT',\n1430:         requestedAt: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),\n1431:         status: 'In Priority Standby'\n1432:       };\n1433:     }\n1434: \n1435:     const res = engine.pushToStandby(candidate);\n1436:     if (!res.success) {\n1437:       showPlatformToast(res.message, 'rose');\n1438:       engine.dispatchStream.unshift(candidate);\n1439:     } else {\n1440:       showPlatformToast(`${candidate.name} admitted to Priority Standby Lounge.`, 'amber');\n1441:     }\n1442:     refreshPlatformUI();\n1443:   });\n1444: \n1445:   document.getElementById('btn-pop-standby').addEventListener('click', () => {\n1446:     const res = engine.popFromStandby();\n1447:     if (!res.success) {\n1448:       showPlatformToast(res.message, 'rose');\n1449:     } else {\n1450:       showPlatformToast(`Seated ${res.item.name} from Priority Standby Lounge.`, 'amber');\n1451:     }\n1452:     refreshPlatformUI();\n1453:   });\n1454: \n1455:   // --- Driver Partner Registration with Visual Seat Selector ---\n1456:   document.getElementById('btn-register-driver').addEventListener('click', () => {\n1457:     const nameInput = document.getElementById('driver-name-input');\n1458:     const name = nameInput.value.trim() || `Partner_${Math.floor(Math.random() * 900 + 100)}`;\n1459:     const station = driverStation.value;\n1460:     const seats = getActiveSeatsCount();\n1461: \n1462:     if (seats === 0) {\n1463:       showPlatformToast('Please toggle at least 1 passenger seat in the vehicle blueprint.', 'rose');\n1464:       return;\n1465:     }\n1466: \n1467:     const partner = engine.onboardDriver(name, station, seats);\n1468:     nameInput.value = '';\n1469:     refreshPlatformUI();\n1470:     showPlatformToast(`Driver Partner ${partner.name} onboarded with ${partner.seats} passenger seats (ID: #${partner.id}).`, 'emerald');\n1471:   });\n1472: \n1473:   // --- Flexible Verification & Lookup ---\n1474:   document.getElementById('btn-verify-id').addEventListener('click', () => {\n1475:     const idInput = document.getElementById('verify-id-input');\n1476:     const resultBox = document.getElementById('verification-result-box');\n1477:     const query = idInput.value.trim();\n1478: \n1479:     if (!query) {\n1480:       resultBox.innerHTML = '<span class=\"text-rose-500 text-xs\">Please enter a valid Driver Partner ID or Booking Reference.</span>';\n1481:       return;\n1482:     }\n1483: \n1484:     const partner = engine.getDriverById(query);\n1485:     if (partner) {\n1486:       resultBox.innerHTML = `\n1487:         <div class=\"flex items-center justify-between w-full text-xs\">\n1488:           <div>\n1489:             <span class=\"text-emerald font-bold\"><i class=\"fa-solid fa-circle-check\"></i> Verified Partner:</span>\n1490:             <span class=\"text-slate-900 font-semibold ml-1\">${partner.name} (ID: #${partner.id})</span>\n1491:             <span class=\"text-slate-500 ml-2\">&bull; ${partner.station} Station</span>\n1492:           </div>\n1493:           <span class=\"seat-counter-pill\">${partner.seats} Seats Free</span>\n1494:         </div>`;\n1495:       showPlatformToast(`Verified operational identity for Partner #${partner.id}.`, 'emerald');\n1496:       return;\n1497:     }\n1498: \n1499:     const booking = engine.getBookingByRef(query);\n1500:     if (booking) {\n1501:       resultBox.innerHTML = `\n1502:         <div class=\"flex items-center justify-between w-full text-xs\">\n1503:           <div>\n1504:             <span class=\"text-electric font-bold\"><i class=\"fa-solid fa-ticket\"></i> Verified Booking:</span>\n1505:             <span class=\"text-slate-900 font-semibold ml-1\">${booking.tripRef} (${booking.passenger.name})</span>\n1506:             <span class=\"text-slate-500 ml-2\">&bull; Driver: ${booking.driverName}</span>\n1507:           </div>\n1508:           <span class=\"route-match-badge\">${booking.matchScore}% Match</span>\n1509:         </div>`;\n1510:       showPlatformToast(`Verified booking reference ${booking.tripRef}.`, 'blue');\n1511:       return;\n1512:     }\n1513: \n1514:     resultBox.innerHTML = `<span class=\"text-rose-500 text-xs\"><i class=\"fa-solid fa-triangle-exclamation\"></i> Reference \"${query}\" not found in metropolitan fleet or booking registry.</span>`;\n1515:     showPlatformToast(`Reference \"${query}\" not recognized.`, 'rose');\n1516:   });\n1517: \n1518:   // --- Match & Dispatch Shared Trip (Triggering Enterprise Confirmation Modal) ---\n1519:   document.getElementById('btn-auto-match-trip').addEventListener('click', () => {\n1520:     let passenger = engine.dequeueNextRequest();\n1521:     if (!passenger && engine.standbyCount > 0) {\n1522:       passenger = engine.popFromStandby().item;\n1523:     }\n1524: \n1525:     if (!passenger) {\n1526:       showPlatformToast('No pending commuter requests waiting to be dispatched.', 'rose');\n1527:       return;\n1528:     }\n1529: \n1530:     let matchedPartner = null;\n1531:     for (const partner of engine.fleetPartners) {\n1532:       if (partner.seats > 0) {\n1533:         matchedPartner = partner;\n1534:         break;\n1535:       }\n1536:     }\n1537: \n1538:     if (!matchedPartner) {\n1539:       engine.dispatchStream.unshift(passenger);\n1540:       showPlatformToast('All driver partners are currently at maximum passenger capacity.', 'rose');\n1541:       return;\n1542:     }\n1543: \n1544:     const route = engine.findOptimalEcoRoute(passenger.pickup, passenger.drop);\n1545:     const matchScore = Math.floor(Math.random() * 14 + 85);\n1546: \n1547:     const trip = engine.dispatchSharedTrip(\n1548:       passenger,\n1549:       matchedPartner,\n1550:       route.path,\n1551:       route.totalDist,\n1552:       route.estTime,\n1553:       route.fare,\n1554:       route.co2Offset,\n1555:       matchScore\n1556:     );\n1557: \n1558:     urbanCanvasInstance.setActivePath(route.path);\n1559:     refreshPlatformUI();\n1560:     openDispatchModal(trip, matchedPartner);\n1561:   });\n1562: \n1563:   // --- Revert Confirmation (Triggering Enterprise Reversal Modal) ---\n1564:   document.getElementById('btn-revert-confirmation').addEventListener('click', () => {\n1565:     const res = engine.revertLatestConfirmation();\n1566:     if (!res.success) {\n1567:       showPlatformToast(res.message, 'rose');\n1568:     } else {\n1569:       refreshPlatformUI();\n1570:       openReversalModal(res.action, res.driver);\n1571:     }\n1572:   });\n1573: \n1574:   // --- Rush-Hour Simulation Scenario ---\n1575:   document.getElementById('btn-demo-rushhour').addEventListener('click', () => {\n1576:     engine.onboardDriver('Marcus Vance', 'ALPHA', 3);\n1577:     engine.onboardDriver('Elena Rostova', 'METRO', 3);\n1578:     engine.onboardDriver('Kaelen Chen', 'SKYPORT', 2);\n1579:     engine.onboardDriver('Siddharth Rao', 'QUANTUM', 3);\n1580: \n1581:     engine.submitRideRequest('Dr. Aris Thorne', 'ALPHA', 'HORIZON');\n1582:     engine.submitRideRequest('Maya Lin', 'METRO', 'SKYPORT');\n1583:     engine.submitRideRequest('Amara Okafor', 'HARBOR', 'QUANTUM');\n1584: \n1585:     engine.pushToStandby({\n1586:       id: '