-layout {\n  max-width: 1720px;\n  margin: 0 auto;\n  padding: 1.25rem 1.75rem 3rem;\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n.glass-panel {\n  background: var(--navy-surface);\n  backdrop-filter: blur(14px);\n  -webkit-backdrop-filter: blur(14px);\n  border: 1px solid var(--navy-border);\n  border-radius: 14px;\n  box-shadow: 0 12px 32px -8px rgba(0, 0, 0, 0.65), 0 0 1px 1px rgba(255, 255, 255, 0.04) inset;\n  transition: border-color 0.28s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.28s cubic-bezier(0.16, 1, 0.3, 1), transform 0.15s ease-out;\n  position: relative;\n}\n\n/* 3D Anti-Gravity Tilt Physics Effect */\n.tilt-element {\n  transform-style: preserve-3d;\n  will-change: transform;\n}\n\n.tilt-element:hover {\n  border-color: var(--navy-border-hover);\n  box-shadow: 0 20px 45px -10px rgba(32, 201, 176, 0.14), 0 0 25px rgba(52, 120, 246, 0.1);\n}\n\n/* --------------------------------------------------------------------------\n   Top Navigation\n   -------------------------------------------------------------------------- */\n.top-nav {\n  padding: 0.85rem 1.75rem;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1.5rem;\n  flex-wrap: wrap;\n}\n\n.nav-left {\n  display: flex;\n  align-items: center;\n  gap: 2.25rem;\n}\n\n.brand-logo {\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n  text-decoration: none;\n}\n\n.brand-icon {\n  width: 40px;\n  height: 40px;\n  border-radius: 10px;\n  background: linear-gradient(135deg, rgba(32, 201, 176, 0.25), rgba(52, 120, 246, 0.2));\n  border: 1px solid var(--mint);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.25rem;\n  box-shadow: 0 0 15px var(--mint-glow);\n}\n\n.brand-name {\n  font-size: 1.25rem;\n  font-weight: 800;\n  letter-spacing: -0.02em;\n  color: #FFFFFF;\n}\n\n.brand-tagline {\n  font-size: 0.62rem;\n  font-family: var(--font-mono);\n  letter-spacing: 0.12em;\n  color: var(--slate-400);\n}\n\n.nav-links {\n  display: flex;\n  align-items: center;\n  gap: 1.25rem;\n}\n\n.nav-link {\n  color: var(--slate-300);\n  text-decoration: none;\n  font-size: 0.85rem;\n  font-weight: 500;\n  display: flex;\n  align-items: center;\n  gap: 0.45rem;\n  padding: 0.4rem 0.65rem;\n  border-radius: 8px;\n  transition: all 0.2s ease;\n}\n\n.nav-link:hover, .nav-link.active {\n  color: #FFFFFF;\n  background: rgba(255, 255, 255, 0.06);\n}\n\n.nav-actions {\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n}\n\n/* --------------------------------------------------------------------------\n   Buttons & Form Controls\n   -------------------------------------------------------------------------- */\n.btn {\n  font-family: var(--font-sans);\n  font-size: 0.825rem;\n  font-weight: 600;\n  padding: 0.55rem 1.05rem;\n  border-radius: 9px;\n  border: 1px solid transparent;\n  cursor: pointer;\n  display: inline-flex;\n  align-items: center;\n  gap: 0.5rem;\n  transition: all 0.22s cubic-bezier(0.16, 1, 0.3, 1);\n  white-space: nowrap;\n}\n\n.btn-primary {\n  background: linear-gradient(135deg, #3478F6, #2055C4);\n  color: #FFFFFF;\n  box-shadow: 0 4px 14px rgba(52, 120, 246, 0.35);\n}\n.btn-primary:hover {\n  background: linear-gradient(135deg, #4A8BF9, #3478F6);\n  box-shadow: 0 6px 20px rgba(52, 120, 246, 0.5);\n  transform: translateY(-2px);\n}\n\n.btn-mint {\n  background: rgba(32, 201, 176, 0.14);\n  border-color: var(--mint);\n  color: var(--mint);\n  box-shadow: 0 0 12px rgba(32, 201, 176, 0.2);\n}\n.btn-mint:hover {\n  background: var(--mint);\n  color: #0B172A;\n  box-shadow: 0 0 22px var(--mint-glow);\n  transform: translateY(-2px);\n}\n\n.btn-amber {\n  background: rgba(245, 158, 11, 0.15);\n  border-color: var(--amber);\n  color: var(--amber);\n}\n.btn-amber:hover {\n  background: var(--amber);\n  color: #0B172A;\n  transform: translateY(-2px);\n}\n\n.btn-rose {\n  background: rgba(244, 63, 94, 0.15);\n  border-color: var(--rose);\n  color: #FDA4AF;\n}\n.btn-rose:hover {\n  background: var(--rose);\n  color: #FFFFFF;\n  box-shadow: 0 0 20px var(--rose-glow);\n  transform: translateY(-2px);\n}\n\n.btn-outline {\n  background: rgba(255, 255, 255, 0.04);\n  border: 1px solid rgba(255, 255, 255, 0.14);\n  color: var(--slate-200);\n}\n.btn-outline:hover {\n  background: rgba(255, 255, 255, 0.09);\n  border-color: rgba(255, 255, 255, 0.3);\n  transform: translateY(-2px);\n}\n\n.btn-ghost {\n  background: transparent;\n  color: var(--slate-400);\n}\n.btn-ghost:hover {\n  background: rgba(255, 255, 255, 0.06);\n  color: #FFFFFF;\n}\n\n.btn-sm {\n  padding: 0.35rem 0.65rem;\n  font-size: 0.74rem;\n}\n\n.text-input, .select-field {\n  background: rgba(11, 23, 42, 0.85);\n  border: 1px solid rgba(52, 120, 246, 0.25);\n  border-radius: 8px;\n  color: #FFFFFF;\n  padding: 0.55rem 0.8rem;\n  font-size: 0.825rem;\n  font-family: var(--font-sans);\n  outline: none;\n  transition: all 0.2s ease;\n  width: 100%;\n}\n\n.text-input:focus, .select-field:focus {\n  border-color: var(--mint);\n  box-shadow: 0 0 12px var(--mint-glow);\n}\n\n.text-input::placeholder {\n  color: var(--slate-500);\n}\n\n.input-with-icon {\n  position: relative;\n  display: flex;\n  align-items: center;\n}\n\n.input-with-icon i {\n  position: absolute;\n  left: 0.8rem;\n  color: var(--slate-400);\n  font-size: 0.85rem;\n  pointer-events: none;\n}\n\n.input-with-icon input {\n  padding-left: 2.2rem;\n}\n\n/* --------------------------------------------------------------------------\n   Executive Summary / KPI Banner\n   -------------------------------------------------------------------------- */\n.kpi-banner {\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 1rem;\n}\n\n@media (max-width: 1300px) {\n  .kpi-banner {\n    grid-template-columns: repeat(3, 1fr);\n  }\n}\n@media (max-width: 800px) {\n  .kpi-banner {\n    grid-template-columns: 1fr;\n  }\n}\n\n.kpi-card {\n  background: var(--navy-surface);\n  border: 1px solid var(--navy-border);\n  border-radius: 12px;\n  padding: 1rem 1.25rem;\n  display: flex;\n  align-items: center;\n  gap: 1rem;\n  box-shadow: 0 6px 20px -5px rgba(0, 0, 0, 0.5);\n}\n\n.kpi-icon-wrap {\n  width: 44px;\n  height: 44px;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 1.25rem;\n  flex-shrink: 0;\n}\n\n.bg-mint-glow { background: rgba(32, 201, 176, 0.15); border: 1px solid rgba(32, 201, 176, 0.3); }\n.bg-blue-glow { background: rgba(52, 120, 246, 0.15); border: 1px solid rgba(52, 120, 246, 0.3); }\n.bg-purple-glow { background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); }\n.bg-amber-glow { background: rgba(245, 158, 11, 0.15); border: 1px solid rgba(245, 158, 11, 0.3); }\n.bg-emerald-glow { background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); }\n\n.kpi-label {\n  font-size: 0.66rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  color: var(--slate-400);\n  font-family: var(--font-mono);\n}\n\n.kpi-value {\n  font-size: 1.45rem;\n  font-weight: 800;\n  line-height: 1.2;\n}\n\n.kpi-unit {\n  font-size: 0.85rem;\n  font-weight: 500;\n  color: var(--slate-300);\n}\n\n.kpi-sub {\n  font-size: 0.72rem;\n  color: var(--slate-400);\n}\n\n/* --------------------------------------------------------------------------\n   Dashboard Grid\n   -------------------------------------------------------------------------- */\n.dashboard-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 1.25rem;\n}\n\n@media (max-width: 1250px) {\n  .dashboard-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.grid-column {\n  display: flex;\n  flex-direction: column;\n  gap: 1.25rem;\n}\n\n.content-panel {\n  display: flex;\n  flex-direction: column;\n  overflow: hidden;\n}\n\n.panel-header {\n  padding: 1.1rem 1.5rem 0.9rem;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  gap: 1rem;\n}\n\n.header-title {\n  display: flex;\n  align-items: center;\n  gap: 0.85rem;\n}\n\n.header-title i {\n  font-size: 1.25rem;\n}\n\n.header-title h2 {\n  font-size: 1rem;\n  font-weight: 700;\n  color: #FFFFFF;\n}\n\n.header-title p {\n  font-size: 0.75rem;\n  color: var(--slate-400);\n}\n\n.status-badge {\n  font-size: 0.72rem;\n  font-weight: 600;\n  padding: 0.3rem 0.75rem;\n  border-radius: 9999px;\n  background: rgba(52, 120, 246, 0.1);\n  border: 1px solid rgba(52, 120, 246, 0.25);\n  color: var(--electric);\n  white-space: nowrap;\n}\n\n.live-badge {\n  background: rgba(32, 201, 176, 0.1);\n  border-color: rgba(32, 201, 176, 0.3);\n  color: var(--mint);\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.live-pulse {\n  width: 6px;\n  height: 6px;\n  border-radius: 50%;\n  background: var(--mint);\n  box-shadow: 0 0 8px var(--mint);\n  animation: pulse 1.8s infinite;\n}\n\n.purple-badge {\n  background: rgba(168, 85, 247, 0.1);\n  border-color: rgba(168, 85, 247, 0.3);\n  color: #D8B4FE;\n}\n\n/* --------------------------------------------------------------------------\n   Module 1: 3D Urban Map & Route Finder\n   -------------------------------------------------------------------------- */\n.route-query-bar {\n  padding: 0.85rem 1.5rem;\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  flex-wrap: wrap;\n  background: rgba(11, 23, 42, 0.4);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n.form-control-inline {\n  display: flex;\n  align-items: center;\n  gap: 0.5rem;\n  font-size: 0.78rem;\n  color: var(--slate-300);\n}\n\n.route-swap-btn {\n  width: 34px;\n  height: 34px;\n  border-radius: 8px;\n  background: rgba(255, 255, 255, 0.05);\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  cursor: pointer;\n  color: var(--slate-300);\n  transition: all 0.2s ease;\n}\n.route-swap-btn:hover {\n  background: rgba(52, 120, 246, 0.2);\n  color: #FFFFFF;\n}\n\n.map-canvas-container {\n  position: relative;\n  width: 100%;\n  height: 370px;\n  overflow: hidden;\n  background: radial-gradient(circle at 50% 50%, rgba(15, 30, 55, 0.85), rgba(8, 16, 30, 0.98));\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  cursor: grab;\n}\n.map-canvas-container:active {\n  cursor: grabbing;\n}\n\n#urban-3d-canvas {\n  width: 100%;\n  height: 100%;\n  display: block;\n}\n\n.map-hud-overlay {\n  position: absolute;\n  bottom: 0.85rem;\n  left: 1.25rem;\n  background: rgba(11, 23, 42, 0.88);\n  border: 1px solid rgba(255, 255, 255, 0.1);\n  border-radius: 6px;\n  padding: 0.35rem 0.75rem;\n  font-size: 0.72rem;\n  color: var(--slate-300);\n  pointer-events: none;\n}\n\n.compass-rose {\n  position: absolute;\n  top: 1rem;\n  right: 1.25rem;\n  pointer-events: none;\n}\n.compass-inner {\n  width: 38px;\n  height: 38px;\n  border-radius: 50%;\n  border: 1px dashed rgba(52, 120, 246, 0.45);\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-family: var(--font-mono);\n  font-size: 0.65rem;\n  color: var(--mint);\n}\n.compass-n { position: absolute; top: 2px; }\n.compass-e { position: absolute; right: 4px; }\n\n.trip-impact-strip {\n  padding: 0.85rem 1.5rem;\n  display: grid;\n  grid-template-columns: repeat(5, 1fr);\n  gap: 0.75rem;\n  background: rgba(11, 23, 42, 0.5);\n}\n\n@media (max-width: 900px) {\n  .trip-impact-strip {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n.impact-metric {\n  display: flex;\n  flex-direction: column;\n}\n.impact-metric .label {\n  font-size: 0.62rem;\n  font-family: var(--font-mono);\n  color: var(--slate-400);\n  letter-spacing: 0.04em;\n}\n.impact-metric .value {\n  font-size: 0.9rem;\n  font-weight: 700;\n  margin-top: 0.15rem;\n}\n\n/* --------------------------------------------------------------------------\n   Module 2: Passenger Dispatch Hub & Standby Lounge\n   -------------------------------------------------------------------------- */\n.action-bar-row {\n  padding: 0.85rem 1.5rem;\n  display: flex;\n  gap: 0.65rem;\n  align-items: center;\n  background: rgba(11, 23, 42, 0.35);\n  border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n  flex-wrap: wrap;\n}\n\n.column-subtitle {\n  font-size: 0.76rem;\n  font-weight: 600;\n  color: var(--slate-200);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 0.65rem;\n}\n\n.sub-pill {\n  font-family: var(--font-mono);\n  font-size: 0.65rem;\n  color: var(--slate-400);\n}\n\n.dispatch-layout {\n  padding: 1.1rem 1.5rem;\n  display: grid;\n  grid-template-columns: 1.35fr 1fr;\n  gap: 1.25rem;\n}\n\n@media (max-width: 950px) {\n  .dispatch-layout {\n    grid-template-columns: 1fr;\n  }\n}\n\n.conveyor-pipeline {\n  display: flex;\n  gap: 0.65rem;\n  overflow-x: auto;\n  padding: 0.75rem 0.5rem;\n  background: rgba(11, 23, 42, 0.6);\n  border-radius: 12px;\n  border: 1px solid rgba(255, 255, 255, 0.05);\n  min-height: 110px;\n  align-items: center;\n}\n\n.commuter-token {\n  min-width: 140px;\n  padding: 0.65rem 0.85rem;\n  border-radius: 10px;\n  background: linear-gradient(135deg, rgba(15, 23, 42, 0.95), rgba(25, 38, 65, 0.85));\n  border: 1px solid rgba(52, 120, 246, 0.3);\n  position: relative;\n  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.35);\n  animation: slideRight 0.3s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.commuter-token.head-token {\n  border-color: var(--mint);\n  box-shadow: 0 0 16px var(--mint-glow);\n}\n\n.commuter-token .token-badge {\n  position: absolute;\n  top: -8px;\n  right: -6px;\n  font-size: 0.58rem;\n  padding: 0.15rem 0.45rem;\n  border-radius: 9999px;\n  background: var(--mint);\n  color: #0B172A;\n  font-weight: 800;\n  font-family: var(--font-mono);\n}\n\n.commuter-token .token-name {\n  font-size: 0.8rem;\n  font-weight: 700;\n  color: #FFFFFF;\n}\n\n.commuter-token .token-route {\n  font-size: 0.7rem;\n  color: var(--electric);\n  margin-top: 0.2rem;\n  font-weight: 500;\n}\n\n.commuter-token .token-meta {\n  font-size: 0.62rem;\n  color: var(--slate-400);\n  font-family: var(--font-mono);\n  margin-top: 0.25rem;\n}\n\n/* Standby Lounge (Circular Hub) */\n.standby-hub-container {\n  position: relative;\n  width: 210px;\n  height: 210px;\n  margin: 0.4rem auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.standby-ring {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  border-radius: 50%;\n  border: 2px dashed rgba(245, 158, 11, 0.3);\n}\n\n.standby-slot {\n  position: absolute;\n  width: 46px;\n  height: 46px;\n  margin-left: -23px;\n  margin-top: -23px;\n  border-radius: 50%;\n  background: rgba(11, 23, 42, 0.9);\n  border: 1.5px solid rgba(255, 255, 255, 0.15);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  font-size: 0.65rem;\n  color: var(--slate-400);\n  transition: all 0.3s ease;\n}\n\n.standby-slot.occupied {\n  border-color: var(--amber);\n  background: rgba(245, 158, 11, 0.2);\n  color: #FFFFFF;\n  box-shadow: 0 0 15px var(--amber-glow);\n}\n\n.standby-slot.is-active-pointer {\n  outline: 2px solid var(--mint);\n  outline-offset: 3px;\n}\n\n.standby-center-badge {\n  position: absolute;\n  width: 86px;\n  height: 86px;\n  border-radius: 50%;\n  background: radial-gradient(circle, rgba(25, 38, 65, 0.95), rgba(11, 23, 42, 0.98));\n  border: 1px solid rgba(245, 158, 11, 0.4);\n  box-shadow: 0 0 18px rgba(0, 0, 0, 0.65);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  pointer-events: none;\n}\n\n.standby-actions {\n  display: flex;\n  justify-content: center;\n  gap: 0.5rem;\n  margin-top: 0.5rem;\n}\n\n/* --------------------------------------------------------------------------\n   Module 3: Driver Partner Fleet & Verification\n   -------------------------------------------------------------------------- */\n.fleet-directory-wrapper, .verification-wrapper {\n  padding: 0.9rem 1.5rem;\n}\n\n.fleet-stream {\n  display: flex;\n  align-items: center;\n  gap: 0.65rem;\n  overflow-x: auto;\n  padding: 0.5rem 0.25rem;\n  min-height: 85px;\n}\n\n.driver-partner-card {\n  min-width: 145px;\n  background: rgba(15, 23, 42, 0.85);\n  border: 1px solid rgba(32, 201, 176, 0.3);\n  border-radius: 10px;\n  padding: 0.6rem 0.85rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.25rem;\n  transition: all 0.25s ease;\n}\n\n.driver-partner-card:hover {\n  border-color: var(--mint);\n  box-shadow: 0 0 16px var(--mint-glow);\n  transform: translateY(-2px);\n}\n\n.driver-partner-card .card-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.driver-id-badge {\n  font-family: var(--font-mono);\n  font-size: 0.68rem;\n  color: var(--mint);\n  font-weight: 600;\n}\n\n.seat-counter-pill {\n  font-size: 0.65rem;\n  font-family: var(--font-mono);\n  background: rgba(32, 201, 176, 0.15);\n  padding: 0.15rem 0.45rem;\n  border-radius: 6px;\n  color: var(--mint);\n  font-weight: 700;\n}\n\n.driver-partner-card .driver-name {\n  font-size: 0.82rem;\n  font-weight: 700;\n  color: #FFFFFF;\n}\n\n.driver-partner-card .driver-corridor {\n  font-size: 0.7rem;\n  color: var(--slate-300);\n}\n\n.fleet-pointer {\n  color: var(--slate-500);\n  font-size: 0.85rem;\n}\n\n.search-bar-row {\n  display: flex;\n  gap: 0.5rem;\n  align-items: center;\n}\n\n.verification-result-box {\n  margin-top: 0.6rem;\n  padding: 0.65rem 0.85rem;\n  background: rgba(11, 23, 42, 0.7);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 8px;\n  min-height: 48px;\n  display: flex;\n  align-items: center;\n}\n\n/* --------------------------------------------------------------------------\n   Module 4: Active Shared Trips Console & Reversal\n   -------------------------------------------------------------------------- */\n.active-trips-stream {\n  padding: 0.9rem 1.5rem;\n  display: flex;\n  gap: 0.65rem;\n  overflow-x: auto;\n  min-height: 95px;\n}\n\n.shared-trip-card {\n  min-width: 170px;\n  background: rgba(15, 23, 42, 0.88);\n  border: 1px solid rgba(168, 85, 247, 0.35);\n  border-radius: 10px;\n  padding: 0.65rem 0.85rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.3rem;\n  position: relative;\n}\n\n.shared-trip-card:hover {\n  border-color: var(--purple);\n  box-shadow: 0 0 16px var(--purple-glow);\n}\n\n.shared-trip-card .trip-ref {\n  font-family: var(--font-mono);\n  font-size: 0.68rem;\n  color: #D8B4FE;\n  font-weight: 700;\n}\n\n.shared-trip-card .btn-cancel-trip {\n  position: absolute;\n  top: 6px;\n  right: 6px;\n  background: transparent;\n  border: none;\n  color: var(--slate-400);\n  cursor: pointer;\n  font-size: 0.75rem;\n}\n.shared-trip-card .btn-cancel-trip:hover {\n  color: var(--rose);\n}\n\n.trip-insights-grid {\n  padding: 0.9rem 1.5rem 1.25rem;\n  display: grid;\n  grid-template-columns: 1.35fr 1fr;\n  gap: 1rem;\n}\n\n@media (max-width: 900px) {\n  .trip-insights-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.insights-box {\n  background: rgba(11, 23, 42, 0.6);\n  border: 1px solid rgba(255, 255, 255, 0.06);\n  border-radius: 12px;\n  padding: 0.85rem;\n}\n\n.canvas-visual-box {\n  width: 100%;\n  height: 180px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: radial-gradient(circle, rgba(15, 23, 42, 0.8), rgba(8, 16, 30, 0.95));\n  border-radius: 8px;\n  overflow: hidden;\n}\n\n.audit-history-list {\n  display: flex;\n  flex-direction: column-reverse;\n  gap: 0.45rem;\n  max-height: 180px;\n  overflow-y: auto;\n  padding: 0.4rem;\n  background: rgba(8, 16, 30, 0.5);\n  border-radius: 8px;\n}\n\n.audit-entry {\n  padding: 0.45rem 0.65rem;\n  border-radius: 6px;\n  background: rgba(52, 120, 246, 0.1);\n  border: 1px solid rgba(52, 120, 246, 0.25);\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.72rem;\n  animation: slideDown 0.25s ease-out;\n}\n\n.audit-entry.latest-entry {\n  border-color: var(--electric);\n  box-shadow: 0 0 10px var(--electric-glow);\n}\n\n/* --------------------------------------------------------------------------\n   Module 5: Sustainability & Carbon Savings Dashboard\n   -------------------------------------------------------------------------- */\n.sustainability-section {\n  padding-bottom: 1.5rem;\n}\n\n.sustainability-grid {\n  padding: 1.25rem 1.5rem;\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 1rem;\n}\n\n@media (max-width: 1100px) {\n  .sustainability-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n@media (max-width: 650px) {\n  .sustainability-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.eco-metric-card {\n  background: rgba(11, 23, 42, 0.65);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 12px;\n  padding: 1.1rem 1.25rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.4rem;\n}\n\n.eco-num {\n  font-size: 1.6rem;\n  font-weight: 800;\n  line-height: 1.1;\n}\n\n.eco-desc {\n  font-size: 0.78rem;\n  color: var(--slate-300);\n  font-weight: 600;\n}\n\n.progress-bar-wrap {\n  width: 100%;\n  height: 6px;\n  border-radius: 9999px;\n  background: rgba(255, 255, 255, 0.1);\n  margin-top: 0.3rem;\n  overflow: hidden;\n}\n\n.progress-bar-fill {\n  height: 100%;\n  border-radius: 9999px;\n  transition: width 0.6s cubic-bezier(0.16, 1, 0.3, 1);\n}\n\n.bg-mint { background: var(--mint); }\n.bg-electric { background: var(--electric); }\n.bg-purple { background: var(--purple); }\n\n.eco-leaderboard-box {\n  background: rgba(11, 23, 42, 0.65);\n  border: 1px solid rgba(255, 255, 255, 0.08);\n  border-radius: 12px;\n  padding: 1rem 1.25rem;\n  display: flex;\n  flex-direction: column;\n}\n\n.leaderboard-title {\n  font-size: 0.8rem;\n  font-weight: 700;\n  color: #FFFFFF;\n  margin-bottom: 0.6rem;\n  display: flex;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.leaderboard-list {\n  display: flex;\n  flex-direction: column;\n  gap: 0.45rem;\n}\n\n.leader-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.72rem;\n  padding: 0.3rem 0;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.05);\n}\n\n/* --------------------------------------------------------------------------\n   Footer & Toasts\n   -------------------------------------------------------------------------- */\n.app-footer {\n  padding: 1.25rem 0.5rem;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  font-size: 0.75rem;\n  color: var(--slate-400);\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n  flex-wrap: wrap;\n  gap: 0.75rem;\n}\n\n.footer-right {\n  display: flex;\n  gap: 1.25rem;\n}\n\n.empty-state {\n  color: var(--slate-400);\n  font-size: 0.78rem;\n  padding: 1rem;\n  text-align: center;\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0.4rem;\n}\n\n.toast-container {\n  position: fixed;\n  bottom: 1.5rem;\n  right: 1.5rem;\n  display: flex;\n  flex-direction: column;\n  gap: 0.5rem;\n  z-index: 9999;\n}\n\n.toast {\n  padding: 0.75rem 1.25rem;\n  border-radius: 10px;\n  background: rgba(11, 23, 42, 0.96);\n  border-left: 4px solid var(--mint);\n  box-shadow: 0 10px 28px rgba(0, 0, 0, 0.65);\n  font-size: 0.8rem;\n  display: flex;\n  align-items: center;\n  gap: 0.75rem;\n  color: #FFFFFF;\n  animation: toastIn 0.3s ease-out;\n}\n.toast.toast-mint { border-left-color: var(--mint); }\n.toast.toast-blue { border-left-color: var(--electric); }\n.toast.toast-rose { border-left-color: var(--rose); }\n.toast.toast-amber { border-left-color: var(--amber); }\n\n@keyframes toastIn {\n  from { opacity: 0; transform: translateY(15px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes slideRight {\n  from { opacity: 0; transform: translateX(20px); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n@keyframes slideDown {\n  from { opacity: 0; transform: translateY(-10px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n\n@keyframes pulse {\n  0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(32, 201, 176, 0.7); }\n  70% { transform: scale(1.1); box-shadow: 0 0 0 6px rgba(32, 201, 176, 0); }\n  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(32, 201, 176, 0); }\n}\n","Description":"Created styles.css with modern dark-mode corporate design system, eco-mint and electric-blue accents, and responsive 3D tilt styles","Overwrite":true,"TargetFile":"C:\\Users\\Kartik Bhosle\\.gemini\\antigravity\\brain\\6976d1a8-fd03-4453-a790-acd552e1861a\\styles.css","toolAction":"Writing file","toolSummary":"Create styles.css for NexusMobility"}}]}
