{"step_index":152,"source":"MODEL","type":"GENERIC","status":"DONE","created_at":"2026-10-20T06:16:10Z","content":"Created At: 2026-10-20T11:46:10+05:30\nCompleted At: 2026-10-20T11:46:10+05:30\nShowing lines 851-1050 of 1652\n851: \n852:   document.getElementById('fleet-count-badge').textContent = `${engine.fleetPartners.length} Active Partners`;\n853:   document.getElementById('active-trips-badge').textContent = `${engine.activeTrips.length} In-Transit`;\n854: }\n855: \n856: // --- Passenger Dispatch Stream with EcoSprout Empty State ---\n857: function renderPassengerDispatchStream() {\n858:   const container = document.getElementById('passenger-conveyor');\n859:   if (!container) return;\n860: \n861:   if (engine.dispatchStream.length === 0) {\n862:     container.innerHTML = `\n863:       <div class=\"ecosprout-container\">\n864:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n865:         <div class=\"ecosprout-bubble\">\n866:           <b>EcoSprout here!</b> The dispatch conveyor is clear. Submit a commuter request above to plan a green trip!\n867:         </div>\n868:       </div>`;\n869:     return;\n870:   }\n871: \n872:   container.innerHTML = engine.dispatchStream.map((pass, idx) => `\n873:     <div class=\"commuter-token ${idx === 0 ? 'head-token' : ''} eco-card-hover\">\n874:       <div class=\"token-badge\">${idx === 0 ? 'NEXT DISPATCH' : `PRIORITY #${idx + 1}`}</div>\n875:       <div class=\"token-name\">${pass.name}</div>\n876:       <div class=\"token-route\"><i class=\"fa-solid fa-route\"></i> ${pass.pickup} &rarr; ${pass.drop}</div>\n877:       <div class=\"token-meta\">${pass.id} &bull; ${pass.requestedAt}</div>\n878:     </div>\n879:   `).join('');\n880: }\n881: \n882: // --- Priority Standby Lounge ---\n883: function renderStandbyLounge() {\n884:   const ring = document.getElementById('standby-ring');\n885:   const counter = document.getElementById('standby-slot-counter');\n886:   const pill = document.getElementById('standby-status-pill');\n887:   if (!ring || !counter || !pill) return;\n888: \n889:   counter.textContent = `${engine.standbyCount} / ${engine.standbyCap}`;\n890:   pill.textContent = `Available Slots: ${engine.standbyCap - engine.standbyCount} / ${engine.standbyCap}`;\n891: \n892:   ring.innerHTML = '';\n893:   const total = engine.standbyCap;\n894:   const radius = 90;\n895: \n896:   for (let i = 0; i < total; i++) {\n897:     const angle = (i * 2 * Math.PI) / total - Math.PI / 2;\n898:     const x = Math.round(radius * Math.cos(angle) + 105);\n899:     const y = Math.round(radius * Math.sin(angle) + 105);\n900: \n901:     const isOccupied = engine.standbyLounge[i] !== null;\n902:     const isActivePointer = i === engine.standbyFront && engine.standbyCount > 0;\n903: \n904:     const slotEl = document.createElement('div');\n905:     slotEl.className = `standby-slot ${isOccupied ? 'occupied' : ''} ${isActivePointer ? 'is-active-pointer' : ''}`;\n906:     slotEl.style.left = `${x}px`;\n907:     slotEl.style.top = `${y}px`;\n908: \n909:     const passenger = engine.standbyLounge[i];\n910:     slotEl.innerHTML = `\n911:       <div class=\"font-bold\">SLOT ${i + 1}</div>\n912:       <div class=\"text-[9px] truncate max-w-[42px]\">${passenger ? passenger.name.split(' ')[0] : 'FREE'}</div>\n913:     `;\n914:     slotEl.title = passenger ? `Standby: ${passenger.name} (${passenger.pickup} -> ${passenger.drop})` : `Slot ${i + 1}: Empty`;\n915:     ring.appendChild(slotEl);\n916:   }\n917: }\n918: \n919: // --- Driver Fleet Directory with EcoSprout Empty State ---\n920: function renderFleetDirectory() {\n921:   const container = document.getElementById('fleet-stream-container');\n922:   const capacityPill = document.getElementById('fleet-capacity-pill');\n923:   if (!container || !capacityPill) return;\n924: \n925:   let totalAvailableSeats = 0;\n926:   engine.fleetPartners.forEach(p => { totalAvailableSeats += p.seats; });\n927:   capacityPill.textContent = `Total Available Seats: ${totalAvailableSeats}`;\n928: \n929:   if (engine.fleetPartners.length === 0) {\n930:     container.innerHTML = `\n931:       <div class=\"ecosprout-container\">\n932:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n933:         <div class=\"ecosprout-bubble\">\n934:           <b>EcoSprout needs partners!</b> Toggle vehicle seats above and onboard a driver partner to open seat capacity.\n935:         </div>\n936:       </div>`;\n937:     return;\n938:   }\n939: \n940:   let html = '';\n941:   engine.fleetPartners.forEach((partner, idx) => {\n942:     html += `\n943:       <div class=\"driver-partner-card eco-card-hover\">\n944:         <div class=\"card-top\">\n945:           <span class=\"driver-id-badge\">ID: #${partner.id}</span>\n946:           <span class=\"seat-counter-pill\">${partner.seats}/${partner.originalSeats} Seats</span>\n947:         </div>\n948:         <div class=\"driver-name\">${partner.name}</div>\n949:         <div class=\"driver-corridor\"><i class=\"fa-solid fa-location-dot text-emerald\"></i> ${partner.station} Station</div>\n950:         <div class=\"text-[10px] text-slate-500 mt-1\">${partner.tripsCompleted} Shared Trips</div>\n951:       </div>\n952:     `;\n953: \n954:     if (idx < engine.fleetPartners.length - 1) {\n955:       html += `<div class=\"fleet-pointer\"><i class=\"fa-solid fa-arrow-right\"></i></div>`;\n956:     }\n957:   });\n958: \n959:   container.innerHTML = html;\n960: }\n961: \n962: // --- Active Shared Trips with EcoSprout Empty State ---\n963: function renderActiveTrips() {\n964:   const container = document.getElementById('active-trips-stream');\n965:   if (!container) return;\n966: \n967:   if (engine.activeTrips.length === 0) {\n968:     container.innerHTML = `\n969:       <div class=\"ecosprout-container\">\n970:         <div class=\"ecosprout-avatar\">${getEcoSproutSVG()}</div>\n971:         <div class=\"ecosprout-bubble\">\n972:           <b>EcoSprout is ready to roll!</b> Dispatch a trip or launch the Rush-Hour simulation to watch active pooled rides.\n973:         </div>\n974:       </div>`;\n975:     return;\n976:   }\n977: \n978:   container.innerHTML = engine.activeTrips.map(trip => `\n979:     <div class=\"shared-trip-card eco-card-hover\">\n980:       <button class=\"btn-cancel-trip\" title=\"Complete / Cancel Trip\" onclick=\"handleCompleteTrip('${trip.tripRef}')\">\n981:         <i class=\"fa-solid fa-xmark\"></i>\n982:       </button>\n983:       <div class=\"flex justify-between items-center\">\n984:         <span class=\"trip-ref\">${trip.tripRef}</span>\n985:         <span class=\"route-match-badge\">${trip.matchScore}% Route Match</span>\n986:       </div>\n987:       <div class=\"text-xs font-bold text-slate-900 mt-0.5\">${trip.passenger.name}</div>\n988:       <div class=\"text-[10px] text-electric font-semibold\">${trip.corridorPath.join(' &rarr; ')}</div>\n989:       <div class=\"text-[10px] text-slate-600 mt-1\"><i class=\"fa-solid fa-id-badge text-emerald\"></i> ${trip.driverName}</div>\n990:       <div class=\"flex justify-between items-center text-[9px] text-slate-500 pt-1 border-t border-slate-200 mt-1\">\n991:         <span>+${trip.co2Saved}kg CO₂</span>\n992:         <button class=\"text-emerald hover:underline font-bold\" onclick=\"viewEcoReceipt('${trip.tripRef}')\">\n993:           <i class=\"fa-solid fa-receipt\"></i> Eco-Receipt\n994:         </button>\n995:         <span class=\"text-slate-900 font-bold\">$${trip.fare}</span>\n996:       </div>\n997:     </div>\n998:   `).join('');\n999: }\n1000: \n1001: // --- Transit Hierarchy Canvas ---\n1002: function renderTransitHierarchyCanvas() {\n1003:   const canvas = document.getElementById('trip-hierarchy-canvas');\n1004:   if (!canvas) return;\n1005:   const ctx = canvas.getContext('2d');\n1006:   const countPill = document.getElementById('registry-count-pill');\n1007: \n1008:   countPill.textContent = `${engine.activeTrips.length} Active Trips`;\n1009:   ctx.clearRect(0, 0, canvas.width, canvas.height);\n1010: \n1011:   if (engine.activeTrips.length === 0) {\n1012:     ctx.fillStyle = '#64748B';\n1013:     ctx.font = '11px \"Inter\"';\n1014:     ctx.textAlign = 'center';\n1015:     ctx.fillText('Transit Dispatch Registry Ready. Active shared trips will display here.', canvas.width / 2, canvas.height / 2);\n1016:     return;\n1017:   }\n1018: \n1019:   // Draw Root Hub\n1020:   const rootX = canvas.width / 2;\n1021:   const rootY = 24;\n1022: \n1023:   ctx.beginPath();\n1024:   ctx.arc(rootX, rootY, 14, 0, Math.PI * 2);\n1025:   ctx.fillStyle = '#FFFFFF';\n1026:   ctx.strokeStyle = '#059669';\n1027:   ctx.lineWidth = 2.5;\n1028:   ctx.fill();\n1029:   ctx.stroke();\n1030: \n1031:   ctx.fillStyle = '#059669';\n1032:   ctx.font = 'bold 9px \"Inter\"';\n1033:   ctx.textAlign = 'center';\n1034:   ctx.textBaseline = 'middle';\n1035:   ctx.fillText('NEXUS', rootX, rootY);\n1036: \n1037:   // Draw Branches\n1038:   const count = engine.activeTrips.length;\n1039:   const spacing = Math.min(80, (canvas.width - 60) / Math.max(count, 1));\n1040:   const startX = rootX - ((count - 1) * spacing) / 2;\n1041: \n1042:   engine.activeTrips.forEach((trip, idx) => {\n1043:     const nodeX = startX + idx * spacing;\n1044:     const nodeY = 110;\n1045: \n1046:     ctx.beginPath();\n1047:     ctx.moveTo(rootX, rootY + 14);\n1048:     ctx.lineTo(nodeX, nodeY - 14);\n1049:     ctx.strokeStyle = '#CBD5E1';\n1050:     ctx.lineWidth = 1.5;"}
